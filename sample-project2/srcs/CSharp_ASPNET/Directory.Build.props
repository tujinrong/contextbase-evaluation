<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).tmp/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath><BaseOutputPath>$(MSBuildThisFileDirectory).tmp/bin/$(MSBuildProjectName)/</BaseOutputPath><Deterministic>true</Deterministic></PropertyGroup></Project>
