@model MenuVm
<main class="sp2-f02" id="menu" data-initial="@JsonSerializer.Serialize(Model,HttpJson.Options)"><div class="panel"><h1>メニュー</h1><p data-item-id="F02-I01">@Model.DisplayName ／ @Model.CurrentRole</p><div class="menu-buttons"><a class="button primary" data-item-id="F02-I02" href="/employees">社員検索・登録</a>@if(Model.CurrentRole==UserRole.ADMIN){<a class="button" data-item-id="F02-I03" href="/codes">汎用コードマスタ</a>}<button type="button" id="logout" data-item-id="F02-I04">ログアウト</button></div><div class="message" data-item-id="F02-I05" role="status">@Model.Outcome?.Message</div><form class="token">@Html.AntiForgeryToken()</form></div></main>
