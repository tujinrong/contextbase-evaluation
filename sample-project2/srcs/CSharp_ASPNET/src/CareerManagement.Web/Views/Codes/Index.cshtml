@model CodeVm
<main class="sp2-f06" id="codes" data-initial="@JsonSerializer.Serialize(Model,HttpJson.Options)"><div class="head"><h1>汎用コードマスタ</h1><button type="button" id="codes-menu" data-item-id="F06-I11">メニュー</button></div><form class="token">@Html.AntiForgeryToken()</form><label>分類<select id="code-category" data-item-id="F06-I01"><option value="DEPARTMENT">部署</option><option value="PROJECT_ROLE">案件役割</option><option value="EMPLOYMENT_STATUS">在籍区分（固定）</option></select></label><p data-item-id="F06-I07">@Model.Note</p><div class="code-layout"><div class="grid" data-item-id="F06-I02"><table><thead><tr><th>選択</th><th>コード</th><th>名称</th><th>順</th><th>有効</th></tr></thead><tbody id="code-rows"></tbody></table></div><fieldset id="code-fields"><legend>コード情報</legend><label>コード<input class="code" id="code-value" data-item-id="F06-I03" inputmode="numeric"></label><label>名称<input class="name" id="code-name" data-item-id="F06-I04" data-max-scalars="40"></label><label>並び順<input class="sort" id="code-sort" data-item-id="F06-I05" inputmode="numeric"></label><label class="check"><input type="checkbox" id="code-enabled" data-item-id="F06-I06">有効</label></fieldset></div><div class="actions"><button type="button" id="code-new" data-item-id="F06-I08">新規</button><button type="button" id="code-save" class="primary" data-item-id="F06-I09">保存</button><button type="button" id="code-cancel" data-item-id="F06-I10">取消・再読込み</button></div><div class="message" id="message" data-item-id="F06-I12" role="status"></div></main>
