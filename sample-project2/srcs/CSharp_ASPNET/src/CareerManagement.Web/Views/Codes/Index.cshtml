@model CodeVm
@{ViewData["ScreenId"]="F06";ViewData["Title"]="汎用コードマスタ";}
<form id="codes" novalidate data-initial="@JsonSerializer.Serialize(Model,HttpJson.Options)"><partial name="_PageHeader"/><div class="token">@Html.AntiForgeryToken()</div><partial name="_FieldErrors"/>
<h2>コード分類</h2><section class="panel"><div class="field"><label for="f06-i01">分類</label><select class="code" id="f06-i01" data-item-id="F06-I01"><option value="DEPARTMENT">部署</option><option value="EMPLOYMENT_STATUS">在籍区分（固定）</option><option value="PROJECT_ROLE">案件役割</option></select></div><p class="help space" data-item-id="F06-I07">@Model.Note</p></section>
<div class="codecols"><section><h2>コード一覧</h2><div class="listwrap" data-item-id="F06-I02" tabindex="0" aria-label="コード一覧"><table><colgroup><col><col><col><col></colgroup><thead><tr><th scope="col" data-col="code">コード</th><th scope="col" data-col="name">名称</th><th scope="col" data-col="sortOrder">並び順</th><th scope="col" data-col="enabled">有効</th></tr></thead><tbody id="code-rows"></tbody></table></div></section>
<section><h2>コード情報</h2><div class="panel" id="code-fields"><p class="help" data-ui="code-mode">一覧からコードを選択するか、新規コードを追加してください。</p>
<div class="field space"><label for="f06-i03">コード</label><input class="no" id="f06-i03" data-item-id="F06-I03" inputmode="numeric"><span class="help">2桁・01～99。登録後は変更できません。</span><span data-ui="field-error" data-error-for="F06-I03"></span></div>
<div class="field space"><label for="f06-i05">並び順</label><input class="no" id="f06-i05" data-item-id="F06-I05" inputmode="numeric"><span data-ui="field-error" data-error-for="F06-I05"></span></div>
<div class="field space"><label for="f06-i04">名称</label><input class="code-name" id="f06-i04" data-item-id="F06-I04" data-max-scalars="40"><span data-ui="field-error" data-error-for="F06-I04"></span></div>
<div class="check space"><input type="checkbox" id="f06-i06" data-item-id="F06-I06"><label for="f06-i06">有効</label><span data-ui="field-error" data-error-for="F06-I06"></span></div>
</div></section></div>
<div class="notice" id="message" data-item-id="F06-I12" role="status"></div><div class="actionbar"><div class="actions"><button type="button" id="code-save" class="primary" data-item-id="F06-I09">このコードを保存</button><button type="button" id="code-cancel" data-item-id="F06-I10">変更を取り消す</button><button type="button" data-action="reload">入力を破棄して保存済み値を再読込</button></div></div></form>
