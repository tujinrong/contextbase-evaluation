@model LoginVm
@{ViewData["ScreenId"]="F01";ViewData["Title"]="ログイン";}
<div class="auth"><div class="auth-panel"><h1>ログイン</h1><p class="help">ログインIDとパスワードを入力してください。</p><div class="notice error" data-item-id="F01-I03" role="status">@Model.Message</div>
<form method="post" action="/account/login" id="login-form">@Html.AntiForgeryToken()
<div class="field"><label for="sp2-login-id">ログインID</label><input id="sp2-login-id" class="login-id" name="LoginId" value="@Model.LoginId" data-item-id="F01-I01" data-max-scalars="20" autocomplete="username" autofocus></div>
<div class="field"><label for="sp2-login-pw">パスワード</label><input id="sp2-login-pw" class="password" name="Password" type="password" data-item-id="F01-I02" data-max-scalars="128" autocomplete="current-password"></div>
<div class="actions"><button type="submit" class="primary" data-item-id="F01-I04">ログイン</button><button type="submit" formaction="/account/exit" formnovalidate data-item-id="F01-I05">終了</button></div></form></div></div>
