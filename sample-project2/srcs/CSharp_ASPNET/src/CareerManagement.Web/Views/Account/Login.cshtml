@model LoginVm
<main class="sp2-f01"><div class="panel"><h1>社員経歴管理システム</h1><p>ログインIDとパスワードを入力してください。</p><div class="message" data-item-id="F01-I03" role="status">@Model.Message</div>
<form method="post" action="/account/login" id="login-form">@Html.AntiForgeryToken()
<label for="sp2-login-id">ログインID</label><input id="sp2-login-id" class="id" name="LoginId" value="@Model.LoginId" data-item-id="F01-I01" data-max-scalars="20" autocomplete="username" autofocus>
<label for="sp2-login-pw">パスワード</label><input id="sp2-login-pw" class="pw" name="Password" type="password" data-item-id="F01-I02" data-max-scalars="128" autocomplete="current-password">
<div class="actions"><button type="submit" class="primary" data-item-id="F01-I04">ログイン</button><button type="submit" formaction="/account/exit" formnovalidate data-item-id="F01-I05">終了</button></div></form></div></main>
