@{
    var title=ViewData["Title"] as string??"";
    var current=ViewData["ScreenId"] as string;
}
<div class="pagehead"><div><div class="crumb">業務の入口 @if(current!="F02"){<span aria-hidden="true"> / </span><span>@(current=="F06"?"汎用コードマスタ":"社員検索・登録")</span>} @if(current=="F04"){<span aria-hidden="true"> / </span><span>@title</span>}</div><h1>@title</h1></div>
@if(current=="F03"&&ViewData["IsUiError"] is not true){<a href="/employees/new" class="button primary" id="employee-new" data-item-id="F03-I10">社員を新規登録</a>}
@if(current=="F06"&&ViewData["IsUiError"] is not true){<button type="button" class="primary" id="code-new" data-item-id="F06-I08">新規コード</button>}
</div>
