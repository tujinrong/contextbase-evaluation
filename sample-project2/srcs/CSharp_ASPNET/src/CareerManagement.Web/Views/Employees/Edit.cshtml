@model EditVm
@{
    ViewData["ScreenId"]="F04";ViewData["Title"]=Model.IsNew?"社員の新規登録":"社員と経歴の編集";
    var basic=new[]{("F04-I01","employeeNo","社員番号","no",6,"半角数字6桁。登録後は変更できません。"),("F04-I02","name","氏名","name",40,"40文字以内"),("F04-I03","kana","氏名カナ","kana",80,"全角カナ・80文字以内"),("F04-I04","departmentCode","部署","code",2,""),("F04-I05","employmentStatus","在籍区分","code",2,""),("F04-I06","joinDateRaw","入社日","date",10,"YYYY-MM-DD")};
    var longBasic=new[]{("F04-I07","careerSummary","職務要約"),("F04-I08","skills","得意技術・スキル"),("F04-I09","qualifications","保有資格"),("F04-I10","selfPr","自己PR")};
    var careerShort=new[]{("F04-I14","startMonthRaw","開始年月","month","YYYY-MM"),("F04-I15","endMonthRaw","終了年月","month","空欄は継続中"),("F04-I23","roleCode","役割","role",""),("F04-I24","teamSizeRaw","チーム人数","team","1～999人"),("F04-I16","companyName","会社名","medium","100文字以内"),("F04-I17","projectName","案件名","medium","100文字以内")};
    var careerLong=new[]{("F04-I18","description","業務・案件概要",1000),("F04-I19","duties","担当業務",1000),("F04-I20","achievements","成果・工夫",1000),("F04-I21","technologies","使用技術",500),("F04-I22","phases","担当工程",200)};
}
<form id="edit" novalidate data-initial="@JsonSerializer.Serialize(Model,HttpJson.Options)"><partial name="_PageHeader"/><div class="token">@Html.AntiForgeryToken()</div>
<div class="target" data-ui="employee-identity"><strong data-ui="identity-number">@(Model.Employee.EmployeeNo.Length==0?"社員番号 未入力":Model.Employee.EmployeeNo)</strong> <span data-ui="identity-name">@(Model.Employee.Name.Length==0?"氏名 未入力":Model.Employee.Name)</span> ／ <span data-ui="identity-mode">@(Model.IsNew?"新規登録":"編集")</span></div>
<partial name="_FieldErrors"/>
<div class="tabs" role="tablist" aria-label="社員情報の切替" data-item-id="F04-I12"><button type="button" role="tab" id="basic-tab" data-tab="basic" aria-controls="basic-pane" aria-selected="true" tabindex="0">基本情報・職務</button><button type="button" role="tab" id="careers-tab" data-tab="career" aria-controls="careers-pane" aria-selected="false" tabindex="-1">経歴</button></div>
<section id="basic-pane" role="tabpanel" data-tab="basic" aria-labelledby="basic-tab" class="form-page"><h2>基本情報</h2><div class="panel"><div class="fields">
@foreach(var f in basic){<div class="field"><label for="@f.Item1.ToLowerInvariant()">@f.Item3 <span class="required">必須</span></label>@if(f.Item2 is "departmentCode" or "employmentStatus"){<select class="@f.Item4" id="@f.Item1.ToLowerInvariant()" data-field="@f.Item2" data-item-id="@f.Item1"></select>}else{<input class="@f.Item4" id="@f.Item1.ToLowerInvariant()" data-field="@f.Item2" data-item-id="@f.Item1" data-max-scalars="@f.Item5" inputmode="@(f.Item2 is "employeeNo" or "joinDateRaw"?"numeric":null)">}<span class="help">@f.Item6</span><span data-ui="field-error" data-error-for="@f.Item1"></span></div>}
</div></div><h2>職務情報</h2><div class="panel two">
@foreach(var f in longBasic){<div class="field"><label for="@f.Item1.ToLowerInvariant()">@f.Item3</label><textarea id="@f.Item1.ToLowerInvariant()" data-field="@f.Item2" data-item-id="@f.Item1" data-max-scalars="1000"></textarea><span class="help">1000文字以内・改行可</span><span data-ui="field-error" data-error-for="@f.Item1"></span></div>}
</div></section>
<section id="careers-pane" role="tabpanel" data-tab="career" aria-labelledby="careers-tab" hidden><div class="careercols"><section><div class="listhead"><h2>経歴一覧</h2><button type="button" id="career-add" data-item-id="F04-I25">経歴追加</button></div><p class="help">案件名から編集する経歴を選択してください。追加・反映・除去は未保存です。</p><div class="panel career-list-panel"><ul class="careerlist" id="career-rows" data-item-id="F04-I13"></ul></div></section>
<section><h2>経歴の内容</h2><div class="panel" id="career-fields"><p class="help" data-ui="career-mode">一覧で選択するか、経歴を追加してください。</p><div class="fields">
@foreach(var f in careerShort){<div class="field"><label for="@f.Item1.ToLowerInvariant()">@f.Item3 @if(f.Item2!="endMonthRaw"){<span class="required">必須</span>}</label>@if(f.Item2=="roleCode"){<select class="@f.Item4" id="@f.Item1.ToLowerInvariant()" data-career="@f.Item2" data-item-id="@f.Item1"></select>}else{<input class="@f.Item4" id="@f.Item1.ToLowerInvariant()" data-career="@f.Item2" data-item-id="@f.Item1" inputmode="@(f.Item2 is "startMonthRaw" or "endMonthRaw" or "teamSizeRaw"?"numeric":null)">}<span class="help">@f.Item5</span><span data-ui="field-error" data-error-for="@f.Item1"></span></div>}
</div><div class="two space">
@foreach(var f in careerLong){<div class="field"><label for="@f.Item1.ToLowerInvariant()">@f.Item3 @if(f.Item2 is "description" or "duties"){<span class="required">必須</span>}</label><textarea id="@f.Item1.ToLowerInvariant()" data-career="@f.Item2" data-item-id="@f.Item1" data-max-scalars="@f.Item4"></textarea><span class="help">@f.Item4 文字以内・改行可</span><span data-ui="field-error" data-error-for="@f.Item1"></span></div>}
</div><div class="actions space"><button type="button" id="career-apply" data-item-id="F04-I26">この経歴を反映</button><button type="button" id="career-remove" class="danger" data-item-id="F04-I27">この経歴を除去</button></div></div></section></div></section>
<div class="notice" id="message" data-item-id="F04-I11" role="status" tabindex="-1"></div><div class="actionbar"><div><p class="help">社員と全経歴を一括保存します。編集中の経歴も含まれます。</p><div class="actions"><button type="button" class="primary" id="employee-save" data-item-id="F04-I28">社員と経歴を保存</button><button type="button" id="employee-cancel" data-item-id="F04-I29">保存せず検索へ戻る</button></div></div><button type="button" id="employee-reload" data-action="reload">入力を破棄して保存済み値を再読込</button></div></form>
