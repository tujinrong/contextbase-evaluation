@model EditVm
<main class="sp2-f04" id="edit" data-initial="@JsonSerializer.Serialize(Model,HttpJson.Options)"><div class="head"><h1>社員登録</h1><span><button id="employee-save" type="button" class="primary" data-item-id="F04-I28">保存</button> <button id="employee-cancel" type="button" data-item-id="F04-I29">取消・検索へ戻る</button> <button id="employee-reload" type="button">再読込み</button></span></div><form class="token">@Html.AntiForgeryToken()</form><div class="message" id="message" data-item-id="F04-I11" role="status"></div>
<div class="tabs" role="tablist" data-item-id="F04-I12"><button type="button" role="tab" id="basic-tab" aria-controls="basic-pane">基本情報</button><button type="button" role="tab" id="careers-tab" aria-controls="careers-pane">経歴</button></div>
<section id="basic-pane" role="tabpanel"><div class="basic-fields"><label>社員番号<input id="employee-no" data-field="employeeNo" data-item-id="F04-I01" data-max-scalars="6" inputmode="numeric"></label><label>氏名<input data-field="name" data-item-id="F04-I02" data-max-scalars="40"></label><label>氏名カナ<input data-field="kana" data-item-id="F04-I03" data-max-scalars="80"></label><label>部署<select data-field="departmentCode" data-item-id="F04-I04"></select></label><label>在籍区分<select data-field="employmentStatus" data-item-id="F04-I05"></select></label><label>入社日<input type="date" data-field="joinDateRaw" data-item-id="F04-I06"></label></div>
<div class="long-fields"><label>職務要約<textarea data-field="careerSummary" data-item-id="F04-I07" data-max-scalars="1000"></textarea></label><label>得意技術・スキル<textarea data-field="skills" data-item-id="F04-I08" data-max-scalars="1000"></textarea></label><label>資格<textarea data-field="qualifications" data-item-id="F04-I09" data-max-scalars="1000"></textarea></label><label>自己PR<textarea data-field="selfPr" data-item-id="F04-I10" data-max-scalars="1000"></textarea></label></div></section>
<section id="careers-pane" role="tabpanel" hidden><div class="career-top"><div class="grid" data-item-id="F04-I13"><table><thead><tr><th>選択</th><th>期間</th><th>会社名</th><th>案件名</th></tr></thead><tbody id="career-rows"></tbody></table></div><div class="actions"><button id="career-add" type="button" data-item-id="F04-I25">経歴追加</button><button id="career-apply" type="button" data-item-id="F04-I26">明細へ反映</button><button id="career-remove" type="button" data-item-id="F04-I27">経歴除去</button></div></div>
<fieldset id="career-fields"><legend>経歴の編集（DBへの反映は全体保存時）</legend><div class="career-short"><label>開始年月<input type="month" data-career="startMonthRaw" data-item-id="F04-I14"></label><label>終了年月<input type="month" data-career="endMonthRaw" data-item-id="F04-I15"></label><label>会社名<input data-career="companyName" data-item-id="F04-I16" data-max-scalars="100"></label><label>案件名<input data-career="projectName" data-item-id="F04-I17" data-max-scalars="100"></label><label>役割<select data-career="roleCode" data-item-id="F04-I23"></select></label><label>チーム人数<input data-career="teamSizeRaw" data-item-id="F04-I24" inputmode="numeric"></label></div><div class="long-fields"><label>業務・案件概要<textarea data-career="description" data-item-id="F04-I18" data-max-scalars="1000"></textarea></label><label>担当業務<textarea data-career="duties" data-item-id="F04-I19" data-max-scalars="1000"></textarea></label><label>成果・工夫<textarea data-career="achievements" data-item-id="F04-I20" data-max-scalars="1000"></textarea></label><label>使用技術<textarea data-career="technologies" data-item-id="F04-I21" data-max-scalars="500"></textarea></label><label>担当工程<textarea data-career="phases" data-item-id="F04-I22" data-max-scalars="200"></textarea></label></div></fieldset></section></main>
