@model SearchVm
<main class="sp2-f03" id="search" data-initial="@JsonSerializer.Serialize(Model,HttpJson.Options)"><div class="head"><h1>社員検索</h1><a class="button" data-item-id="F03-I13" href="/menu">メニュー</a></div><form class="token">@Html.AntiForgeryToken()</form>
<div class="fields"><label>社員番号<input class="no" id="search-no" data-item-id="F03-I01" data-max-scalars="6" inputmode="numeric" autofocus></label><label>氏名・氏名カナ<input class="name" id="search-name" data-item-id="F03-I02" data-max-scalars="40"></label><label>部署<select id="search-dep" data-item-id="F03-I03"></select></label><label>在籍区分<select id="search-status" data-item-id="F03-I04"></select></label><button class="primary" type="button" id="search-run" data-item-id="F03-I05">検索</button><button type="button" id="search-clear" data-item-id="F03-I06">クリア</button></div>
<div class="actions"><span id="search-count" data-item-id="F03-I07">未検索</span><span><button type="button" id="employee-new" data-item-id="F03-I10">新規登録</button> <button type="button" id="employee-edit" data-item-id="F03-I11" disabled>編集</button> <button type="button" id="employee-export" data-item-id="F03-I12" disabled>経歴書Excel</button> <button type="button" id="export-cancel" hidden>作成取消</button></span></div>
<div class="grid" data-item-id="F03-I08"><table><thead><tr><th class="select-col">選択</th><th class="no-col">社員番号</th><th>氏名</th><th>氏名カナ</th><th>部署</th><th>在籍</th><th>入社日</th></tr></thead><tbody id="search-rows"></tbody></table></div><div class="message" id="message" data-item-id="F03-I09" role="status"></div><p>経歴書には社員経歴が含まれます。保存先と共有範囲を確認してください。</p></main>
