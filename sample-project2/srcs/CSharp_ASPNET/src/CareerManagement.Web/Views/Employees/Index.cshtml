@model SearchVm
@{ViewData["ScreenId"]="F03";ViewData["Title"]="社員検索";}
<form id="search" novalidate data-initial="@JsonSerializer.Serialize(Model,HttpJson.Options)"><partial name="_PageHeader"/><div class="token">@Html.AntiForgeryToken()</div>
<partial name="_FieldErrors"/><h2>検索条件</h2><section class="panel" aria-label="検索条件"><div class="fields">
<div class="field"><label for="f03-i01">社員番号</label><input class="no" id="f03-i01" data-item-id="F03-I01" inputmode="numeric" data-max-scalars="6"><span class="help">完全一致・6桁</span></div>
<div class="field"><label for="f03-i02">氏名・氏名カナ</label><input class="name" id="f03-i02" data-item-id="F03-I02" data-max-scalars="40"><span class="help">氏名・カナの一部で検索</span></div>
<div class="field"><label for="f03-i03">部署</label><select class="code" id="f03-i03" data-item-id="F03-I03"></select><span data-invalid-hint="department" class="help raw-value"></span></div>
<div class="field"><label for="f03-i04">在籍区分</label><select class="code" id="f03-i04" data-item-id="F03-I04"></select><span data-invalid-hint="employmentStatus" class="help raw-value"></span></div>
</div><div class="actions space"><button type="button" class="primary" id="search-run" data-item-id="F03-I05">検索</button><button type="button" id="search-clear" data-item-id="F03-I06">クリア</button></div><p class="help space" data-ui="criteria-state">未検索です。条件を入力して検索してください。</p><p class="help" data-ui="applied-criteria"></p></section>
<h2 id="results-heading" tabindex="-1">検索結果</h2><div class="panel"><div class="listhead"><span id="search-count" data-item-id="F03-I07">未検索</span><div class="actions"><button type="button" id="employee-export" data-item-id="F03-I12" disabled>選択した社員の経歴書Excel</button><button type="button" id="export-cancel" hidden>作成を取り消す</button></div></div>
<p class="help" data-ui="selection">社員を選択してください。行の編集は事前の選択なしで開けます。</p>
<div class="listwrap" data-item-id="F03-I08" tabindex="0" aria-label="社員一覧"><table class="employees"><colgroup><col><col><col><col><col><col><col><col></colgroup><thead><tr><th scope="col" data-col="select">選択</th><th scope="col" data-col="employeeNo">社員番号</th><th scope="col" data-col="name">氏名</th><th scope="col" data-col="kana">氏名カナ</th><th scope="col" data-col="department">部署</th><th scope="col" data-col="status">在籍</th><th scope="col" data-col="joinDate">入社日</th><th scope="col" data-col="edit">操作</th></tr></thead><tbody id="search-rows"></tbody></table></div>
<p class="help space">表示範囲は検索した全件（最大200件）です。社員番号の昇順で表示します。Excelは保存済みの選択社員1人と全経歴が対象です。</p></div>
<div class="notice" id="message" data-item-id="F03-I09" role="status" tabindex="-1"></div></form>
