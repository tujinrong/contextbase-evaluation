{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "projectId",
    "capsuleManifestSha256",
    "executionContextSha256",
    "planSha256",
    "sourceOnly",
    "businessEvidenceAuthority",
    "originalAppExecuted",
    "originalSpecificationsAuthorized",
    "evaluationExpectationsAuthorized",
    "newSourceReadPermissions",
    "documents",
    "formalPercentage",
    "published"
  ],
  "properties": {
    "schema": {
      "const": "spec-agent-same-run-routing-record/1"
    },
    "runId": {
      "const": "20261014-nenkin-high-01"
    },
    "projectId": {
      "const": "nenkin"
    },
    "capsuleManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executionContextSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceOnly": {
      "const": true
    },
    "businessEvidenceAuthority": {
      "const": false
    },
    "originalAppExecuted": {
      "const": false
    },
    "originalSpecificationsAuthorized": {
      "const": false
    },
    "evaluationExpectationsAuthorized": {
      "const": false
    },
    "newSourceReadPermissions": {
      "const": false
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "kind",
          "path",
          "disposition",
          "locations"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "specification",
              "report-only"
            ]
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "format",
                "relativePath"
              ],
              "properties": {
                "scope": {
                  "enum": [
                    "specification-bundle",
                    "execution-report"
                  ]
                },
                "format": {
                  "enum": [
                    "md",
                    "html",
                    "pdf",
                    "xlsx",
                    "json"
                  ]
                },
                "relativePath": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "formalPercentage": {
      "const": null
    },
    "published": {
      "const": false
    }
  }
}
