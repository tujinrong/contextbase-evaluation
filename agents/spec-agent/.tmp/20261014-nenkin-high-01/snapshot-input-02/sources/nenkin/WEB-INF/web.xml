<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/dtd/web-app_2_3.dtd">
<web-app>
	<display-name>年金自動受取予約管理システム</display-name>

	<context-param>
		<param-name>LOGGER_NAME</param-name>
		<param-value>n2nenkin</param-value>
	</context-param>

	<listener>
		<listener-class>nenkin.H2JndiSetupListener</listener-class>
	</listener>

	<servlet>
		<servlet-name>ControlServlet</servlet-name>
		<servlet-class>common.ControlServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>

	<servlet-mapping>
		<servlet-name>ControlServlet</servlet-name>
		<url-pattern>/Action.do</url-pattern>
	</servlet-mapping>

	<welcome-file-list>
		<welcome-file>JSP/MENU/Login.jsp</welcome-file>
	</welcome-file-list>
</web-app>

