<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.List,java.util.Map,nenkin.bean.PensionViewBean,nenkin.model.CodeLookupItem,nenkin.model.PensionReservation,nenkin.service.ReferenceDataService,nenkin.util.HtmlUtil" %>
<!DOCTYPE html>
<jsp:useBean id="ViewBean" class="nenkin.bean.PensionViewBean" scope="session"/>
<% PensionReservation r=ViewBean.getReservation(); String locked=ViewBean.isExisting()?" readonly class=\"form-control access-key-locked\"":" class=\"form-control\""; ReferenceDataService codes=ReferenceDataService.getInstance(); List<CodeLookupItem> genders=codes.listGenders(),claims=codes.listClaimStatuses(),benefits=codes.listBenefitStatuses(); Map<Integer,String> pensionLabels=codes.getPensionTypeLabels(); %>
<html lang="ja">
<head>
	<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
	<title>新規・変更・削除</title>
	<link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/site.css">
	<script src="<%=request.getContextPath()%>/assets/js/app.js" defer></script>
	<script src="<%=request.getContextPath()%>/assets/js/japanese-era-calendar.js" defer></script>
</head>
<body>
	<header class="app-nav"><div class="app-nav__title">年金自動受取予約管理システム</div><div class="app-nav__meta">職員番号 <strong><%=HtmlUtil.escape(ViewBean.getStaffNo())%></strong>　<%=HtmlUtil.escape(ViewBean.getStaffName())%></div></header>
	<main class="app-shell"><section class="screen surface pension-screen">
		<div class="screen-header"><h1>新規・変更・削除　画面</h1><button class="access-button secondary narrow" type="button" onclick="navigateMenu()">戻る</button></div>
		<% if(ViewBean.getMessage().length()>0){ %><div id="pensionStatusMessage" role="status" aria-live="polite" class="message <%=ViewBean.getMessage().indexOf("終了")>=0?"success":"error"%>"><%=HtmlUtil.escape(ViewBean.getMessage())%></div><% } else { %><div id="pensionStatusMessage" role="status" aria-live="polite" class="message" hidden></div><% } %>
		<form id="pensionForm" action="<%=request.getContextPath()%>/Action.do" method="post" accept-charset="Windows-31J" class="access-form pension-entry-form">
			<input type="hidden" name="FUNCTION_ID" value="nenkin"><input id="pensionView" type="hidden" name="VIEW_ID" value="Pension"><input id="pensionCommand" type="hidden" name="COMMAND_ID" value="Save"><input type="hidden" name="CSRF_TOKEN" value="<%=HtmlUtil.escape(String.valueOf(session.getAttribute("NENKIN_CSRF_TOKEN")))%>"><input id="originalKana" type="hidden" name="ORIGINAL_KANA" value="<%=ViewBean.isExisting()?HtmlUtil.escape(r.getKanaName()):""%>"><input id="originalPhone" type="hidden" name="ORIGINAL_PHONE" value="<%=ViewBean.isExisting()?HtmlUtil.escape(r.getPhoneNumber()):""%>"><input id="lookupKana" type="hidden" name="LOOKUP_KANA" value=""><input id="lookupPhone" type="hidden" name="LOOKUP_PHONE" value="">
			<div class="access-layout">
				<div class="access-section"><h2>基本情報</h2>
					<div class="field-row access-row"><label for="branchNo">店番</label><div class="input-reference"><input id="branchNo" name="BRANCH_NO" value="<%=HtmlUtil.value(r.getBranchNo())%>" class="form-control code-input short-input" maxlength="3" inputmode="numeric" data-digits-only><button class="lookup-button" type="button" onclick="openLookup('branch')">参照</button><span id="branchName" class="code-name-display"><%=HtmlUtil.escape(r.getBranchName())%></span></div></div>
					<div class="field-row access-row"><label for="customerNo">顧客番号</label><div class="input-reference"><input id="customerNo" name="CUSTOMER_NO" value="<%=HtmlUtil.value(r.getCustomerNo())%>" class="form-control code-input medium-input" maxlength="7" inputmode="numeric" data-digits-only><button class="lookup-button" type="button" onclick="openLookup('customer')">参照</button><span id="customerNameDisplay" class="code-name-display"><%=HtmlUtil.escape(r.getCustomerName())%></span></div></div>
					<div class="field-row access-row"><label for="staffCode">担当者コード</label><div class="input-reference"><input id="staffCode" name="STAFF_CODE" value="<%=HtmlUtil.value(r.getStaffCode())%>" class="form-control code-input short-input" maxlength="4" inputmode="numeric" data-digits-only><button class="lookup-button" type="button" onclick="openLookup('staff')">参照</button><span id="staffNameDisplay" class="code-name-display"></span></div></div>
					<div class="field-row access-row"><label class="access-red-label" for="kanaName">フリガナ</label><input id="kanaName" name="KANA_NAME" value="<%=HtmlUtil.escape(r.getKanaName())%>"<%=locked%>></div>
					<div class="field-row access-row"><label for="customerName">顧客氏名</label><input id="customerName" name="CUSTOMER_NAME" value="<%=HtmlUtil.escape(r.getCustomerName())%>" class="form-control"></div>
					<div class="field-row access-row"><label for="gender">性別</label><select id="gender" name="GENDER" class="form-select short-input"><option value=""></option><% for(int i=0;i<genders.size();i++){CodeLookupItem x=genders.get(i); %><option value="<%=HtmlUtil.escape(x.getLabel())%>"<%=HtmlUtil.selected(r.getGender(),x.getLabel())%>><%=HtmlUtil.escape(x.getLabel())%></option><% } %></select></div>
					<div class="field-row access-row tall"><label for="address">住所</label><textarea id="address" name="ADDRESS" class="form-control" rows="3"><%=HtmlUtil.escape(r.getAddress())%></textarea></div>
					<div class="field-row access-row"><label class="access-red-label" for="phoneNumber">電話番号</label><div class="input-reference"><input id="phoneNumber" name="PHONE_NUMBER" value="<%=HtmlUtil.escape(r.getPhoneNumber())%>"<%=locked%>><button class="lookup-button" type="button" onclick="openLookup('candidate')">候補</button></div></div>
					<div class="field-row access-row"><label for="birthDate">生年月日</label><div class="calendar-input"><input id="birthDate" name="BIRTH_DATE" value="<%=HtmlUtil.escape(HtmlUtil.formatJapaneseDate(r.getBirthDate()))%>" class="form-control medium-input" maxlength="14" data-era-calendar data-era-calendar-mode="japanese"><button class="era-calendar-button" type="button" data-era-calendar-toggle="birthDate" aria-label="生年月日のカレンダーを開く"></button></div></div>
					<div class="field-row access-row"><label for="dataUpdateDate">データ更新日</label><input id="dataUpdateDate" name="DATA_UPDATE_DATE" value="<%=HtmlUtil.escape(HtmlUtil.formatWesternDate(r.getDataUpdateDate()))%>" class="form-control medium-input access-readonly-display" readonly></div>
				</div>
				<div class="access-section"><h2>予約情報</h2>
					<div class="field-row access-row tall"><label>年金種類</label><div class="checkbox-grid"><label><input type="checkbox" name="NATIONAL_PENSION" value="1"<%=HtmlUtil.checked(r.isNationalPension())%>> <%=HtmlUtil.escape(pensionLabels.get(Integer.valueOf(1)))%></label><label><input type="checkbox" name="EMPLOYEE_PENSION_FUND" value="1"<%=HtmlUtil.checked(r.isEmployeePensionFund())%>> <%=HtmlUtil.escape(pensionLabels.get(Integer.valueOf(8)))%></label><label><input type="checkbox" name="EMPLOYEE_PENSION" value="1"<%=HtmlUtil.checked(r.isEmployeePension())%>> <%=HtmlUtil.escape(pensionLabels.get(Integer.valueOf(2)))%></label><label><input type="checkbox" name="NATIONAL_PENSION_FUND" value="1"<%=HtmlUtil.checked(r.isNationalPensionFund())%>> <%=HtmlUtil.escape(pensionLabels.get(Integer.valueOf(16)))%></label><label><input type="checkbox" name="MUTUAL_AID_PENSION" value="1"<%=HtmlUtil.checked(r.isMutualAidPension())%>> <%=HtmlUtil.escape(pensionLabels.get(Integer.valueOf(4)))%></label></div></div>
					<div class="field-row access-row"><label for="claimStatus">裁定請求書徴収</label><select id="claimStatus" name="CLAIM_STATUS" class="form-select short-input"><option value=""></option><% for(int i=0;i<claims.size();i++){CodeLookupItem x=claims.get(i); %><option value="<%=HtmlUtil.escape(x.getLabel())%>"<%=HtmlUtil.selected(r.getClaimStatus(),x.getLabel())%>><%=HtmlUtil.escape(x.getLabel())%></option><% } %></select></div>
					<div class="field-row access-row"><label for="claimDate">請求予定日</label><div class="calendar-input"><input id="claimDate" name="CLAIM_SCHEDULED_DATE" value="<%=HtmlUtil.escape(HtmlUtil.formatWesternDate(r.getClaimScheduledDate()))%>" class="form-control medium-input" maxlength="14" data-era-calendar data-era-calendar-mode="western"><button class="era-calendar-button" type="button" data-era-calendar-toggle="claimDate" aria-label="請求予定日のカレンダーを開く"></button></div></div>
					<div class="field-row access-row"><label for="plannedAge">予定年齢</label><input id="plannedAge" name="PLANNED_AGE" value="<%=HtmlUtil.value(r.getPlannedAge())%>" class="form-control short-input" maxlength="3" inputmode="numeric" data-digits-only></div>
					<div class="field-row access-row"><label for="spouseName">配偶者名</label><input id="spouseName" name="SPOUSE_NAME" value="<%=HtmlUtil.escape(r.getSpouseName())%>" class="form-control"></div>
					<div class="field-row access-row"><label for="spouseBirthDate">配偶者生年月日</label><div class="calendar-input"><input id="spouseBirthDate" name="SPOUSE_BIRTH_DATE" value="<%=HtmlUtil.escape(HtmlUtil.formatJapaneseDate(r.getSpouseBirthDate()))%>" class="form-control medium-input" maxlength="14" data-era-calendar data-era-calendar-mode="japanese"><button class="era-calendar-button" type="button" data-era-calendar-toggle="spouseBirthDate" aria-label="配偶者生年月日のカレンダーを開く"></button></div></div>
					<div class="field-row access-row"><label for="hasBenefit">受給有無</label><select id="hasBenefit" name="HAS_BENEFIT" class="form-select short-input"><option value=""></option><% for(int i=0;i<benefits.size();i++){CodeLookupItem x=benefits.get(i); %><option value="<%=HtmlUtil.escape(x.getLabel())%>"<%=HtmlUtil.selected(r.getHasBenefit(),x.getLabel())%>><%=HtmlUtil.escape(x.getLabel())%></option><% } %></select></div>
					<div class="field-row access-row"><label for="requestDate">予約徴求日</label><div class="calendar-input"><input id="requestDate" name="RESERVATION_REQUEST_DATE" value="<%=HtmlUtil.escape(HtmlUtil.formatWesternDate(r.getReservationRequestDate()))%>" class="form-control medium-input" maxlength="14" data-era-calendar data-era-calendar-mode="western"><button class="era-calendar-button" type="button" data-era-calendar-toggle="requestDate" aria-label="予約徴求日のカレンダーを開く"></button></div></div>
					<div class="field-row access-row tall"><label for="notes">備考</label><textarea id="notes" name="NOTES" class="form-control" rows="3"><%=HtmlUtil.escape(r.getNotes())%></textarea></div>
					<div class="field-row access-row"><label>６ヶ月先確認</label><label class="single-check"><input type="checkbox" name="SIX_MONTH_CHECK" value="1"<%=HtmlUtil.checked(r.isSixMonthCheck())%>> 確認済</label></div>
				</div>
			</div>
			<div class="button-row sticky-actions"><button class="access-button primary" type="button" onclick="confirmSave()">登録</button><button class="access-button danger" type="button" onclick="confirmDelete()">削除</button><button class="access-button secondary" type="button" onclick="submitCommand('Clear')">クリア</button></div>
		</form>
	</section></main>

	<div id="lookupModal" class="lookup-modal" role="dialog" aria-modal="true" aria-labelledby="lookupTitle" hidden><div class="lookup-modal__backdrop" onclick="closeLookup()"></div><div class="lookup-modal__panel"><div class="lookup-modal__header"><h2 id="lookupTitle">入力補助</h2><button id="lookupClose" class="lookup-modal__close" type="button" onclick="closeLookup()">閉じる</button></div><iframe id="lookupFrame" name="lookupFrame" class="lookup-modal__frame" title="入力補助"></iframe></div></div>
	<div id="messageBox" class="message-box" role="dialog" aria-modal="true" aria-labelledby="messageTitle" hidden><div class="message-box__backdrop"></div><div class="message-box__panel"><div class="message-box__titlebar"><h2 id="messageTitle">確認</h2></div><div class="message-box__body"><div id="messageIcon" class="message-box__icon">?</div><p id="messageText" class="message-box__message"></p></div><div class="message-box__actions"><button id="messageOk" class="access-button primary" type="button">OK</button><button id="messageCancel" class="access-button" type="button">キャンセル</button></div></div></div>

	<script>
	const contextPath='<%=request.getContextPath()%>';
	const form=document.getElementById('pensionForm');
	let lookupOpener=null;
	function submitCommand(command){document.getElementById('pensionView').value='Pension';document.getElementById('pensionCommand').value=command;form.submit();}
	function navigateMenu(){document.getElementById('pensionView').value='Menu';document.getElementById('pensionCommand').value='View';form.submit();}
	function showBox(title,message,confirmMode){return new Promise(resolve=>{const box=document.getElementById('messageBox');document.getElementById('messageTitle').textContent=title;document.getElementById('messageText').textContent=message;document.getElementById('messageIcon').textContent=confirmMode?'?':'!';const ok=document.getElementById('messageOk'),cancel=document.getElementById('messageCancel');cancel.hidden=!confirmMode;box.hidden=false;ok.focus();const done=value=>{box.hidden=true;ok.onclick=null;cancel.onclick=null;resolve(value);};ok.onclick=()=>done(true);cancel.onclick=()=>done(false);});}
	async function confirmSave(){if(!document.getElementById('branchNo').value){await showBox('店番確認','店番は必ず入力してください',false);return;}if(!document.getElementById('kanaName').value||!document.getElementById('phoneNumber').value){await showBox('入力確認','フリガナと電話番号を入力してください。',false);return;}if(await showBox('確認','登録します。よろしいですか？',true))submitCommand('Save');}
	async function confirmDelete(){if(!document.getElementById('branchNo').value){await showBox('削除','店番は必ず入力してください',false);return;}if(!document.getElementById('kanaName').value||!document.getElementById('phoneNumber').value){await showBox('削除','削除対象がありません。既存レコードを読み込んでから削除してください。',false);return;}if(await showBox('削除確認','表示しているレコードを削除します。よろしいですか？',true))submitCommand('Delete');}
	function postToFrame(values){const launcher=document.createElement('form');launcher.method='post';launcher.action=contextPath+'/Action.do';launcher.target='lookupFrame';launcher.acceptCharset='Windows-31J';Object.keys(values).forEach(key=>{const input=document.createElement('input');input.type='hidden';input.name=key;input.value=values[key]||'';launcher.appendChild(input);});document.body.appendChild(launcher);launcher.submit();launcher.remove();}
	function openLookup(target){lookupOpener=document.activeElement;let actual=target==='candidate'?'customer':target;const branch=document.getElementById('branchNo').value;const kana=target==='candidate'?document.getElementById('kanaName').value:'';const phone=target==='candidate'?document.getElementById('phoneNumber').value:'';document.getElementById('lookupTitle').textContent=actual==='branch'?'店番参照':actual==='staff'?'担当者参照':'顧客参照';document.getElementById('lookupModal').hidden=false;document.body.classList.add('lookup-modal-open');document.getElementById('lookupClose').focus();postToFrame({FUNCTION_ID:'nenkin',VIEW_ID:'Lookup',COMMAND_ID:'View',TARGET:actual,POPUP:'1',BRANCH_NO:branch,NAME_KEYWORD:kana,PHONE_KEYWORD:phone});}
	function closeLookup(){document.getElementById('lookupModal').hidden=true;document.getElementById('lookupFrame').src='about:blank';document.body.classList.remove('lookup-modal-open');if(lookupOpener&&lookupOpener.focus)lookupOpener.focus();}
	window.addEventListener('message',event=>{if(event.origin!==location.origin||!event.data||event.data.source!=='nenkin.lookup')return;const d=event.data;if(d.target==='branch'){document.getElementById('branchNo').value=d.branchNo||'';document.getElementById('branchName').textContent=d.branchName||'';}else if(d.target==='staff'){document.getElementById('staffCode').value=d.staffCode||'';document.getElementById('staffNameDisplay').textContent=d.staffName||'';}else if(d.target==='customer'){document.getElementById('branchNo').value=d.branchNo||'';document.getElementById('customerNo').value=d.customerNo||'';document.getElementById('branchName').textContent=d.branchName||'';document.getElementById('customerNameDisplay').textContent=d.customerName||'';document.getElementById('lookupKana').value=d.kanaName||'';document.getElementById('lookupPhone').value=d.phoneNumber||'';closeLookup();submitCommand('Load');return;}closeLookup();});
	function maybeLoadExisting(){const kana=document.getElementById('kanaName'),phone=document.getElementById('phoneNumber');if(document.getElementById('originalKana').value||kana.readOnly||phone.readOnly||!kana.value.trim()||!phone.value.trim())return;document.getElementById('lookupKana').value=kana.value;document.getElementById('lookupPhone').value=phone.value;submitCommand('Load');}
	function calculatePlannedAge(){if(!window.nenkinEraDate)return;const birth=window.nenkinEraDate.parse(document.getElementById('birthDate').value),claim=window.nenkinEraDate.parse(document.getElementById('claimDate').value);if(birth&&claim)document.getElementById('plannedAge').value=String(claim.getUTCFullYear()-birth.getUTCFullYear());}
	document.getElementById('kanaName').addEventListener('change',maybeLoadExisting);document.getElementById('phoneNumber').addEventListener('change',maybeLoadExisting);document.getElementById('customerNo').addEventListener('change',()=>{if(document.getElementById('branchNo').value&&document.getElementById('customerNo').value&&!document.getElementById('originalKana').value)openLookup('customer');});['input','change'].forEach(eventName=>{document.getElementById('birthDate').addEventListener(eventName,calculatePlannedAge);document.getElementById('claimDate').addEventListener(eventName,calculatePlannedAge);});document.addEventListener('keydown',event=>{if(event.key!=='Escape')return;if(!document.getElementById('messageBox').hidden){document.getElementById('messageCancel').click();}else if(!document.getElementById('lookupModal').hidden)closeLookup();});const statusMessage=document.getElementById('pensionStatusMessage');if(statusMessage&&!statusMessage.hidden&&statusMessage.textContent.includes('終了'))setTimeout(()=>showBox('完了',statusMessage.textContent.trim(),false),0);
	</script>
</body></html>
