<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.List,nenkin.bean.LookupViewBean,nenkin.model.BranchLookupItem,nenkin.model.CustomerLookupItem,nenkin.model.StaffLookupItem,nenkin.util.HtmlUtil" %>
<!DOCTYPE html>
<jsp:useBean id="SubWindowBean" class="nenkin.bean.LookupViewBean" scope="session"/>
<% String target=SubWindowBean.getTarget(); String title="branch".equals(target)?"店番参照":"staff".equals(target)?"担当者参照":"顧客参照"; %>
<html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=title%></title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/site.css"><script src="<%=request.getContextPath()%>/assets/js/app.js" defer></script></head>
<body class="popup-page"><main class="app-shell"><section class="screen surface lookup-screen lookup-screen-popup">
	<div class="screen-header compact"><h1><%=title%></h1><button class="access-button secondary narrow" type="button" onclick="closePopup()">閉じる</button></div>
	<form id="lookupForm" action="<%=request.getContextPath()%>/Action.do" method="post" accept-charset="Windows-31J" class="lookup-filter">
		<input type="hidden" name="FUNCTION_ID" value="nenkin"><input type="hidden" name="VIEW_ID" value="Lookup"><input type="hidden" name="COMMAND_ID" value="Search"><input type="hidden" name="TARGET" value="<%=HtmlUtil.escape(target)%>"><input id="lookupPage" type="hidden" name="PAGE" value="1"><input type="hidden" name="POPUP" value="1">
		<% if("customer".equals(target)){ %>
		<div class="lookup-filter-row"><label for="lookupBranch">店番</label><input id="lookupBranch" name="BRANCH_NO" value="<%=HtmlUtil.escape(SubWindowBean.getBranchNo())%>" class="form-control code-input short-input" maxlength="3" inputmode="numeric" data-digits-only><label for="lookupName">氏名・フリガナ</label><input id="lookupName" name="NAME_KEYWORD" value="<%=HtmlUtil.escape(SubWindowBean.getNameKeyword())%>" class="form-control"><label for="lookupPhone">電話番号</label><input id="lookupPhone" name="PHONE_KEYWORD" value="<%=HtmlUtil.escape(SubWindowBean.getPhoneKeyword())%>" class="form-control"><button class="access-button primary narrow" type="submit">検索</button><button class="access-button narrow" type="button" onclick="clearFilters()">クリア</button></div>
		<% } else if("staff".equals(target)){ %>
		<div class="lookup-filter-row"><label for="lookupBranch">店番</label><input id="lookupBranch" name="BRANCH_NO" value="<%=HtmlUtil.escape(SubWindowBean.getBranchNo())%>" class="form-control code-input short-input" maxlength="3" inputmode="numeric" data-digits-only><label for="lookupKeyword">担当者名</label><input id="lookupKeyword" name="KEYWORD" value="<%=HtmlUtil.escape(SubWindowBean.getKeyword())%>" class="form-control"><button class="access-button primary narrow" type="submit">検索</button><button class="access-button narrow" type="button" onclick="clearFilters()">クリア</button></div>
		<% } else { %>
		<div class="lookup-filter-row"><label for="lookupKeyword">検索</label><input id="lookupKeyword" name="KEYWORD" value="<%=HtmlUtil.escape(SubWindowBean.getKeyword())%>" class="form-control" placeholder="番号・店舗名で検索"><button class="access-button primary narrow" type="submit">検索</button><button class="access-button narrow" type="button" onclick="clearFilters()">クリア</button></div>
		<% } %>
	</form>
	<div class="lookup-pagination-top"><span><%=SubWindowBean.getTotalCount()%>件中 <%=SubWindowBean.getFirstRow()%>～<%=SubWindowBean.getLastRow()%>件</span></div>
	<div class="table-wrap lookup-table-wrap"><table class="access-table"><thead>
	<% if("branch".equals(target)){ %><tr><th class="access-code-center">店番</th><th>店名</th><th></th></tr>
	<% } else if("staff".equals(target)){ %><tr><th class="access-code-center">担当者コード</th><th>担当者名</th><th class="access-code-center">店番</th><th>店名</th><th></th></tr>
	<% } else { %><tr><th class="access-code-center">店番</th><th>店名</th><th class="access-code-center">顧客番号</th><th>フリガナ</th><th>顧客氏名</th><th>電話番号</th><th>生年月日</th><th></th></tr><% } %>
	</thead><tbody>
	<% if("branch".equals(target)){ List<BranchLookupItem> rows=SubWindowBean.getBranches(); for(int i=0;i<rows.size();i++){BranchLookupItem x=rows.get(i); %><tr><td class="access-code-center"><%=x.getBranchNo()%></td><td><%=HtmlUtil.escape(x.getBranchName())%></td><td><button class="table-action" type="button" data-choice-target="branch" data-branch-no="<%=x.getBranchNo()%>" data-branch-name="<%=HtmlUtil.escape(x.getBranchName())%>" onclick="choose(this)">選択</button></td></tr><% }}
	else if("staff".equals(target)){ List<StaffLookupItem> rows=SubWindowBean.getStaff(); for(int i=0;i<rows.size();i++){StaffLookupItem x=rows.get(i); %><tr><td class="access-code-center"><%=x.getStaffCode()%></td><td><%=HtmlUtil.escape(x.getStaffName())%></td><td class="access-code-center"><%=x.getBranchNo()%></td><td><%=HtmlUtil.escape(x.getBranchName())%></td><td><button class="table-action" type="button" data-choice-target="staff" data-staff-code="<%=x.getStaffCode()%>" data-staff-name="<%=HtmlUtil.escape(x.getStaffName())%>" data-branch-no="<%=x.getBranchNo()%>" onclick="choose(this)">選択</button></td></tr><% }}
	else { List<CustomerLookupItem> rows=SubWindowBean.getCustomers(); for(int i=0;i<rows.size();i++){CustomerLookupItem x=rows.get(i); %><tr><td class="access-code-center"><%=x.getBranchNo()%></td><td><%=HtmlUtil.escape(x.getBranchName())%></td><td class="access-code-center"><%=x.getCustomerNo()%></td><td><%=HtmlUtil.escape(x.getKanaName())%></td><td><%=HtmlUtil.escape(x.getCustomerName())%></td><td><%=HtmlUtil.escape(x.getPhoneNumber())%></td><td><%=HtmlUtil.escape(HtmlUtil.formatJapaneseDate(x.getBirthDate()))%></td><td><button class="table-action" type="button" data-choice-target="customer" data-branch-no="<%=x.getBranchNo()%>" data-customer-no="<%=x.getCustomerNo()%>" data-branch-name="<%=HtmlUtil.escape(x.getBranchName())%>" data-customer-name="<%=HtmlUtil.escape(x.getCustomerName())%>" data-staff-code="<%=x.getStaffCode()%>" data-kana-name="<%=HtmlUtil.escape(x.getKanaName())%>" data-phone-number="<%=HtmlUtil.escape(x.getPhoneNumber())%>" onclick="choose(this)">選択</button></td></tr><% }} %>
	</tbody></table></div>
	<% if(SubWindowBean.getTotalPages()>1){ %><nav class="pagination"><button type="button"<%=SubWindowBean.getPage()<=1?" disabled":""%> onclick="goPage(<%=SubWindowBean.getPage()-1%>)">前へ</button><% int start=Math.max(1,SubWindowBean.getPage()-3),end=Math.min(SubWindowBean.getTotalPages(),start+6);start=Math.max(1,end-6);for(int p=start;p<=end;p++){%><button type="button" class="<%=p==SubWindowBean.getPage()?"current":""%>" onclick="goPage(<%=p%>)"><%=p%></button><%}%><button type="button"<%=SubWindowBean.getPage()>=SubWindowBean.getTotalPages()?" disabled":""%> onclick="goPage(<%=SubWindowBean.getPage()+1%>)">次へ</button></nav><% } %>
</section></main>
<script>
function send(data){data.source='nenkin.lookup';window.parent.postMessage(data,location.origin);}
function choose(button){const d=button.dataset;if(d.choiceTarget==='branch')send({target:'branch',branchNo:d.branchNo,branchName:d.branchName});else if(d.choiceTarget==='staff')send({target:'staff',staffCode:d.staffCode,staffName:d.staffName,branchNo:d.branchNo});else send({target:'customer',branchNo:d.branchNo,customerNo:d.customerNo,branchName:d.branchName,customerName:d.customerName,staffCode:d.staffCode,kanaName:d.kanaName,phoneNumber:d.phoneNumber});}
function closePopup(){send({target:'close'});}
function goPage(page){if(page<1)return;document.getElementById('lookupPage').value=String(page);document.getElementById('lookupForm').submit();}
function clearFilters(){document.querySelectorAll('#lookupForm input:not([type]), #lookupForm input[type="text"]').forEach(x=>x.value='');document.getElementById('lookupPage').value='1';document.getElementById('lookupForm').submit();}
</script></body></html>
