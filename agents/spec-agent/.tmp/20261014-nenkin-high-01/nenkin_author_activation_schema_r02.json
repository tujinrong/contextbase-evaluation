{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "approved",
    "agentRole",
    "projectId",
    "mode",
    "runId",
    "deadline",
    "driverSha256",
    "capsuleManifestSha256",
    "executionContextSha256",
    "runtimeReceiptSha256",
    "codeAuditApproved",
    "codeAudit",
    "plan",
    "planReview",
    "documents",
    "protectedInputSealSha256"
  ],
  "properties": {
    "schema": {
      "const": "spec-agent-author-activation/1"
    },
    "approved": {
      "const": true
    },
    "agentRole": {
      "const": "AG-SPEC"
    },
    "projectId": {
      "const": "nenkin"
    },
    "mode": {
      "const": "source-only"
    },
    "runId": {
      "const": "20261014-nenkin-high-01"
    },
    "deadline": {
      "const": "2026-10-14T13:06:43.011844+00:00"
    },
    "driverSha256": {
      "$ref": "#/$defs/sha"
    },
    "capsuleManifestSha256": {
      "const": "92c339cb7040019312d0ec01669d22c44e4cc73fa373d5278c3f6f04c0c09631"
    },
    "executionContextSha256": {
      "const": "d3a4e4d1bedd6e4d7a2d8658f162e2d8f7a0119ffdb4529650f2a2d369ca90cc"
    },
    "runtimeReceiptSha256": {
      "const": "5c3eeafb764afb64e3ef80fb422e4f68a9c41b98f000d13a8d57a505d947cc79"
    },
    "codeAuditApproved": {
      "const": true
    },
    "codeAudit": {
      "$ref": "#/$defs/file"
    },
    "protectedInputSealSha256": {
      "$ref": "#/$defs/sha"
    },
    "plan": {
      "$ref": "#/$defs/handoffFile"
    },
    "planReview": {
      "$ref": "#/$defs/handoffFile"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "handoffFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "handoffSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "handoffSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  }
}
