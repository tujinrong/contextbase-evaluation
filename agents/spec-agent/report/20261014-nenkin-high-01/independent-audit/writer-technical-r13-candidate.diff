+def technical_revision_selection(pin, plan, selected, previous):
+    metadata = pin.get('technicalRevisionMetadata')
+    if metadata is None:
+        return
+    require(selected == metadata['documentIds'] and set(previous) == set(selected), 'Technical metadata needs one exact full previous revision')
+    source = metadata['context']['parentResult']
+    old = previous[selected[0]]
+    require(old['sourceResult'] == source['path'] and old['sourceResultSha256'] == source['sha256'],
+        'Technical revision selected a different previous full draft/review')
+
+def technical_revision_context(revision_context, original_context, pin, definition):
+    metadata = pin.get('technicalRevisionMetadata')
+    if metadata is None:
+        return revision_context
+    require(definition['kind'] in {'basic-design','detailed-specification'} and
+        [definition['id']] == metadata['documentIds'] and isinstance(revision_context, dict) and
+        revision_context.get('executionContext') == original_context and
+        isinstance(revision_context.get('previousCanonicalMarkdown'), str) and
+        bool(revision_context['previousCanonicalMarkdown']) and
+        isinstance(revision_context.get('preservedIndependentReview'), dict),
+        'Technical revision requires full original context/previous AI text/independent review')
+    result = dict(revision_context)
+    require('technicalRevisionMetadata' not in result and 'technicalRevisionPolicy' not in result,
+        'Technical metadata cannot overwrite prior revision metadata')
+    result['technicalRevisionMetadata'] = metadata['context']
+    result['technicalRevisionPolicy'] = TECHNICAL_REVISION_POLICY
+    return result
