+        require((target.name == 'renderer-original-manifest.json' if artifact['role'] == 'renderer-original-manifest' else
+            target.suffix == '.log') and sha(target) == artifact['sha256'], 'Technical artifact path/SHA differs')
+        pins[str(target)] = sha(target)
+    result = dict(pin);result['pinnedFiles'] = dict(pin['pinnedFiles'])
+    for filename, expected in pins.items():
+        require(filename not in result['pinnedFiles'] or result['pinnedFiles'][filename] == expected,
+            'Technical pin conflict')
+        require(sha(filename) == expected, 'Technical bytes drift during binding')
+        result['pinnedFiles'][filename] = expected
+    result['technicalRevisionMetadata'] = {'schema':'spec-agent-technical-revision-binding/1',
+        'metadata':{'path':str(path),'sha256':sha(path)},'documentIds':[definition['id']], 'pinnedFiles':pins,
+        'context':value,'businessEvidenceAuthority':False,'newSourceReadPermissions':False,
+        'businessProseAssembledByPython':False,'nativeOrFormalApproval':False}
+    return result
