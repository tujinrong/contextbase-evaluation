+def with_technical_revision_metadata(pin, plan, path, expected_sha):
+    from jsonschema import Draft202012Validator
+    require('technicalRevisionMetadata' not in pin, 'Technical metadata needs original base input')
+    path = inside(path, REPORT / 'execution-metadata')
+    require(path.suffix == '.json' and sha(path) == hash_arg(expected_sha), 'Technical metadata path/SHA differs')
+    value = load(path)
+    Draft202012Validator(TECHNICAL_METADATA_SCHEMA).validate(value)
+    require(value['capsuleManifestSha256'] == pin['snapshot']['manifestSha256'] and
+        value['executionContextSha256'] == pin['executionContextSha256'] and value['planSha256'] == pin['planSha256'] and
+        pin['snapshot']['mode'] == 'source-only', 'Technical metadata cap/context/plan differs')
+    definition = next((d for d in plan['documents'] if d['id'] == value['document']['documentId']), None)
+    require(definition is not None and value['document'] ==
+        {'documentId':definition['id'],'kind':definition['kind'],'path':definition['path']},
+        'Technical metadata exact plan document differs')
+    parent_file = inside(value['parentResult']['path'], WORK / 'jobs')
+    require(parent_file.name == 'author-document-result.json' and sha(parent_file) == value['parentResult']['sha256'],
+        'Technical previous result path/SHA differs')
+    parent = load(parent_file)
+    require(parent['documentId'] == definition['id'] and parent['kind'] == definition['kind'] and
+        parent['path'] == definition['path'] and parent['capsule'] == pin['snapshot'] and
+        parent['planSha256'] == pin['planSha256'] and parent['executionContextSha256'] == pin['executionContextSha256'] and
+        parent['draft']['sha256'] == value['parentDocumentSha256'],
+        'Technical parent result/document identity differs')
+    parent_document = inside(parent['draft']['canonicalMarkdown'], WORK / 'drafts')
+    require(sha(parent_document) == value['parentDocumentSha256'], 'Technical parent Markdown byte drift')
+    manifest_file = inside(value['renderManifest']['path'], WORK / 'renders')
+    require(manifest_file.name == 'manifest.json' and sha(manifest_file) == value['renderManifest']['sha256'],
+        'Technical render manifest path/SHA differs')
+    manifest = load(manifest_file)
+    require(manifest['sourceSha256'] == value['parentDocumentSha256'], 'Render manifest parent SHA differs')
+    actual = [{key:d[key] for key in ['id','sourceLines','sourceSha256','status','error']}
+        for d in manifest['diagrams'] if d['status'] == 'ERROR']
+    require(actual == value['technicalFindings'] and actual and
