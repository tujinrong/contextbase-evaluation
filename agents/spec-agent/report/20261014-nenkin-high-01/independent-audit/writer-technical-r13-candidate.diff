+            d['sourceLines'][0] <= d['sourceLines'][1] for d in actual),
+        'Technical findings differ from full actual failed diagram records')
+    require({a['role'] for a in value['artifacts']} == {'renderer-original-manifest','render-log'},
+        'Technical artifact roles differ')
+    pins = {str(path):sha(path), str(parent_file):sha(parent_file), str(parent_document):sha(parent_document),
