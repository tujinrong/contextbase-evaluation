+    revision_context = writer.technical_revision_context(revision_context,context,bound,bound_definition)
+    require(sha(path) == TECHNICAL_METADATA_WRITER_SHA, 'Technical writer changed while binding')
+    return {'context':bound['technicalRevisionMetadata']['context'],'policy':writer.TECHNICAL_REVISION_POLICY,
