+    require(isinstance(previous,dict) and isinstance(reused,dict) and set(reused)<=set(prepared['documents']),
+        'Technical prepared revision/reuse map differs')
+    writer.technical_revision_selection(bound, exact_plan, prepared['documents'], previous)
+    require(bound == wave_input and [definition['id']] == bound['technicalRevisionMetadata']['documentIds'],
