+            'Unbound technical carrier or prompt refused')
+        return
+    require(definition['kind'] in {'basic-design','detailed-specification'} and
+        all(value.get('technicalRevisionMetadata')==optional['provenance'] for value in carriers),
+        'Technical text-pin/result/review-handoff provenance differs')
