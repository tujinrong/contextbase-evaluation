{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data_relations": {
      "items": {
        "required": [
          "kind",
          "store",
          "operation"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "dependencies": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "events": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "trigger"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "items": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "io": {
            "enum": [
              "I",
              "O",
              "I／O",
              "‐"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "io",
          "type",
          "required"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "scenarios": {
      "type": "array"
    },
    "schema": {
      "const": "contextbase.feature.v1"
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "kind",
    "dependencies",
    "items",
    "events",
    "data_relations",
    "scenarios"
  ],
  "type": "object"
}
