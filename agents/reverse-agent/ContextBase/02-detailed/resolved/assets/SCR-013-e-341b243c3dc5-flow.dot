digraph flow {
graph [rankdir=TB, bgcolor=white, nodesep=0.25, ranksep=0.35];
node [fontname="Noto Sans CJK JP",fontsize=12,margin="0.12,0.07"]; edge [fontname="Noto Sans CJK JP",fontsize=11];
"n0" [shape=oval,label="終了"];
"n1" [shape=oval,label="処理結果を呼出元へ返す"];
"n2" [shape=oval,label="処理結果を呼出元へ返す"];
"n3" [shape=diamond,label="条件1を満たす（原本条件は補足説明を参照）？"];
"n4" [shape=box,label="関連情報を取得・設定する（処理2：詳細仕様参照）"];
"n5" [shape=box,label="関連情報を取得・設定する（処理3：詳細仕様参照）"];
"n6" [shape=box,label="関連情報を取得・設定する（処理4：詳細仕様参照）"];
"n7" [shape=oval,label="開始：ログイン処理"];
"n1" -> "n0" [label=""];
"n2" -> "n0" [label=""];
"n3" -> "n2" [label="はい"];
"n3" -> "n1" [label="いいえ"];
"n4" -> "n3" [label=""];
"n5" -> "n4" [label=""];
"n6" -> "n5" [label=""];
"n7" -> "n6" [label=""];
}
