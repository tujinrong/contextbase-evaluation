{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projectId", "profile", "rubricSha256", "sourceSnapshotSha256", "documents"],
  "properties": {
    "schema": {"const": "independent-evaluation-batch-selection/1"},
    "projectId": {"const": "test-project1"},
    "profile": {"const": "CSharp_ASPNET"},
    "rubricSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceSnapshotSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "createdAt": {"type": "string"},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "batchPath", "normalizationPath", "canonicalPath", "canonicalSha256"],
        "properties": {
          "documentId": {"type": "string", "minLength": 1},
          "batchPath": {"type": "string", "minLength": 1},
          "normalizationPath": {"type": "string", "minLength": 1},
          "canonicalPath": {"type": "string", "minLength": 1},
          "canonicalSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "visualReviewPath": {"type": ["string", "null"]},
          "requiredVisualModes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "roundId": {"type": "string"}
        }
      }
    }
  }
}
