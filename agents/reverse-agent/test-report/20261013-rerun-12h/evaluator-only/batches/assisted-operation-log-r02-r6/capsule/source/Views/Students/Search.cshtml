@model StudentSearchPageModel
@{var data=Model.Data;var items=data.GetProperty("items");var outcome=data.GetProperty("outcome").GetString();int count=data.GetProperty("totalCount").ValueKind==System.Text.Json.JsonValueKind.Number?data.GetProperty("totalCount").GetInt32():0;int page=data.GetProperty("page").GetInt32();var codes=Model.Lookups.Codes;}
<h1>学生検索</h1><partial name="_MessagePanel" model="Model.Message" />
<form method="post" action="/students/search" data-search-form><input type="hidden" name="ContextId" value="@Model.Context.Id"><input type="hidden" name="ContextRevision" value="@Model.Context.Revision"><input type="hidden" name="TabId" value="@Model.Context.Tab"><input type="hidden" name="PageSize" value="@Model.PageSize"><input type="hidden" name="SortKey" value="@Model.SortKey"><input type="hidden" name="SortDirection" value="@Model.SortDirection">@Html.AntiForgeryToken()
<fieldset><legend>検索条件</legend><div class="fields"><label>学籍番号<input asp-for="Criteria.StudentNo" id="SRC-001" maxlength="30"></label><label>氏名<input asp-for="Criteria.Name" id="SRC-002" maxlength="16"></label><label>氏名カナ<input asp-for="Criteria.Kana" id="SRC-003" maxlength="72"></label><label>年度<select asp-for="Criteria.SchoolYear" id="SRC-004" disabled="@Model.Criteria.UnassignedOnly"><option value="">すべて</option>@foreach(var y in Model.Lookups.Classes.Select(c=>c.SchoolYear).Distinct().OrderDescending()){<option value="@y">@y</option>}</select></label><label>学年<select asp-for="Criteria.GradeCode" id="SRC-005" disabled="@Model.Criteria.UnassignedOnly"><option value="">すべて</option>@foreach(var c in codes.Where(c=>c.CategoryId=="GRADE")){<option value="@c.CodeValue">@c.CodeName</option>}</select></label><label>クラス<select asp-for="Criteria.ClassId" id="SRC-006" disabled="@Model.Criteria.UnassignedOnly"><option value="">すべて</option>@foreach(var c in Model.Lookups.Classes.Where(c=>(Model.Criteria.SchoolYear is null||c.SchoolYear==Model.Criteria.SchoolYear)&&(string.IsNullOrEmpty(Model.Criteria.GradeCode)||c.GradeCode==Model.Criteria.GradeCode))){<option value="@c.ClassId">@c.SchoolYear @c.ClassCode @c.ClassName @(!c.IsActive?"（停止）":"")</option>}</select></label><label class="check"><input asp-for="Criteria.UnassignedOnly" id="SRC-007">未所属のみ</label><fieldset><legend>在籍区分</legend>@foreach(var c in codes.Where(c=>c.CategoryId=="ENROLLMENT_STATUS")){<label class="check"><input type="checkbox" name="Criteria.StatusCodes" value="@c.CodeValue" checked="@Model.Criteria.StatusCodes.Contains(c.CodeValue)">@c.CodeName</label>}<small>全解除はすべて</small></fieldset><label>都道府県<select asp-for="Criteria.PrefectureCode" id="SRC-009"><option value="">すべて</option>@foreach(var c in codes.Where(c=>c.CategoryId=="PREFECTURE")){<option value="@c.CodeValue">@c.CodeName</option>}</select></label><label>電話番号<input asp-for="Criteria.PhoneNumber" id="SRC-010" maxlength="40"></label><label>入学日・開始<input asp-for="Criteria.AdmissionFrom" id="SRC-011" type="date"></label><label>入学日・終了<input asp-for="Criteria.AdmissionTo" id="SRC-012" type="date"></label></div><div class="actions"><button type="submit" class="primary">検索</button><button type="submit" formaction="/students/options">候補を更新</button></div></fieldset></form>
<div class="actions"><form method="post" action="/students/clear">@Html.AntiForgeryToken()<input type="hidden" name="ContextId" value="@Model.Context.Id"><input type="hidden" name="ContextRevision" value="@Model.Context.Revision"><input type="hidden" name="TabId" value="@Model.Context.Tab"><button>クリア</button></form>@if(Model.User.Role!=Role.Viewer){<a href="/students/new?returnContextId=@Model.Context.Id">新規登録</a>}</div>
@if(outcome=="tooMany"){<p class="warning">10,000件を超えました。条件を追加してください。</p>}else if(outcome=="empty"){<p>該当する学生はありません。</p>}else if(outcome=="unsearched"){<p>未検索</p>}else{<p>検索結果 @count 件　@data.GetProperty("searchedAt").GetString()</p>}
<form method="post" action="/students/page">@Html.AntiForgeryToken()<input type="hidden" name="ContextId" value="@Model.Context.Id"><input type="hidden" name="ContextRevision" value="@Model.Context.Revision"><input type="hidden" name="TabId" value="@Model.Context.Tab"><div class="actions"><label>表示件数<select name="PageSize">@foreach(var n in new[]{20,50,100}){<option value="@n" selected="@(n==Model.PageSize)">@n</option>}</select></label><label>並び順<select name="SortKey">@foreach(var s in new[]{("studentNo","学籍番号"),("name","氏名"),("admissionDate","入学日"),("updatedAt","更新日時")}){<option value="@s.Item1" selected="@(s.Item1==Model.SortKey)">@s.Item2</option>}</select></label><select name="SortDirection" aria-label="並び順方向"><option value="asc" selected="@(Model.SortDirection=="asc")">昇順</option><option value="desc" selected="@(Model.SortDirection=="desc")">降順</option></select><button name="Page" value="1" disabled="@(outcome!="found")">並び順・件数を反映</button></div><div class="grid"><table><thead><tr><th>学籍番号</th><th>氏名</th><th>氏名カナ</th><th>生年月日</th><th>年度／学年</th><th>クラス</th><th>在籍区分</th><th>住所</th><th>本人電話</th><th>更新日時</th><th>操作</th></tr></thead><tbody>@foreach(var row in items.EnumerateArray()){<tr><td>@row.GetProperty("studentNo").GetString()</td><td>@row.GetProperty("studentName").GetString()</td><td>@row.GetProperty("studentNameKana").GetString()</td><td>@row.GetProperty("birthDateWareki").GetString()</td><td>@row.GetProperty("schoolYear") @row.GetProperty("gradeName").GetString()</td><td>@row.GetProperty("classCode").GetString() @row.GetProperty("className").GetString()</td><td>@row.GetProperty("enrollmentName").GetString()</td><td>@row.GetProperty("addressDisplay").GetString()</td><td>@(row.GetProperty("phoneNumber").GetString()??"－")</td><td>@row.GetProperty("updatedAt").GetString()</td><td><a href="/students/@row.GetProperty("studentId").GetString()?returnContextId=@Model.Context.Id">@(Model.User.Role==Role.Viewer?"参照":"編集")</a></td></tr>}</tbody></table></div><nav class="pager"><button name="Page" value="@(page-1)" disabled="@(outcome!="found"||page<=1)">前へ</button><span>@(page) / @Math.Max(1,(count+Model.PageSize-1)/Model.PageSize)</span><button name="Page" value="@(page+1)" disabled="@(outcome!="found"||page*Model.PageSize>=count)">次へ</button></nav></form>
