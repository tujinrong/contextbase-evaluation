<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="nenkin.bean.ExcelViewBean,nenkin.util.HtmlUtil" %>
<!DOCTYPE html>
<jsp:useBean id="ViewBean" class="nenkin.bean.ExcelViewBean" scope="session"/>
<html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EXCEL出力</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/site.css"><script src="<%=request.getContextPath()%>/assets/js/app.js" defer></script></head>
<body><header class="app-nav"><div class="app-nav__title">年金自動受取予約管理システム</div></header><main class="app-shell"><section class="screen surface compact-screen excel-screen">
	<div class="screen-header"><h1>EXCEL出力</h1><button class="access-button secondary narrow" type="button" onclick="backMenu()">戻る</button></div>
	<% if(ViewBean.getMessage().length()>0){ %><div class="message error"><%=HtmlUtil.escape(ViewBean.getMessage())%></div><% } %>
	<form id="excelForm" action="<%=request.getContextPath()%>/Action.do" method="post" accept-charset="Windows-31J" class="access-form"><input type="hidden" name="FUNCTION_ID" value="nenkin"><input id="excelView" type="hidden" name="VIEW_ID" value="Excel"><input id="excelCommand" type="hidden" name="COMMAND_ID" value="Export"><div class="field-row"><label for="excelBranch">店番</label><div class="input-reference"><input id="excelBranch" name="BRANCH_NO" value="<%=HtmlUtil.escape(ViewBean.getBranchNo())%>" class="form-control code-input short-input" maxlength="3" inputmode="numeric" data-digits-only><button class="lookup-button" type="button" onclick="openLookup()">参照</button><span id="excelBranchName" class="code-name-display"><%=HtmlUtil.escape(ViewBean.getBranchName())%></span></div></div><div class="button-row"><button class="access-button primary" type="submit">EXCEL出力</button><button class="access-button secondary" type="button" onclick="backMenu()">戻る</button></div></form>
	<div id="lookupModal" class="lookup-modal" role="dialog" aria-modal="true" hidden><div class="lookup-modal__backdrop" onclick="closeLookup()"></div><div class="lookup-modal__panel"><div class="lookup-modal__header"><h2>店番参照</h2><button class="lookup-modal__close" type="button" onclick="closeLookup()">閉じる</button></div><iframe id="lookupFrame" name="lookupFrame" class="lookup-modal__frame" title="店番参照"></iframe></div></div>
</section></main><script>const contextPath='<%=request.getContextPath()%>';function backMenu(){document.getElementById('excelView').value='Menu';document.getElementById('excelCommand').value='View';document.getElementById('excelForm').submit();}function openLookup(){const launcher=document.createElement('form');launcher.method='post';launcher.action=contextPath+'/Action.do';launcher.target='lookupFrame';launcher.acceptCharset='Windows-31J';const values={FUNCTION_ID:'nenkin',VIEW_ID:'Lookup',COMMAND_ID:'View',TARGET:'branch',POPUP:'1'};Object.keys(values).forEach(key=>{const input=document.createElement('input');input.type='hidden';input.name=key;input.value=values[key];launcher.appendChild(input);});document.body.appendChild(launcher);document.getElementById('lookupModal').hidden=false;launcher.submit();launcher.remove();}function closeLookup(){document.getElementById('lookupModal').hidden=true;document.getElementById('lookupFrame').src='about:blank';}window.addEventListener('message',e=>{if(e.origin!==location.origin||!e.data||e.data.source!=='nenkin.lookup')return;if(e.data.target==='branch'){document.getElementById('excelBranch').value=e.data.branchNo||'';document.getElementById('excelBranchName').textContent=e.data.branchName||'';}closeLookup();});</script></body></html>
