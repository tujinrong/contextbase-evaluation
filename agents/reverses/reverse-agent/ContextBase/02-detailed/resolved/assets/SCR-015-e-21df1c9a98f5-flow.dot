digraph flow {
graph [rankdir=TB, bgcolor=white, nodesep=0.25, ranksep=0.35];
node [fontname="Noto Sans CJK JP",fontsize=12,margin="0.12,0.07"]; edge [fontname="Noto Sans CJK JP",fontsize=11];
"n0" [shape=oval,label="終了"];
"n1" [shape=oval,label="EXCEL出力へ表示を戻す"];
"n2" [shape=box,label="処理結果とメッセージを画面の表示内容へ設定する"];
"n3" [shape=oval,label="年金自動受取予約管理システム - ログインへ表示\nを戻す"];
"n4" [shape=diamond,label="ログイン職員を確認できない？"];
"n5" [shape=oval,label="開始：Excel出力画面表示"];
"n1" -> "n0" [label=""];
"n2" -> "n1" [label=""];
"n3" -> "n0" [label=""];
"n4" -> "n3" [label="はい"];
"n4" -> "n2" [label="いいえ"];
"n5" -> "n4" [label=""];
}
