graph er {
graph [rankdir=LR,bgcolor=white,nodesep=0.4,ranksep=0.8];
node [shape=plain,fontname="Noto Sans CJK JP",fontsize=12]; edge [fontname="Noto Sans CJK JP",fontsize=10];
"t0" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT">受給有無テーブル<BR/>受給有無テーブル<BR/>参照</TD></TR><TR><TD ALIGN="LEFT">PK 受給ｺｰﾄﾞ [受給ｺｰﾄﾞ]</TD></TR><TR><TD ALIGN="LEFT">受給有無 [受給有無]</TD></TR></TABLE>>];
"t1" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT">年金1_LK<BR/>年金1_LK<BR/>参照・登録・更新</TD></TR><TR><TD ALIGN="LEFT">店番 [店番]</TD></TR><TR><TD ALIGN="LEFT">顧客番号 [顧客番号]</TD></TR><TR><TD ALIGN="LEFT">担当者コード [担当者コード]</TD></TR><TR><TD ALIGN="LEFT">顧客氏名 [顧客氏名]</TD></TR><TR><TD ALIGN="LEFT">ふりがな [ふりがな]</TD></TR><TR><TD ALIGN="LEFT">性別 [性別]</TD></TR><TR><TD ALIGN="LEFT">住所 [住所]</TD></TR><TR><TD ALIGN="LEFT">電話番号 [電話番号]</TD></TR><TR><TD ALIGN="LEFT">生年月日 [生年月日]</TD></TR><TR><TD ALIGN="LEFT">種類：国民年金 [種類：国民年金]</TD></TR><TR><TD ALIGN="LEFT">種類：厚生年金 [種類：厚生年金]</TD></TR><TR><TD ALIGN="LEFT">種類：共済年金 [種類：共済年金]</TD></TR><TR><TD ALIGN="LEFT">他16項目：統合テーブル定義書参照</TD></TR></TABLE>>];
"t2" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT">年金種類テーブル<BR/>年金種類テーブル<BR/>参照</TD></TR><TR><TD ALIGN="LEFT">PK 種類ｺｰﾄﾞ [種類ｺｰﾄﾞ]</TD></TR><TR><TD ALIGN="LEFT">年金種類 [年金種類]</TD></TR></TABLE>>];
"t3" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT">店名テーブル<BR/>店名テーブル<BR/>参照</TD></TR><TR><TD ALIGN="LEFT">PK 店舗ｺｰﾄﾞ [店舗ｺｰﾄﾞ]</TD></TR><TR><TD ALIGN="LEFT">店名 [店名]</TD></TR></TABLE>>];
"t4" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT">性別テーブル<BR/>性別テーブル<BR/>参照</TD></TR><TR><TD ALIGN="LEFT">PK 性別ｺｰﾄﾞ [性別ｺｰﾄﾞ]</TD></TR><TR><TD ALIGN="LEFT">性別 [性別]</TD></TR></TABLE>>];
"t5" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT">裁定請求テーブル<BR/>裁定請求テーブル<BR/>参照</TD></TR><TR><TD ALIGN="LEFT">PK 裁請ｺｰﾄﾞ [裁請ｺｰﾄﾞ]</TD></TR><TR><TD ALIGN="LEFT">裁定請求 [裁定請求]</TD></TR></TABLE>>];
"t6" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT">Ｕ職員名簿表<BR/>DB2.Ｕ職員名簿表<BR/>参照</TD></TR><TR><TD ALIGN="LEFT">PK 職員番号 [職員番号]</TD></TR><TR><TD ALIGN="LEFT">所属店番 [所属店番]</TD></TR><TR><TD ALIGN="LEFT">漢字氏名 [漢字氏名]</TD></TR><TR><TD ALIGN="LEFT">カナ氏名 [カナ氏名]</TD></TR><TR><TD ALIGN="LEFT">役職コード [役職コード]</TD></TR></TABLE>>];
"t1" -- "t3" [label="店番 = 店舗ｺｰﾄﾞ\nSQL結合（多重度未確定）"];
"t1" -- "t4" [label="性別 = 性別ｺｰﾄﾞ\nSQL結合（多重度未確定）"];
"t1" -- "t5" [label="裁定請求 = 裁請ｺｰﾄﾞ\nSQL結合（多重度未確定）"];
"t1" -- "t0" [label="受給有無 = 受給ｺｰﾄﾞ\nSQL結合（多重度未確定）"];
"t1" -- "t2" [label="年金種類 = 種類ｺｰﾄﾞ\nSQL結合（多重度未確定）"];
}
