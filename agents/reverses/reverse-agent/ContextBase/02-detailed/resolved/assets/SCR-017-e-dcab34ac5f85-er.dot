graph er {
graph [rankdir=LR,bgcolor=white,nodesep=0.4,ranksep=0.8];
node [shape=plain,fontname="Noto Sans CJK JP",fontsize=12]; edge [fontname="Noto Sans CJK JP",fontsize=10];
"t0" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT">Ｕ職員名簿表<BR/>DB2.Ｕ職員名簿表<BR/>参照</TD></TR><TR><TD ALIGN="LEFT">PK 職員番号 [職員番号]</TD></TR><TR><TD ALIGN="LEFT">所属店番 [所属店番]</TD></TR><TR><TD ALIGN="LEFT">漢字氏名 [漢字氏名]</TD></TR><TR><TD ALIGN="LEFT">カナ氏名 [カナ氏名]</TD></TR><TR><TD ALIGN="LEFT">役職コード [役職コード]</TD></TR></TABLE>>];
"t1" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT">店名テーブル<BR/>店名テーブル<BR/>参照</TD></TR><TR><TD ALIGN="LEFT">PK 店舗ｺｰﾄﾞ [店舗ｺｰﾄﾞ]</TD></TR><TR><TD ALIGN="LEFT">店名 [店名]</TD></TR></TABLE>>];
}
