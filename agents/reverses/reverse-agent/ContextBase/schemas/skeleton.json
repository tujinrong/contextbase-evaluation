{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "dependencies": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "screen",
        "common"
      ]
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "ready_for_detail": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "path",
    "dependencies",
    "ready_for_detail"
  ],
  "type": "object"
}
