{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assets": {
      "items": {
        "properties": {
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "source",
          "destination",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "documents": {
      "items": {
        "properties": {
          "model": {
            "properties": {
              "sections": {
                "items": {
                  "properties": {
                    "blocks": {
                      "items": {
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "kind": {
                                  "const": "table"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value": {
                                  "items": {
                                    "type": "array"
                                  },
                                  "minItems": 1,
                                  "type": "array"
                                }
                              },
                              "required": [
                                "value"
                              ]
                            }
                          },
                          {
                            "if": {
                              "properties": {
                                "kind": {
                                  "enum": [
                                    "paragraph",
                                    "heading",
                                    "code"
                                  ]
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "value"
                              ]
                            }
                          },
                          {
                            "if": {
                              "properties": {
                                "kind": {
                                  "const": "image"
                                }
                              }
                            },
                            "then": {
                              "required": [
                                "path"
                              ]
                            }
                          }
                        ],
                        "properties": {
                          "alt": {
                            "type": "string"
                          },
                          "kind": {
                            "enum": [
                              "paragraph",
                              "heading",
                              "table",
                              "image",
                              "code"
                            ]
                          },
                          "level": {
                            "maximum": 6,
                            "minimum": 1,
                            "type": "integer"
                          },
                          "path": {
                            "type": "string"
                          },
                          "value": {}
                        },
                        "required": [
                          "kind"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "title",
                    "blocks"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "sections"
            ],
            "type": "object"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "model"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "foundation_generation": {
      "type": "string"
    },
    "schema": {
      "const": "contextbase.resolved.v1"
    },
    "source_snapshot": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "project",
    "foundation_generation",
    "source_snapshot",
    "documents",
    "assets"
  ],
  "type": "object"
}
