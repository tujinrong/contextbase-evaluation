from pathlib import Path
import hashlib,json,zipfile
clone=Path.cwd();root=clone.parents[3]
manifest=json.loads((root/'report/20261012-build-09-source-packages.json').read_text(encoding='utf-8-sig'))
pkg=next(x for x in manifest['packages'] if x['profile']=='Access')
zipfile_path=root/'agent-input/Access-source.zip'
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest().upper()
assert sha(zipfile_path)==pkg['sha256'].upper()
rows=[]
with zipfile.ZipFile(zipfile_path) as archive:
 for item in archive.infolist():
  if item.is_dir():continue
  p=clone/item.filename
  data=archive.read(item)
  expected=hashlib.sha256(data).hexdigest().upper()
  assert p.is_file() and sha(p)==expected,item.filename
  assert not {'spec','spec-eval','tests','test-report','tools'}.intersection(Path(item.filename).parts),item.filename
  rows.append({'path':item.filename,'sha256':expected,'bytes':len(data)})
assert len(rows)==27
build=clone/'build';build.mkdir(exist_ok=True)
pre={'runId':'20261012-build-09-access-source-package','workingDirectory':str(clone),'sourceZip':str(zipfile_path),'sourceZipSha256':sha(zipfile_path),'sourceManifest':'20261012-build-09-source-packages.json','archiveEntries':rows,'archiveExtractMatches':True,'sourceZipSpecAndTestsExcluded':True,'mainDistribution':str(clone.parents[1]/'StudentManagement.accdb'),'mainBeforeSha256':sha(clone.parents[1]/'StudentManagement.accdb')}
(build/'source-package-preflight.json').write_text(json.dumps(pre,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
print(json.dumps({'sourceZipSha256':pre['sourceZipSha256'],'entries':len(rows),'mainBeforeSha256':pre['mainBeforeSha256'],'archiveExtractMatches':True},ensure_ascii=False))
