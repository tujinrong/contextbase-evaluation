**free
 ctl-opt dftactgrp( *no ) option( *srcstmt :*nodebugio ) ccsid( *ucs2 :1200 ) ;
 dcl-f STUSCHD workstn sfile( SFLROW :rrn ) ;
/copy '../copy/STUTYPES.rpgleinc'
/copy '../copy/STUPROTO.rpgleinc'
/copy '../copy/STUDSPDECL.rpgleinc'
 dcl-pr ShowRows ;
 end-pr ;
 dcl-pr ReadSearch ;
 end-pr ;
 dcl-pr DrawSearch ;
 end-pr ;
 dcl-pr ReadQ ;
 index int( 10 ) const ;
 value varchar( 128 ) const ;
 end-pr ;
 dcl-pr SelectRow ;
 end-pr ;
 dcl-pr FullRow ;
 row likeds( StudentRecord_t ) const ;
 end-pr ;
 dcl-s rrn int( 5 ) ;
 dcl-s block int( 10 ) inz( 0 ) ;
 dcl-s idx int( 10 ) ;
 dcl-s prior char( 128 ) dim( 12 ) ;
 dcl-ds raw likeds( SearchRaw_t ) ;
 dcl-ds context likeds( SearchContext_t ) ;
 dcl-ds page likeds( SearchPage_t ) ;
 dcl-ds startup likeds( Result_t ) ;
 dcl-s principal varchar( 128 ) ;
 dcl-s role int( 10 ) ;
 dcl-s id int( 20 ) ;
 dcl-s viewOnly ind ;
 dcl-s notice char( 128 ) ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s chosen varchar( 24 ) ;
 dcl-s choiceField int( 10 ) ;
 dcl-s year varchar( 4 ) ;
 dcl-s grade varchar( 2 ) ;
 dcl-s occupancy int( 10 ) ;
 dcl-s askedSize int( 10 ) ;
 dcl-s askedSort varchar( 16 ) ;
 dcl-s askedDirection varchar( 4 ) ;
 dcl-s optionsChanged ind ;
 dcl-s rowAction ind ;
 dcl-s capacity int( 10 ) ;
 dcl-s capacityInd int( 5 ) ;
 exec sql SET OPTION COMMIT=*CS , CLOSQLCSR=*ENDMOD , DATFMT=*ISO ;
 StStartup( startup ) ;
 if startup.kind<>0 ;
 notice=Render( UiMessage( startup ) :128 ) ;
 dsply notice ;
 *inlr=*on ;
 return ;
 endif ;
 StAuthorize( 'READ' :principal :role :startup ) ;
 if startup.kind<>0 ;
 notice=Render( UiMessage( startup ) :128 ) ;
 dsply notice ;
 *inlr=*on ;
 return ;
 endif ;
 StNewId( context.instanceId ) ;
 context.owner=principal ;
 raw.selected( 1 ) =*on ;
 raw.selected( 2 ) =*on ;
 DrawSearch( ) ;
 ShowRows( ) ;
 dou *off ;
 write COND ;
 *in03=*off ;
 *in04=*off ;
 *in05=*off ;
 *in06=*off ;
 *in08=*off ;
 *in09=*off ;
 *in07=*off ;
 *in10=*off ;
 *in14=*off ;
 *in25=*off ;
 *in26=*off ;
 *in20=*off ;
 exfmt SFLCTL ;
 if *in03 ;
 leave ;
 endif ;
 monitor ;
 askedSize=%int( %trim( QSIZE ) ) ;
 on-error ;
 askedSize=0 ;
 endmon ;
 askedSort=%trim( QSORT ) ;
 askedDirection=%trim( QDIR ) ;
 optionsChanged=askedSize<>context.pageSize or askedSort<>context.sortKey or
 askedDirection<>context.direction ;
 ReadSearch( ) ;
 if not uiError ;
 DrawSearch( ) ;
 endif ;
 if uiError ;
 QMSG= 'Invalid conversion:original values retained; F8 explicit Unicode' ;
 iter ;
 endif ;
 if *in05 ;
 clear raw ;
 clear context ;
 clear page ;
 StNewId( context.instanceId ) ;
 context.page=1 ;
 context.pageSize=20 ;
 context.sortKey= 'studentNo' ;
 context.direction= 'asc' ;
 raw.selected( 1 ) =*on ;
 raw.selected( 2 ) =*on ;
 block=0 ;
 QMSG= '' ;
 DrawSearch( ) ;
 ShowRows( ) ;
 iter ;
 endif ;
 if *in06 ;
 StAuthorize( 'SAVE' :principal :role :startup ) ;
 if startup.kind<>0 ;
 QMSG=Render( UiMessage( startup ) :128 ) ;
 iter ;
 endif ;
 id=0 ;
 viewOnly=*off ;
 notice= '' ;
 StEdit( id :viewOnly :notice ) ;
 QMSG=notice ;
 if context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 block=0 ;
 ShowRows( ) ;
 endif ;
 iter ;
 endif ;
 if *in08 ;
 monitor ;
 idx=%int( %trim( QFIELD ) ) ;
 on-error ;
 idx=0 ;
 endmon ;
 if idx>=1 and idx<=12 ;
 LongEdit( raw.values( idx ) :*off ) ;
 DrawSearch( ) ;
 endif ;
 iter ;
 endif ;
 if *in20 ;
 ErrorList( page.result ) ;
 iter ;
 endif ;
 if *in04 ;
 monitor ;
 choiceField=%int( %trim( QFIELD ) ) ;
 on-error ;
 choiceField=0 ;
 endmon ;
 year=%char( raw.values( 4 ) ) ;
 grade=%char( raw.values( 5 ) ) ;
 idx=0 ;
 monitor ;
 idx=%int( year ) ;
 on-error ;
 idx=0 ;
 endmon ;
 select ;
 when choiceField=4 ;
 chosen=Choice( 'YEAR' :year :0 :'' :*off ) ;
 if chosen<>year ;
 raw.values( 4 ) =%ucs2( chosen ) ;
 raw.values( 6 ) =%ucs2( '' ) ;
 endif ;
 when choiceField=5 ;
 chosen=Choice( 'GRADE' :grade :idx :'' :*off ) ;
 if chosen<>grade ;
 raw.values( 5 ) =%ucs2( chosen ) ;
 raw.values( 6 ) =%ucs2( '' ) ;
 endif ;
 when choiceField=6 ;
 chosen=Choice( 'CLASS' :%char( raw.values( 6 ) ) :idx :grade :*off ) ;
 raw.values( 6 ) =%ucs2( chosen ) ;
 if chosen<> '' ;
 id=%int( chosen ) ;
 StClassInfo( id :year :grade :occupancy :capacity :capacityInd :startup :*off ) ;
 if startup.kind=0 ;
 raw.values( 4 ) =%ucs2( year ) ;
 raw.values( 5 ) =%ucs2( grade ) ;
 raw.values( 7 ) =%ucs2( '0' ) ;
 endif ;
 endif ;
 when choiceField=9 ;
 raw.values( 9 ) =%ucs2( Choice( 'PREFECTURE' :%char( raw.values( 9 ) ) :0 :'' :*off )
 ) ;
 endsl ;
 DrawSearch( ) ;
 iter ;
 endif ;
 if *in09 and page.rowCount>0 ;
 block+=10 ;
 if block>=page.rowCount ;
 block=0 ;
 endif ;
 ShowRows( ) ;
 iter ;
 endif ;
 if *in14 ;
 SelectRow( ) ;
 if context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 ShowRows( ) ;
 endif ;
 iter ;
 endif ;
 if not( *in07 or *in10 or *in25 or *in26 ) ;
 SelectRow( ) ;
 if rowAction ;
 if context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 ShowRows( ) ;
 endif ;
 notice= '' ;
 iter ;
 endif ;
 endif ;
 if *in07 ;
 context.page=1 ;
 elseif *in10 ;
 context.page=%max( 1 :%div( page.total+context.pageSize-1 :context.pageSize ) ) ;
 elseif *in26 ;
 context.page=%max( 1 :context.page-1 ) ;
 elseif *in25 ;
 context.page+=1 ;
 else ;
 context.pageSize=askedSize ;
 context.sortKey=askedSort ;
 context.direction=askedDirection ;
 context.page=1 ;
 endif ;
 if optionsChanged and context.hasApplied ;
 context.page=1 ;
 context.pageSize=askedSize ;
 context.sortKey=askedSort ;
 context.direction=askedDirection ;
 endif ;
 StSearchStudents( raw :context :not( *in07 or *in10 or *in26 or *in25 ) :page ) ;
 block=0 ;
 QMSG=Render( UiMessage( page.result ) :128 ) ;
 DrawSearch( ) ;
 ShowRows( ) ;
 enddo ;
 *inlr=*on ;
 return ;
 dcl-proc ReadQ ;
 dcl-pi *n ;
 index int( 10 ) const ;
 value varchar( 128 ) const ;
 end-pi ;
 dcl-s next varucs2( 320 ) ccsid( 1200 ) ;
 if value<>prior( index ) ;
 next=ReadBuffer( %trimr( value ) ) ;
 if not uiError ;
 raw.values( index ) =next ;
 endif ;
 endif ;
 end-proc ;
 dcl-proc ReadSearch ;
 uiError=*off ;
 ReadQ( 1 :QSTUNO ) ;
 ReadQ( 2 :QNAME ) ;
 ReadQ( 3 :QKANA ) ;
 ReadQ( 4 :QYEAR ) ;
 ReadQ( 5 :QGRADE ) ;
 ReadQ( 6 :QCLASS ) ;
 ReadQ( 7 :QUNASS ) ;
 ReadQ( 9 :QPREF ) ;
 ReadQ( 10 :QPHONE ) ;
 ReadQ( 11 :QADMFROM ) ;
 ReadQ( 12 :QADMTO ) ;
 raw.selected( 1 ) =QST01= '1' ;
 raw.selected( 2 ) =QST02= '1' ;
 raw.selected( 3 ) =QST03= '1' ;
 raw.selected( 4 ) =QST04= '1' ;
 if raw.values( 7 ) =%ucs2( '1' ) ;
 raw.values( 4 ) =%ucs2( '' ) ;
 raw.values( 5 ) =%ucs2( '' ) ;
 raw.values( 6 ) =%ucs2( '' ) ;
 endif ;
 end-proc ;
 dcl-proc DrawSearch ;
 QSTUNO=Render( raw.values( 1 ) :30 ) ;
 prior( 1 ) =QSTUNO ;
 QNAME=Render( raw.values( 2 ) :40 ) ;
 prior( 2 ) =QNAME ;
 QKANA=Render( raw.values( 3 ) :72 ) ;
 prior( 3 ) =QKANA ;
 QYEAR=Render( raw.values( 4 ) :4 ) ;
 prior( 4 ) =QYEAR ;
 QGRADE=Render( raw.values( 5 ) :2 ) ;
 prior( 5 ) =QGRADE ;
 QCLASS=Render( raw.values( 6 ) :19 ) ;
 prior( 6 ) =QCLASS ;
 QUNASS=Render( raw.values( 7 ) :1 ) ;
 prior( 7 ) =QUNASS ;
 QPREF=Render( raw.values( 9 ) :2 ) ;
 prior( 9 ) =QPREF ;
 QPHONE=Render( raw.values( 10 ) :40 ) ;
 prior( 10 ) =QPHONE ;
 QADMFROM=Render( raw.values( 11 ) :10 ) ;
 prior( 11 ) =QADMFROM ;
 QADMTO=Render( raw.values( 12 ) :10 ) ;
 prior( 12 ) =QADMTO ;
 QST01= '0' ;
 QST02= '0' ;
 QST03= '0' ;
 QST04= '0' ;
 if raw.selected( 1 ) ;
 QST01= '1' ;
 endif ;
 if raw.selected( 2 ) ;
 QST02= '1' ;
 endif ;
 if raw.selected( 3 ) ;
 QST03= '1' ;
 endif ;
 if raw.selected( 4 ) ;
 QST04= '1' ;
 endif ;
 QSIZE=%char( context.pageSize ) ;
 QSORT=context.sortKey ;
 QDIR=context.direction ;
 end-proc ;
 dcl-proc ShowRows ;
 dcl-s i int( 10 ) ;
 dcl-s row int( 10 ) ;
 dcl-s era varchar( 10 ) ;
 dcl-s y varucs2( 8 ) ccsid( 1200 ) ;
 dcl-s m varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s d varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s birth varucs2( 80 ) ccsid( 1200 ) ;
 *in90=*off ;
 *in91=*on ;
 *in92=*on ;
 write SFLCTL ;
 *in92=*off ;
 for i=1 to %min( 10 :page.rowCount-block ) ;
 row=block+i ;
 rrn=i ;
 SOPT= '' ;
 SROWID=%char( page.rows( row ).studentId ) ;
 SNO=page.rows( row ).work.studentNo ;
 SNAME=Render( page.rows( row ).work.studentName :20 ) ;
 StFormatBirthDate( page.rows( row ).work.birthDate :era :y :m :d :birth ) ;
 SBIRTH=Render( birth :26 ) ;
 SYEARGR= '' ;
 SCLASS= '' ;
 if page.rows( row ).work.classIdInd=0 ;
 SYEARGR=Render( %ucs2( %char( page.rows( row ).schoolYear ) + ' ' ) +page.rows( row )
 .gradeName :10 ) ;
 SCLASS=Render( %ucs2( page.rows( row ).classCode+ ' ' ) +page.rows( row ).className :30
 ) ;
 endif ;
 SSTATUS=Render( page.rows( row ).enrollmentName :18 ) ;
 write SFLROW ;
 endfor ;
 *in90=page.rowCount>0 ;
 RESULT_CNT= 'Total ' +%char( page.total ) + ' SQL page ' +%char( context.page ) + ' block '
 +%char( %div( block :10 ) +1 ) ;
 SEARCH_AT=%char( page.searchedAt :*iso ) ;
 end-proc ;
 dcl-proc SelectRow ;
 dcl-s row int( 10 ) ;
 rowAction=*off ;
 readc SFLROW ;
 dow not %eof( STUSCHD ) ;
 row=block+rrn ;
 if row>=1 and row<=page.rowCount ;
 if SOPT= '9' ;
 rowAction=*on ;
 FullRow( page.rows( row ) ) ;
 elseif SOPT= '2' or SOPT= '5' ;
 rowAction=*on ;
 id=page.rows( row ).studentId ;
 viewOnly=SOPT= '5' ;
 notice= '' ;
 StEdit( id :viewOnly :notice ) ;
 QMSG=notice ;
 endif ;
 endif ;
 readc SFLROW ;
 enddo ;
 end-proc ;
 dcl-proc FullRow ;
 dcl-pi *n ;
 row likeds( StudentRecord_t ) const ;
 end-pi ;
 dcl-s lines varucs2( 320 ) ccsid( 1200 ) dim( 11 ) ;
 dcl-s i int( 10 ) ;
 dcl-s selected int( 10 ) ;
 dcl-s era varchar( 10 ) ;
 dcl-s y varucs2( 8 ) ccsid( 1200 ) ;
 dcl-s m varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s d varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s birth varucs2( 80 ) ccsid( 1200 ) ;
 StFormatBirthDate( row.work.birthDate :era :y :m :d :birth ) ;
 lines( 1 ) =%ucs2( row.work.studentNo ) ;
 lines( 2 ) =row.work.studentName ;
 lines( 3 ) =row.work.studentNameKana ;
 lines( 4 ) =birth ;
 lines( 5 ) =%ucs2( %char( row.schoolYear ) ) ;
 lines( 6 ) =row.gradeName ;
 lines( 7 ) =%ucs2( row.classCode+ ' ' ) +row.className ;
 lines( 8 ) =row.enrollmentName ;
 lines( 9 ) =%ucs2( %char( row.work.admissionDate :*iso ) ) ;
 lines( 10 ) =row.prefectureName ;
 lines( 11 ) =%ucs2( %char( row.updatedAt+%hours( 9 ) :*iso ) ) ;
 for i=1 to 11 ;
 text=%ucs2( %char( i ) + ':' ) +lines( i ) ;
 LongEdit( text :*on ) ;
 endfor ;
 end-proc ;
/copy '../copy/STUDSP.rpgleinc'
/copy '../copy/STUFIELDUI.rpgleinc'
