**free
 ctl-opt dftactgrp( *no ) option( *srcstmt :*nodebugio ) ccsid( *ucs2 :1200 ) ;
 dcl-f STUSCHD workstn sfile( SFLROW :rrn ) ;
/copy '../copy/STUTYPES.rpgleinc'
/copy '../copy/STUPROTO.rpgleinc'
/copy '../copy/STUDSPDECL.rpgleinc'
 dcl-pr CaptureCursor ;
 end-pr ;
 dcl-pr ShowRows ;
 end-pr ;
 dcl-pr ReadSearch ;
 end-pr ;
 dcl-pr DrawSearch ;
 end-pr ;
 dcl-pr ReadQ ;
 index int( 10 ) const ;
 value varchar( 128 ) const ;
 end-pr ;
 dcl-pr SelectRow ;
 end-pr ;
 dcl-pr FullRow ;
 row likeds( StudentListRow_t ) const ;
 end-pr ;
 dcl-s rrn int( 5 ) ;
 dcl-s block int( 10 ) inz( 0 ) ;
 dcl-s idx int( 10 ) ;
 dcl-s prior char( 128 ) dim( 3 ) ;
 dcl-s windowUsed int( 10 ) dim( 3 ) ;
 dcl-s windowAdvance int( 10 ) ;
 dcl-ds raw likeds( SearchRaw_t ) ;
 dcl-ds context likeds( SearchContext_t ) ;
 dcl-ds page likeds( SearchPage_t ) ;
 dcl-ds startup likeds( Result_t ) ;
 dcl-s principal varchar( 128 ) ;
 dcl-s role int( 10 ) ;
 dcl-s id int( 20 ) ;
 dcl-s viewOnly ind ;
 dcl-s notice char( 128 ) ;
 dcl-s chosen varchar( 24 ) ;
 dcl-s choiceField int( 10 ) ;
 dcl-s year varchar( 4 ) ;
 dcl-s grade varchar( 2 ) ;
 dcl-s occupancy int( 10 ) ;
 dcl-s askedSize int( 10 ) ;
 dcl-s askedSort varchar( 16 ) ;
 dcl-s askedDirection varchar( 4 ) ;
 dcl-s optionsChanged ind ;
 dcl-s rowAction ind ;
 dcl-s rowOpened ind ;
 dcl-s selectedOptions char( 1 ) dim( 8 ) ;
 dcl-s capacity int( 10 ) ;
 dcl-s capacityInd int( 5 ) ;
 exec sql SET OPTION COMMIT=*CS , CLOSQLCSR=*ENDMOD , DATFMT=*ISO ;
 StStartup( startup ) ;
 if startup.kind<>0 ;
 notice=Render( UiMessage( startup ) :128 ) ;
 dsply notice ;
 *inlr=*on ;
 return ;
 endif ;
 StAuthorize( 'READ' :principal :role :startup ) ;
 if startup.kind<>0 ;
 notice=Render( UiMessage( startup ) :128 ) ;
 dsply notice ;
 *inlr=*on ;
 return ;
 endif ;
 StCreateSearchContext( raw :context :page ) ;
 if page.result.kind<>0 ;
 notice=Render( UiMessage( page.result ) :128 ) ;
 dsply notice ;
 *inlr=*on ;
 return ;
 endif ;
 CSRROW=2 ;
 CSRCOL=12 ;
 DrawSearch( ) ;
 ShowRows( ) ;
 dou *off ;
 write COND ;
 *in03=*off ;
 *in12=*off ;
 *in11=*off ;
 *in15=*off ;
 *in16=*off ;
 *in04=*off ;
 *in05=*off ;
 *in06=*off ;
 *in08=*off ;
 *in09=*off ;
 *in07=*off ;
 *in10=*off ;
 *in14=*off ;
 *in25=*off ;
 *in26=*off ;
 *in20=*off ;
 exfmt SFLCTL ;
 CaptureCursor( ) ;
 if *in03 or *in12 ;
 leave ;
 endif ;
 ReadSearch( ) ;
 if not uiError ;
 DrawSearch( ) ;
 endif ;
 if uiError and not( *in08 or *in05 ) ;
 QMSG= 'Invalid conversion:original values retained; F8 explicit Unicode' ;
 iter ;
 endif ;
 if *in05 ;
 StClearSearchContext( raw :context :page ) ;
 block=0 ;
 QMSG=Render( UiMessage( page.result ) :128 ) ;
 DrawSearch( ) ;
 ShowRows( ) ;
 iter ;
 endif ;
 if *in06 ;
 StAuthorize( 'SAVE' :principal :role :startup ) ;
 if startup.kind<>0 ;
 QMSG=Render( UiMessage( startup ) :128 ) ;
 iter ;
 endif ;
 id=0 ;
 viewOnly=*off ;
 notice= '' ;
 StEdit( id :viewOnly :notice ) ;
 QMSG=notice ;
 if context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 block=0 ;
 ShowRows( ) ;
 endif ;
 iter ;
 endif ;
 if *in08 ;
 if CSRREL>=1 and CSRREL<=%min( 8 :page.rowCount-block ) ;
 FullRow( page.rows( block+CSRREL ) ) ;
 elseif CSRFLD= 'QSTUNO' ;
 LongEdit( raw.values( 1 ) :*off ) ;
 elseif CSRFLD= 'QNAME' ;
 LongEdit( raw.values( 2 ) :*off ) ;
 elseif CSRFLD= 'QCLASS' ;
 LongEdit( raw.values( 3 ) :*off ) ;
 endif ;
 DrawSearch( ) ;
 iter ;
 endif ;
 if *in20 ;
 ErrorList( page.result ) ;
 iter ;
 endif ;
 if *in04 ;
 if CSRFLD= 'QCLASS' ;
 chosen=Choice( 'CLASS' :%char( raw.values( 3 ) ) :0 :'' :*off ) ;
 raw.values( 3 ) =%ucs2( chosen ) ;
 endif ;
 DrawSearch( ) ;
 iter ;
 endif ;
 if *in09 or *in11 ;
 if *in11 ;
 chosen=Choice( 'PAGE' :%char( context.pageSize ) :0 :'' :*off ) ;
 if chosen=%char( context.pageSize ) ;
 iter ;
 endif ;
 context.pageSize=%int( chosen ) ;
 else ;
 chosen=Choice( 'SORT' :%trim( context.sortKey ) + ':' +context.direction :0 :'' :*off ) ;
 if chosen=%trim( context.sortKey ) + ':' +context.direction ;
 iter ;
 endif ;
 idx=%scan( ':' :chosen ) ;
 if idx=0 ;
 iter ;
 endif ;
 context.sortKey=%subst( chosen :1 :idx-1 ) ;
 context.direction=%subst( chosen :idx+1 ) ;
 endif ;
 context.page=1 ;
 block=0 ;
 if context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 endif ;
 DrawSearch( ) ;
 ShowRows( ) ;
 iter ;
 endif ;
 if *in25 or *in26 ;
 if page.rowCount>0 ;
 if *in25 and block+8<page.rowCount ;
 block+=8 ;
 elseif *in26 and block>=8 ;
 block-=8 ;
 endif ;
 ShowRows( ) ;
 endif ;
 iter ;
 endif ;
 if *in14 or *in20 ;
 iter ;
 endif ;
 if *in07 or *in10 or *in15 or *in16 ;
 if not context.hasApplied or page.rowCount=0 or page.total>10000 ;
 iter ;
 endif ;
 idx=%max( 1 :%div( page.total+context.pageSize-1 :context.pageSize ) ) ;
 if( *in07 or *in15 ) and context.page=1 ;
 iter ;
 endif ;
 if( *in10 or *in16 ) and context.page=idx ;
 iter ;
 endif ;
 select ;
 when *in15 ;
 context.page=1 ;
 when *in16 ;
 context.page=idx ;
 when *in07 ;
 context.page-=1 ;
 when *in10 ;
 context.page+=1 ;
 endsl ;
 else ;
 SelectRow( ) ;
 if rowAction ;
 if rowOpened and context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 ShowRows( ) ;
 endif ;
 iter ;
 endif ;
 context.page=1 ;
 endif ;
 StSearchStudents( raw :context :not( *in07 or *in10 or *in15 or *in16 ) :
 page ) ;
 block=0 ;
 QMSG=Render( UiMessage( page.result ) :128 ) ;
 DrawSearch( ) ;
 ShowRows( ) ;
 enddo ;
 StCloseSearchContext( context :startup ) ;
 *inlr=*on ;
 return ;
 dcl-proc CaptureCursor ;
 select ;
 when CSRFLD= 'QSTUNO' ;
 CSRROW=2 ;
 CSRCOL=12 ;
 when CSRFLD= 'QNAME' ;
 CSRROW=2 ;
 CSRCOL=38 ;
 when CSRFLD= 'QCLASS' ;
 CSRROW=3 ;
 CSRCOL=12 ;
 when CSRFLD= 'QST01' ;
 CSRROW=4 ;
 CSRCOL=12 ;
 when CSRFLD= 'QST02' ;
 CSRROW=4 ;
 CSRCOL=22 ;
 when CSRFLD= 'QST03' ;
 CSRROW=4 ;
 CSRCOL=32 ;
 when CSRFLD= 'QST04' ;
 CSRROW=4 ;
 CSRCOL=42 ;
 other ;
 if CSRREL>=1 and CSRREL<=8 ;
 CSRROW=8+( CSRREL-1 ) *2 ;
 select ;
 when CSRFLD= 'ROPT' ;
 CSRCOL=2 ;
 when CSRFLD= 'RSTUNO' ;
 CSRCOL=6 ;
 when CSRFLD= 'RNAME' ;
 CSRCOL=24 ;
 when CSRFLD= 'RKANA' ;
 CSRCOL=44 ;
 when CSRFLD= 'RBIRTH' ;
 CSRCOL=84 ;
 when CSRFLD= 'RYEAR' ;
 CSRROW+=1 ;
 CSRCOL=6 ;
 when CSRFLD= 'RGRADE' ;
 CSRROW+=1 ;
 CSRCOL=13 ;
 when CSRFLD= 'RCCODE' ;
 CSRROW+=1 ;
 CSRCOL=38 ;
 when CSRFLD= 'RCNAME' ;
 CSRROW+=1 ;
 CSRCOL=56 ;
 when CSRFLD= 'RSTATUS' ;
 CSRROW+=1 ;
 CSRCOL=108 ;
 endsl ;
 endif ;
 endsl ;
 if CSRPOS>0 ;
 CSRCOL+=CSRPOS-1 ;
 endif ;
 end-proc ;
 dcl-proc ReadQ ;
 dcl-pi *n ;
 index int( 10 ) const ;
 value varchar( 128 ) const ;
 end-pi ;
 dcl-s next varucs2( 320 ) ccsid( 1200 ) ;
 if value<>prior( index ) ;
 next=raw.values( index ) ;
 MergeWindow( next :value :0 :windowUsed( index ) ) ;
 if not uiError ;
 raw.values( index ) =next ;
 endif ;
 endif ;
 end-proc ;
 dcl-proc ReadSearch ;
 uiError=*off ;
 ReadQ( 1 :QSTUNO ) ;
 ReadQ( 2 :QNAME ) ;
 ReadQ( 3 :QCLASS ) ;
 if( QST01<> '0' and QST01<> '1' ) or( QST02<> '0' and QST02<> '1' ) or
 ( QST03<> '0' and QST03<> '1' ) or( QST04<> '0' and QST04<> '1' ) ;
 uiError=*on ;
 return ;
 endif ;
 raw.selected( 1 ) =QST01= '1' ;
 raw.selected( 2 ) =QST02= '1' ;
 raw.selected( 3 ) =QST03= '1' ;
 raw.selected( 4 ) =QST04= '1' ;
 end-proc ;
 dcl-proc DrawSearch ;
 QSTUNO=Window( raw.values( 1 ) :0 :15 :windowUsed( 1 ) :windowAdvance ) ;
 prior( 1 ) =QSTUNO ;
 QNAME=Window( raw.values( 2 ) :0 :20 :windowUsed( 2 ) :windowAdvance ) ;
 prior( 2 ) =QNAME ;
 QCLASS=Window( raw.values( 3 ) :0 :19 :windowUsed( 3 ) :windowAdvance ) ;
 prior( 3 ) =QCLASS ;
 QST01= '0' ;
 QST02= '0' ;
 QST03= '0' ;
 QST04= '0' ;
 if raw.selected( 1 ) ;
 QST01= '1' ;
 endif ;
 if raw.selected( 2 ) ;
 QST02= '1' ;
 endif ;
 if raw.selected( 3 ) ;
 QST03= '1' ;
 endif ;
 if raw.selected( 4 ) ;
 QST04= '1' ;
 endif ;
 QSIZE=%char( context.pageSize ) ;
 QSORT=context.sortKey ;
 QDIR=context.direction ;
 end-proc ;
 dcl-proc ShowRows ;
 dcl-s i int( 10 ) ;
 dcl-s row int( 10 ) ;
 dcl-s era varchar( 10 ) ;
 dcl-s y varucs2( 8 ) ccsid( 1200 ) ;
 dcl-s m varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s d varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s birth varucs2( 80 ) ccsid( 1200 ) ;
 if page.result.messageId<> '' or page.result.errorCount>0 ;
 QMSG=Render( UiMessage( page.result ) :128 ) ;
 endif ;
 block=StSearchBlock( block :page.rowCount ) ;
 clear selectedOptions ;
 *in90=*off ;
 *in91=*on ;
 *in92=*on ;
 write SFLCTL ;
 *in92=*off ;
 for i=1 to %min( 8 :page.rowCount-block ) ;
 row=block+i ;
 rrn=i ;
 ROPT= '' ;
 SROWID=%char( page.rows( row ).studentId ) ;
 RSTUNO=page.rows( row ).work.studentNo ;
 RNAME=Render( page.rows( row ).work.studentName :18 ) ;
 RKANA=Render( page.rows( row ).work.studentNameKana :38 ) ;
 StFormatBirthDate( page.rows( row ).work.birthDate :era :y :m :d :birth ) ;
 RBIRTH=Render( birth :24 ) ;
 RYEAR= '' ;
 RGRADE= '' ;
 RCCODE= '' ;
 RCNAME= '' ;
 if page.rows( row ).work.classIdInd=0 ;
 RYEAR=%char( page.rows( row ).schoolYear ) ;
 RGRADE=Render( page.rows( row ).gradeName :22 ) ;
 RCCODE=Render( %ucs2( page.rows( row ).classCode ) :15 ) ;
 RCNAME=Render( page.rows( row ).className :48 ) ;
 endif ;
 RSTATUS=Render( page.rows( row ).enrollmentName :14 ) ;
 write SFLROW ;
 endfor ;
 *in90=page.rowCount>0 ;
 PAGING= 'Window ' +%char( %div( block :8 ) +1 ) + ' / ' +%char( %max( 1 :%div( page.rowCount+7
 :8 ) ) ) +
 ' PgUp/Dn=8 rows F7/10=DB prev/next F15/16=first/last' ;
 if not context.hasApplied ;
 DBPAGE= '' ;
 RCOUNT= '未検索' ;
 SRCHTIME= '' ;
 elseif page.total>10000 ;
 RCOUNT= 'Over 10,000' ;
 DBPAGE= 'Narrow the criteria' ;
 SRCHTIME= '' ;
 else ;
 RCOUNT= 'Total ' +%char( page.total ) ;
 DBPAGE= 'DB page ' +%char( context.page ) + ' / ' +%char( %max( 1 :%div(
 page.total+context.pageSize-1 :context.pageSize ) ) ) ;
 SRCHTIME=%char( page.searchedAt :*iso ) ;
 endif ;
 end-proc ;
 dcl-proc SelectRow ;
 dcl-s row int( 10 ) ;
 dcl-s selected int( 10 ) ;
 dcl-s count int( 10 ) ;
 dcl-s i int( 10 ) ;
 dcl-s option char( 1 ) ;
 rowAction=*off ;
 rowOpened=*off ;
 count=0 ;
// READC clears change flags. Keep nonblank choices until explicitly changed/cleared.
 readc SFLROW ;
 dow not %eof( STUSCHD ) ;
 if rrn>=1 and rrn<=%min( 8 :page.rowCount-block ) ;
 selectedOptions( rrn ) =ROPT ;
 else ;
 count=99 ;
 rowAction=*on ;
 endif ;
 readc SFLROW ;
 enddo ;
 for i=1 to %min( 8 :page.rowCount-block ) ;
 row=block+i ;
 if selectedOptions( i ) <> ' ' ;
 rowAction=*on ;
 if selectedOptions( i ) <> '2' and selectedOptions( i ) <> '5' ;
 count=99 ;
 else ;
 count+=1 ;
 selected=row ;
 option=selectedOptions( i ) ;
 endif ;
 endif ;
 endfor ;
 if not rowAction ;
 return ;
 endif ;
 if count<>1 ;
 QMSG= 'Enter: select exactly one row, 2=edit or 5=view' ;
 return ;
 endif ;
 id=page.rows( selected ).studentId ;
 viewOnly=option= '5' ;
 notice= '' ;
 StEdit( id :viewOnly :notice ) ;
 rowOpened=*on ;
 QMSG=notice ;
 end-proc ;
 dcl-proc FullRow ;
 dcl-pi *n ;
 row likeds( StudentListRow_t ) const ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 select ;
 when CSRFLD= 'RSTUNO' ;
 text=%ucs2( row.work.studentNo ) ;
 when CSRFLD= 'RKANA' ;
 text=row.work.studentNameKana ;
 when CSRFLD= 'RGRADE' ;
 text=row.gradeName ;
 when CSRFLD= 'RCCODE' or CSRFLD= 'RCNAME' ;
 if row.work.classIdInd<0 ;
 text=%ucs2( '未所属' ) ;
 else ;
 text=%ucs2( row.classCode+ ' ' ) +row.className ;
 endif ;
 when CSRFLD= 'RSTATUS' ;
 text=row.enrollmentName ;
 other ;
 text=row.work.studentName ;
 endsl ;
 LongEdit( text :*on ) ;
 end-proc ;
/copy '../copy/STUDSP.rpgleinc'
/copy '../copy/STUFIELDUI.rpgleinc'
