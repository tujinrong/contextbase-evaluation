**free
 ctl-opt dftactgrp( *no ) option( *srcstmt :*nodebugio ) ccsid( *ucs2 :1200 ) ;
 dcl-f STUSCHD workstn sfile( SFLROW :rrn ) ;
/copy '../copy/STUTYPES.rpgleinc'
/copy '../copy/STUPROTO.rpgleinc'
/copy '../copy/STUDSPDECL.rpgleinc'
 dcl-pr ShowRows ;
 end-pr ;
 dcl-pr ReadSearch ;
 end-pr ;
 dcl-pr DrawSearch ;
 end-pr ;
 dcl-pr ReadQ ;
 index int( 10 ) const ;
 value varchar( 128 ) const ;
 end-pr ;
 dcl-pr SelectRow ;
 end-pr ;
 dcl-pr FullRow ;
 row likeds( StudentListRow_t ) const ;
 end-pr ;
 dcl-s rrn int( 5 ) ;
 dcl-s block int( 10 ) inz( 0 ) ;
 dcl-s idx int( 10 ) ;
 dcl-s prior char( 128 ) dim( 3 ) ;
 dcl-ds raw likeds( SearchRaw_t ) ;
 dcl-ds context likeds( SearchContext_t ) ;
 dcl-ds page likeds( SearchPage_t ) ;
 dcl-ds startup likeds( Result_t ) ;
 dcl-s principal varchar( 128 ) ;
 dcl-s role int( 10 ) ;
 dcl-s id int( 20 ) ;
 dcl-s viewOnly ind ;
 dcl-s notice char( 128 ) ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s chosen varchar( 24 ) ;
 dcl-s choiceField int( 10 ) ;
 dcl-s year varchar( 4 ) ;
 dcl-s grade varchar( 2 ) ;
 dcl-s occupancy int( 10 ) ;
 dcl-s askedSize int( 10 ) ;
 dcl-s askedSort varchar( 16 ) ;
 dcl-s askedDirection varchar( 4 ) ;
 dcl-s optionsChanged ind ;
 dcl-s rowAction ind ;
 dcl-s capacity int( 10 ) ;
 dcl-s capacityInd int( 5 ) ;
 exec sql SET OPTION COMMIT=*CS , CLOSQLCSR=*ENDMOD , DATFMT=*ISO ;
 StStartup( startup ) ;
 if startup.kind<>0 ;
 notice=Render( UiMessage( startup ) :128 ) ;
 dsply notice ;
 *inlr=*on ;
 return ;
 endif ;
 StAuthorize( 'READ' :principal :role :startup ) ;
 if startup.kind<>0 ;
 notice=Render( UiMessage( startup ) :128 ) ;
 dsply notice ;
 *inlr=*on ;
 return ;
 endif ;
 StCreateSearchContext( raw :context :page ) ;
 if page.result.kind<>0 ;
 notice=Render( UiMessage( page.result ) :128 ) ;
 dsply notice ;
 *inlr=*on ;
 return ;
 endif ;
 DrawSearch( ) ;
 ShowRows( ) ;
 dou *off ;
 write COND ;
 *in03=*off ;
 *in12=*off ;
 *in11=*off ;
 *in15=*off ;
 *in16=*off ;
 *in04=*off ;
 *in05=*off ;
 *in06=*off ;
 *in08=*off ;
 *in09=*off ;
 *in07=*off ;
 *in10=*off ;
 *in14=*off ;
 *in25=*off ;
 *in26=*off ;
 *in20=*off ;
 exfmt SFLCTL ;
 if *in03 or *in12 ;
 leave ;
 endif ;
 monitor ;
 askedSize=%int( %trim( QSIZE ) ) ;
 on-error ;
 askedSize=0 ;
 endmon ;
 askedSort=%trim( QSORT ) ;
 askedDirection=%trim( QDIR ) ;
 optionsChanged=askedSize<>context.pageSize or askedSort<>context.sortKey or
 askedDirection<>context.direction ;
 ReadSearch( ) ;
 if not uiError ;
 DrawSearch( ) ;
 endif ;
 if uiError and not( *in08 or *in05 ) ;
 QMSG= 'Invalid conversion:original values retained; F8 explicit Unicode' ;
 iter ;
 endif ;
 if *in05 ;
 StClearSearchContext( raw :context :page ) ;
 block=0 ;
 QMSG=Render( UiMessage( page.result ) :128 ) ;
 DrawSearch( ) ;
 ShowRows( ) ;
 iter ;
 endif ;
 if *in06 ;
 StAuthorize( 'SAVE' :principal :role :startup ) ;
 if startup.kind<>0 ;
 QMSG=Render( UiMessage( startup ) :128 ) ;
 iter ;
 endif ;
 id=0 ;
 viewOnly=*off ;
 notice= '' ;
 StEdit( id :viewOnly :notice ) ;
 QMSG=notice ;
 if context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 block=0 ;
 ShowRows( ) ;
 endif ;
 iter ;
 endif ;
 if *in08 ;
 monitor ;
 idx=%int( %trim( QFIELD ) ) ;
 on-error ;
 idx=0 ;
 endmon ;
 if idx>=1 and idx<=3 ;
 LongEdit( raw.values( idx ) :*off ) ;
 DrawSearch( ) ;
 endif ;
 iter ;
 endif ;
 if *in20 ;
 ErrorList( page.result ) ;
 iter ;
 endif ;
 if *in04 ;
 monitor ;
 choiceField=%int( %trim( QFIELD ) ) ;
 on-error ;
 choiceField=0 ;
 endmon ;
 if choiceField=3 or choiceField=6 ;
 chosen=Choice( 'CLASS' :%char( raw.values( 3 ) ) :0 :'' :*off ) ;
 raw.values( 3 ) =%ucs2( chosen ) ;
 endif ;
 DrawSearch( ) ;
 iter ;
 endif ;
 if *in09 or *in11 ;
 if *in11 ;
 select ;
 when context.pageSize=20 ;
 context.pageSize=50 ;
 when context.pageSize=50 ;
 context.pageSize=100 ;
 other ;
 context.pageSize=20 ;
 endsl ;
 else ;
 select ;
 when context.sortKey= 'studentNo' ;
 context.sortKey= 'name' ;
 when context.sortKey= 'name' ;
 context.sortKey= 'admissionDate' ;
 when context.sortKey= 'admissionDate' ;
 context.sortKey= 'updatedAt' ;
 other ;
 context.sortKey= 'studentNo' ;
 if context.direction= 'asc' ;
 context.direction= 'desc' ;
 else ;
 context.direction= 'asc' ;
 endif ;
 endsl ;
 endif ;
 context.page=1 ;
 block=0 ;
 if context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 endif ;
 DrawSearch( ) ;
 ShowRows( ) ;
 iter ;
 endif ;
 if *in25 or *in26 ;
 if page.rowCount>0 ;
 if *in25 and block+8<page.rowCount ;
 block+=8 ;
 elseif *in26 and block>=8 ;
 block-=8 ;
 endif ;
 ShowRows( ) ;
 endif ;
 iter ;
 endif ;
 if *in14 ;
 SelectRow( ) ;
 if context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 ShowRows( ) ;
 endif ;
 iter ;
 endif ;
 if *in07 or *in10 or *in15 or *in16 ;
 if not context.hasApplied or page.rowCount=0 or page.total>10000 ;
 iter ;
 endif ;
 idx=%max( 1 :%div( page.total+context.pageSize-1 :context.pageSize ) ) ;
 if( *in07 or *in15 ) and context.page=1 ;
 iter ;
 endif ;
 if( *in10 or *in16 ) and context.page=idx ;
 iter ;
 endif ;
 select ;
 when *in15 ;
 context.page=1 ;
 when *in16 ;
 context.page=idx ;
 when *in07 ;
 context.page-=1 ;
 when *in10 ;
 context.page+=1 ;
 endsl ;
 else ;
 SelectRow( ) ;
 if rowAction ;
 if context.hasApplied ;
 StSearchStudents( raw :context :*off :page ) ;
 ShowRows( ) ;
 endif ;
 iter ;
 endif ;
 context.pageSize=askedSize ;
 context.sortKey=askedSort ;
 context.direction=askedDirection ;
 context.page=1 ;
 endif ;
 StSearchStudents( raw :context :not( *in07 or *in10 or *in15 or *in16 ) :
 page ) ;
 block=0 ;
 QMSG=Render( UiMessage( page.result ) :128 ) ;
 DrawSearch( ) ;
 ShowRows( ) ;
 enddo ;
 StCloseSearchContext( context :startup ) ;
 *inlr=*on ;
 return ;
 dcl-proc ReadQ ;
 dcl-pi *n ;
 index int( 10 ) const ;
 value varchar( 128 ) const ;
 end-pi ;
 dcl-s next varucs2( 320 ) ccsid( 1200 ) ;
 if value<>prior( index ) ;
 next=ReadBuffer( %trimr( value ) ) ;
 if not uiError ;
 raw.values( index ) =next ;
 endif ;
 endif ;
 end-proc ;
 dcl-proc ReadSearch ;
 uiError=*off ;
 ReadQ( 1 :QSTUNO ) ;
 ReadQ( 2 :QNAME ) ;
 ReadQ( 3 :QCLASS ) ;
 if( QST01<> '0' and QST01<> '1' ) or( QST02<> '0' and QST02<> '1' ) or
 ( QST03<> '0' and QST03<> '1' ) or( QST04<> '0' and QST04<> '1' ) ;
 uiError=*on ;
 return ;
 endif ;
 raw.selected( 1 ) =QST01= '1' ;
 raw.selected( 2 ) =QST02= '1' ;
 raw.selected( 3 ) =QST03= '1' ;
 raw.selected( 4 ) =QST04= '1' ;
 end-proc ;
 dcl-proc DrawSearch ;
 QSTUNO=Render( raw.values( 1 ) :30 ) ;
 prior( 1 ) =QSTUNO ;
 QNAME=Render( raw.values( 2 ) :16 ) ;
 prior( 2 ) =QNAME ;
 QCLASS=Render( raw.values( 3 ) :19 ) ;
 prior( 3 ) =QCLASS ;
 QST01= '0' ;
 QST02= '0' ;
 QST03= '0' ;
 QST04= '0' ;
 if raw.selected( 1 ) ;
 QST01= '1' ;
 endif ;
 if raw.selected( 2 ) ;
 QST02= '1' ;
 endif ;
 if raw.selected( 3 ) ;
 QST03= '1' ;
 endif ;
 if raw.selected( 4 ) ;
 QST04= '1' ;
 endif ;
 QSIZE=%char( context.pageSize ) ;
 QSORT=context.sortKey ;
 QDIR=context.direction ;
 end-proc ;
 dcl-proc ShowRows ;
 dcl-s i int( 10 ) ;
 dcl-s row int( 10 ) ;
 dcl-s era varchar( 10 ) ;
 dcl-s y varucs2( 8 ) ccsid( 1200 ) ;
 dcl-s m varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s d varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s birth varucs2( 80 ) ccsid( 1200 ) ;
 if page.result.messageId<> '' or page.result.errorCount>0 ;
 QMSG=Render( UiMessage( page.result ) :128 ) ;
 endif ;
 block=StSearchBlock( block :page.rowCount ) ;
 *in90=*off ;
 *in91=*on ;
 *in92=*on ;
 write SFLCTL ;
 *in92=*off ;
 for i=1 to %min( 8 :page.rowCount-block ) ;
 row=block+i ;
 rrn=i ;
 SOPT= '' ;
 SROWID=%char( page.rows( row ).studentId ) ;
 SNO=page.rows( row ).work.studentNo ;
 SNAME=Render( page.rows( row ).work.studentName :16 ) ;
 SKANA=Render( page.rows( row ).work.studentNameKana :72 ) ;
 StFormatBirthDate( page.rows( row ).work.birthDate :era :y :m :d :birth ) ;
 SBIRTH=Render( birth :26 ) ;
 SYEARGR= '' ;
 SCLASS= '' ;
 if page.rows( row ).work.classIdInd=0 ;
 SYEARGR=Render( %ucs2( %char( page.rows( row ).schoolYear ) + ' ' ) +page.rows( row )
 .gradeName :22 ) ;
 SCLASS=Render( %ucs2( page.rows( row ).classCode+ ' ' ) +page.rows( row ).className :48
 ) ;
 endif ;
 SSTATUS=Render( page.rows( row ).enrollmentName :24 ) ;
 write SFLROW ;
 endfor ;
 *in90=page.rowCount>0 ;
 if not context.hasApplied ;
 RESULT_CNT= '未検索' ;
 SEARCH_AT= '' ;
 elseif page.total>10000 ;
 RESULT_CNT= 'Over 10,000: narrow the criteria' ;
 SEARCH_AT= '' ;
 else ;
 RESULT_CNT= 'Total ' +%char( page.total ) + ' SQL page ' +%char( context.page ) + ' block '
 +%char( %div( block :8 ) +1 ) ;
 SEARCH_AT=%char( page.searchedAt :*iso ) ;
 endif ;
 end-proc ;
 dcl-proc SelectRow ;
 dcl-s row int( 10 ) ;
 rowAction=*off ;
 readc SFLROW ;
 dow not %eof( STUSCHD ) ;
 row=block+rrn ;
 if row>=1 and row<=page.rowCount ;
 if SOPT= '9' ;
 rowAction=*on ;
 FullRow( page.rows( row ) ) ;
 elseif SOPT= '2' or SOPT= '5' ;
 rowAction=*on ;
 id=page.rows( row ).studentId ;
 viewOnly=SOPT= '5' ;
 notice= '' ;
 StEdit( id :viewOnly :notice ) ;
 QMSG=notice ;
 endif ;
 endif ;
 readc SFLROW ;
 enddo ;
 end-proc ;
 dcl-proc FullRow ;
 dcl-pi *n ;
 row likeds( StudentListRow_t ) const ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 text=row.work.studentName ;
 LongEdit( text :*on ) ;
 text=row.work.studentNameKana ;
 LongEdit( text :*on ) ;
 if row.work.classIdInd<0 ;
 text=%ucs2( '未所属' ) ;
 LongEdit( text :*on ) ;
 return ;
 endif ;
 text=%ucs2( %char( row.schoolYear ) + ' / ' ) +row.gradeName ;
 LongEdit( text :*on ) ;
 text=%ucs2( row.classCode+ ' ' ) +row.className ;
 LongEdit( text :*on ) ;
 end-proc ;
/copy '../copy/STUDSP.rpgleinc'
/copy '../copy/STUFIELDUI.rpgleinc'
