**free
 ctl-opt dftactgrp( *no ) option( *srcstmt :*nodebugio ) ccsid( *ucs2 :1200 ) ;
/copy '../copy/STUTYPES.rpgleinc'
/copy '../copy/STUPROTO.rpgleinc'
 dcl-pi *n ;
 approvedPath char( 256 ) ;
 exitStatus int( 10 ) ;
 end-pi ;
 dcl-pr StApprovedOpen int( 10 ) extproc( 'StApprovedOpen' ) ;
 path pointer value ;
 bytes int( 10 ) value ;
 end-pr ;
 dcl-pr StApprovedLine int( 10 ) extproc( 'StApprovedLine' ) ;
 output pointer value ;
 capacity int( 10 ) value ;
 written int( 10 ) ;
 end-pr ;
 dcl-pr StApprovedClose extproc( 'StApprovedClose' ) ;
 end-pr ;
 dcl-pr Num int( 20 ) ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 end-pr ;
 dcl-pr Assign ;
 key varchar( 32 ) const ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 end-pr ;
 dcl-ds result likeds( Result_t ) ;
 dcl-s principal varchar( 128 ) ;
 dcl-s role int( 10 ) ;
 dcl-ds cw likeds( ClassWork_t ) ;
 dcl-ds kw likeds( CodeWork_t ) ;
 dcl-s kind varchar( 5 ) ;
 dcl-s data ucs2( 4096 ) ccsid( 1200 ) ;
 dcl-s decoded ucs2( 320 ) ccsid( 1200 ) ;
 dcl-s line varucs2( 4096 ) ccsid( 1200 ) ;
 dcl-s key varchar( 32 ) ;
 dcl-s value varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s n int( 10 ) ;
 dcl-s length int( 10 ) ;
 dcl-s rc int( 10 ) ;
 dcl-s split int( 10 ) ;
 dcl-s number int( 10 ) ;
 dcl-s path varchar( 256 ) ;
 dcl-s message char( 52 ) ;
 dcl-s keys varchar( 32 ) dim( 30 ) ;
 dcl-s keyCount int( 10 ) ;
 exec sql SET OPTION COMMIT=*CS , CLOSQLCSR=*ENDMOD , DATFMT=*ISO ;
 exitStatus=1 ;
 StStartup( result ) ;
 if result.kind<>0 ;
 dsply result.messageId ;
 *inlr=*on ;
 return ;
 endif ;
 StAuthorize( 'MAINTAIN' :principal :role :result ) ;
 if result.kind<>0 ;
 dsply result.messageId ;
 *inlr=*on ;
 return ;
 endif ;
 path=%trimr( approvedPath ) ;
 rc=StApprovedOpen( %addr( path :*data ) :%len( path ) ) ;
 if rc<>0 ;
 message= 'Approved IFS leaf file could not be opened' ;
 dsply message ;
 *inlr=*on ;
 return ;
 endif ;
 clear cw ;
 clear kw ;
 cw.capacityInd=-1 ;
 cw.remarksInd=-1 ;
 kw.validToInd=-1 ;
 kw.remarksInd=-1 ;
 dou *off ;
 rc=StApprovedLine( %addr( data ) :4096 :n ) ;
 if rc=0 ;
 leave ;
 endif ;
 if rc<0 ;
 message= 'Invalid UTF8 or input line too long' ;
 dsply message ;
 leave ;
 endif ;
 number+=1 ;
 if n=0 ;
 iter ;
 endif ;
 line=%subst( data :1 :n ) ;
 if %subst( line :1 :1 ) =%ucs2( '#' ) ;
 iter ;
 endif ;
 if line=%ucs2( 'END' ) ;
 if %lookup( 'expectedVersion' :keys ) =0 or %lookup( 'displayOrder' :keys ) =0 or %lookup(
 'isActive' :keys ) =0 or %lookup( 'validFrom' :keys ) =0 or %lookup( 'reason' :keys ) =0 ;
 StError( result :'input' :'E-COM-003' ) ;
 leave ;
 endif ;
 if kind= 'CLASS' and( %lookup( 'classId' :keys ) =0 or %lookup( 'schoolYear' :keys ) =0 or
 %lookup(
 'gradeCode' :keys ) =0 or %lookup( 'classCode' :keys ) =0 or %lookup( 'className' :keys )
 =0 or
 %lookup( 'validTo' :keys ) =0 ) ;
 StError( result :'input' :'E-COM-003' ) ;
 leave ;
 endif ;
 if kind= 'CODE' and( %lookup( 'categoryId' :keys ) =0 or %lookup( 'codeValue' :keys ) =0
 or
 %lookup( 'codeName' :keys ) =0 ) ;
 StError( result :'input' :'E-COM-003' ) ;
 leave ;
 endif ;
 if kind= 'CLASS' ;
 StMaintainClass( cw :result ) ;
 elseif kind= 'CODE' ;
 StMaintainCode( kw :result ) ;
 else ;
 StError( result :'type' :'E-COM-003' ) ;
 endif ;
 message=%trim( result.messageId ) + ' kind=' +%char( result.kind ) + ' version='
 +%char( result.rowVersion ) ;
 dsply message ;
 message= 'request=' +result.requestId ;
 dsply message ;
 if result.kind<>RK_SAVED and result.kind<>RK_NOCHANGE ;
 leave ;
 endif ;
 clear cw ;
 clear kw ;
 clear keys ;
 clear kind ;
 clear result ;
 keyCount=0 ;
 cw.capacityInd=-1 ;
 cw.remarksInd=-1 ;
 kw.validToInd=-1 ;
 kw.remarksInd=-1 ;
 exitStatus=0 ;
 iter ;
 endif ;
 split=%scan( %ucs2( '=' ) :line ) ;
 if split<2 or split>33 ;
 StError( result :'input' :'E-COM-003' ) ;
 leave ;
 endif ;
 key=%char( %subst( line :1 :split-1 ) ) ;
 if %lookup( key :keys ) >0 or keyCount>=30 ;
 StError( result :'input' :'E-COM-003' ) ;
 leave ;
 endif ;
 keyCount+=1 ;
 keys( keyCount ) =key ;
 length=%len( line ) -split ;
 rc=StUnicodeEscape( %addr( data ) +split*2 :length :1 :%addr( decoded ) :320 :n ) ;
 if rc<>0 ;
 StError( result :key :'E-COM-003' ) ;
 leave ;
 endif ;
 if n=0 ;
 value=%ucs2( '' ) ;
 else ;
 value=%subst( decoded :1 :n ) ;
 endif ;
 monitor ;
 Assign( key :value ) ;
 on-error ;
 StError( result :key :'E-COM-003' ) ;
 endmon ;
 if result.kind<>0 ;
 leave ;
 endif ;
 enddo ;
 if kind<> '' or result.kind<>0 ;
 exitStatus=1 ;
 message= 'Rejected/incomplete block at line ' +%char( number ) ;
 dsply message ;
 dsply result.messageId ;
 endif ;
 StApprovedClose( ) ;
 *inlr=*on ;
 return ;
 dcl-proc Num ;
 dcl-pi *n int( 20 ) ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 end-pi ;
 dcl-s text varchar( 640 ) ;
 dcl-s x int( 20 ) ;
 text=%char( value ) ;
 if %len( text ) =0 or %len( text ) >19 or %check( '0123456789' :text ) >0 ;
 StError( result :key :'E-COM-003' ) ;
 return 0 ;
 endif ;
 monitor ;
 x=%int( text ) ;
 on-error ;
 StError( result :key :'E-COM-003' ) ;
 return 0 ;
 endmon ;
 return x ;
 end-proc ;
 dcl-proc Assign ;
 dcl-pi *n ;
 key varchar( 32 ) const ;
 input varucs2( 320 ) ccsid( 1200 ) const ;
 end-pi ;
 dcl-s value varucs2( 320 ) ccsid( 1200 ) ;
 value=input ;
 if key= 'TYPE' ;
 kind=%char( value ) ;
 if kind<> 'CLASS' and kind<> 'CODE' ;
 StError( result :key :'E-COM-003' ) ;
 endif ;
 return ;
 endif ;
 if kind= 'CLASS' ;
 select ;
 when key= 'classId' ;
 cw.classId=Num( value ) ;
 when key= 'expectedVersion' ;
 cw.expectedVersion=Num( value ) ;
 when key= 'schoolYear' ;
 cw.schoolYear=Num( value ) ;
 when key= 'gradeCode' ;
 value=StNormalizeText( value :2 :2 :6 :*on :key :result ) ;
 cw.gradeCode=%char( value ) ;
 when key= 'classCode' ;
 value=StNormalizeText( value :9 :9 :5 :*on :key :result ) ;
 cw.classCode=%char( value ) ;
 when key= 'className' ;
 if %len( value ) >36 ;
 StError( result :key :'E-STU-002' ) ;
 else ;
 cw.className=value ;
 endif ;
 when key= 'validFrom' ;
 StIsoDate( value :d'9999-12-31' :cw.validFrom :key :result ) ;
 when key= 'validTo' ;
 StIsoDate( value :d'9999-12-31' :cw.validTo :key :result ) ;
 when key= 'capacity' ;
 if %len( value ) >0 ;
 cw.capacity=Num( value ) ;
 cw.capacityInd=0 ;
 endif ;
 when key= 'displayOrder' ;
 cw.displayOrder=Num( value ) ;
 when key= 'isActive' ;
 cw.isActive=Num( value ) ;
 when key= 'remarks' ;
 if %len( value ) >240 ;
 StError( result :key :'E-STU-002' ) ;
 else ;
 cw.remarks=value ;
 endif ;
 when key= 'reason' ;
 if %len( value ) >120 ;
 StError( result :key :'E-STU-002' ) ;
 else ;
 cw.reason=value ;
 endif ;
 other ;
 StError( result :key :'E-COM-003' ) ;
 endsl ;
 elseif kind= 'CODE' ;
 select ;
 when key= 'categoryId' ;
 if %len( value ) >24 ;
 StError( result :key :'E-COM-003' ) ;
 else ;
 kw.categoryId=%char( value ) ;
 endif ;
 when key= 'codeValue' ;
 if %len( value ) >10 ;
 StError( result :key :'E-COM-003' ) ;
 else ;
 kw.codeValue=%char( value ) ;
 endif ;
 when key= 'expectedVersion' ;
 kw.expectedVersion=Num( value ) ;
 when key= 'codeName' ;
 if %len( value ) >24 ;
 StError( result :key :'E-STU-002' ) ;
 else ;
 kw.codeName=value ;
 endif ;
 when key= 'displayOrder' ;
 kw.displayOrder=Num( value ) ;
 when key= 'isActive' ;
 kw.isActive=Num( value ) ;
 when key= 'validFrom' ;
 StIsoDate( value :d'9999-12-31' :kw.validFrom :key :result ) ;
 when key= 'validTo' ;
 if %len( value ) >0 ;
 StIsoDate( value :d'9999-12-31' :kw.validTo :key :result ) ;
 kw.validToInd=0 ;
 endif ;
 when key= 'remarks' ;
 if %len( value ) >240 ;
 StError( result :key :'E-STU-002' ) ;
 else ;
 kw.remarks=value ;
 endif ;
 when key= 'reason' ;
 if %len( value ) >120 ;
 StError( result :key :'E-STU-002' ) ;
 else ;
 kw.reason=value ;
 endif ;
 other ;
 StError( result :key :'E-COM-003' ) ;
 endsl ;
 else ;
 StError( result :'TYPE' :'E-COM-003' ) ;
 endif ;
 end-proc ;
