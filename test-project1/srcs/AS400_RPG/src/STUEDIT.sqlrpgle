**free
 ctl-opt dftactgrp( *no ) option( *srcstmt :*nodebugio ) ccsid( *ucs2 :1200 ) ;
 dcl-f STUEDTD workstn ;
/copy '../copy/STUTYPES.rpgleinc'
/copy '../copy/STUPROTO.rpgleinc'
/copy '../copy/STUDSPDECL.rpgleinc'
 dcl-pi *n ;
 studentId int( 20 ) ;
 readOnly ind ;
 notice char( 128 ) ;
 end-pi ;
 dcl-pr LoadForm ;
 end-pr ;
 dcl-pr DrawForm ;
 end-pr ;
 dcl-pr ReadForm ;
 end-pr ;
 dcl-pr ReadEdited ;
 index int( 10 ) const ;
 value varchar( 128 ) const ;
 end-pr ;
 dcl-pr Dirty ind ;
 end-pr ;
 dcl-pr EditFull ;
 field int( 10 ) const ;
 end-pr ;
 dcl-pr ShowErrors ;
 end-pr ;
 dcl-pr SaveForm ;
 end-pr ;
 dcl-pr Pick ;
 field int( 10 ) const ;
 end-pr ;
 dcl-ds raw likeds( StudentRaw_t ) ;
 dcl-ds original likeds( StudentRaw_t ) ;
 dcl-ds hints likeds( StudentHints_t ) ;
 dcl-ds oldHints likeds( StudentHints_t ) ;
 dcl-ds rec likeds( StudentRecord_t ) ;
 dcl-ds work likeds( StudentWork_t ) ;
 dcl-ds result likeds( Result_t ) ;
 dcl-s principal varchar( 128 ) ;
 dcl-s role int( 10 ) ;
 dcl-s era varchar( 10 ) ;
 dcl-s wareki varucs2( 80 ) ccsid( 1200 ) ;
 dcl-s utc timestamp ;
 dcl-s day date ;
 dcl-s prior char( 128 ) dim( 19 ) ;
 dcl-s priorEra char( 10 ) ;
 dcl-s priorYear char( 8 ) ;
 dcl-s priorMonth char( 4 ) ;
 dcl-s priorDay char( 4 ) ;
 dcl-s priorHintYear char( 4 ) ;
 dcl-s priorHintGrade char( 2 ) ;
 dcl-s priorReason char( 122 ) ;
 dcl-s panel int( 10 ) inz( 1 ) ;
 dcl-s field int( 10 ) ;
 dcl-s protected ind ;
 dcl-s committed ind ;
 dcl-s closed ind ;
 dcl-s reason varucs2( 120 ) ccsid( 1200 ) ;
 dcl-s deleteReason varucs2( 120 ) ccsid( 1200 ) ;
 dcl-s lookupValues varchar( 24 ) dim( 20 ) ;
 dcl-s lookupLabels varucs2( 320 ) ccsid( 1200 ) dim( 20 ) ;
 dcl-s lookupCount int( 10 ) ;
 dcl-ds lookupResult likeds( Result_t ) ;
 dcl-s occupancy int( 10 ) ;
 dcl-s capacity int( 10 ) ;
 dcl-s capacityInd int( 5 ) ;
 exec sql SET OPTION COMMIT=*CS , CLOSQLCSR=*ENDMOD , DATFMT=*ISO ;
 StNewId( hints.instanceId ) ;
 StAuthorize( 'READ' :principal :role :result ) ;
 if result.kind<>0 ;
 notice=Render( UiMessage( result ) :128 ) ;
 *inlr=*on ;
 return ;
 endif ;
 if studentId=0 ;
 StAuthorize( 'SAVE' :principal :role :result ) ;
 if result.kind<>0 ;
 notice=Render( UiMessage( result ) :128 ) ;
 *inlr=*on ;
 return ;
 endif ;
 endif ;
 protected=readOnly or role=1 ;
 LoadForm( ) ;
 if result.kind<>0 ;
 notice=Render( UiMessage( result ) :128 ) ;
 *inlr=*on ;
 return ;
 endif ;
 dou closed ;
 if not uiError ;
 DrawForm( ) ;
 endif ;
 *in75=protected ;
 *in76=studentId>0 ;
 *in03=*off ;
 *in04=*off ;
 *in05=*off ;
 *in07=*off ;
 *in08=*off ;
 *in09=*off ;
 *in10=*off ;
 *in12=*off ;
 *in14=*off ;
 *in20=*off ;
 *in23=*off ;
 select ;
 when panel=1 ;
 exfmt EDBASE ;
 other ;
 exfmt EDENROLL ;
 endsl ;
 ReadForm( ) ;
 if uiError and not( *in08 or *in03 or *in12 or *in05 or *in14 ) ;
 result.kind=RK_VALIDATION ;
 result.messageId= 'E-COM-003' ;
 iter ;
 endif ;
 if *in03 or *in12 ;
 if( not Dirty( ) and not uiError ) or Question( 'W-STU-103' :reason :*off :result ) ;
 closed=*on ;
 endif ;
 iter ;
 endif ;
 if *in07 ;
 panel=%max( 1 :panel-1 ) ;
 iter ;
 endif ;
 if *in09 ;
 panel=3-panel ;
 iter ;
 endif ;
 if *in20 ;
 ErrorList( result ) ;
 iter ;
 endif ;
 if *in05 ;
 if( not Dirty( ) and not uiError ) or Question( 'W-STU-104' :reason :*off :result ) ;
 StCancelConfirmation( hints.instanceId :lookupResult ) ;
 raw=original ;
 hints.schoolYear=oldHints.schoolYear ;
 hints.gradeCode=oldHints.gradeCode ;
 hints.reason=%ucs2( '' ) ;
 clear result ;
 uiError=*off ;
 endif ;
 iter ;
 endif ;
 if *in14 ;
 if( not Dirty( ) and not uiError ) or Question( 'W-STU-109' :reason :*off :result ) ;
 LoadForm( ) ;
 endif ;
 iter ;
 endif ;
 field=0 ;
 monitor ;
 select ;
 when panel=1 ;
 field=%int( %trim( EFIELD ) ) ;
 other ;
 field=%int( %trim( EFIELD2 ) ) ;
 endsl ;
 on-error ;
 field=0 ;
 endmon ;
 if *in08 ;
 EditFull( field ) ;
 uiError=*off ;
 iter ;
 endif ;
 if *in04 and not protected ;
 Pick( field ) ;
 iter ;
 endif ;
 if *in10 and not protected ;
 SaveForm( ) ;
 iter ;
 endif ;
 if *in23 and not protected and studentId>0 ;
 clear result ;
 result.messageId= 'W-STU-105' ;
 StAuthorize( 'DELETE' :principal :role :result ) ;
 if result.kind<>0 ;
 iter ;
 endif ;
 if Question( 'W-STU-105' :deleteReason :*on :result ) ;
 StDeleteStudent( studentId :rec.rowVersion :deleteReason :result ) ;
 if result.kind=RK_SAVED ;
 notice=Render( UiMessage( result ) :128 ) ;
 closed=*on ;
 elseif result.kind=RK_VALIDATION ;
 ShowErrors( ) ;
 endif ;
 endif ;
 endif ;
 enddo ;
 StCancelConfirmation( hints.instanceId :lookupResult ) ;
 *inlr=*on ;
 return ;
 dcl-proc LoadForm ;
 uiError=*off ;
 StCancelConfirmation( hints.instanceId :lookupResult ) ;
 clear result ;
 if studentId>0 ;
 StLoadStudent( studentId :rec :result ) ;
 if result.kind<>0 ;
 return ;
 endif ;
/copy '../copy/STUTORAW.rpgleinc'
 hints.schoolYear= '' ;
 hints.gradeCode= '' ;
 if rec.work.classIdInd=0 ;
 hints.schoolYear=%char( rec.schoolYear ) ;
 hints.gradeCode=rec.gradeCode ;
 endif ;
 else ;
 clear raw ;
 clear rec ;
 StClock( utc :day ) ;
 hints.schoolYear=%char( %subdt( day :*years ) ) ;
 if %subdt( day :*months ) <4 ;
 hints.schoolYear=%char( %subdt( day :*years ) -1 ) ;
 endif ;
 hints.gradeCode= '' ;
 raw.values( 5 ) =%ucs2( '0' ) ;
 raw.values( 12 ) =%ucs2( %char( day :*iso ) ) ;
 raw.values( 13 ) =%ucs2( '01' ) ;
 endif ;
 hints.reason=%ucs2( '' ) ;
 original=raw ;
 oldHints=hints ;
 StLookupChoice( 'CLASS' :1 :0 :'' :lookupValues :lookupLabels :lookupCount :
 lookupResult ) ;
 if lookupResult.kind<>0 ;
 result=lookupResult ;
 elseif lookupCount=0 ;
 result.messageId= 'W-STU-108' ;
 endif ;
 end-proc ;
 dcl-proc DrawForm ;
 dcl-ds classResult likeds( Result_t ) ;
 dcl-s classId int( 20 ) ;
/copy '../copy/STUEDITOUT.rpgleinc'
 EBERA=raw.birthEra ;
 priorEra=EBERA ;
 EBYEAR=Render( raw.birthYear :8 ) ;
 priorYear=EBYEAR ;
 EBMONTH=Render( raw.birthMonth :4 ) ;
 priorMonth=EBMONTH ;
 EBDAY=Render( raw.birthDay :4 ) ;
 priorDay=EBDAY ;
 EYEAR=hints.schoolYear ;
 priorHintYear=EYEAR ;
 EGRADE=hints.gradeCode ;
 priorHintGrade=EGRADE ;
 EREASON=Render( hints.reason :90 ) ;
 priorReason=EREASON ;
 ESTUID=%char( studentId ) ;
 EVERSION=%char( rec.rowVersion ) ;
 UPDATEDAT=%char( rec.updatedAt+%hours( 9 ) :*iso ) ;
 UPDATEDBY=Render( rec.updatedBy :90 ) ;
 EMSG1=Render( UiMessage( result ) :128 ) ;
 EMSG2=EMSG1 ;
 OCCUPANCY= '' ;
 if %len( raw.values( 15 ) ) >0 ;
 monitor ;
 classId=%int( %char( raw.values( 15 ) ) ) ;
 on-error ;
 return ;
 endmon ;
 StClassInfo( classId :EYEAR :EGRADE :occupancy :capacity :capacityInd :classResult :*on
 ) ;
 if classResult.kind=0 ;
 OCCUPANCY= 'Current occupancy ' +%char( occupancy ) ;
 if capacityInd=0 ;
 OCCUPANCY+= ' / ' +%char( capacity ) ;
 else ;
 OCCUPANCY+= ' / unlimited' ;
 endif ;
 endif ;
 endif ;
 end-proc ;
 dcl-proc ReadEdited ;
 dcl-pi *n ;
 index int( 10 ) const ;
 value varchar( 128 ) const ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 if value<>prior( index ) ;
 text=ReadBuffer( %trimr( value ) ) ;
 if not uiError ;
 raw.values( index ) =text ;
 endif ;
 endif ;
 end-proc ;
 dcl-proc ReadForm ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 uiError=*off ;
 if protected ;
 return ;
 endif ;
/copy '../copy/STUEDITIO.rpgleinc'
 if EBERA<>priorEra ;
 raw.birthEra=%trim( EBERA ) ;
 endif ;
 if EBYEAR<>priorYear ;
 text=ReadBuffer( %trimr( EBYEAR ) ) ;
 if not uiError ;
 raw.birthYear=text ;
 endif ;
 endif ;
 if EBMONTH<>priorMonth ;
 text=ReadBuffer( %trimr( EBMONTH ) ) ;
 if not uiError ;
 raw.birthMonth=text ;
 endif ;
 endif ;
 if EBDAY<>priorDay ;
 text=ReadBuffer( %trimr( EBDAY ) ) ;
 if not uiError ;
 raw.birthDay=text ;
 endif ;
 endif ;
 if EYEAR<>priorHintYear or EGRADE<>priorHintGrade ;
 hints.schoolYear=%trim( EYEAR ) ;
 hints.gradeCode=%trim( EGRADE ) ;
 raw.values( 15 ) =%ucs2( '' ) ;
 endif ;
 if EREASON<>priorReason ;
 text=ReadBuffer( %trimr( EREASON ) ) ;
 if not uiError and %len( text ) <=120 ;
 hints.reason=text ;
 endif ;
 endif ;
 end-proc ;
 dcl-proc Dirty ;
 dcl-pi *n ind ;
 end-pi ;
 dcl-s i int( 10 ) ;
 for i=1 to 19 ;
 if raw.values( i ) <>original.values( i ) ;
 return *on ;
 endif ;
 endfor ;
 return raw.birthEra<>original.birthEra or raw.birthYear<>original.birthYear or
 raw.birthMonth<>original.birthMonth or raw.birthDay<>original.birthDay or
 hints.schoolYear<>oldHints.schoolYear or hints.gradeCode<>oldHints.gradeCode ;
 end-proc ;
 dcl-proc EditFull ;
 dcl-pi *n ;
 field int( 10 ) const ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 if field>=1 and field<=19 and field<>4 ;
 LongEdit( raw.values( field ) :protected or( field=1 and studentId>0 ) ) ;
 elseif field=20 ;
 text=%ucs2( raw.birthEra ) ;
 if LongEdit( text :protected ) ;
 raw.birthEra=%char( text ) ;
 endif ;
 elseif field=21 ;
 text=raw.birthYear ;
 if LongEdit( text :protected ) ;
 if %len( text ) <=8 ;
 raw.birthYear=text ;
 endif ;
 endif ;
 elseif field=22 ;
 text=raw.birthMonth ;
 if LongEdit( text :protected ) ;
 if %len( text ) <=4 ;
 raw.birthMonth=text ;
 endif ;
 endif ;
 elseif field=23 ;
 text=raw.birthDay ;
 if LongEdit( text :protected ) ;
 if %len( text ) <=4 ;
 raw.birthDay=text ;
 endif ;
 endif ;
 elseif field=24 ;
 text=hints.reason ;
 if LongEdit( text :protected ) ;
 if %len( text ) <=120 ;
 hints.reason=text ;
 endif ;
 endif ;
 endif ;
 end-proc ;
 dcl-proc ShowErrors ;
 panel=2 ;
 if result.errorCount>0 ;
 select ;
 when result.fieldErrors( 1 ).field= 'studentNo' or
 result.fieldErrors( 1 ).field= 'studentName' or
 result.fieldErrors( 1 ).field= 'studentNameKana' or
 result.fieldErrors( 1 ).field= 'birthDate' or
 result.fieldErrors( 1 ).field= 'genderCode' or
 result.fieldErrors( 1 ).field= 'postalCode' or
 result.fieldErrors( 1 ).field= 'prefectureCode' or
 result.fieldErrors( 1 ).field= 'addressLine1' or
 result.fieldErrors( 1 ).field= 'addressLine2' or
 result.fieldErrors( 1 ).field= 'phoneNumber' or
 result.fieldErrors( 1 ).field= 'emailAddress' ;
 panel=1 ;
 endsl ;
 endif ;
 ErrorList( result ) ;
 end-proc ;
 dcl-proc SaveForm ;
 dcl-s token char( 36 ) ;
 StClock( utc :day ) ;
 StNormalize( raw :work :day :result ) ;
 if result.kind=0 ;
 StValidate( work :result ) ;
 endif ;
 if result.kind<>0 ;
 ShowErrors( ) ;
 return ;
 endif ;
 dou *off ;
 StSaveStudent( work :hints :studentId :rec.rowVersion :token :result ) ;
 if result.kind=RK_CONFIRM ;
 if not Question( result.messageId :hints.reason :*on :result ) ;
 StCancelConfirmation( hints.instanceId :lookupResult ) ;
 return ;
 endif ;
 token=result.token ;
 iter ;
 endif ;
 if result.kind=RK_SAVED ;
 notice=Render( UiMessage( result :work.studentNo ) :128 ) ;
 closed=*on ;
 elseif result.kind=RK_NOCHANGE ;
 notice=Render( UiMessage( result :work.studentNo ) :128 ) ;
 closed=*on ;
 elseif result.kind=RK_VALIDATION ;
 ShowErrors( ) ;
 elseif result.kind=RK_CONFLICT ;
 if Question( 'E-STU-105' :reason :*off :result ) ;
 LoadForm( ) ;
 endif ;
 endif ;
 leave ;
 enddo ;
 end-proc ;
 dcl-proc Pick ;
 dcl-pi *n ;
 field int( 10 ) const ;
 end-pi ;
 dcl-s kind varchar( 24 ) ;
 dcl-s selected varchar( 24 ) ;
 dcl-s year int( 10 ) ;
 dcl-s id int( 20 ) ;
 monitor ;
 year=%int( hints.schoolYear ) ;
 on-error ;
 year=0 ;
 endmon ;
 select ;
 when field=5 ;
 kind= 'GENDER' ;
 when field=7 ;
 kind= 'PREFECTURE' ;
 when field=13 ;
 kind= 'ENROLLMENT_STATUS' ;
 when field=15 ;
 kind= 'CLASS' ;
 when field=17 ;
 kind= 'RELATIONSHIP' ;
 when field=25 ;
 kind= 'YEAR' ;
 when field=26 ;
 kind= 'GRADE' ;
 other ;
 return ;
 endsl ;
 if field=25 ;
 selected=Choice( kind :hints.schoolYear :0 :'' :*on ) ;
 if selected<>hints.schoolYear ;
 hints.schoolYear=selected ;
 raw.values( 15 ) =%ucs2( '' ) ;
 endif ;
 elseif field=26 ;
 selected=Choice( kind :hints.gradeCode :year :'' :*on ) ;
 if selected<>hints.gradeCode ;
 hints.gradeCode=selected ;
 raw.values( 15 ) =%ucs2( '' ) ;
 endif ;
 else ;
 selected=Choice( kind :%char( raw.values( field ) ) :year :hints.gradeCode :*on ) ;
 raw.values( field ) =%ucs2( selected ) ;
 if field=15 and selected<> '' ;
 id=%int( selected ) ;
 StClassInfo( id :hints.schoolYear :hints.gradeCode :occupancy :capacity :capacityInd :
 result :*on ) ;
 endif ;
 endif ;
 end-proc ;
/copy '../copy/STUDSP.rpgleinc'
