// Values loaded from DB become raw without going through display substitution.
raw.values(1)=%ucs2(%char(rec.work.studentNo));
raw.values(2)=rec.work.studentName;
raw.values(3)=rec.work.studentNameKana;
raw.values(5)=%ucs2(%char(rec.work.genderCode));
raw.values(6)=%ucs2(%char(rec.work.postalCode));
raw.values(7)=%ucs2(%char(rec.work.prefectureCode));
raw.values(8)=rec.work.addressLine1;
if rec.work.addressLine2Ind<0; raw.values(9)=%ucs2(''); else; raw.values(9)=rec.work.addressLine2; endif;
if rec.work.phoneNumberInd<0; raw.values(10)=%ucs2(''); else; raw.values(10)=%ucs2(%char(rec.work.phoneNumber)); endif;
if rec.work.emailAddressInd<0; raw.values(11)=%ucs2(''); else; raw.values(11)=%ucs2(%char(rec.work.emailAddress)); endif;
raw.values(12)=%ucs2(%char(rec.work.admissionDate));
raw.values(13)=%ucs2(%char(rec.work.enrollmentStatusCode));
if rec.work.enrollmentEndDateInd<0; raw.values(14)=%ucs2(''); else; raw.values(14)=%ucs2(%char(rec.work.enrollmentEndDate)); endif;
if rec.work.classIdInd<0; raw.values(15)=%ucs2(''); else; raw.values(15)=%ucs2(%char(rec.work.classId)); endif;
if rec.work.emergencyContactNameInd<0; raw.values(16)=%ucs2(''); else; raw.values(16)=rec.work.emergencyContactName; endif;
if rec.work.relationshipCodeInd<0; raw.values(17)=%ucs2(''); else; raw.values(17)=%ucs2(%char(rec.work.relationshipCode)); endif;
if rec.work.emergencyPhoneNumberInd<0; raw.values(18)=%ucs2(''); else; raw.values(18)=%ucs2(%char(rec.work.emergencyPhoneNumber)); endif;
if rec.work.remarksInd<0; raw.values(19)=%ucs2(''); else; raw.values(19)=rec.work.remarks; endif;
StFormatBirthDate(rec.work.birthDate:raw.birthEra:raw.birthYear:raw.birthMonth:raw.birthDay:wareki);
