 dcl-proc FieldName ;
 dcl-pi *n varucs2( 64 ) ccsid( 1200 ) ;
 property varchar( 32 ) const ;
 end-pi ;
 select ;
 when property= 'studentNo' ;
 return %ucs2( '学籍番号' ) ;
 when property= 'studentName' ;
 return %ucs2( '氏名' ) ;
 when property= 'studentNameKana' ;
 return %ucs2( '氏名カナ' ) ;
 when property= 'birthDate' ;
 return %ucs2( '生年月日' ) ;
 when property= 'genderCode' ;
 return %ucs2( '性別' ) ;
 when property= 'postalCode' ;
 return %ucs2( '郵便番号' ) ;
 when property= 'prefectureCode' ;
 return %ucs2( '都道府県' ) ;
 when property= 'addressLine1' ;
 return %ucs2( '住所1' ) ;
 when property= 'addressLine2' ;
 return %ucs2( '住所2' ) ;
 when property= 'phoneNumber' ;
 return %ucs2( '電話番号' ) ;
 when property= 'emailAddress' ;
 return %ucs2( 'メールアドレス' ) ;
 when property= 'admissionDate' ;
 return %ucs2( '入学日' ) ;
 when property= 'enrollmentStatusCode' ;
 return %ucs2( '在籍状態' ) ;
 when property= 'enrollmentEndDate' ;
 return %ucs2( '在籍終了日' ) ;
 when property= 'classId' ;
 return %ucs2( 'クラス' ) ;
 when property= 'emergencyContactName' ;
 return %ucs2( '緊急連絡先氏名' ) ;
 when property= 'relationshipCode' ;
 return %ucs2( '続柄' ) ;
 when property= 'emergencyPhoneNumber' ;
 return %ucs2( '緊急連絡先電話番号' ) ;
 when property= 'remarks' ;
 return %ucs2( '備考' ) ;
 when property= 'schoolYear' ;
 return %ucs2( '年度' ) ;
 when property= 'gradeCode' ;
 return %ucs2( '学年' ) ;
 when property= 'reason' ;
 return %ucs2( '理由' ) ;
 when property= 'admissionFrom' ;
 return %ucs2( '入学日開始' ) ;
 when property= 'admissionTo' ;
 return %ucs2( '入学日終了' ) ;
 when property= 'unassignedOnly' ;
 return %ucs2( '未所属のみ' ) ;
 other ;
 return %ucs2( property ) ;
 endsl ;
 end-proc ;
 dcl-proc FieldMax ;
 dcl-pi *n varchar( 4 ) ;
 property varchar( 32 ) const ;
 end-pi ;
 select ;
 when property= 'studentNo' ;
 return '15' ;
 when property= 'studentName' ;
 return '8' ;
 when property= 'studentNameKana' ;
 return '36' ;
 when property= 'genderCode' ;
 return '1' ;
 when property= 'postalCode' ;
 return '10' ;
 when property= 'prefectureCode' ;
 return '2' ;
 when property= 'addressLine1' ;
 return '45' ;
 when property= 'addressLine2' ;
 return '45' ;
 when property= 'phoneNumber' ;
 return '20' ;
 when property= 'emailAddress' ;
 return '60' ;
 when property= 'admissionDate' ;
 return '10' ;
 when property= 'enrollmentStatusCode' ;
 return '2' ;
 when property= 'enrollmentEndDate' ;
 return '10' ;
 when property= 'classId' ;
 return '19' ;
 when property= 'emergencyContactName' ;
 return '8' ;
 when property= 'relationshipCode' ;
 return '2' ;
 when property= 'emergencyPhoneNumber' ;
 return '20' ;
 when property= 'remarks' ;
 return '120' ;
 when property= 'reason' ;
 return '60' ;
 other ;
 return '320' ;
 endsl ;
 end-proc ;
 dcl-proc ErrorList ;
 dcl-pi *n ;
 result likeds( Result_t ) const ;
 end-pi ;
 dcl-s page int( 10 ) inz( 1 ) ;
 dcl-s i int( 10 ) ;
 dcl-s item int( 10 ) ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s rows char( 122 ) dim( 10 ) ;
 dcl-ds one likeds( Result_t ) ;
 dou *off ;
 clear rows ;
 for i=1 to 10 ;
 item=( page-1 ) *10+i ;
 if item<=result.errorCount ;
 clear one ;
 one.kind=RK_VALIDATION ;
 one.errorCount=1 ;
 one.fieldErrors( 1 ) =result.fieldErrors( item ) ;
 text=FieldName( one.fieldErrors( 1 ).field ) +%ucs2( ':' ) +UiMessage( one ) ;
 rows( i ) =Render( text :122 ) ;
 endif ;
 endfor ;
 C01=rows( 1 ) ;
 C02=rows( 2 ) ;
 C03=rows( 3 ) ;
 C04=rows( 4 ) ;
 C05=rows( 5 ) ;
 C06=rows( 6 ) ;
 C07=rows( 7 ) ;
 C08=rows( 8 ) ;
 C09=rows( 9 ) ;
 C10=rows( 10 ) ;
 CTITLE= 'All field errors(F8 with 1..10 opens full message)' ;
 CTOTAL=%char( result.errorCount ) + ' errors, page ' +%char( page ) ;
 CREASON= '' ;
 CSEL= '' ;
 *in03=*off ;
 *in08=*off ;
 *in10=*off ;
 *in12=*off ;
 *in25=*off ;
 *in26=*off ;
 exfmt CNFRM ;
 if *in03 or *in12 or *in10 ;
 return ;
 endif ;
 if *in25 and page*10<result.errorCount ;
 page+=1 ;
 endif ;
 if *in26 and page>1 ;
 page-=1 ;
 endif ;
 if *in08 ;
 monitor ;
 item=( page-1 ) *10+%int( %trim( CSEL ) ) ;
 on-error ;
 iter ;
 endmon ;
 if item>0 and item<=result.errorCount ;
 clear one ;
 one.kind=RK_VALIDATION ;
 one.errorCount=1 ;
 one.fieldErrors( 1 ) =result.fieldErrors( item ) ;
 text=UiMessage( one ) ;
 LongEdit( text :*on ) ;
 endif ;
 endif ;
 enddo ;
 end-proc ;
