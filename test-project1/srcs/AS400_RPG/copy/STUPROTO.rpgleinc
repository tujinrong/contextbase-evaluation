/if not defined(STUPROTO_DEFINED)
/define STUPROTO_DEFINED
 dcl-pr StError ;
 result likeds( Result_t ) ;
 field varchar( 32 ) const ;
 message char( 16 ) const ;
 end-pr ;
 dcl-pr StAuthorize ;
 operation varchar( 16 ) const ;
 principal varchar( 128 ) ;
 role int( 10 ) ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StClock ;
 utc timestamp ;
 businessDay date ;
 end-pr ;
 dcl-pr StNewId ;
 id char( 36 ) ;
 end-pr ;
 dcl-pr StStartup ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StNormalize ;
 raw likeds( StudentRaw_t ) const ;
 work likeds( StudentWork_t ) ;
 businessDay date const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StValidate ;
 work likeds( StudentWork_t ) const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StParseBirthDate ;
 era varucs2( 20 ) ccsid( 1200 ) const ;
 year varucs2( 8 ) ccsid( 1200 ) const ;
 month varucs2( 4 ) ccsid( 1200 ) const ;
 day varucs2( 4 ) ccsid( 1200 ) const ;
 businessDay date const ;
 birth date ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StFormatBirthDate ;
 birth date const ;
 era varchar( 10 ) ;
 year varucs2( 8 ) ccsid( 1200 ) ;
 month varucs2( 4 ) ccsid( 1200 ) ;
 day varucs2( 4 ) ccsid( 1200 ) ;
 display varucs2( 80 ) ccsid( 1200 ) ;
 end-pr ;
 dcl-pr StNormalizeText varucs2( 320 ) ccsid( 1200 ) ;
 raw varucs2( 320 ) ccsid( 1200 ) const ;
 rawMax int( 10 ) const ;
 savedMax int( 10 ) const ;
 mode int( 10 ) const ;
 required ind const ;
 field varchar( 32 ) const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StIsoDate ;
 raw varucs2( 320 ) ccsid( 1200 ) const ;
 maximum date const ;
 value date ;
 field varchar( 32 ) const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StLong int( 20 ) ;
 raw varucs2( 320 ) ccsid( 1200 ) const ;
 required ind const ;
 field varchar( 32 ) const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StEscapeLike varucs2( 642 ) ccsid( 1200 ) ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 prefix ind const ;
 end-pr ;
 dcl-pr StHash char( 64 ) ;
 value varucs2( 8000 ) ccsid( 1200 ) const ;
 end-pr ;
 dcl-pr StBusinessHash char( 64 ) ;
 work likeds( StudentWork_t ) const ;
 end-pr ;
 dcl-pr StMessage varucs2( 320 ) ccsid( 1200 ) ;
 code char( 16 ) const ;
 end-pr ;
 dcl-pr StLoadStudent ;
 studentId int( 20 ) const ;
 record likeds( StudentRecord_t ) ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StCancelConfirmation ;
 instance char( 36 ) const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StCreateSearchContext ;
 raw likeds( SearchRaw_t ) ;
 context likeds( SearchContext_t ) ;
 page likeds( SearchPage_t ) ;
 end-pr ;
 dcl-pr StClearSearchContext ;
 raw likeds( SearchRaw_t ) ;
 context likeds( SearchContext_t ) ;
 page likeds( SearchPage_t ) ;
 end-pr ;
 dcl-pr StCloseSearchContext ;
 context likeds( SearchContext_t ) ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StSearchStudents ;
 raw likeds( SearchRaw_t ) ;
 context likeds( SearchContext_t ) ;
 newSearch ind const ;
 page likeds( SearchPage_t ) ;
 end-pr ;
 dcl-pr StSaveStudent ;
 input likeds( StudentWork_t ) const ;
 hints likeds( StudentHints_t ) const ;
 studentId int( 20 ) const ;
 expectedVersion int( 20 ) const ;
 confirmation char( 36 ) const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StDeleteStudent ;
 studentId int( 20 ) const ;
 expectedVersion int( 20 ) const ;
 reason varucs2( 120 ) ccsid( 1200 ) const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StLookupChoice ;
 kind varchar( 24 ) const ;
 page int( 10 ) const ;
 schoolYear int( 10 ) const ;
 grade varchar( 2 ) const ;
 values varchar( 24 ) dim( 20 ) ;
 labels varucs2( 320 ) ccsid( 1200 ) dim( 20 ) ;
 count int( 10 ) ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StClassInfo ;
 classId int( 20 ) const ;
 year varchar( 4 ) ;
 grade varchar( 2 ) ;
 occupancy int( 10 ) ;
 capacity int( 10 ) ;
 capacityInd int( 5 ) ;
 result likeds( Result_t ) ;
 registration ind const options( *nopass ) ;
 end-pr ;
 dcl-pr StMaintainClass ;
 work likeds( ClassWork_t ) const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StMaintainCode ;
 work likeds( CodeWork_t ) const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StConfirm ind ;
 value likeds( Confirmation_t ) const ;
 owner varchar( 128 ) const ;
 job varchar( 28 ) const ;
 instance char( 36 ) const ;
 id int( 20 ) const ;
 version int( 20 ) const ;
 business char( 64 ) const ;
 candidates char( 64 ) const ;
 utc timestamp const ;
 reason varucs2( 120 ) ccsid( 1200 ) const ;
 end-pr ;
 dcl-pr StEndWork ;
 commit ind const ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StLookupCodes ;
 kind varchar( 24 ) const ;
 page int( 10 ) const ;
 values varchar( 24 ) dim( 20 ) ;
 labels varucs2( 320 ) ccsid( 1200 ) dim( 20 ) ;
 count int( 10 ) ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StLookupClasses ;
 page int( 10 ) const ;
 year int( 10 ) const ;
 grade varchar( 2 ) const ;
 values varchar( 24 ) dim( 20 ) ;
 labels varucs2( 320 ) ccsid( 1200 ) dim( 20 ) ;
 count int( 10 ) ;
 result likeds( Result_t ) ;
 end-pr ;
 dcl-pr StSearchStateCheck int( 10 ) extproc( 'StSearchStateCheck' ) ;
 identity int( 10 ) value ;
 expected int( 20 ) value ;
 actual int( 20 ) value ;
 storedFormat int( 10 ) value ;
 requestFormat int( 10 ) value ;
 expired int( 10 ) value ;
 end-pr ;
 dcl-pr StSearchKeysValid int( 10 ) extproc( 'StSearchKeysValid' ) ;
 keys pointer value ;
 length int( 10 ) value ;
 end-pr ;
 dcl-pr StSearchBlock int( 10 ) extproc( 'StSearchBlock' ) ;
 block int( 10 ) value ;
 count int( 10 ) value ;
 end-pr ;
 dcl-pr StUnicodeNormalize int( 10 ) extproc( 'StUnicodeNormalize' ) ;
 input pointer value ;
 units int( 10 ) value ;
 rawMax int( 10 ) value ;
 savedMax int( 10 ) value ;
 mode int( 10 ) value ;
 required int( 10 ) value ;
 output pointer value ;
 capacity int( 10 ) value ;
 written int( 10 ) ;
 end-pr ;
 dcl-pr StUnicodeScalars int( 10 ) extproc( 'StUnicodeScalars' ) ;
 input pointer value ;
 units int( 10 ) value ;
 end-pr ;
 dcl-pr StUnicodeToJob int( 10 ) extproc( 'StUnicodeToJob' ) ;
 input pointer value ;
 units int( 10 ) value ;
 ccsid int( 10 ) value ;
 output pointer value ;
 capacity int( 10 ) value ;
 written int( 10 ) ;
 end-pr ;
 dcl-pr StUnicodeFromJob int( 10 ) extproc( 'StUnicodeFromJob' ) ;
 input pointer value ;
 bytes int( 10 ) value ;
 ccsid int( 10 ) value ;
 output pointer value ;
 capacity int( 10 ) value ;
 written int( 10 ) ;
 end-pr ;
 dcl-pr StUnicodeEscape int( 10 ) extproc( 'StUnicodeEscape' ) ;
 input pointer value ;
 units int( 10 ) value ;
 decode int( 10 ) value ;
 output pointer value ;
 capacity int( 10 ) value ;
 written int( 10 ) ;
 end-pr ;
 dcl-pr StUnicodeDigest extproc( 'StUnicodeDigest' ) ;
 input pointer value ;
 units int( 10 ) value ;
 output char( 64 ) ;
 end-pr ;
 dcl-pr StEdit extpgm( 'STUEDIT' ) ;
 studentId int( 20 ) ;
 readOnly ind ;
 notice char( 128 ) ;
 end-pr ;
/endif
