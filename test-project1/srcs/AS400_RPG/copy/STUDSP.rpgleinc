 dcl-proc Render ;
 dcl-pi *n char( 128 ) ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 width int( 10 ) const ;
 end-pi ;
 dcl-s out char( 128 ) ;
 dcl-s n int( 10 ) ;
 dcl-s rc int( 10 ) ;
 rc=StUnicodeToJob( %addr( value :*data ) :%len( value ) :1399 :%addr( out ) :width :n
 ) ;
 if rc<>0 ;
 out= '[Unicode/full value:F8]' ;
 elseif n<128 ;
 %subst( out :n+1 ) =*blanks ;
 endif ;
 return out ;
 end-proc ;
 dcl-proc ReadBuffer ;
 dcl-pi *n varucs2( 320 ) ccsid( 1200 ) ;
 value varchar( 720 ) const ;
 end-pi ;
 dcl-s out ucs2( 320 ) ccsid( 1200 ) ;
 dcl-s n int( 10 ) ;
 dcl-s rc int( 10 ) ;
 rc=StUnicodeFromJob( %addr( value :*data ) :%len( value ) :1399 :%addr( out ) :320 :n
 ) ;
 if rc<>0 ;
 uiError=*on ;
 return %ucs2( '' ) ;
 endif ;
 if n=0 ;
 return %ucs2( '' ) ;
 endif ;
 return %subst( out :1 :n ) ;
 end-proc ;
 dcl-proc ReplaceText ;
 dcl-pi *n varucs2( 320 ) ccsid( 1200 ) ;
 text varucs2( 320 ) ccsid( 1200 ) const ;
 key varucs2( 40 ) ccsid( 1200 ) const ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 end-pi ;
 dcl-s out varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s pos int( 10 ) ;
 out=text ;
 pos=%scan( key :out ) ;
 dow pos>0 ;
 out=%replace( value :out :pos :%len( key ) ) ;
 pos=%scan( key :out ) ;
 enddo ;
 return out ;
 end-proc ;
 dcl-proc UiMessage ;
 dcl-pi *n varucs2( 320 ) ccsid( 1200 ) ;
 result likeds( Result_t ) const ;
 number varchar( 15 ) const options( *nopass ) ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s i int( 10 ) ;
 dcl-s value varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s utc timestamp ;
 dcl-s day date ;
 dcl-s era varchar( 10 ) ;
 dcl-s y varucs2( 8 ) ccsid( 1200 ) ;
 dcl-s m varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s d varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s wareki varucs2( 80 ) ccsid( 1200 ) ;
 if result.kind=0 and result.messageId= '' and result.errorCount=0 ;
 return %ucs2( '' ) ;
 endif ;
 text=StMessage( result.messageId ) ;
 if result.errorCount>0 ;
 text=%ucs2( '' ) ;
 for i=1 to %min( result.errorCount :3 ) ;
 value=StMessage( result.fieldErrors( i ).messageId ) ;
 value=ReplaceText( value :%ucs2( '{field}' ) :FieldName( result.fieldErrors( i ).field )
 ) ;
 value=ReplaceText( value :%ucs2( '{max}' ) :%ucs2( FieldMax( result.fieldErrors( i )
 .field ) ) ) ;
 if %len( text ) +%len( value ) +1<=300 ;
 text+=value+%ucs2( ' ' ) ;
 endif ;
 endfor ;
 if result.errorCount>3 ;
 text+=%ucs2( ' 他の項目にもエラーがあります。F14で' +
 '一覧を参照してください。' ) ;
 endif ;
 endif ;
 text=ReplaceText( text :%ucs2( '{correlationId}' ) :%ucs2( result.requestId ) ) ;
 text=ReplaceText( text :%ucs2( '{count}' ) :%ucs2( %char( result.candidateCount ) ) ) ;
 if %parms( ) >=2 ;
 text=ReplaceText( text :%ucs2( '{studentNo}' ) :%ucs2( number ) ) ;
 endif ;
 StClock( utc :day ) ;
 if result.errorCount>0 and result.fieldErrors( 1 ).field= 'birthDate' ;
 StFormatBirthDate( day :era :y :m :d :wareki ) ;
 text=ReplaceText( text :%ucs2( '{maxDate}' ) :wareki ) ;
 StFormatBirthDate( d'1900-01-01' :era :y :m :d :wareki ) ;
 text=ReplaceText( text :%ucs2( '{minDate}' ) :wareki ) ;
 else ;
 text=ReplaceText( text :%ucs2( '{maxDate}' ) :%ucs2( %char( day :*iso ) ) ) ;
 text=ReplaceText( text :%ucs2( '{minDate}' ) :%ucs2( '1900-01-01' ) ) ;
 endif ;
 text=ReplaceText( text :%ucs2( '{minYear}' ) :%ucs2( '1900' ) ) ;
 text=ReplaceText( text :%ucs2( '{maxYear}' ) :%ucs2( '9998' ) ) ;
 text=ReplaceText( text :%ucs2( '{fromField}' ) :%ucs2( '開始日' ) ) ;
 text=ReplaceText( text :%ucs2( '{toField}' ) :%ucs2( '終了日' ) ) ;
 if result.kind=RK_UNKNOWN ;
 text+=%ucs2( ' 再保存前に検索で結果を確認してください。' ) ;
 endif ;
 return text ;
 end-proc ;
 dcl-proc LongEdit ;
 dcl-pi *n ind ;
 value varucs2( 320 ) ccsid( 1200 ) ;
 locked ind const ;
 end-pi ;
 dcl-s buffer ucs2( 3600 ) ccsid( 1200 ) ;
 dcl-s edited ucs2( 3600 ) ccsid( 1200 ) ;
 dcl-s decoded ucs2( 320 ) ccsid( 1200 ) ;
 dcl-s segment ucs2( 720 ) ccsid( 1200 ) ;
 dcl-s bytes char( 720 ) ;
 dcl-s n int( 10 ) ;
 dcl-s length int( 10 ) ;
 dcl-s rc int( 10 ) ;
 dcl-s page int( 10 ) inz( 1 ) ;
 dcl-s start int( 10 ) ;
 dcl-s pages int( 10 ) ;
 dcl-s priorPage char( 720 ) ;
 dcl-s wasProtected ind ;
 rc=StUnicodeEscape( %addr( value :*data ) :%len( value ) :0 :%addr( buffer ) :3200 :
 length ) ;
 if rc<>0 ;
 return *off ;
 endif ;
 edited=buffer ;
 pages=%max( 1 :%div( length+719 :720 ) ) ;
 wasProtected=*in75 ;
 *in75=locked ;
 dou *off ;
 start=( page-1 ) *720+1 ;
 segment=%subst( edited :start :720 ) ;
 rc=StUnicodeToJob( %addr( segment ) :720 :1399 :%addr( bytes ) :720 :n ) ;
 if rc<>0 ;
 *in75=wasProtected ;
 return *off ;
 endif ;
 LTXT1=%subst( bytes :1 :120 ) ;
 LTXT2=%subst( bytes :121 :120 ) ;
 LTXT3=%subst( bytes :241 :120 ) ;
 LTXT4=%subst( bytes :361 :120 ) ;
 LTXT5=%subst( bytes :481 :120 ) ;
 LTXT6=%subst( bytes :601 :120 ) ;
 priorPage=bytes ;
 LPOS=%char( page ) + ' / ' +%char( pages ) ;
 LTITLE= 'Full Unicode value:explicit escaped editing' ;
 *in03=*off ;
 *in10=*off ;
 *in12=*off ;
 *in25=*off ;
 *in26=*off ;
 exfmt LONGTXT ;
 if *in12 or *in03 ;
 *in75=wasProtected ;
 return *off ;
 endif ;
 bytes=LTXT1+LTXT2+LTXT3+LTXT4+LTXT5+LTXT6 ;
 if not locked and bytes<>priorPage ;
 rc=StUnicodeFromJob( %addr( bytes ) :720 :1399 :%addr( segment ) :720 :n ) ;
 if rc<>0 ;
 LMSG= 'Conversion failed:input retained' ;
 iter ;
 endif ;
 %subst( edited :start :720 ) =segment ;
 endif ;
 if *in25 and page<5 ;
 page+=1 ;
 pages=%max( pages :page ) ;
 iter ;
 endif ;
 if *in26 and page>1 ;
 page-=1 ;
 iter ;
 endif ;
 if *in10 and not locked ;
 length=%len( %trimr( edited ) ) ;
 rc=StUnicodeEscape( %addr( edited ) :length :1 :%addr( decoded ) :320 :n ) ;
 if rc<>0 ;
 LMSG= 'Invalid escape / value too long:edits retained' ;
 iter ;
 endif ;
 if n=0 ;
 value=%ucs2( '' ) ;
 else ;
 value=%subst( decoded :1 :n ) ;
 endif ;
 *in75=wasProtected ;
 return *on ;
 endif ;
 enddo ;
 end-proc ;
 dcl-proc Question ;
 dcl-pi *n ind ;
 code char( 16 ) const ;
 reason varucs2( 120 ) ccsid( 1200 ) ;
 needReason ind const ;
 result likeds( Result_t ) const ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s changedReason varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s priorReason char( 122 ) ;
 dcl-s page int( 10 ) inz( 1 ) ;
 dcl-s first int( 10 ) ;
 dcl-s i int( 10 ) ;
 dcl-s item int( 10 ) ;
 dcl-s rows char( 122 ) dim( 10 ) ;
 dcl-s era varchar( 10 ) ;
 dcl-s y varucs2( 8 ) ccsid( 1200 ) ;
 dcl-s m varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s d varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s birth varucs2( 80 ) ccsid( 1200 ) ;
 dcl-ds check likeds( Result_t ) ;
 dcl-s full varucs2( 320 ) ccsid( 1200 ) dim( 20 ) ;
 dcl-s selected int( 10 ) ;
 clear check ;
 check=result ;
 check.messageId=code ;
 CTITLE=Render( UiMessage( check ) :100 ) ;
 CREASON=Render( reason :122 ) ;
 priorReason=CREASON ;
 CMSG= 'F8:0=full reason, 1..10=full candidate' ;
 CTOTAL= 'Total candidates ' +%char( result.candidateCount ) + '; displayed maximum 20' ;
 CSEL= '' ;
 dou *off ;
 clear rows ;
 first=( page-1 ) *10 ;
 for i=1 to 10 ;
 item=first+i ;
 if item<=%min( result.candidateCount :20 ) ;
 StFormatBirthDate( result.candidates( item ).birthDate :era :y :m :d :birth ) ;
 text=%ucs2( result.candidates( item ).studentNo ) +%ucs2( ' '
 ) +result.candidates( item ).studentName+%ucs2( ' '
 ) +birth+%ucs2( ' ' +result.candidates( item ).classCode+ ' ' ) +
 result.candidates( item ).className ;
 rows( i ) =Render( text :122 ) ;
 full( item ) =text ;
 endif ;
 endfor ;
 C01=rows( 1 ) ;
 C02=rows( 2 ) ;
 C03=rows( 3 ) ;
 C04=rows( 4 ) ;
 C05=rows( 5 ) ;
 C06=rows( 6 ) ;
 C07=rows( 7 ) ;
 C08=rows( 8 ) ;
 C09=rows( 9 ) ;
 C10=rows( 10 ) ;
 *in03=*off ;
 *in08=*off ;
 *in10=*off ;
 *in12=*off ;
 *in25=*off ;
 *in26=*off ;
 exfmt CNFRM ;
 if *in12 or *in03 ;
 return *off ;
 endif ;
 if *in08 ;
 monitor ;
 selected=%int( %trim( CSEL ) ) ;
 on-error ;
 selected=0 ;
 endmon ;
 if selected=0 ;
 changedReason=reason ;
 if LongEdit( changedReason :*off ) and %len( changedReason ) <=120 ;
 reason=changedReason ;
 CREASON=Render( reason :122 ) ;
 priorReason=CREASON ;
 endif ;
 elseif selected>=1 and selected<=10 and( page-1 ) *10+selected<=%min( result.candidateCount :
 20 ) ;
 text=full(( page-1 ) *10+selected ) ;
 LongEdit( text :*on ) ;
 endif ;
 iter ;
 endif ;
 if CREASON<>priorReason ;
 uiError=*off ;
 changedReason=ReadBuffer( %trimr( CREASON ) ) ;
 if uiError or StUnicodeScalars( %addr( changedReason :*data ) :%len( changedReason ) ) >60
 ;
 CMSG= 'Reason must be valid Unicode, maximum 60 scalars' ;
 iter ;
 endif ;
 reason=changedReason ;
 priorReason=CREASON ;
 endif ;
 if *in25 and page=1 and result.candidateCount>10 ;
 page=2 ;
 iter ;
 endif ;
 if *in26 and page=2 ;
 page=1 ;
 iter ;
 endif ;
 if *in10 ;
 if needReason and %len( %trim( reason ) ) =0 ;
 CMSG= 'Explicit confirmation requires a reason' ;
 iter ;
 endif ;
 return *on ;
 endif ;
 enddo ;
 end-proc ;
 dcl-proc Choice ;
 dcl-pi *n varchar( 24 ) ;
 kind varchar( 24 ) const ;
 current varchar( 24 ) const ;
 year int( 10 ) const ;
 grade varchar( 2 ) const ;
 forSave ind const ;
 end-pi ;
 dcl-s values varchar( 24 ) dim( 20 ) ;
 dcl-s labels varucs2( 320 ) ccsid( 1200 ) dim( 20 ) ;
 dcl-ds result likeds( Result_t ) ;
 dcl-s count int( 10 ) ;
 dcl-s page int( 10 ) inz( 1 ) ;
 dcl-s half int( 10 ) ;
 dcl-s i int( 10 ) ;
 dcl-s chosen int( 10 ) ;
 dcl-s rows char( 122 ) dim( 10 ) ;
 dou *off ;
 if kind= 'CLASS' ;
 StLookupClasses( page :year :grade :values :labels :count :result ) ;
 elseif kind= 'YEAR' ;
 StLookupChoice( kind :page :year :grade :values :labels :count :result ) ;
 else ;
 StLookupCodes( kind :page :values :labels :count :result ) ;
 endif ;
 if result.kind<>0 ;
 return current ;
 endif ;
 clear rows ;
 for i=1 to 10 ;
 if half+i<=count ;
 rows( i ) =%char( i ) + ' ' +%trim( Render( %ucs2( values( half+i ) + ' ' ) +labels(
 half+i ) :116 ) ) ;
 endif ;
 endfor ;
 C01=rows( 1 ) ;
 C02=rows( 2 ) ;
 C03=rows( 3 ) ;
 C04=rows( 4 ) ;
 C05=rows( 5 ) ;
 C06=rows( 6 ) ;
 C07=rows( 7 ) ;
 C08=rows( 8 ) ;
 C09=rows( 9 ) ;
 C10=rows( 10 ) ;
 CTITLE= 'Choice ' +kind+ '; 0=unset; F12=retain' ;
 CTOTAL= 'Page ' +%char( page ) + ' / block ' +%char( %div( half :10 ) +1 ) ;
 CREASON= '' ;
 CSEL= '' ;
 *in03=*off ;
 *in08=*off ;
 *in10=*off ;
 *in12=*off ;
 *in25=*off ;
 *in26=*off ;
 exfmt CNFRM ;
 if *in12 or *in03 ;
 return current ;
 endif ;
 if *in25 ;
 if half=0 and count>10 ;
 half=10 ;
 else ;
 page+=1 ;
 half=0 ;
 endif ;
 iter ;
 endif ;
 if *in26 ;
 if half=10 ;
 half=0 ;
 elseif page>1 ;
 page-=1 ;
 half=10 ;
 endif ;
 iter ;
 endif ;
 if *in10 ;
 monitor ;
 chosen=%int( %trim( CSEL ) ) ;
 on-error ;
 CMSG= 'Select 0..10' ;
 iter ;
 endmon ;
 if chosen=0 ;
 return '' ;
 endif ;
 if chosen<1 or chosen>10 or chosen+half>count ;
 CMSG= 'Invalid choice' ;
 iter ;
 endif ;
 chosen+=half ;
 if forSave and values( chosen ) <>current and %scan( %ucs2( '[停止' ) :labels( chosen )
 ) >0 ;
 CMSG= 'Stopped/expired values cannot be newly selected' ;
 iter ;
 endif ;
 return values( chosen ) ;
 endif ;
 enddo ;
 end-proc ;
