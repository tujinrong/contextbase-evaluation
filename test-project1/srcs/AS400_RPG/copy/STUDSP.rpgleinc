 dcl-proc Render ;
 dcl-pi *n char( 128 ) ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 width int( 10 ) const ;
 end-pi ;
 dcl-s out char( 128 ) ;
 dcl-s n int( 10 ) ;
 dcl-s rc int( 10 ) ;
 rc=StUnicodeToJob( %addr( value :*data ) :%len( value ) :1399 :%addr( out ) :width :n
 ) ;
 if rc<>0 ;
 out= '[Unicode/full value:F8]' ;
 elseif n<128 ;
 %subst( out :n+1 ) =*blanks ;
 endif ;
 return out ;
 end-proc ;
 dcl-proc ReadBuffer ;
 dcl-pi *n varucs2( 320 ) ccsid( 1200 ) ;
 value varchar( 720 ) const ;
 end-pi ;
 dcl-s out ucs2( 320 ) ccsid( 1200 ) ;
 dcl-s n int( 10 ) ;
 dcl-s rc int( 10 ) ;
 rc=StUnicodeFromJob( %addr( value :*data ) :%len( value ) :1399 :%addr( out ) :320 :n
 ) ;
 if rc<>0 ;
 uiError=*on ;
 return %ucs2( '' ) ;
 endif ;
 if n=0 ;
 return %ucs2( '' ) ;
 endif ;
 return %subst( out :1 :n ) ;
 end-proc ;
 dcl-proc ReplaceText ;
 dcl-pi *n varucs2( 320 ) ccsid( 1200 ) ;
 text varucs2( 320 ) ccsid( 1200 ) const ;
 key varucs2( 40 ) ccsid( 1200 ) const ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 end-pi ;
 dcl-s out varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s pos int( 10 ) ;
 out=text ;
 pos=%scan( key :out ) ;
 dow pos>0 ;
 out=%replace( value :out :pos :%len( key ) ) ;
 pos=%scan( key :out ) ;
 enddo ;
 return out ;
 end-proc ;
 dcl-proc UiMessage ;
 dcl-pi *n varucs2( 320 ) ccsid( 1200 ) ;
 result likeds( Result_t ) const ;
 number varchar( 15 ) const options( *nopass ) ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s i int( 10 ) ;
 dcl-s value varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s utc timestamp ;
 dcl-s day date ;
 dcl-s era varchar( 10 ) ;
 dcl-s y varucs2( 8 ) ccsid( 1200 ) ;
 dcl-s m varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s d varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s wareki varucs2( 80 ) ccsid( 1200 ) ;
 if result.kind=0 and result.messageId= '' and result.errorCount=0 ;
 return %ucs2( '' ) ;
 endif ;
 text=StMessage( result.messageId ) ;
 if result.errorCount>0 ;
 text=%ucs2( '' ) ;
 for i=1 to %min( result.errorCount :3 ) ;
 value=StMessage( result.fieldErrors( i ).messageId ) ;
 value=ReplaceText( value :%ucs2( '{field}' ) :FieldName( result.fieldErrors( i ).field )
 ) ;
 value=ReplaceText( value :%ucs2( '{max}' ) :%ucs2( FieldMax( result.fieldErrors( i )
 .field ) ) ) ;
 if %len( text ) +%len( value ) +1<=300 ;
 text+=value+%ucs2( ' ' ) ;
 endif ;
 endfor ;
 if result.errorCount>3 ;
 text+=%ucs2( ' 他の項目にもエラーがあります。F9で' +
 '一覧を参照してください。' ) ;
 endif ;
 endif ;
 text=ReplaceText( text :%ucs2( '{correlationId}' ) :%ucs2( result.requestId ) ) ;
 text=ReplaceText( text :%ucs2( '{count}' ) :%ucs2( %char( result.candidateCount ) ) ) ;
 if %parms( ) >=2 ;
 text=ReplaceText( text :%ucs2( '{studentNo}' ) :%ucs2( number ) ) ;
 endif ;
 StClock( utc :day ) ;
 if result.errorCount>0 and result.fieldErrors( 1 ).field= 'birthDate' ;
 StFormatBirthDate( day :era :y :m :d :wareki ) ;
 text=ReplaceText( text :%ucs2( '{maxDate}' ) :wareki ) ;
 StFormatBirthDate( d'1900-01-01' :era :y :m :d :wareki ) ;
 text=ReplaceText( text :%ucs2( '{minDate}' ) :wareki ) ;
 else ;
 text=ReplaceText( text :%ucs2( '{maxDate}' ) :%ucs2( %char( day :*iso ) ) ) ;
 text=ReplaceText( text :%ucs2( '{minDate}' ) :%ucs2( '1900-01-01' ) ) ;
 endif ;
 text=ReplaceText( text :%ucs2( '{minYear}' ) :%ucs2( '1900' ) ) ;
 text=ReplaceText( text :%ucs2( '{maxYear}' ) :%ucs2( '9998' ) ) ;
 text=ReplaceText( text :%ucs2( '{fromField}' ) :%ucs2( '開始日' ) ) ;
 text=ReplaceText( text :%ucs2( '{toField}' ) :%ucs2( '終了日' ) ) ;
 if result.kind=RK_UNKNOWN ;
 text+=%ucs2( ' 再保存前に検索で結果を確認してください。' ) ;
 endif ;
 return text ;
 end-proc ;
// Window offsets/counts are UTF16 units into raw. LF remains outside a window.
 dcl-proc Window ;
 dcl-pi *n char( 128 ) ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 start int( 10 ) const ;
 width int( 10 ) const ;
 used int( 10 ) ;
 advance int( 10 ) ;
 end-pi ;
 dcl-s out char( 128 ) ;
 dcl-s rc int( 10 ) ;
 out=*blanks ;
 rc=StTextWindow( %addr( value :*data ) :%len( value ) :start :1399 :%addr( out ) :width :used :
 advance ) ;
 if rc<>0 ;
 used=-1 ;
 advance=0 ;
 out= '[Unicode/full value:F8]' ;
 endif ;
 return out ;
 end-proc ;
 dcl-proc MergeWindow ;
 dcl-pi *n ;
 value varucs2( 320 ) ccsid( 1200 ) ;
 buffer varchar( 128 ) const ;
 start int( 10 ) const ;
 count int( 10 ) const ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s out ucs2( 320 ) ccsid( 1200 ) ;
 dcl-s n int( 10 ) ;
 dcl-s rc int( 10 ) ;
 if count<0 ;
 uiError=*on ;
 return ;
 endif ;
 text=ReadBuffer( %trimr( buffer ) ) ;
 if uiError ;
 return ;
 endif ;
 rc=StTextSplice( %addr( value :*data ) :%len( value ) :start :count :
 %addr( text :*data ) :%len( text ) :%addr( out ) :320 :n ) ;
 if rc<>0 ;
 uiError=*on ;
 return ;
 endif ;
 if n=0 ;
 value=%ucs2( '' ) ;
 else ;
 value=%subst( out :1 :n ) ;
 endif ;
 end-proc ;
 dcl-proc DrawParts ;
 dcl-pi *n ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 parts int( 10 ) const ;
 buffers char( 128 ) dim( 3 ) ;
 starts int( 10 ) dim( 3 ) ;
 counts int( 10 ) dim( 3 ) ;
 end-pi ;
 dcl-s i int( 10 ) ;
 dcl-s start int( 10 ) ;
 dcl-s advance int( 10 ) ;
 clear buffers ;
 clear starts ;
 clear counts ;
 for i=1 to parts ;
 starts( i ) =start ;
 buffers( i ) =Window( value :start :112 :counts( i ) :advance ) ;
 if counts( i ) <0 ;
 leave ;
 endif ;
 start+=advance ;
 endfor ;
 end-proc ;
 dcl-proc MergeParts ;
 dcl-pi *n ;
 value varucs2( 320 ) ccsid( 1200 ) ;
 parts int( 10 ) const ;
 buffers char( 128 ) dim( 3 ) const ;
 prior char( 128 ) dim( 3 ) const ;
 starts int( 10 ) dim( 3 ) const ;
 counts int( 10 ) dim( 3 ) const ;
 end-pi ;
 dcl-s i int( 10 ) ;
 dcl-s draft varucs2( 320 ) ccsid( 1200 ) ;
 draft=value ;
 for i=parts downto 1 ;
 if buffers( i ) <>prior( i ) ;
 MergeWindow( draft :%subst( buffers( i ) :1 :112 ) :starts( i ) :counts( i ) ) ;
 if uiError ;
 return ;
 endif ;
 endif ;
 endfor ;
 value=draft ;
 end-proc ;
 dcl-proc LongEdit ;
 dcl-pi *n ind ;
 value varucs2( 320 ) ccsid( 1200 ) ;
 locked ind const ;
 maxUnits int( 10 ) const options( *nopass ) ;
 maxScalars int( 10 ) const options( *nopass ) ;
 end-pi ;
 dcl-s draft varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s piece varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s encoded ucs2( 128 ) ccsid( 1200 ) ;
 dcl-s decoded ucs2( 320 ) ccsid( 1200 ) ;
 dcl-s output ucs2( 320 ) ccsid( 1200 ) ;
 dcl-s bytes char( 128 ) ;
 dcl-s prior char( 128 ) ;
 dcl-s starts int( 10 ) dim( 321 ) ;
 dcl-s page int( 10 ) inz( 1 ) ;
 dcl-s used int( 10 ) ;
 dcl-s advance int( 10 ) ;
 dcl-s n int( 10 ) ;
 dcl-s rc int( 10 ) ;
 dcl-s unicode ind ;
 dcl-s redraw ind inz( *on ) ;
 dcl-s wasProtected ind ;
 dcl-s returnRow int( 5 ) ;
 dcl-s returnCol int( 5 ) ;
 dcl-s unitLimit int( 10 ) inz( 320 ) ;
 dcl-s scalarLimit int( 10 ) inz( 320 ) ;
 if %parms( ) >=3 ;
 unitLimit=maxUnits ;
 endif ;
 if %parms( ) >=4 ;
 scalarLimit=maxScalars ;
 endif ;
 draft=value ;
 returnRow=CSRROW ;
 returnCol=CSRCOL ;
 wasProtected=*in75 ;
 *in75=locked ;
 LMSG= '' ;
 dou *off ;
 if redraw ;
 if unicode ;
 rc=StTextEscapeWindow( %addr( draft :*data ) :%len( draft ) :starts( page ) :
 %addr( encoded ) :128 :used :n ) ;
 advance=used ;
 if rc=0 ;
 bytes=*blanks ;
 rc=StUnicodeToJob( %addr( encoded ) :n :1399 :%addr( bytes ) :128 :n ) ;
 endif ;
 if rc=0 ;
 TEXT=bytes ;
 else ;
 TEXT= '' ;
 used=-1 ;
 endif ;
 LTITLE= 'Unicode mode: explicit \\ / \n / \u{HEX}' ;
 else ;
 TEXT=Window( draft :starts( page ) :128 :used :advance ) ;
 LTITLE= 'Normal mode: backslash sequences remain literal' ;
 endif ;
 prior=TEXT ;
 LPOS= 'Window ' +%char( page ) + ' / raw UTF16 offset ' +%char( starts( page ) ) ;
 redraw=*off ;
 endif ;
 *in03=*off ;
 *in04=*off ;
 *in05=*off ;
 *in06=*off ;
 *in07=*off ;
 *in08=*off ;
 *in09=*off ;
 *in10=*off ;
 *in11=*off ;
 *in12=*off ;
 *in14=*off ;
 *in15=*off ;
 *in16=*off ;
 *in20=*off ;
 *in23=*off ;
 *in25=*off ;
 *in26=*off ;
 CSRROW=5 ;
 CSRCOL=2 ;
 exfmt LONGTXT ;
 if *in12 or *in03 ;
 *in75=wasProtected ;
 CSRROW=returnRow ;
 CSRCOL=returnCol ;
 return *off ;
 endif ;
// Mode changes render draft without parsing or replacing the raw value.
 if *in06 ;
 unicode=not unicode ;
 page=1 ;
 clear starts ;
 redraw=*on ;
 iter ;
 endif ;
 if not locked and TEXT<>prior ;
 if used<0 ;
 LMSG= 'Unrepresentable window: use F6 Unicode; raw retained' ;
 iter ;
 endif ;
 uiError=*off ;
 piece=ReadBuffer( %trimr( TEXT ) ) ;
 if uiError ;
 LMSG= 'Conversion failed; input retained' ;
 iter ;
 endif ;
 if unicode ;
 rc=StUnicodeEscape( %addr( piece :*data ) :%len( piece ) :1 :%addr( decoded ) :320 :n ) ;
 if rc<>0 ;
 LMSG= 'Invalid escape; correct input or F12 cancel' ;
 iter ;
 endif ;
 if n=0 ;
 piece=%ucs2( '' ) ;
 else ;
 piece=%subst( decoded :1 :n ) ;
 endif ;
 endif ;
 rc=StTextSplice( %addr( draft :*data ) :%len( draft ) :starts( page ) :used :
 %addr( piece :*data ) :%len( piece ) :%addr( output ) :320 :n ) ;
 if rc<>0 ;
 LMSG= 'Raw capacity exceeded; input retained' ;
 iter ;
 endif ;
 if n=0 ;
 draft=%ucs2( '' ) ;
 else ;
 draft=%subst( output :1 :n ) ;
 endif ;
 advance+=%len( piece ) -used ;
 used=%len( piece ) ;
 prior=TEXT ;
 endif ;
 if *in10 and not locked ;
 rc=StTextLimit( %addr( draft :*data ) :%len( draft ) :unitLimit :scalarLimit ) ;
 if rc<>0 ;
 LMSG= 'Raw field limit exceeded: correct this window or F12 cancel' ;
 iter ;
 endif ;
 value=draft ;
 *in75=wasProtected ;
 CSRROW=returnRow ;
 CSRCOL=returnCol ;
 return *on ;
 endif ;
 if *in25 and used>=0 and advance>0 and starts( page ) +advance<%len( draft ) ;
 starts( page+1 ) =starts( page ) +advance ;
 page+=1 ;
 redraw=*on ;
 elseif *in26 and page>1 ;
 page-=1 ;
 redraw=*on ;
 endif ;
 enddo ;
 end-proc ;
 dcl-proc Question ;
 dcl-pi *n ind ;
 code char( 16 ) const ;
 reason varucs2( 120 ) ccsid( 1200 ) ;
 needReason ind const ;
 result likeds( Result_t ) const ;
 end-pi ;
 dcl-s page int( 10 ) inz( 1 ) ;
 dcl-s first int( 10 ) ;
 dcl-s i int( 10 ) ;
 dcl-s item int( 10 ) ;
 dcl-s rows char( 124 ) dim( 8 ) ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s full varucs2( 320 ) ccsid( 1200 ) dim( 20 ) ;
 dcl-s era varchar( 10 ) ;
 dcl-s y varucs2( 8 ) ccsid( 1200 ) ;
 dcl-s m varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s d varucs2( 4 ) ccsid( 1200 ) ;
 dcl-s birth varucs2( 80 ) ccsid( 1200 ) ;
 dcl-ds check likeds( Result_t ) ;
 dcl-s deleting ind ;
 dcl-s duplicate ind ;
 dcl-s candidateCount int( 10 ) ;
 dcl-s prior74 ind ;
 dcl-s returnRow int( 5 ) ;
 dcl-s returnCol int( 5 ) ;
 dcl-s reasonDraft varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s buffers char( 128 ) dim( 3 ) ;
 dcl-s prior char( 128 ) dim( 3 ) ;
 dcl-s starts int( 10 ) dim( 3 ) ;
 dcl-s counts int( 10 ) dim( 3 ) ;
 returnRow=CSRROW ;
 returnCol=CSRCOL ;
 deleting=code= 'W-STU-105' ;
 duplicate=code= 'W-STU-101' or code= 'W-STU-102' ;
 candidateCount=0 ;
 if duplicate ;
 candidateCount=result.candidateCount ;
 endif ;
 prior74=*in74 ;
 *in74=not deleting ;
 check=result ;
 check.errorCount=0 ;
 check.messageId=code ;
 CTITLE=Render( UiMessage( check ) :124 ) ;
 CMSG= '' ;
 reasonDraft=reason ;
 DrawParts( reasonDraft :2 :buffers :starts :counts ) ;
 prior=buffers ;
 DELREAS1=%subst( buffers( 1 ) :1 :112 ) ;
 DELREAS2=%subst( buffers( 2 ) :1 :112 ) ;
 if deleting ;
 CKEYS= 'F23=Explicit delete; F12=cancel (default)' ;
 else ;
 CKEYS= 'F10=Explicit continue; F12=cancel (default)' ;
 endif ;
 dou *off ;
 clear rows ;
 first=( page-1 ) *8 ;
 for i=1 to 8 ;
 item=first+i ;
 if item<=%min( candidateCount :20 ) ;
 StFormatBirthDate( result.candidates( item ).birthDate :era :y :m :d :birth ) ;
 text=%ucs2( result.candidates( item ).studentNo+ ' ' ) +result.candidates( item ).studentName+
 %ucs2( ' ' ) +birth+%ucs2( ' ' +result.candidates( item ).classCode+ ' ' ) +result.candidates(
 item ).className ;
 rows( i ) =Render( text :124 ) ;
 full( item ) =text ;
 endif ;
 endfor ;
 C01=rows( 1 ) ;
 C02=rows( 2 ) ;
 C03=rows( 3 ) ;
 C04=rows( 4 ) ;
 C05=rows( 5 ) ;
 C06=rows( 6 ) ;
 C07=rows( 7 ) ;
 C08=rows( 8 ) ;
 DUPCNT= '' ;
 if duplicate ;
 DUPCNT= 'Candidates ' +%char( candidateCount ) + ' (maximum 20), page ' +%char( page ) ;
 if CMSG= '' ;
 CMSG= 'F8=reason full edit, or cursor candidate full view' ;
 endif ;
 endif ;
 *in03=*off ;
 *in04=*off ;
 *in05=*off ;
 *in06=*off ;
 *in07=*off ;
 *in08=*off ;
 *in09=*off ;
 *in10=*off ;
 *in11=*off ;
 *in12=*off ;
 *in14=*off ;
 *in15=*off ;
 *in16=*off ;
 *in20=*off ;
 *in23=*off ;
 *in25=*off ;
 *in26=*off ;
 CSRROW=26 ;
 CSRCOL=2 ;
 exfmt CNFRM ;
 if *in12 or *in03 ;
 *in74=prior74 ;
 CSRROW=returnRow ;
 CSRCOL=returnCol ;
 return *off ;
 endif ;
 if deleting ;
 buffers( 1 ) =DELREAS1 ;
 buffers( 2 ) =DELREAS2 ;
 uiError=*off ;
 MergeParts( reasonDraft :2 :buffers :prior :starts :counts ) ;
 if uiError ;
 CMSG= 'Invalid conversion: reason retained; F8 for full input' ;
 iter ;
 endif ;
 DrawParts( reasonDraft :2 :buffers :starts :counts ) ;
 prior=buffers ;
 DELREAS1=%subst( buffers( 1 ) :1 :112 ) ;
 DELREAS2=%subst( buffers( 2 ) :1 :112 ) ;
 if %len( reasonDraft ) >120 ;
 CMSG= 'Reason capacity exceeded; correct or cancel' ;
 iter ;
 endif ;
 reason=reasonDraft ;
 endif ;
 if *in08 ;
 if deleting or( duplicate and( CSRFLD= 'CMSG' or %subst( CSRFLD :1 :1 ) <> 'C' ) ) ;
 if LongEdit( reasonDraft :*off :120 :60 ) ;
 reason=reasonDraft ;
 DrawParts( reasonDraft :2 :buffers :starts :counts ) ;
 prior=buffers ;
 DELREAS1=%subst( buffers( 1 ) :1 :112 ) ;
 DELREAS2=%subst( buffers( 2 ) :1 :112 ) ;
 endif ;
 else ;
 monitor ;
 item=%int( %subst( %trim( CSRFLD ) :2 ) ) +first ;
 on-error ;
 item=0 ;
 endmon ;
 if item>first and item<=%min( first+8 :%min( candidateCount :20 ) ) ;
 text=full( item ) ;
 LongEdit( text :*on ) ;
 endif ;
 endif ;
 iter ;
 endif ;
 if *in25 and page*8<%min( candidateCount :20 ) ;
 page+=1 ;
 iter ;
 endif ;
 if *in26 and page>1 ;
 page-=1 ;
 iter ;
 endif ;
 if( deleting and *in23 ) or( not deleting and *in10 ) ;
 if needReason and( %len( %trim( reason ) ) =0 or
 StUnicodeScalars( %addr( reason :*data ) :%len( reason ) ) >60 ) ;
 CMSG= 'Explicit confirmation needs a nonblank reason, maximum 60 scalars' ;
 iter ;
 endif ;
 *in74=prior74 ;
 CSRROW=returnRow ;
 CSRCOL=returnCol ;
 return *on ;
 endif ;
 enddo ;
 end-proc ;
 dcl-proc Choice ;
 dcl-pi *n varchar( 24 ) ;
 kind varchar( 24 ) const ;
 current varchar( 24 ) const ;
 year int( 10 ) const ;
 grade varchar( 2 ) const ;
 forSave ind const ;
 end-pi ;
 dcl-s values varchar( 24 ) dim( 20 ) ;
 dcl-s labels varucs2( 320 ) ccsid( 1200 ) dim( 20 ) ;
 dcl-ds result likeds( Result_t ) ;
 dcl-s count int( 10 ) ;
 dcl-s page int( 10 ) inz( 1 ) ;
 dcl-s screen int( 10 ) inz( 1 ) ;
 dcl-s local int( 10 ) ;
 dcl-s i int( 10 ) ;
 dcl-s selected int( 10 ) ;
 dcl-s selections char( 1 ) dim( 8 ) ;
 dcl-s rows char( 124 ) dim( 8 ) ;
 dcl-s chosen int( 10 ) ;
 dcl-s total int( 10 ) ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s offset int( 10 ) inz( 1 ) ;
 dcl-s fetched ind ;
 dcl-s returnRow int( 5 ) ;
 dcl-s returnCol int( 5 ) ;
 returnRow=CSRROW ;
 returnCol=CSRCOL ;
 CSRROW=3 ;
 CSRCOL=2 ;
 dou *off ;
 if not fetched ;
 if kind= 'SORT' ;
 offset=0 ;
 count=8 ;
 values( 1 ) = 'studentNo:asc' ;
 values( 2 ) = 'studentNo:desc' ;
 values( 3 ) = 'name:asc' ;
 values( 4 ) = 'name:desc' ;
 values( 5 ) = 'admissionDate:asc' ;
 values( 6 ) = 'admissionDate:desc' ;
 values( 7 ) = 'updatedAt:asc' ;
 values( 8 ) = 'updatedAt:desc' ;
 for i=1 to 8 ;
 labels( i ) =%ucs2( values( i ) ) ;
 endfor ;
 elseif kind= 'PAGE' ;
 offset=0 ;
 count=3 ;
 values( 1 ) = '20' ;
 values( 2 ) = '50' ;
 values( 3 ) = '100' ;
 for i=1 to 3 ;
 labels( i ) =%ucs2( values( i ) ) ;
 endfor ;
 elseif kind= 'ERA' ;
 count=5 ;
 values( 1 ) = 'MEIJI' ;
 values( 2 ) = 'TAISHO' ;
 values( 3 ) = 'SHOWA' ;
 values( 4 ) = 'HEISEI' ;
 values( 5 ) = 'REIWA' ;
 for i=1 to 5 ;
 labels( i ) =%ucs2( values( i ) ) ;
 endfor ;
 elseif kind= 'CLASS' ;
 StLookupClasses( page :year :grade :values :labels :count :result ) ;
 elseif kind= 'YEAR' ;
 StLookupChoice( kind :page :year :grade :values :labels :count :result ) ;
 else ;
 StLookupCodes( kind :page :values :labels :count :result ) ;
 endif ;
 if result.kind<>0 ;
 CSRROW=returnRow ;
 CSRCOL=returnCol ;
 return current ;
 endif ;
 fetched=*on ;
 endif ;
 clear rows ;
 clear selections ;
 for i=1 to 8 ;
// The first displayed choice is explicit unset; all backend rows remain 20/page.
 local=( screen-1 ) *8+i-offset ;
 if local=0 ;
 rows( i ) = '(unset)' ;
 elseif local<=count ;
 rows( i ) =Render( %ucs2( values( local ) + ' ' ) +labels( local ) :124 ) ;
 endif ;
 endfor ;
 PSEL1= '' ;
 PSEL2= '' ;
 PSEL3= '' ;
 PSEL4= '' ;
 PSEL5= '' ;
 PSEL6= '' ;
 PSEL7= '' ;
 PSEL8= '' ;
 PVAL1=rows( 1 ) ;
 PVAL2=rows( 2 ) ;
 PVAL3=rows( 3 ) ;
 PVAL4=rows( 4 ) ;
 PVAL5=rows( 5 ) ;
 PVAL6=rows( 6 ) ;
 PVAL7=rows( 7 ) ;
 PVAL8=rows( 8 ) ;
 PTITLE= 'Choice ' +kind+ ' / page ' +%char( page ) + ' / window ' +%char( screen ) ;
 *in03=*off ;
 *in04=*off ;
 *in05=*off ;
 *in06=*off ;
 *in07=*off ;
 *in08=*off ;
 *in09=*off ;
 *in10=*off ;
 *in11=*off ;
 *in12=*off ;
 *in14=*off ;
 *in15=*off ;
 *in16=*off ;
 *in20=*off ;
 *in23=*off ;
 *in25=*off ;
 *in26=*off ;
 exfmt PICK ;
 if *in12 or *in03 ;
 CSRROW=returnRow ;
 CSRCOL=returnCol ;
 return current ;
 endif ;
 if *in08 ;
 monitor ;
 i=%int( %subst( %trim( CSRFLD ) :5 ) ) ;
 on-error ;
 i=0 ;
 endmon ;
 local=( screen-1 ) *8+i-offset ;
 if i>=1 and i<=8 and local>=1 and local<=count ;
 text=labels( local ) ;
 LongEdit( text :*on ) ;
 endif ;
 iter ;
 endif ;
 if *in25 ;
 if screen*8<count+offset ;
 screen+=1 ;
 elseif count=20 and kind<> 'SORT' and kind<> 'PAGE' and kind<> 'ERA' ;
 page+=1 ;
 screen=1 ;
 fetched=*off ;
 endif ;
 iter ;
 endif ;
 if *in26 ;
 if screen>1 ;
 screen-=1 ;
 elseif page>1 ;
 page-=1 ;
 screen=3 ;
 fetched=*off ;
 endif ;
 iter ;
 endif ;
// CF keys never select a row; Enter requires exactly one literal 1.
 if *in04 or *in05 or *in06 or *in07 or *in09 or *in10 or *in11 or
 *in14 or *in15 or *in16 or *in20 or *in23 ;
 iter ;
 endif ;
 selections( 1 ) =PSEL1 ;
 selections( 2 ) =PSEL2 ;
 selections( 3 ) =PSEL3 ;
 selections( 4 ) =PSEL4 ;
 selections( 5 ) =PSEL5 ;
 selections( 6 ) =PSEL6 ;
 selections( 7 ) =PSEL7 ;
 selections( 8 ) =PSEL8 ;
 total=0 ;
 chosen=-1 ;
 for i=1 to 8 ;
 if selections( i ) <> ' ' ;
 if selections( i ) <> '1' ;
 total=99 ;
 leave ;
 endif ;
 total+=1 ;
 chosen=( screen-1 ) *8+i-offset ;
 endif ;
 endfor ;
 if total<>1 or chosen<0 or chosen>count ;
 PMSG= 'Select exactly one valid row with 1' ;
 iter ;
 endif ;
 if chosen=0 ;
 CSRROW=returnRow ;
 CSRCOL=returnCol ;
 return '' ;
 endif ;
 if forSave and values( chosen ) <>current and %scan( %ucs2( '[停止' ) :labels( chosen ) ) >0
 ;
 PMSG= 'Stopped/expired values cannot be newly selected' ;
 iter ;
 endif ;
 CSRROW=returnRow ;
 CSRCOL=returnCol ;
 return values( chosen ) ;
 enddo ;
 end-proc ;
 dcl-proc UiLabel ;
 dcl-pi *n varucs2( 320 ) ccsid( 1200 ) ;
 kind varchar( 24 ) const ;
 current varucs2( 320 ) ccsid( 1200 ) const ;
 year int( 10 ) const ;
 grade varchar( 2 ) const ;
 end-pi ;
 dcl-s values varchar( 24 ) dim( 20 ) ;
 dcl-s labels varucs2( 320 ) ccsid( 1200 ) dim( 20 ) ;
 dcl-ds result likeds( Result_t ) ;
 dcl-s page int( 10 ) inz( 1 ) ;
 dcl-s count int( 10 ) ;
 dcl-s i int( 10 ) ;
 if current=%ucs2( '' ) ;
 return %ucs2( '' ) ;
 endif ;
 dou *off ;
 StLookupChoice( kind :page :year :grade :values :labels :count :result ) ;
 if result.kind<>0 ;
 return %ucs2( '[lookup unavailable]' ) ;
 endif ;
 for i=1 to count ;
 if %ucs2( values( i ) ) =current ;
 return labels( i ) ;
 endif ;
 endfor ;
 if count<20 ;
 return %ucs2( '[inconsistent code]' ) ;
 endif ;
 page+=1 ;
 enddo ;
 end-proc ;
