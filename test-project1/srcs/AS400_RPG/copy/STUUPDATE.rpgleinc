 exec sql UPDATE STUDAPP.M_STUDENT SET
 student_name= :work.studentName ,
 student_name_kana= :work.studentNameKana ,
 birth_date= :work.birthDate ,
 gender_code= :work.genderCode ,
 postal_code= :work.postalCode ,
 prefecture_code= :work.prefectureCode ,
 address_line1= :work.addressLine1 ,
 address_line2= :work.addressLine2 :work.addressLine2Ind ,
 phone_number= :work.phoneNumber :work.phoneNumberInd ,
 email_address= :work.emailAddress :work.emailAddressInd ,
 admission_date= :work.admissionDate ,
 enrollment_status_code= :work.enrollmentStatusCode ,
 enrollment_end_date= :work.enrollmentEndDate :work.enrollmentEndDateInd ,
 class_id= :work.classId :work.classIdInd ,
 emergency_contact_name= :work.emergencyContactName :work.emergencyContactNameInd ,
 relationship_code= :work.relationshipCode :work.relationshipCodeInd ,
 emergency_phone_number= :work.emergencyPhoneNumber :work.emergencyPhoneNumberInd ,
 remarks= :work.remarks :work.remarksInd , name_key= :work.nameKey , kana_key= :work.kanaKey
 ,
 relationship_category= :work.relationshipCategory :work.relationshipCategoryInd ,
 updated_at= :utc , updated_by= :principal , row_version=row_version+1
 WHERE student_id= :studentId AND row_version= :expectedVersion AND is_deleted=0 ;
