// UI-only procedures: no DB statements and no authority decisions.
 dcl-pr Render char( 128 ) ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 width int( 10 ) const ;
 end-pr ;
 dcl-pr ReadBuffer varucs2( 320 ) ccsid( 1200 ) ;
 value varchar( 720 ) const ;
 end-pr ;
 dcl-pr ReplaceText varucs2( 320 ) ccsid( 1200 ) ;
 text varucs2( 320 ) ccsid( 1200 ) const ;
 key varucs2( 40 ) ccsid( 1200 ) const ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 end-pr ;
 dcl-pr UiMessage varucs2( 320 ) ccsid( 1200 ) ;
 result likeds( Result_t ) const ;
 number varchar( 15 ) const options( *nopass ) ;
 end-pr ;
 dcl-pr LongEdit ind ;
 value varucs2( 320 ) ccsid( 1200 ) ;
 locked ind const ;
 end-pr ;
 dcl-pr Question ind ;
 code char( 16 ) const ;
 reason varucs2( 120 ) ccsid( 1200 ) ;
 needReason ind const ;
 result likeds( Result_t ) const ;
 end-pr ;
 dcl-pr Choice varchar( 24 ) ;
 kind varchar( 24 ) const ;
 current varchar( 24 ) const ;
 year int( 10 ) const ;
 grade varchar( 2 ) const ;
 forSave ind const ;
 end-pr ;
 dcl-pr FieldName varucs2( 64 ) ccsid( 1200 ) ;
 property varchar( 32 ) const ;
 end-pr ;
 dcl-pr FieldMax varchar( 4 ) ;
 property varchar( 32 ) const ;
 end-pr ;
 dcl-s uiError ind ;
 dcl-pr ErrorList ;
 result likeds( Result_t ) const ;
 end-pr ;
