// UI-only procedures: no DB statements and no authority decisions.
 dcl-pr StTextWindow int( 10 ) extproc( 'StTextWindow' ) ;
 input pointer value ;
 units int( 10 ) value ;
 start int( 10 ) value ;
 ccsid int( 10 ) value ;
 output pointer value ;
 capacity int( 10 ) value ;
 used int( 10 ) ;
 advance int( 10 ) ;
 end-pr ;
 dcl-pr StTextSplice int( 10 ) extproc( 'StTextSplice' ) ;
 input pointer value ;
 units int( 10 ) value ;
 start int( 10 ) value ;
 count int( 10 ) value ;
 added pointer value ;
 addedUnits int( 10 ) value ;
 output pointer value ;
 capacity int( 10 ) value ;
 written int( 10 ) ;
 end-pr ;
 dcl-pr StTextEscapeWindow int( 10 ) extproc( 'StTextEscapeWindow' ) ;
 input pointer value ;
 units int( 10 ) value ;
 start int( 10 ) value ;
 output pointer value ;
 capacity int( 10 ) value ;
 used int( 10 ) ;
 written int( 10 ) ;
 end-pr ;
 dcl-pr Window char( 128 ) ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 start int( 10 ) const ;
 width int( 10 ) const ;
 used int( 10 ) ;
 advance int( 10 ) ;
 end-pr ;
 dcl-pr MergeWindow ;
 value varucs2( 320 ) ccsid( 1200 ) ;
 buffer varchar( 128 ) const ;
 start int( 10 ) const ;
 count int( 10 ) const ;
 end-pr ;
 dcl-pr DrawParts ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 parts int( 10 ) const ;
 buffers char( 128 ) dim( 3 ) ;
 starts int( 10 ) dim( 3 ) ;
 counts int( 10 ) dim( 3 ) ;
 end-pr ;
 dcl-pr MergeParts ;
 value varucs2( 320 ) ccsid( 1200 ) ;
 parts int( 10 ) const ;
 buffers char( 128 ) dim( 3 ) const ;
 prior char( 128 ) dim( 3 ) const ;
 starts int( 10 ) dim( 3 ) const ;
 counts int( 10 ) dim( 3 ) const ;
 end-pr ;
 dcl-pr Render char( 128 ) ;
 value varucs2( 320 ) ccsid( 1200 ) const ;
 width int( 10 ) const ;
 end-pr ;
 dcl-pr ReadBuffer varucs2( 320 ) ccsid( 1200 ) ;
 value varchar( 720 ) const ;
 end-pr ;
 dcl-pr ReplaceText varucs2( 320 ) ccsid( 1200 ) ;
