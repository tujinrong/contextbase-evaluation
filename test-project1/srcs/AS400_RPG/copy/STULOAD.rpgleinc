// Explicit fixed host variables. Caller owns the commitment gate.
 exec sql SELECT s.student_id , s.row_version , s.student_no ,
 s.student_name ,
 s.student_name_kana ,
 s.birth_date ,
 s.gender_code ,
 s.postal_code ,
 s.prefecture_code ,
 s.address_line1 ,
 s.address_line2 ,
 s.phone_number ,
 s.email_address ,
 s.admission_date ,
 s.enrollment_status_code ,
 s.enrollment_end_date ,
 s.class_id ,
 s.emergency_contact_name ,
 s.relationship_code ,
 s.emergency_phone_number ,
 s.remarks ,
 s.relationship_category , s.name_key , s.kana_key , s.updated_at , s.updated_by
 INTO :rec.studentId , :rec.rowVersion , :rec.work.studentNo ,
 :rec.work.studentName ,
 :rec.work.studentNameKana ,
 :rec.work.birthDate ,
 :rec.work.genderCode ,
 :rec.work.postalCode ,
 :rec.work.prefectureCode ,
 :rec.work.addressLine1 ,
 :rec.work.addressLine2 :rec.work.addressLine2Ind ,
 :rec.work.phoneNumber :rec.work.phoneNumberInd ,
 :rec.work.emailAddress :rec.work.emailAddressInd ,
 :rec.work.admissionDate ,
 :rec.work.enrollmentStatusCode ,
 :rec.work.enrollmentEndDate :rec.work.enrollmentEndDateInd ,
 :rec.work.classId :rec.work.classIdInd ,
 :rec.work.emergencyContactName :rec.work.emergencyContactNameInd ,
 :rec.work.relationshipCode :rec.work.relationshipCodeInd ,
 :rec.work.emergencyPhoneNumber :rec.work.emergencyPhoneNumberInd ,
 :rec.work.remarks :rec.work.remarksInd ,
 :rec.work.relationshipCategory :rec.work.relationshipCategoryInd , :rec.work.nameKey , :
  rec.work.kanaKey , :rec.updatedAt , :rec.updatedBy
 FROM STUDAPP.M_STUDENT s WHERE s.student_id= :id AND s.is_deleted=0 ;
