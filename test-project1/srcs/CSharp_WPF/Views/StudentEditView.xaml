<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="StudentManagement.Wpf.Views.StudentEditView" Title="{Binding Title}" Width="1300" Height="700" MinWidth="640" MinHeight="400" FontFamily="Yu Gothic UI" FontSize="12" Foreground="#22374C" Background="#E7EDF3" SizeChanged="Reflow">
  <Window.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="{Binding IsReadOnly}"/></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="IsEnabled" Value="{Binding CanEdit}"/></Style>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><Border BorderBrush="#BECDDB" BorderThickness="1" Background="{TemplateBinding Background}"><DockPanel><Border DockPanel.Dock="Top" Background="#EDF2F7" BorderBrush="#C6D2DD" BorderThickness="0,0,0,1" Padding="8,3"><ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"/></Border><ContentPresenter Margin="{TemplateBinding Padding}"/></DockPanel></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="EditorContent" Margin="10,6" Background="White">
      <Border Background="#15577E" Padding="12,5" Margin="0,0,0,6"><TextBlock Text="学生管理システム" Foreground="White" FontWeight="SemiBold"/></Border>
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" />
      <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="70" VerticalScrollBarVisibility="Auto" Foreground="#8B2835"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
      <GroupBox Header="基本情報">
        <Grid x:Name="BasicGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="38" />
            <RowDefinition Height="Auto" MinHeight="38" />
          </Grid.RowDefinitions>
          <Label Grid.Row="0" Grid.Column="0">
            <TextBlock Text="学生管理番号" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Label>
          <TextBlock Text="{Binding StudentIdDisplay}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" />
          <Label Grid.Row="0" Grid.Column="2">
            <TextBlock Text="学籍番号 ※ 15文字（新規だけ）" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Label>
          <TextBox IsReadOnly="{Binding IsNumberReadOnly}" Text="{Binding Model.StudentNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="30" AutomationProperties.Name="学籍番号" Grid.Row="0" Grid.Column="3" />
          <Label Grid.Row="0" Grid.Column="4">
            <TextBlock Text="氏名 ※ 8文字" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Label>
          <TextBox Text="{Binding Model.StudentName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="16" AutomationProperties.Name="氏名" Grid.Row="0" Grid.Column="5" />
          <Label Grid.Row="1" Grid.Column="0">
            <TextBlock Text="氏名カナ ※ 入力36／保存18文字" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Label>
          <TextBox Text="{Binding Model.StudentNameKana, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="72" AutomationProperties.Name="氏名カナ" Grid.Row="1" Grid.Column="1" />
          <Label Grid.Row="1" Grid.Column="2">
            <TextBlock Text="生年月日 ※ 和暦4入力" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Label>
          <WrapPanel Grid.Row="1" Grid.Column="3">
            <ComboBox Width="75" ItemsSource="{Binding Eras}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.BirthEra, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="元号" />
            <TextBox Width="42" MaxLength="4" Text="{Binding Model.BirthYear, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="元号年" />
            <Label Content="年" />
            <TextBox Width="30" MaxLength="2" Text="{Binding Model.BirthMonth, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="生年月日月" />
            <Label Content="月" />
            <TextBox Width="30" MaxLength="2" Text="{Binding Model.BirthDay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="生年月日日" />
            <Label Content="日" />
          </WrapPanel>
          <Label Grid.Row="1" Grid.Column="4">
            <TextBlock Text="性別 ※（未回答可）" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Label>
          <ComboBox ItemsSource="{Binding Genders}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.GenderCode, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="性別" Grid.Row="1" Grid.Column="5" />
        </Grid>
      </GroupBox>
      <Grid x:Name="EditorColumns">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <UserControl Grid.Column="0" VerticalAlignment="Top">
          <StackPanel>
            <GroupBox Header="住所・連絡先">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="郵便番号 ※ 入力10／保存7桁" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.PostalCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="20" AutomationProperties.Name="郵便番号" Grid.Row="0" Grid.Column="1" />
                <Label Grid.Row="1" Grid.Column="0">
                  <TextBlock Text="都道府県 ※" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <ComboBox ItemsSource="{Binding Prefectures}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.PrefectureCode, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="都道府県" Grid.Row="1" Grid.Column="1" />
                <Label Grid.Row="2" Grid.Column="0">
                  <TextBlock Text="住所1 ※ 45文字" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.AddressLine1, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="90" AutomationProperties.Name="住所1" Grid.Row="2" Grid.Column="1" />
                <Label Grid.Row="3" Grid.Column="0">
                  <TextBlock Text="住所2 45文字" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.AddressLine2, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="90" AutomationProperties.Name="住所2" Grid.Row="3" Grid.Column="1" />
                <Label Grid.Row="4" Grid.Column="0">
                  <TextBlock Text="本人電話 入力20文字" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="40" AutomationProperties.Name="本人電話" Grid.Row="4" Grid.Column="1" />
                <Label Grid.Row="5" Grid.Column="0">
                  <TextBlock Text="本人メール 60文字" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.EmailAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="120" AutomationProperties.Name="本人メール" Grid.Row="5" Grid.Column="1" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </UserControl>
        <UserControl Grid.Column="1" VerticalAlignment="Top">
          <StackPanel>
            <GroupBox Header="在籍・所属">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="入学日 ※ yyyy-MM-dd" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.AdmissionDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="10" AutomationProperties.Name="入学日" Grid.Row="0" Grid.Column="1" />
                <Label Grid.Row="1" Grid.Column="0">
                  <TextBlock Text="在籍区分 ※" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <ComboBox ItemsSource="{Binding Statuses}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.EnrollmentStatusCode, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="在籍区分" Grid.Row="1" Grid.Column="1" />
                <Label Grid.Row="2" Grid.Column="0">
                  <TextBlock Text="卒業・退学日 yyyy-MM-dd（03/04は必須）" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.EnrollmentEndDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="10" AutomationProperties.Name="卒業・退学日" Grid.Row="2" Grid.Column="1" />
                <Label Grid.Row="3" Grid.Column="0">
                  <TextBlock Text="選択補助：年度" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.SchoolYear, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="4" AutomationProperties.Name="年度" Grid.Row="3" Grid.Column="1" />
                <Label Grid.Row="4" Grid.Column="0">
                  <TextBlock Text="選択補助：学年" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <ComboBox ItemsSource="{Binding Grades}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.GradeCode}" AutomationProperties.Name="学年" Grid.Row="4" Grid.Column="1" />
                <Label Grid.Row="5" Grid.Column="0">
                  <TextBlock Text="クラス（01/02は必須）" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <ComboBox ItemsSource="{Binding Classes}" SelectedValuePath="Value" SelectedValue="{Binding Model.ClassId, ValidatesOnNotifyDataErrors=True}" SelectionChanged="ClassChanged" AutomationProperties.Name="クラス" Grid.Row="5" Grid.Column="1" />
                <Label Grid.Row="6" Grid.Column="0" Content="所属人数・定員" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OccupancyText}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="所属人数・定員" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </UserControl>
        <UserControl Grid.Column="2" VerticalAlignment="Top">
          <StackPanel>
            <GroupBox Header="緊急連絡先・備考・理由">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                  <RowDefinition Height="Auto" MinHeight="38" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="緊急連絡先氏名 8文字" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.EmergencyContactName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="16" AutomationProperties.Name="緊急連絡先氏名" Grid.Row="0" Grid.Column="1" />
                <Label Grid.Row="1" Grid.Column="0">
                  <TextBlock Text="続柄" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <ComboBox ItemsSource="{Binding Relationships}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.RelationshipCode, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="続柄" Grid.Row="1" Grid.Column="1" />
                <Label Grid.Row="2" Grid.Column="0">
                  <TextBlock Text="緊急電話 入力20文字" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Label>
                <TextBox Text="{Binding Model.EmergencyPhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="40" AutomationProperties.Name="緊急電話" Grid.Row="2" Grid.Column="1" />
                <Label Grid.Row="3" Grid.Column="0" Content="備考 120文字" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Model.Remarks, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="240" AcceptsReturn="True" TextWrapping="Wrap" Height="52" AutomationProperties.Name="備考" VerticalScrollBarVisibility="Auto" />
                <Label Grid.Row="4" Grid.Column="0"><TextBlock Text="確認・変更理由 60文字（条件付）" TextWrapping="Wrap" /></Label>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Model.OperationReason, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="120" AcceptsReturn="True" Height="52" AutomationProperties.Name="確認・変更理由" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </UserControl>
      </Grid>
      <TextBlock Text="{Binding UpdatedInfo}" Margin="4" />
      <WrapPanel Margin="0,4,0,0">
        <Button Content="登録／更新" Command="{Binding SaveCommand}" Background="#22658F" BorderBrush="#22658F" Foreground="White" FontWeight="SemiBold" />
        <Button Content="入力クリア／編集取消" Command="{Binding ResetCommand}" />
        <Button Content="最新情報を再読込" Command="{Binding ReloadCommand}" />
        <Button Content="検索へ戻る" Command="{Binding BackCommand}" />
        <Button Content="論理削除" Command="{Binding DeleteCommand}" BorderBrush="#B35460" Foreground="#A32B3C" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
