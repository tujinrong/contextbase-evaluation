<Window x:Class="StudentManagement.Wpf.Views.StudentEditView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="1100" Height="900" MinWidth="900" MinHeight="650">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"/><TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="65" Foreground="#8B2835"/><TextBlock Text="{Binding UpdatedInfo}"/></StackPanel>
  <WrapPanel DockPanel.Dock="Bottom"><Button Content="登録／更新" Command="{Binding SaveCommand}"/><Button Content="入力クリア／編集取消" Command="{Binding ResetCommand}"/><Button Content="最新情報を再読込" Command="{Binding ReloadCommand}"/><Button Content="論理削除" Command="{Binding DeleteCommand}"/><Button Content="検索へ戻る" Command="{Binding BackCommand}"/></WrapPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <GroupBox Header="基本情報"><UniformGrid Columns="2" IsEnabled="{Binding CanEdit}">
    <Label Content="学籍番号 ※ 15文字（新規だけ）"/><TextBox IsEnabled="{Binding CanEditNumber}" Text="{Binding Model.StudentNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="30" AutomationProperties.Name="学籍番号"/>
    <Label Content="氏名 ※ 8文字"/><TextBox Text="{Binding Model.StudentName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="16" AutomationProperties.Name="氏名"/>
    <Label Content="氏名カナ ※ 入力36／保存18文字"/><TextBox Text="{Binding Model.StudentNameKana, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="72" AutomationProperties.Name="氏名カナ"/>
    <Label Content="生年月日 ※ 和暦4入力"/><WrapPanel>
     <ComboBox Width="90" ItemsSource="{Binding Eras}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.BirthEra, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="元号"/>
     <TextBox Width="70" MaxLength="4" Text="{Binding Model.BirthYear, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="元号年"/><Label Content="年"/>
     <TextBox Width="45" MaxLength="2" Text="{Binding Model.BirthMonth, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="生年月日月"/><Label Content="月"/>
     <TextBox Width="45" MaxLength="2" Text="{Binding Model.BirthDay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="生年月日日"/><Label Content="日"/>
    </WrapPanel>
    <Label Content="性別 ※（未回答可）"/><ComboBox ItemsSource="{Binding Genders}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.GenderCode, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="性別"/>
   </UniformGrid></GroupBox>
   <GroupBox Header="住所・連絡先"><UniformGrid Columns="2" IsEnabled="{Binding CanEdit}">
    <Label Content="郵便番号 ※ 入力10／保存7桁"/><TextBox Text="{Binding Model.PostalCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="20" AutomationProperties.Name="郵便番号"/>
    <Label Content="都道府県 ※"/><ComboBox ItemsSource="{Binding Prefectures}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.PrefectureCode, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="都道府県"/>
    <Label Content="住所1 ※ 45文字"/><TextBox Text="{Binding Model.AddressLine1, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="90" AutomationProperties.Name="住所1"/>
    <Label Content="住所2 45文字"/><TextBox Text="{Binding Model.AddressLine2, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="90" AutomationProperties.Name="住所2"/>
    <Label Content="本人電話 入力20文字"/><TextBox Text="{Binding Model.PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="40" AutomationProperties.Name="本人電話"/>
    <Label Content="本人メール 60文字"/><TextBox Text="{Binding Model.EmailAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="120" AutomationProperties.Name="本人メール"/>
   </UniformGrid></GroupBox>
   <GroupBox Header="在籍・所属"><UniformGrid Columns="2" IsEnabled="{Binding CanEdit}">
    <Label Content="入学日 ※ yyyy-MM-dd"/><TextBox Text="{Binding Model.AdmissionDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="10" AutomationProperties.Name="入学日"/>
    <Label Content="在籍区分 ※"/><ComboBox ItemsSource="{Binding Statuses}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.EnrollmentStatusCode, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="在籍区分"/>
    <Label Content="卒業・退学日 yyyy-MM-dd（03/04は必須）"/><TextBox Text="{Binding Model.EnrollmentEndDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="10" AutomationProperties.Name="卒業・退学日"/>
    <Label Content="選択補助：年度"/><TextBox Text="{Binding Model.SchoolYear, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="4" AutomationProperties.Name="年度"/>
    <Label Content="選択補助：学年"/><ComboBox ItemsSource="{Binding Grades}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.GradeCode}" AutomationProperties.Name="学年"/>
    <Label Content="クラス（01/02は必須）"/><ComboBox ItemsSource="{Binding Classes}" SelectedValuePath="Value" SelectedValue="{Binding Model.ClassId, ValidatesOnNotifyDataErrors=True}" SelectionChanged="ClassChanged" AutomationProperties.Name="クラス"/>
   </UniformGrid></GroupBox>
   <GroupBox Header="緊急連絡先（3項目一式）"><UniformGrid Columns="2" IsEnabled="{Binding CanEdit}">
    <Label Content="緊急連絡先氏名 8文字"/><TextBox Text="{Binding Model.EmergencyContactName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="16" AutomationProperties.Name="緊急連絡先氏名"/>
    <Label Content="続柄"/><ComboBox ItemsSource="{Binding Relationships}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Model.RelationshipCode, ValidatesOnNotifyDataErrors=True}" AutomationProperties.Name="続柄"/>
    <Label Content="緊急電話 入力20文字"/><TextBox Text="{Binding Model.EmergencyPhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="40" AutomationProperties.Name="緊急電話"/>
   </UniformGrid></GroupBox>
   <Label Content="備考 120文字"/><TextBox Text="{Binding Model.Remarks, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="240" AcceptsReturn="True" TextWrapping="Wrap" Height="80" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="備考"/>
   <Label Content="確認・変更理由 60文字（警告続行・終了区分訂正時）"/><TextBox Text="{Binding Model.OperationReason, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MaxLength="120" AcceptsReturn="True" Height="60" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="確認・変更理由"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
