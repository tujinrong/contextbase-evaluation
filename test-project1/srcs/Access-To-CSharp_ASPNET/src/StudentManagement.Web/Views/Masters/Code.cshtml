@model CodeEditorViewModel
@{ ViewData["Title"] = Model.ExpectedVersion.HasValue ? "コード編集" : "コード追加"; }
<h1>@ViewData["Title"]</h1>
@if (Model.IsProtected) { <p class="muted">このコードは保護対象です。停止や有効期間の縮小には制約があります。</p> }
<form method="post" asp-action="Code" data-track-changes="true">
    <input asp-for="ExpectedVersion" type="hidden" />
    <div asp-validation-summary="All"></div>
    <div class="panel form-grid">
        <div class="field"><label asp-for="CategoryId">分類 *</label><div class="field-value">
        @if (Model.ExpectedVersion.HasValue) { <input asp-for="CategoryId" readonly /> }
        else { <select asp-for="CategoryId" asp-items="Model.Categories"><option value="">選択</option></select> }
        </div></div>
        <div class="field"><label asp-for="CodeValue">コード *</label><div class="field-value"><input asp-for="CodeValue" readonly="@Model.ExpectedVersion.HasValue" /></div></div>
        <div class="field"><label asp-for="Input.CodeName">名称 *</label><div class="field-value"><input asp-for="Input.CodeName" /></div></div>
        <div class="field"><label asp-for="Input.DisplayOrder">表示順</label><div class="field-value"><input asp-for="Input.DisplayOrder" inputmode="numeric" /></div></div>
        <div class="field"><label asp-for="Input.ValidFrom">利用開始日 *</label><div class="field-value date-value"><input asp-for="Input.ValidFrom" type="date" data-japanese-date aria-describedby="ValidFrom-hint" /><small id="ValidFrom-hint" data-japanese-date-for="Input_ValidFrom" aria-live="polite">@(DateOnly.TryParse(Model.Input.ValidFrom, out _) ? JapaneseDate.FormatBirthDate(Model.Input.ValidFrom!) : "日付を選択")</small></div></div>
        <div class="field"><label asp-for="Input.ValidTo">利用終了日</label><div class="field-value date-value"><input asp-for="Input.ValidTo" type="date" data-japanese-date aria-describedby="ValidTo-hint" /><small id="ValidTo-hint" data-japanese-date-for="Input_ValidTo" aria-live="polite">@(DateOnly.TryParse(Model.Input.ValidTo, out _) ? JapaneseDate.FormatBirthDate(Model.Input.ValidTo!) : "未設定")</small></div></div>
        <div class="field"><span class="field-label" id="active-label">状態</span><div class="field-value"><label class="inline" aria-labelledby="active-label"><input asp-for="Input.IsActive" />有効</label></div></div>
        <div class="field full"><label asp-for="Input.Remarks">備考</label><div class="field-value"><textarea asp-for="Input.Remarks" rows="2"></textarea></div></div>
    </div>
    <div class="actions"><button type="submit" class="primary">保存</button><a class="button" asp-action="Index" data-discard-confirm>戻る</a></div>
</form>
