    COMPUTE T-ID = 4000 + L * 20 + 2
    COMPUTE T-ROW = BASE-ROW + 0 MOVE 5 TO T-COL
    MOVE 15 TO T-WIDTH MOVE 8 TO T-FLAGS
    MOVE ROW-VALUE(ROW-INDEX,2) TO T-VALUE
    PERFORM ADD-VALUE
    COMPUTE T-ID = 4000 + L * 20 + 3
    COMPUTE T-ROW = BASE-ROW + 0 MOVE 22 TO T-COL
    MOVE 16 TO T-WIDTH MOVE 8 TO T-FLAGS
    MOVE ROW-VALUE(ROW-INDEX,3) TO T-VALUE
    PERFORM ADD-VALUE
    COMPUTE T-ID = 4000 + L * 20 + 5
    COMPUTE T-ROW = BASE-ROW + 0 MOVE 40 TO T-COL
    MOVE 22 TO T-WIDTH MOVE 8 TO T-FLAGS
    MOVE ROW-VALUE(ROW-INDEX,5) TO T-VALUE
    MOVE ROW-DATA(ROW-INDEX,5)(1:10) TO DATE-OUT
    CALL "STDATEOUT" USING DATE-OUT ERA-SCRATCH YEAR-SCRATCH
      MONTH-SCRATCH DAY-SCRATCH WAREKI-OUT WAREKI-LENGTH RETURNING RC END-CALL
    IF RC = 0 MOVE WAREKI-OUT TO T-DATA MOVE WAREKI-LENGTH TO T-LENGTH END-IF
    PERFORM ADD-VALUE
    COMPUTE T-ID = 4000 + L * 20 + 6
    COMPUTE T-ROW = BASE-ROW + 0 MOVE 64 TO T-COL
    MOVE 30 TO T-WIDTH MOVE 8 TO T-FLAGS
    MOVE ROW-VALUE(ROW-INDEX,6) TO T-VALUE
    INITIALIZE T-VALUE
    STRING FUNCTION TRIM(ROW-DATA(ROW-INDEX,6)) " "
      FUNCTION TRIM(ROW-DATA(ROW-INDEX,7)) INTO T-DATA END-STRING
    PERFORM TEXT-VALUE
    PERFORM ADD-VALUE
    COMPUTE T-ID = 4000 + L * 20 + 4
    COMPUTE T-ROW = BASE-ROW + 1 MOVE 11 TO T-COL
    MOVE 36 TO T-WIDTH MOVE 8 TO T-FLAGS
    MOVE ROW-VALUE(ROW-INDEX,4) TO T-VALUE
    PERFORM ADD-VALUE
    COMPUTE T-ID = 4000 + L * 20 + 8
    COMPUTE T-ROW = BASE-ROW + 1 MOVE 58 TO T-COL
    MOVE 48 TO T-WIDTH MOVE 8 TO T-FLAGS
    MOVE ROW-VALUE(ROW-INDEX,8) TO T-VALUE
    INITIALIZE T-VALUE
    STRING FUNCTION TRIM(ROW-DATA(ROW-INDEX,8)) " "
      FUNCTION TRIM(ROW-DATA(ROW-INDEX,9)) INTO T-DATA END-STRING
    PERFORM TEXT-VALUE
    PERFORM ADD-VALUE
    COMPUTE T-ID = 4000 + L * 20 + 10
    COMPUTE T-ROW = BASE-ROW + 1 MOVE 108 TO T-COL
    MOVE 24 TO T-WIDTH MOVE 8 TO T-FLAGS
    MOVE ROW-VALUE(ROW-INDEX,10) TO T-VALUE
    PERFORM ADD-VALUE
    .
PICK-PANEL.
    MOVE 1100 TO T-ID MOVE 4 TO T-ROW MOVE 1 TO T-COL MOVE 40 TO T-WIDTH
    MOVE 0 TO T-FLAGS INITIALIZE T-VALUE MOVE T-PICK-TOTAL TO NUM-OUT
    STRING "候補件数:" FUNCTION TRIM(NUM-OUT) " 選択番号:" INTO T-DATA END-STRING
    PERFORM TEXT-VALUE PERFORM ADD-VALUE
    MOVE 9001 TO T-ID MOVE 43 TO T-COL MOVE 2 TO T-WIDTH T-MAX
    MOVE 1 TO T-FLAGS MOVE T-SPECIAL(1) TO T-VALUE PERFORM ADD-VALUE
    PERFORM VARYING L FROM 1 BY 1 UNTIL L > T-PICK-COUNT
      COMPUTE T-ID = 5000 + L COMPUTE T-ROW = 5 + L * 2
      MOVE 1 TO T-COL MOVE 132 TO T-WIDTH MOVE 8 TO T-FLAGS
      MOVE T-PICK-LABEL(L) TO T-VALUE PERFORM ADD-VALUE
      ADD 1 TO T-ROW ADD 10 TO T-ID
      MOVE T-PICK-VALUE(L) TO T-VALUE PERFORM ADD-VALUE
    END-PERFORM
    MOVE 1124 TO T-ID MOVE 24 TO T-ROW MOVE 1 TO T-COL MOVE 132 TO T-WIDTH
    MOVE 0 TO T-FLAGS
    MOVE "Enter 選択検査 / 00 未選択 / PgUp,PgDn 候補窓 / F8 全文 / F12 取消"
      TO T-DATA PERFORM TEXT-VALUE PERFORM ADD-VALUE.
CONFIRM-PANEL.
    MOVE 1204 TO T-ID MOVE 4 TO T-ROW MOVE 1 TO T-COL MOVE 132 TO T-WIDTH
    MOVE 2 TO T-FLAGS INITIALIZE T-VALUE
    STRING "確認目的: " FUNCTION TRIM(EDITOR-PENDING) INTO T-DATA END-STRING
    PERFORM TEXT-VALUE PERFORM ADD-VALUE
    IF EDITOR-PENDING = "DUPLICATE"
      MOVE 1205 TO T-ID MOVE 5 TO T-ROW MOVE 0 TO T-FLAGS
      MOVE DUP-COUNT TO NUM-OUT
      MOVE "重複全候補件数: " TO T-DATA
      STRING "重複全候補件数: " FUNCTION TRIM(NUM-OUT) INTO T-DATA END-STRING
      PERFORM TEXT-VALUE PERFORM ADD-VALUE
      COMPUTE FIRST-ROW = (T-MODAL-WINDOW - 1) * 6 + 1
      PERFORM VARYING L FROM 1 BY 1 UNTIL L > 6
        COMPUTE ROW-INDEX = FIRST-ROW + L - 1
        IF ROW-INDEX <= DUP-COUNT AND ROW-INDEX <= 20
          COMPUTE T-ID = 6000 + L COMPUTE T-ROW = 5 + L * 2
          MOVE 1 TO T-COL MOVE 132 TO T-WIDTH MOVE 8 TO T-FLAGS
          INITIALIZE T-VALUE
          MOVE ROW-DATA(ROW-INDEX,5)(1:10) TO DATE-OUT
          CALL "STDATEOUT" USING DATE-OUT ERA-SCRATCH YEAR-SCRATCH
      MONTH-SCRATCH DAY-SCRATCH WAREKI-OUT WAREKI-LENGTH RETURNING RC END-CALL
          STRING FUNCTION TRIM(ROW-DATA(ROW-INDEX,3)) " "
            FUNCTION TRIM(ROW-DATA(ROW-INDEX,4)) " "
            WAREKI-OUT(1:WAREKI-LENGTH) INTO T-DATA END-STRING
          PERFORM TEXT-VALUE PERFORM ADD-VALUE
          ADD 1 TO T-ROW ADD 10 TO T-ID
          MOVE ROW-VALUE(ROW-INDEX,6) TO T-VALUE PERFORM ADD-VALUE
        END-IF
      END-PERFORM
      MOVE 28 TO T-ID MOVE 20 TO T-ROW MOVE 14 TO T-COL
      MOVE 100 TO T-WIDTH MOVE 60 TO T-MAX
      MOVE "別人確認理由" TO T-FIELD-LABEL(28) PERFORM RAW-FIELD
    END-IF
    IF EDITOR-PENDING = "DELETE"
      MOVE 36 TO T-ID MOVE 10 TO T-ROW MOVE 14 TO T-COL
      MOVE 100 TO T-WIDTH MOVE 60 TO T-MAX
      MOVE "削除理由" TO T-FIELD-LABEL(36) PERFORM RAW-FIELD
    END-IF
    MOVE 1222 TO T-ID MOVE 22 TO T-ROW MOVE 1 TO T-COL MOVE 10 TO T-WIDTH
    MOVE 0 TO T-FLAGS MOVE "続行Y/N:" TO T-DATA PERFORM TEXT-VALUE PERFORM ADD-VALUE
    MOVE 9002 TO T-ID MOVE 14 TO T-COL MOVE 1 TO T-WIDTH T-MAX T-FLAGS
    MOVE T-SPECIAL(2) TO T-VALUE PERFORM ADD-VALUE
    MOVE 1224 TO T-ID MOVE 24 TO T-ROW MOVE 1 TO T-COL MOVE 132 TO T-WIDTH
    MOVE 0 TO T-FLAGS
    MOVE "N/取消が既定。明示Y + 新しいF5だけ続行 / Enterは保存しません / F12取消"
      TO T-DATA PERFORM TEXT-VALUE PERFORM ADD-VALUE.
ERROR-PANEL.
    MOVE 1304 TO T-ID MOVE 4 TO T-ROW MOVE 1 TO T-COL MOVE 40 TO T-WIDTH
    MOVE 2 TO T-FLAGS MOVE "エラー一覧 / 選択番号:" TO T-DATA
    PERFORM TEXT-VALUE PERFORM ADD-VALUE
    MOVE 9001 TO T-ID MOVE 43 TO T-COL MOVE 2 TO T-WIDTH T-MAX
    MOVE 1 TO T-FLAGS MOVE T-SPECIAL(1) TO T-VALUE PERFORM ADD-VALUE
    COMPUTE FIRST-ROW = (T-MODAL-WINDOW - 1) * 6 + 1
    PERFORM VARYING L FROM 1 BY 1 UNTIL L > 6
      COMPUTE ROW-INDEX = FIRST-ROW + L - 1
      IF ROW-INDEX <= T-ERROR-COUNT
        COMPUTE T-ID = 7000 + L COMPUTE T-ROW = 5 + L * 2
        MOVE 1 TO T-COL MOVE 132 TO T-WIDTH MOVE 12 TO T-FLAGS
        MOVE T-ERROR-VALUE(ROW-INDEX) TO T-VALUE PERFORM ADD-VALUE
      END-IF
    END-PERFORM
    MOVE 1324 TO T-ID MOVE 24 TO T-ROW MOVE 1 TO T-COL MOVE 132 TO T-WIDTH
    MOVE 0 TO T-FLAGS
    MOVE "番号+Enterで不正項目へ / PgUp,PgDn 一覧移動 / F8 全文 / F12 原入力へ"
      TO T-DATA PERFORM TEXT-VALUE PERFORM ADD-VALUE.
HELP-PANEL.
    MOVE 1404 TO T-ID MOVE 4 TO T-ROW MOVE 1 TO T-COL MOVE 132 TO T-WIDTH
    MOVE 8 TO T-FLAGS INITIALIZE T-VALUE
    IF T-RETURN-FOCUS >= 1 AND <= 64
      STRING FUNCTION TRIM(T-FIELD-LABEL(T-RETURN-FOCUS))
        " / 原入力の長さと表示幅は別。F8全文で確認。保存前に業務検査を行います。"
        INTO T-DATA END-STRING
    ELSE MOVE "操作説明: Enterは保存せず、F5が明示操作。補助はF12取消。" TO T-DATA END-IF
    PERFORM TEXT-VALUE PERFORM ADD-VALUE
    MOVE 1424 TO T-ID MOVE 24 TO T-ROW MOVE 1 TO T-COL MOVE 132 TO T-WIDTH
    MOVE 0 TO T-FLAGS MOVE "F12で元のパネルへ戻ります。" TO T-DATA
    PERFORM TEXT-VALUE PERFORM ADD-VALUE.
BUILD-ERRORS.
    IF APP-ERRORS-LENGTH <= 1 EXIT PARAGRAPH END-IF
    MOVE 0 TO T-ERROR-COUNT MOVE 1 TO ERROR-START
    PERFORM VARYING ERROR-POS FROM 1 BY 1
      UNTIL ERROR-POS >= APP-ERRORS-LENGTH OR T-ERROR-COUNT >= 64
      IF APP-ERRORS(ERROR-POS:1) = X"0A"
        ADD 1 TO T-ERROR-COUNT INITIALIZE T-ERROR-VALUE(T-ERROR-COUNT)
        COMPUTE T-ERROR-LENGTH(T-ERROR-COUNT) = FUNCTION MIN(1024, ERROR-POS - ERROR-START)
        MOVE APP-ERRORS(ERROR-START:T-ERROR-LENGTH(T-ERROR-COUNT))
          TO T-ERROR-DATA(T-ERROR-COUNT)
        MOVE 0 TO T-ERROR-FIELD(T-ERROR-COUNT)
        PERFORM MAP-ERROR
        COMPUTE ERROR-START = ERROR-POS + 1
      END-IF
    END-PERFORM.
MAP-ERROR.
    MOVE T-ERROR-DATA(T-ERROR-COUNT) TO ERROR-TEXT
    IF VIEW-MODE = "Search"
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目1", "#") NOT = ERROR-TEXT
        MOVE 4 TO T-ERROR-FIELD(T-ERROR-COUNT) END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目2", "#") NOT = ERROR-TEXT
        MOVE 5 TO T-ERROR-FIELD(T-ERROR-COUNT) END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目6", "#") NOT = ERROR-TEXT
        MOVE 21 TO T-ERROR-FIELD(T-ERROR-COUNT) END-IF
    ELSE
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目19の", "#", "項目19を", "#") NOT = ERROR-TEXT
        MOVE 25 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目18の", "#", "項目18を", "#") NOT = ERROR-TEXT
        MOVE 24 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目17の", "#", "項目17を", "#") NOT = ERROR-TEXT
        MOVE 23 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目16の", "#", "項目16を", "#") NOT = ERROR-TEXT
        MOVE 22 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目15の", "#", "項目15を", "#") NOT = ERROR-TEXT
        MOVE 21 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目14の", "#", "項目14を", "#") NOT = ERROR-TEXT
        MOVE 20 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目13の", "#", "項目13を", "#") NOT = ERROR-TEXT
        MOVE 19 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目12の", "#", "項目12を", "#") NOT = ERROR-TEXT
        MOVE 18 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目11の", "#", "項目11を", "#") NOT = ERROR-TEXT
        MOVE 17 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目10の", "#", "項目10を", "#") NOT = ERROR-TEXT
        MOVE 16 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目9の", "#", "項目9を", "#") NOT = ERROR-TEXT
        MOVE 15 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目8の", "#", "項目8を", "#") NOT = ERROR-TEXT
        MOVE 14 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目7の", "#", "項目7を", "#") NOT = ERROR-TEXT
        MOVE 13 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目6の", "#", "項目6を", "#") NOT = ERROR-TEXT
        MOVE 12 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目5の", "#", "項目5を", "#") NOT = ERROR-TEXT
        MOVE 11 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目4の", "#", "項目4を", "#") NOT = ERROR-TEXT
        MOVE 7 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目3の", "#", "項目3を", "#") NOT = ERROR-TEXT
        MOVE 6 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目2の", "#", "項目2を", "#") NOT = ERROR-TEXT
        MOVE 5 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      IF FUNCTION SUBSTITUTE(ERROR-TEXT, "項目1の", "#", "項目1を", "#") NOT = ERROR-TEXT
        MOVE 4 TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PARAGRAPH END-IF
      PERFORM VARYING J FROM 1 BY 1 UNTIL J > 64
        IF T-FIELD-LABEL(J) NOT = SPACES AND LOW-VALUES AND
          FUNCTION SUBSTITUTE(ERROR-TEXT, FUNCTION TRIM(T-FIELD-LABEL(J)), "#") NOT = ERROR-TEXT
          MOVE J TO T-ERROR-FIELD(T-ERROR-COUNT) EXIT PERFORM END-IF
      END-PERFORM
      IF ERROR-TEXT(1:7) = "E-DATE-" MOVE 7 TO T-ERROR-FIELD(T-ERROR-COUNT) END-IF
    END-IF.

copy "ST-HELPERS.cpy".
end program STRENDER.
