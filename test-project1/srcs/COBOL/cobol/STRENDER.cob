      WHEN "PICK" PERFORM PICK-PANEL
      WHEN "ERROR" PERFORM ERROR-PANEL
      WHEN "HELP" PERFORM HELP-PANEL
      WHEN "CONFIRM" PERFORM CONFIRM-PANEL
