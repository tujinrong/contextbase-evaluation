       >>SOURCE FORMAT FREE
identification division.
program-id. STDATE.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".

procedure division.
    MOVE 0 TO ERA-OFFSET
    EVALUATE FUNCTION TRIM(R-DATA(F-BIRTHERA))
      WHEN "MEIJI" MOVE 1867 TO ERA-OFFSET
        MOVE "1900-01-01" TO ERA-START MOVE "1912-07-29" TO ERA-END
      WHEN "TAISHO" MOVE 1911 TO ERA-OFFSET
        MOVE "1912-07-30" TO ERA-START MOVE "1926-12-24" TO ERA-END
      WHEN "SHOWA" MOVE 1925 TO ERA-OFFSET
        MOVE "1926-12-25" TO ERA-START MOVE "1989-01-07" TO ERA-END
      WHEN "HEISEI" MOVE 1988 TO ERA-OFFSET
        MOVE "1989-01-08" TO ERA-START MOVE "2019-04-30" TO ERA-END
      WHEN "REIWA" MOVE 2018 TO ERA-OFFSET
        MOVE "2019-05-01" TO ERA-START MOVE BUSINESS-DAY TO ERA-END
    END-EVALUATE
    IF ERA-OFFSET = 0 PERFORM DATE-ERROR GOBACK END-IF
    MOVE 0 TO YEAR-N MONTH-N DAY-N
    MOVE F-BIRTHYEAR TO I
    CALL "STUNICODE" USING BY VALUE 5 BY REFERENCE R-VALUE(I)
      TMP-VALUE BY VALUE 4 4 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM DATE-ERROR GOBACK END-IF
    IF TMP-DATA(1:3) = "元" MOVE 1 TO YEAR-N
    ELSE
      CALL "STINTEGER" USING TMP-VALUE V RETURNING RC END-CALL
      IF RC NOT = 0 OR V < 1 OR V > 9999
        PERFORM DATE-ERROR GOBACK END-IF
      MOVE V TO YEAR-N
    END-IF
    ADD ERA-OFFSET TO YEAR-N
    PERFORM VARYING I FROM F-BIRTHMONTH BY 1 UNTIL I > F-BIRTHDAY
      CALL "STUNICODE" USING BY VALUE 5 BY REFERENCE R-VALUE(I)
        TMP-VALUE BY VALUE 2 2 RETURNING RC END-CALL
      IF RC NOT = 0 PERFORM DATE-ERROR GOBACK END-IF
      CALL "STINTEGER" USING TMP-VALUE V RETURNING RC END-CALL
      IF RC NOT = 0 PERFORM DATE-ERROR GOBACK END-IF
      IF I = F-BIRTHMONTH MOVE V TO MONTH-N ELSE MOVE V TO DAY-N END-IF
    END-PERFORM
    PERFORM REAL-DATE
    IF RC NOT = 0 OR DATE-OUT < ERA-START OR DATE-OUT > ERA-END
      OR DATE-OUT > BUSINESS-DAY
      PERFORM DATE-ERROR GOBACK
    END-IF
    MOVE DATE-OUT TO N-DATA(4) MOVE 10 TO N-LENGTH(4)
    MOVE 0 TO N-NULL(4)
    GOBACK.
DATE-ERROR.
    MOVE "E-DATE-001: 生年月日の元号・年・月・日を確認してください。"
      TO ERROR-TEXT PERFORM ADD-ERROR.
REAL-DATE.
    MOVE 0 TO RC
    IF YEAR-N < 1900 OR YEAR-N > 9999 OR MONTH-N < 1 OR MONTH-N > 12
      MOVE -1 TO RC EXIT PARAGRAPH END-IF
    MOVE 31 TO MONTH-DAYS
    IF MONTH-N = 4 OR 6 OR 9 OR 11 MOVE 30 TO MONTH-DAYS END-IF
    IF MONTH-N = 2
      MOVE 28 TO MONTH-DAYS
      IF FUNCTION MOD(YEAR-N,400) = 0 OR
        (FUNCTION MOD(YEAR-N,4) = 0 AND FUNCTION MOD(YEAR-N,100) NOT = 0)
        MOVE 29 TO MONTH-DAYS
      END-IF
    END-IF
    IF DAY-N < 1 OR DAY-N > MONTH-DAYS MOVE -1 TO RC EXIT PARAGRAPH END-IF
    MOVE YEAR-N TO YEAR-OUT MOVE MONTH-N TO MONTH-OUT MOVE DAY-N TO DAY-OUT
    STRING YEAR-OUT "-" MONTH-OUT "-" DAY-OUT INTO DATE-OUT END-STRING.

copy "ST-HELPERS.cpy".
end program STDATE.
