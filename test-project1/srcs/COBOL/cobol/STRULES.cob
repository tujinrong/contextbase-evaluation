       >>SOURCE FORMAT FREE
identification division.
program-id. STRULES.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".

procedure division.
    MOVE 0 TO OLD-SEAT NEW-SEAT
    IF O-NULL(15) = 0 AND (O-DATA(13)(1:2) = "01" OR "02")
      MOVE 1 TO OLD-SEAT END-IF
    IF N-NULL(15) = 0 AND (N-DATA(13)(1:2) = "01" OR "02")
      MOVE 1 TO NEW-SEAT END-IF
    IF STUDENT-ID > 0
      IF O-DATA(1) NOT = N-DATA(1) OR O-LENGTH(1) NOT = N-LENGTH(1)
        MOVE "E-STU-104: 学籍番号は変更できません。" TO ERROR-TEXT
        PERFORM ADD-ERROR
      END-IF
      IF (O-DATA(13)(1:2) = "03" OR "04") AND
        O-DATA(13) NOT = N-DATA(13) AND (ROLE-CODE NOT = 2 OR N-NULL(22) = -1)
        MOVE 403 TO APP-STATUS MOVE "Forbidden" TO APP-OUTCOME
        MOVE "E-STU-106: 終了区分訂正は管理者と理由が必要です。"
          TO ERROR-TEXT PERFORM ADD-ERROR
      END-IF
    END-IF
    PERFORM VARYING I FROM 5 BY 1 UNTIL I > 17
      EVALUATE I
        WHEN 5 MOVE "GENDER" TO CODE-CATEGORY
        WHEN 7 MOVE "PREFECTURE" TO CODE-CATEGORY
        WHEN 13 MOVE "ENROLLMENT_STATUS" TO CODE-CATEGORY
        WHEN 17 MOVE "RELATIONSHIP" TO CODE-CATEGORY
      END-EVALUATE
      IF (I = 5 OR 7 OR 13 OR 17) AND N-NULL(I) = 0
        MOVE "ST-CODE" TO COMMAND-NAME PERFORM DB-RESET
        INITIALIZE TMP-VALUE MOVE CODE-CATEGORY TO TMP-DATA
        COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(CODE-CATEGORY))
        MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP
        MOVE I TO PARAM-FIELD PERFORM ADD-NORMAL
        PERFORM DB-EXECUTE
        IF RC NOT = 0 GOBACK END-IF
        CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
        IF RC NOT = 1
          MOVE "E-STU-009: 指定コードが存在しません。" TO ERROR-TEXT
          PERFORM ADD-ERROR
        ELSE
          IF STUDENT-ID = 0 OR N-VALUE(I) NOT = O-VALUE(I)
            MOVE 1 TO K PERFORM FETCH-TEMP
            IF TMP-DATA(1:1) NOT = "1" PERFORM INACTIVE-CODE END-IF
            MOVE 2 TO K PERFORM FETCH-TEMP
            IF TMP-DATA(1:1) NOT = "1" PERFORM INACTIVE-CODE END-IF
            MOVE 3 TO K PERFORM FETCH-TEMP
            IF TMP-DATA(1:10) > BUSINESS-DAY PERFORM INACTIVE-CODE END-IF
            MOVE 4 TO K PERFORM FETCH-TEMP
            IF TMP-NULL = 0 AND TMP-DATA(1:10) < BUSINESS-DAY
              PERFORM INACTIVE-CODE END-IF
          END-IF
        END-IF
      END-IF
    END-PERFORM
    IF N-NULL(15) = 0
      MOVE "ST-CLASS" TO COMMAND-NAME PERFORM DB-RESET
      MOVE 3 TO PARAM-TYPE MOVE 15 TO PARAM-FIELD PERFORM ADD-NORMAL
      PERFORM DB-EXECUTE IF RC NOT = 0 GOBACK END-IF
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      IF RC NOT = 1
        MOVE "E-STU-010: 指定クラスが存在しません。" TO ERROR-TEXT
        PERFORM ADD-ERROR GOBACK
      END-IF
      MOVE 1 TO K PERFORM FETCH-TEMP
      IF R-NULL(F-SCHOOLYEAR) = 0 AND R-DATA(F-SCHOOLYEAR) NOT = TMP-DATA
        PERFORM CLASS-MISMATCH END-IF
      MOVE 2 TO K PERFORM FETCH-TEMP
      IF R-NULL(F-GRADECODE) = 0 AND R-DATA(F-GRADECODE) NOT = TMP-DATA
        PERFORM CLASS-MISMATCH END-IF
      MOVE 3 TO K PERFORM FETCH-TEMP MOVE TMP-DATA TO ERA-START
      MOVE 4 TO K PERFORM FETCH-TEMP MOVE TMP-DATA TO ERA-END
      MOVE 5 TO K PERFORM FETCH-TEMP
      IF NEW-SEAT = 1 AND (OLD-SEAT = 0 OR N-VALUE(15) NOT = O-VALUE(15))
        AND (TMP-DATA(1:1) NOT = "1" OR BUSINESS-DAY < ERA-START
             OR BUSINESS-DAY > ERA-END)
        MOVE "E-STU-013: 新規所属できないクラスです。" TO ERROR-TEXT
        PERFORM ADD-ERROR
      END-IF
      IF (N-DATA(13)(1:2) = "03" OR "04") AND
        (STUDENT-ID = 0 OR N-VALUE(15) NOT = O-VALUE(15) OR
         N-VALUE(13) NOT = O-VALUE(13) OR N-VALUE(12) NOT = O-VALUE(12)
         OR N-VALUE(14) NOT = O-VALUE(14)) AND
        (N-DATA(12)(1:10) > ERA-END OR N-DATA(14)(1:10) < ERA-START)
        MOVE "E-STU-108: 最終所属の期間が重なりません。" TO ERROR-TEXT
        PERFORM ADD-ERROR
      END-IF
      MOVE 6 TO K PERFORM FETCH-TEMP
      IF TMP-NULL = 0 AND NEW-SEAT = 1 AND
        (OLD-SEAT = 0 OR N-VALUE(15) NOT = O-VALUE(15))
        CALL "STINTEGER" USING TMP-VALUE CAPACITY-N RETURNING RC END-CALL
        MOVE "ST-CAP" TO COMMAND-NAME PERFORM DB-RESET
        MOVE 3 TO PARAM-TYPE MOVE 15 TO PARAM-FIELD PERFORM ADD-NORMAL
        PERFORM ID-PARAMETERS
        PERFORM DB-EXECUTE IF RC NOT = 0 GOBACK END-IF
        CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
        MOVE 1 TO K PERFORM FETCH-TEMP
        CALL "STINTEGER" USING TMP-VALUE V RETURNING RC END-CALL
        IF RC NOT = 0 OR V + 1 > CAPACITY-N
          MOVE "E-STU-102: クラス定員を超えます。" TO ERROR-TEXT
          PERFORM ADD-ERROR
        END-IF
      END-IF
    END-IF
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    GOBACK.
ID-PARAMETERS.
    MOVE STUDENT-ID TO V PERFORM ID-AS-TEMP
    IF STUDENT-ID = 0 MOVE -1 TO TMP-NULL END-IF
    MOVE 3 TO PARAM-TYPE PERFORM ADD-TEMP PERFORM ADD-TEMP.
INACTIVE-CODE.
    MOVE "E-STU-011: 現在使用できないコードです。" TO ERROR-TEXT
    PERFORM ADD-ERROR.
CLASS-MISMATCH.
    MOVE "E-STU-014: 年度・学年・クラスが一致しません。" TO ERROR-TEXT
    PERFORM ADD-ERROR.

copy "ST-HELPERS.cpy".
end program STRULES.
