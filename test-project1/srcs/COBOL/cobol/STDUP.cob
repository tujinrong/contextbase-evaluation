       >>SOURCE FORMAT FREE
identification division.
program-id. STDUP.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".

procedure division.
    MOVE "ST-DUP" TO COMMAND-NAME PERFORM DB-RESET
    MOVE STUDENT-ID TO V PERFORM ID-AS-TEMP
    IF STUDENT-ID = 0 MOVE -1 TO TMP-NULL END-IF
    MOVE 3 TO PARAM-TYPE PERFORM ADD-TEMP
    MOVE 4 TO PARAM-TYPE MOVE 4 TO PARAM-FIELD PERFORM ADD-NORMAL
    MOVE 1 TO PARAM-TYPE MOVE 20 TO PARAM-FIELD PERFORM ADD-NORMAL
    MOVE 21 TO PARAM-FIELD PERFORM ADD-NORMAL
    PERFORM DB-EXECUTE IF RC NOT = 0 GOBACK END-IF
    MOVE 0 TO DUP-COUNT
    CALL "STHASHSTART" RETURNING HASH-HANDLE END-CALL
    IF HASH-HANDLE = NULL MOVE 503 TO APP-STATUS GOBACK END-IF
    PERFORM UNTIL EXIT
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      IF RC = 0 EXIT PERFORM END-IF
      IF RC NOT = 1 MOVE 503 TO APP-STATUS EXIT PERFORM END-IF
      ADD 1 TO DUP-COUNT
      PERFORM VARYING K FROM 1 BY 1 UNTIL K > 6
        PERFORM FETCH-TEMP
        IF K <= 2
          CALL "STHASHADD" USING BY VALUE HASH-HANDLE
            BY REFERENCE TMP-VALUE RETURNING RC END-CALL
          IF RC NOT = 0 MOVE 503 TO APP-STATUS END-IF
        END-IF
        IF DUP-COUNT <= 20 MOVE TMP-VALUE TO ROW-VALUE(DUP-COUNT,K) END-IF
      END-PERFORM
      IF APP-STATUS NOT = 200 EXIT PERFORM END-IF
    END-PERFORM
    CALL "STHASHEND" USING BY VALUE HASH-HANDLE
      BY REFERENCE CONFIRM-CANDIDATE-HASH RETURNING RC END-CALL
    IF RC NOT = 0 MOVE 503 TO APP-STATUS END-IF
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    CALL "STHASHSTART" RETURNING HASH-HANDLE END-CALL
    IF HASH-HANDLE = NULL MOVE 503 TO APP-STATUS GOBACK END-IF
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 21
      CALL "STHASHADD" USING BY VALUE HASH-HANDLE
        BY REFERENCE N-VALUE(I) RETURNING RC END-CALL
      IF RC NOT = 0 MOVE 503 TO APP-STATUS END-IF
    END-PERFORM
    CALL "STHASHADD" USING BY VALUE HASH-HANDLE
      BY REFERENCE N-VALUE(25) RETURNING RC END-CALL
    IF RC NOT = 0 MOVE 503 TO APP-STATUS END-IF
    CALL "STHASHEND" USING BY VALUE HASH-HANDLE
      BY REFERENCE CONFIRM-INPUT-HASH RETURNING RC END-CALL
    MOVE STUDENT-ID TO CONFIRM-TARGET
    MOVE EXPECTED-VERSION TO CONFIRM-VERSION
    MOVE CONFIRM-PAYLOAD TO CONFIRM-CURRENT
    MOVE 0 TO CONFIRMED-DUP
    IF R-NULL(F-CONFIRMATIONTOKEN) = 0
      MOVE R-DATA(F-CONFIRMATIONTOKEN) TO CONFIRM-ID
      MOVE "Confirmation" TO STATE-KIND
      CALL "STSTATEIO" USING BY VALUE DB-HANDLE 5
        BY REFERENCE CONFIRM-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
          CONFIRM-PAYLOAD BY VALUE LENGTH OF CONFIRM-PAYLOAD
        BY REFERENCE CONFIRM-REVISION BY VALUE 10 RETURNING RC END-CALL
      IF RC = 0 AND CONFIRM-CURRENT = CONFIRM-PAYLOAD
        MOVE 1 TO CONFIRMED-DUP
        IF N-NULL(22) = -1
          MOVE "E-STU-107: 重複確認の理由を入力してください。" TO ERROR-TEXT
          PERFORM ADD-ERROR
        END-IF
      END-IF
    END-IF
    IF (DUP-COUNT > 0 OR R-NULL(F-CONFIRMATIONTOKEN) = 0)
      AND CONFIRMED-DUP = 0 AND APP-STATUS = 200
      PERFORM ROLLBACK-UNIT
      IF RC NOT = 0 MOVE 503 TO APP-STATUS GOBACK END-IF
      MOVE CONFIRM-CURRENT TO CONFIRM-PAYLOAD
      MOVE "Confirmation" TO STATE-KIND
      CALL "STSTATEIO" USING BY VALUE DB-HANDLE 1
        BY REFERENCE CONFIRM-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
          CONFIRM-PAYLOAD BY VALUE LENGTH OF CONFIRM-PAYLOAD
        BY REFERENCE CONFIRM-REVISION BY VALUE 10 RETURNING RC END-CALL
      IF RC NOT = 0 MOVE 503 TO APP-STATUS GOBACK END-IF
      MOVE 409 TO APP-STATUS MOVE "ConfirmationRequired" TO APP-OUTCOME
      MOVE "W-STU-101: 同一人物候補があります。別人であることを確認してください。"
        TO ERROR-TEXT PERFORM ADD-ERROR
    END-IF
    GOBACK.

copy "ST-HELPERS.cpy".
end program STDUP.
