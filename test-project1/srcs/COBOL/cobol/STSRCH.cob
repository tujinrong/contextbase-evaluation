       >>SOURCE FORMAT FREE
identification division.
program-id. STSRCH.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
01 PAGE-RAW PIC X(1032).
01 SIZE-RAW PIC X(1032).
01 ORDER-RAW PIC X(1032).
01 DIRECTION-RAW PIC X(1032).
01 ACTION-RAW PIC X(16).

procedure division.
    MOVE "Search" TO VIEW-MODE MOVE 0 TO ROW-COUNT
    CALL "STSTATE" END-CALL IF APP-STATUS NOT = 200 GOBACK END-IF
    IF R-DATA(F-ACTION) = "" OR "INITIAL" OR "CLEAR"
      PERFORM DEFAULTS
      MOVE 0 TO SEARCH-EXECUTED TOTAL-COUNT ROW-COUNT
      MOVE ST-RAW TO SEARCH-RAW
      IF R-DATA(F-ACTION) = "CLEAR" PERFORM SAVE-CONTEXT END-IF
      GOBACK
    END-IF
    IF R-DATA(F-ACTION) = "OPTIONS"
      MOVE SEARCH-COUNT TO TOTAL-COUNT MOVE SEARCH-PAGE TO CURRENT-PAGE
      MOVE SEARCH-SIZE TO PAGE-SIZE MOVE SEARCH-ROW-COUNT TO ROW-COUNT
      MOVE SEARCH-ROWS TO ST-ROWS
      IF R-DATA(F-UNASSIGNEDONLY) = "1"
        PERFORM VARYING I FROM F-SCHOOLYEAR BY 1 UNTIL I > F-GRADECODE
          INITIALIZE R-VALUE(I) MOVE -1 TO R-NULL(I)
        END-PERFORM
        INITIALIZE R-VALUE(F-CLASSID) MOVE -1 TO R-NULL(F-CLASSID)
      END-IF
      GOBACK
    END-IF
    IF R-DATA(F-ACTION) = "PAGE" OR "RESUME"
      IF SEARCH-EXECUTED = 0
        MOVE SEARCH-RAW TO ST-RAW GOBACK END-IF
      MOVE R-VALUE(F-PAGE) TO PAGE-RAW
      MOVE R-VALUE(F-PAGESIZE) TO SIZE-RAW
      MOVE R-VALUE(F-SORTKEY) TO ORDER-RAW
      MOVE R-VALUE(F-SORTDIRECTION) TO DIRECTION-RAW
      MOVE R-DATA(F-ACTION) TO ACTION-RAW
      MOVE SEARCH-RAW TO ST-RAW
      IF ACTION-RAW = "PAGE"
        MOVE PAGE-RAW TO R-VALUE(F-PAGE)
        MOVE SIZE-RAW TO R-VALUE(F-PAGESIZE)
        MOVE ORDER-RAW TO R-VALUE(F-SORTKEY)
        MOVE DIRECTION-RAW TO R-VALUE(F-SORTDIRECTION)
      END-IF
    ELSE
      INITIALIZE R-VALUE(F-PAGE) MOVE "1" TO R-DATA(F-PAGE)
      MOVE 1 TO R-LENGTH(F-PAGE) MOVE 0 TO R-NULL(F-PAGE)
    END-IF
    INITIALIZE ST-NORMAL
    CALL "STUNICODE" USING BY VALUE 4 BY REFERENCE R-VALUE(4)
      N-VALUE(1) BY VALUE 15 15 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目1の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(5)
      N-VALUE(2) BY VALUE 8 8 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目2の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 3 BY REFERENCE R-VALUE(6)
      N-VALUE(3) BY VALUE 36 18 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目3の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(26)
      N-VALUE(4) BY VALUE 4 4 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目4の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 5 BY REFERENCE R-VALUE(27)
      N-VALUE(5) BY VALUE 2 2 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目5の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(21)
      N-VALUE(6) BY VALUE 19 19 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目6の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(41)
      N-VALUE(7) BY VALUE 1 1 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目7の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 5 BY REFERENCE R-VALUE(13)
      N-VALUE(8) BY VALUE 2 2 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目8の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 7 BY REFERENCE R-VALUE(16)
      N-VALUE(9) BY VALUE 20 16 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目9の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(46)
      N-VALUE(10) BY VALUE 10 10 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目10の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(47)
      N-VALUE(11) BY VALUE 10 10 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE "E-SRC-002: 検索項目11の長さまたは文字が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    CALL "STUNICODE" USING BY VALUE 2 BY REFERENCE N-VALUE(2)
      TMP-VALUE BY VALUE 8 160 RETURNING RC END-CALL
    MOVE TMP-VALUE TO N-VALUE(2)
    CALL "STUNICODE" USING BY VALUE 2 BY REFERENCE N-VALUE(3)
      TMP-VALUE BY VALUE 18 18 RETURNING RC END-CALL
    MOVE TMP-VALUE TO N-VALUE(3)
    CALL "STPATTERN" USING N-VALUE(1) BY VALUE 1 RETURNING RC END-CALL
    CALL "STPATTERN" USING N-VALUE(2) BY VALUE 0 RETURNING RC END-CALL
    CALL "STPATTERN" USING N-VALUE(3) BY VALUE 0 RETURNING RC END-CALL
    IF N-NULL(7) = -1
      INITIALIZE N-VALUE(7) MOVE "0" TO N-DATA(7) MOVE 1 TO N-LENGTH(7)
    END-IF
    IF N-DATA(7)(1:1) NOT = "0" AND "1"
      PERFORM SEARCH-ERROR END-IF
    IF N-DATA(7)(1:1) = "1" AND
      (N-NULL(4) = 0 OR N-NULL(5) = 0 OR N-NULL(6) = 0)
      MOVE "E-SRC-001: 未所属と年度・学年・クラスは同時指定できません。"
        TO ERROR-TEXT PERFORM ADD-ERROR END-IF
    IF N-NULL(4) = 0
      CALL "STINTEGER" USING N-VALUE(4) V RETURNING RC END-CALL
      IF RC NOT = 0 OR V < 1900 OR > 9998 OR N-LENGTH(4) NOT = 4
        PERFORM SEARCH-ERROR END-IF
    END-IF
    IF N-NULL(6) = 0
      CALL "STINTEGER" USING N-VALUE(6) V RETURNING RC END-CALL
      IF RC NOT = 0 OR V < 1 PERFORM SEARCH-ERROR END-IF
    END-IF
    PERFORM VARYING I FROM 10 BY 1 UNTIL I > 11
      IF N-NULL(I) = 0
        MOVE N-VALUE(I) TO TMP-VALUE
        CALL "STISODATE" USING TMP-VALUE BUSINESS-DAY RETURNING RC END-CALL
        IF RC NOT = 0 PERFORM SEARCH-ERROR END-IF
      END-IF
    END-PERFORM
    IF N-NULL(10) = 0 AND N-NULL(11) = 0 AND N-DATA(10) > N-DATA(11)
      PERFORM SEARCH-ERROR END-IF
    PERFORM VARYING I FROM 12 BY 1 UNTIL I > 15
      INITIALIZE N-VALUE(I) MOVE -1 TO N-NULL(I)
      COMPUTE J = I + 30
      IF R-NULL(J) = 0
        IF R-DATA(J)(1:1) NOT = "1" PERFORM SEARCH-ERROR
        ELSE
          COMPUTE MONTH-N = I - 11 MOVE MONTH-N TO MONTH-OUT
          MOVE MONTH-OUT TO N-DATA(I) MOVE 2 TO N-LENGTH(I)
          MOVE 0 TO N-NULL(I)
        END-IF
      END-IF
    END-PERFORM
    CALL "STINTEGER" USING R-VALUE(F-PAGE) V RETURNING RC END-CALL
    IF RC NOT = 0 OR V < 1 OR V > 10000 PERFORM SEARCH-ERROR
    ELSE MOVE V TO CURRENT-PAGE END-IF
    CALL "STINTEGER" USING R-VALUE(F-PAGESIZE) V RETURNING RC END-CALL
    IF RC NOT = 0 OR (V NOT = 20 AND 50 AND 100) PERFORM SEARCH-ERROR
    ELSE MOVE V TO PAGE-SIZE END-IF
    EVALUATE FUNCTION TRIM(R-DATA(F-SORTKEY))
      WHEN "studentNo" MOVE "1" TO LIST-ORDER
      WHEN "name" MOVE "2" TO LIST-ORDER
      WHEN "admissionDate" MOVE "3" TO LIST-ORDER
      WHEN "updatedAt" MOVE "4" TO LIST-ORDER
      WHEN OTHER PERFORM SEARCH-ERROR
    END-EVALUATE
    EVALUATE FUNCTION TRIM(R-DATA(F-SORTDIRECTION))
      WHEN "asc" MOVE "A" TO LIST-DIRECTION
      WHEN "desc" MOVE "D" TO LIST-DIRECTION
      WHEN OTHER PERFORM SEARCH-ERROR
    END-EVALUATE
    IF APP-STATUS NOT = 200 GOBACK END-IF
    CALL "STBEGIN" USING BY VALUE DB-HANDLE 1 BY REFERENCE ST-DB-RESULT
      RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM DATABASE-ERROR GOBACK END-IF
    PERFORM EXISTENCE
    IF APP-STATUS NOT = 200 PERFORM ROLLBACK-UNIT GOBACK END-IF
    MOVE "ST-COUNT" TO COMMAND-NAME PERFORM DB-RESET PERFORM SEARCH-PARAMS
    PERFORM DB-EXECUTE IF RC NOT = 0 PERFORM DATABASE-ERROR GOBACK END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 1 PERFORM DATABASE-ERROR GOBACK END-IF
    MOVE 1 TO K PERFORM FETCH-TEMP
    CALL "STINTEGER" USING TMP-VALUE V RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM DATABASE-ERROR GOBACK END-IF
    MOVE V TO TOTAL-COUNT MOVE 0 TO ROW-COUNT
    IF TOTAL-COUNT > 10000
      MOVE "W-SRC-001: 検索結果が10,000件を超えています。条件を追加してください。"
        TO APP-MESSAGE
      COMPUTE APP-MESSAGE-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(APP-MESSAGE))
    ELSE
      COMPUTE LAST-PAGE = FUNCTION MAX(1,FUNCTION INTEGER((TOTAL-COUNT + PAGE-SIZE - 1) / PAGE-SIZE))
      IF CURRENT-PAGE > LAST-PAGE MOVE LAST-PAGE TO CURRENT-PAGE END-IF
      MOVE SPACES TO COMMAND-NAME
      STRING "ST-LIST-" LIST-ORDER LIST-DIRECTION INTO COMMAND-NAME END-STRING
      PERFORM DB-RESET PERFORM SEARCH-PARAMS
      COMPUTE V = (CURRENT-PAGE - 1) * PAGE-SIZE PERFORM ID-AS-TEMP
      MOVE 5 TO PARAM-TYPE PERFORM ADD-TEMP
      MOVE PAGE-SIZE TO V PERFORM ID-AS-TEMP PERFORM ADD-TEMP
      PERFORM DB-EXECUTE IF RC NOT = 0 PERFORM DATABASE-ERROR GOBACK END-IF
      PERFORM UNTIL ROW-COUNT >= PAGE-SIZE
        CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
        IF RC = 0 EXIT PERFORM END-IF
        IF RC NOT = 1 PERFORM DATABASE-ERROR GOBACK END-IF
        ADD 1 TO ROW-COUNT
        PERFORM VARYING K FROM 1 BY 1 UNTIL K > 13
          PERFORM FETCH-TEMP
          IF RC NOT = 0 PERFORM DATABASE-ERROR GOBACK END-IF
          MOVE TMP-VALUE TO ROW-VALUE(ROW-COUNT,K)
        END-PERFORM
      END-PERFORM
      IF TOTAL-COUNT = 0
        MOVE "I-SRC-001: 該当する学生がありません。" TO APP-MESSAGE
        COMPUTE APP-MESSAGE-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(APP-MESSAGE))
      END-IF
    END-IF
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    CALL "STEND" USING BY VALUE DB-HANDLE 1 BY REFERENCE ST-DB-RESULT
      RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM DATABASE-ERROR GOBACK END-IF
    MOVE 1 TO SEARCH-EXECUTED
    MOVE ST-RAW TO SEARCH-RAW PERFORM SAVE-CONTEXT
    GOBACK.
SEARCH-PARAMS.
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 15
      MOVE I TO PARAM-FIELD MOVE 2 TO PARAM-TYPE
      IF I = 2 OR 3 MOVE 1 TO PARAM-TYPE END-IF
      IF I = 4 MOVE 5 TO PARAM-TYPE END-IF
      IF I = 6 MOVE 3 TO PARAM-TYPE END-IF
      IF I = 7 MOVE 7 TO PARAM-TYPE END-IF
      IF I = 10 OR 11 MOVE 4 TO PARAM-TYPE END-IF
      PERFORM ADD-NORMAL
    END-PERFORM.
EXISTENCE.
    PERFORM VARYING I FROM 5 BY 3 UNTIL I > 8
      IF N-NULL(I) = 0
        MOVE "ST-CODE" TO COMMAND-NAME PERFORM DB-RESET
        INITIALIZE TMP-VALUE
        IF I = 5 MOVE "GRADE" TO TMP-DATA ELSE MOVE "PREFECTURE" TO TMP-DATA END-IF
        COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(TMP-DATA))
        MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP
        MOVE I TO PARAM-FIELD PERFORM ADD-NORMAL
        PERFORM DB-EXECUTE IF RC NOT = 0 EXIT PARAGRAPH END-IF
        CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
        IF RC NOT = 1 PERFORM SEARCH-ERROR END-IF
      END-IF
    END-PERFORM
    IF N-NULL(4) = 0
      MOVE "ST-YEAR" TO COMMAND-NAME PERFORM DB-RESET
      MOVE 5 TO PARAM-TYPE MOVE 4 TO PARAM-FIELD PERFORM ADD-NORMAL
      PERFORM DB-EXECUTE IF RC NOT = 0 EXIT PARAGRAPH END-IF
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      MOVE 1 TO K PERFORM FETCH-TEMP
      IF TMP-DATA(1:1) = "0" PERFORM SEARCH-ERROR END-IF
    END-IF
    IF N-NULL(6) = 0
      MOVE "ST-CLASS" TO COMMAND-NAME PERFORM DB-RESET
      MOVE 3 TO PARAM-TYPE MOVE 6 TO PARAM-FIELD PERFORM ADD-NORMAL
      PERFORM DB-EXECUTE IF RC NOT = 0 EXIT PARAGRAPH END-IF
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      IF RC NOT = 1 PERFORM SEARCH-ERROR EXIT PARAGRAPH END-IF
      MOVE 1 TO K PERFORM FETCH-TEMP
      IF N-NULL(4) = 0 AND N-DATA(4) NOT = TMP-DATA PERFORM SEARCH-ERROR END-IF
      MOVE 2 TO K PERFORM FETCH-TEMP
      IF N-NULL(5) = 0 AND N-DATA(5) NOT = TMP-DATA PERFORM SEARCH-ERROR END-IF
    END-IF
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL.
SAVE-CONTEXT.
    MOVE TOTAL-COUNT TO SEARCH-COUNT MOVE CURRENT-PAGE TO SEARCH-PAGE
    MOVE PAGE-SIZE TO SEARCH-SIZE MOVE ROW-COUNT TO SEARCH-ROW-COUNT
    MOVE ST-ROWS TO SEARCH-ROWS MOVE "Search" TO STATE-KIND
    CALL "STSTATEIO" USING BY VALUE DB-HANDLE 3
      BY REFERENCE CONTEXT-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
        SEARCH-STATE BY VALUE LENGTH OF SEARCH-STATE
      BY REFERENCE CONTEXT-REVISION BY VALUE 30 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME MOVE 0 TO ROW-COUNT
      MOVE "E-COM-003: 旧画面からの要求です。画面を開き直してください。"
        TO ERROR-TEXT PERFORM ADD-ERROR END-IF.
DEFAULTS.
    PERFORM VARYING I FROM 4 BY 1 UNTIL I > 47
      IF I NOT = F-CONTEXTID AND F-CONTEXTREVISION AND F-TABID AND F-CSRFTOKEN
        INITIALIZE R-VALUE(I) MOVE -1 TO R-NULL(I) END-IF
    END-PERFORM
    MOVE "1" TO R-DATA(F-PAGE) MOVE 1 TO R-LENGTH(F-PAGE)
    MOVE 0 TO R-NULL(F-PAGE)
    MOVE "20" TO R-DATA(F-PAGESIZE) MOVE 2 TO R-LENGTH(F-PAGESIZE)
    MOVE 0 TO R-NULL(F-PAGESIZE)
    MOVE "studentNo" TO R-DATA(F-SORTKEY) MOVE 9 TO R-LENGTH(F-SORTKEY)
    MOVE 0 TO R-NULL(F-SORTKEY)
    MOVE "asc" TO R-DATA(F-SORTDIRECTION) MOVE 3 TO R-LENGTH(F-SORTDIRECTION)
    MOVE 0 TO R-NULL(F-SORTDIRECTION)
    MOVE "1" TO R-DATA(F-STATUS01) R-DATA(F-STATUS02)
    MOVE 1 TO R-LENGTH(F-STATUS01) R-LENGTH(F-STATUS02)
    MOVE 0 TO R-NULL(F-STATUS01) R-NULL(F-STATUS02)
    MOVE 1 TO CURRENT-PAGE MOVE 20 TO PAGE-SIZE.
SEARCH-ERROR.
    MOVE "E-SRC-002: 検索条件または表示指定が正しくありません。"
      TO ERROR-TEXT PERFORM ADD-ERROR.
DATABASE-ERROR.
    PERFORM ROLLBACK-UNIT MOVE 0 TO ROW-COUNT
    MOVE 503 TO APP-STATUS MOVE "SystemError" TO APP-OUTCOME
    MOVE "E-COM-004: 検索できませんでした。" TO ERROR-TEXT PERFORM ADD-ERROR.

copy "ST-HELPERS.cpy".
end program STSRCH.
