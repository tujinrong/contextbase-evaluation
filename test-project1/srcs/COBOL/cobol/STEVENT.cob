       >>SOURCE FORMAT FREE
identification division.
program-id. STEVENT.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
copy "ST-TEXT.cpy".
01 EVENT-FOCUS BINARY-LONG SIGNED.
01 EVENT-KEY BINARY-LONG SIGNED.
01 EVENT-MOD BINARY-LONG SIGNED.
01 CHANGED-UPPER BINARY-LONG SIGNED.
01 CANDIDATE-INDEX BINARY-LONG SIGNED.

procedure division.
    MOVE SPACES TO T-ACTION
    CALL "STTERMNEXT" USING T-KEY T-FOCUS RETURNING T-RC END-CALL
    IF T-RC < 0 GOBACK END-IF
    CALL "STSAMPLECHECK" RETURNING RC END-CALL
    IF RC NOT = 0 MOVE -1 TO T-RC GOBACK END-IF
    MOVE T-FOCUS TO EVENT-FOCUS
    COMPUTE EVENT-KEY = FUNCTION MOD(T-KEY, 65536)
    COMPUTE EVENT-MOD = FUNCTION INTEGER(T-KEY / 65536)
    MOVE 0 TO CHANGED-UPPER
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 64
      IF T-REGISTERED(I) = 1
        MOVE I TO T-ID
        CALL "STTERMGET" USING T-ID TMP-VALUE T-CHANGED RETURNING T-RC END-CALL
        IF T-RC < 0 GOBACK END-IF
        IF T-CHANGED NOT = 0
          IF I = 7 PERFORM ERA-CANONICAL END-IF
          MOVE TMP-VALUE TO R-VALUE(I)
          IF I = 26 OR 27 OR 19 OR 18 OR 20 MOVE 1 TO CHANGED-UPPER END-IF
        END-IF
      END-IF
    END-PERFORM
    IF T-PANEL = "PICK" OR "ERROR" OR
      (T-PANEL = "NORMAL" AND VIEW-MODE = "Search")
      MOVE 9001 TO T-ID
      CALL "STTERMGET" USING T-ID T-SPECIAL(1) T-CHANGED RETURNING T-RC END-CALL
      IF T-RC < 0 GOBACK END-IF
    END-IF
    IF T-PANEL = "CONFIRM"
      MOVE 9002 TO T-ID
      CALL "STTERMGET" USING T-ID T-SPECIAL(2) T-CHANGED RETURNING T-RC END-CALL
      IF T-RC < 0 GOBACK END-IF
    END-IF
    IF T-PANEL = "NORMAL" AND VIEW-MODE = "Search"
      PERFORM SEARCH-PRESENTATION
      IF T-RC < 0 GOBACK END-IF
    END-IF
    CALL "STTEXTCHECK" USING ST-RAW RETURNING RC END-CALL
    IF RC NOT = 0 MOVE -1 TO T-RC GOBACK END-IF
    EVALUATE T-PANEL
      WHEN "HELP"
        IF EVENT-KEY = 123
          MOVE T-PREVIOUS-PANEL TO T-PANEL MOVE T-RETURN-FOCUS TO T-FOCUS
        END-IF
      WHEN "PICK" PERFORM PICK-EVENT
      WHEN "ERROR" PERFORM ERROR-EVENT
      WHEN "CONFIRM" PERFORM CONFIRM-EVENT
      WHEN OTHER PERFORM NORMAL-EVENT
    END-EVALUATE
    IF T-ACTION NOT = SPACES PERFORM MAKE-REQUEST END-IF
    GOBACK.
ERA-CANONICAL.
    EVALUATE TMP-DATA
      WHEN "M" MOVE "MEIJI" TO TMP-DATA MOVE 5 TO TMP-LENGTH
      WHEN "T" MOVE "TAISHO" TO TMP-DATA MOVE 6 TO TMP-LENGTH
      WHEN "S" MOVE "SHOWA" TO TMP-DATA MOVE 5 TO TMP-LENGTH
      WHEN "H" MOVE "HEISEI" TO TMP-DATA MOVE 6 TO TMP-LENGTH
      WHEN "R" MOVE "REIWA" TO TMP-DATA MOVE 5 TO TMP-LENGTH
    END-EVALUATE.
SEARCH-PRESENTATION.
    MOVE 9003 TO T-ID
    CALL "STTERMGET" USING T-ID TMP-VALUE T-CHANGED RETURNING T-RC END-CALL
    IF T-RC < 0 EXIT PARAGRAPH END-IF
    IF T-CHANGED NOT = 0
      EVALUATE TMP-DATA
        WHEN "1" MOVE "studentNo" TO TMP-DATA MOVE 9 TO TMP-LENGTH
        WHEN "2" MOVE "name" TO TMP-DATA MOVE 4 TO TMP-LENGTH
        WHEN "3" MOVE "admissionDate" TO TMP-DATA MOVE 13 TO TMP-LENGTH
        WHEN "4" MOVE "updatedAt" TO TMP-DATA MOVE 9 TO TMP-LENGTH
      END-EVALUATE MOVE TMP-VALUE TO R-VALUE(F-SORTKEY)
    END-IF
    MOVE 9004 TO T-ID
    CALL "STTERMGET" USING T-ID TMP-VALUE T-CHANGED RETURNING T-RC END-CALL
    IF T-RC < 0 EXIT PARAGRAPH END-IF
    IF T-CHANGED NOT = 0
      EVALUATE TMP-DATA
        WHEN "A" MOVE "asc" TO TMP-DATA MOVE 3 TO TMP-LENGTH
        WHEN "D" MOVE "desc" TO TMP-DATA MOVE 4 TO TMP-LENGTH
      END-EVALUATE MOVE TMP-VALUE TO R-VALUE(F-SORTDIRECTION)
    END-IF
    IF EVENT-FOCUS >= 9042 AND <= 9045
      COMPUTE I = EVENT-FOCUS - 9000
      IF EVENT-KEY = 32
        IF R-NULL(I) = 0 INITIALIZE R-VALUE(I) MOVE -1 TO R-NULL(I)
        ELSE INITIALIZE R-VALUE(I) MOVE "1" TO R-DATA(I)
          MOVE 1 TO R-LENGTH(I) END-IF
      END-IF
    END-IF.
NORMAL-EVENT.
    EVALUATE EVENT-KEY
      WHEN 112
        MOVE T-PANEL TO T-PREVIOUS-PANEL MOVE "HELP" TO T-PANEL
        MOVE EVENT-FOCUS TO T-RETURN-FOCUS
      WHEN 119 PERFORM FULL-VALUE
      WHEN 115 PERFORM START-PICK
      WHEN OTHER
        IF VIEW-MODE = "Search" PERFORM SEARCH-EVENT
        ELSE PERFORM EDIT-EVENT END-IF
    END-EVALUATE
    IF CHANGED-UPPER = 1 AND T-ACTION = SPACES AND T-PANEL = "NORMAL"
      MOVE "OPTIONS" TO T-ACTION END-IF.
SEARCH-EVENT.
    EVALUATE EVENT-KEY
      WHEN 116 MOVE "SEARCH" TO T-ACTION
      WHEN 117 MOVE "CLEAR" TO T-ACTION
      WHEN 113 MOVE "NEW" TO T-ACTION
      WHEN 114 MOVE "MENU" TO T-ACTION
      WHEN 33
        IF T-DISPLAY-WINDOW > 1
          SUBTRACT 1 FROM T-DISPLAY-WINDOW PERFORM SAVE-WINDOW END-IF
      WHEN 34
        IF T-DISPLAY-WINDOW * 4 < ROW-COUNT
          ADD 1 TO T-DISPLAY-WINDOW PERFORM SAVE-WINDOW END-IF
      WHEN 118
        COMPUTE V = FUNCTION MAX(1, CURRENT-PAGE - 1) PERFORM SET-PAGE
      WHEN 121
        COMPUTE V = FUNCTION MIN(LAST-PAGE, CURRENT-PAGE + 1) PERFORM SET-PAGE
      WHEN 36 IF EVENT-MOD = 2 MOVE 1 TO V PERFORM SET-PAGE END-IF
      WHEN 35 IF EVENT-MOD = 2 MOVE LAST-PAGE TO V PERFORM SET-PAGE END-IF
      WHEN 13
        IF EVENT-FOCUS = 9001
          CALL "STINTEGER" USING T-SPECIAL(1) V RETURNING RC END-CALL
          COMPUTE J = (T-DISPLAY-WINDOW - 1) * 4 + V
          IF RC = 0 AND V >= 1 AND <= 4 AND J <= ROW-COUNT
            MOVE ROW-VALUE(J,1) TO R-VALUE(F-OPENSTUDENTID)
            MOVE "OPEN" TO T-ACTION
          ELSE PERFORM INVALID-SELECTION END-IF
        ELSE
          MOVE "Enterは保存・検索を行いません。検索はF5、一覧選択は行番号+Enter。"
            TO APP-MESSAGE
          COMPUTE APP-MESSAGE-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(APP-MESSAGE))
        END-IF
    END-EVALUATE.
SET-PAGE.
    IF SEARCH-EXECUTED NOT = 1 OR V = CURRENT-PAGE EXIT PARAGRAPH END-IF
    PERFORM ID-AS-TEMP MOVE TMP-VALUE TO R-VALUE(F-PAGE)
    MOVE "PAGE" TO T-ACTION.
SAVE-WINDOW.
    MOVE T-DISPLAY-WINDOW TO SEARCH-WINDOW
    MOVE "Search" TO STATE-KIND
    MOVE ST-RAW TO SEARCH-PENDING
    CALL "STSTATEIO" USING BY VALUE DB-HANDLE 3
      BY REFERENCE CONTEXT-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
        SEARCH-STATE BY VALUE LENGTH OF SEARCH-STATE
      BY REFERENCE CONTEXT-REVISION BY VALUE 30 RETURNING RC END-CALL
    IF RC NOT = 0 MOVE 409 TO APP-STATUS END-IF.
EDIT-EVENT.
    EVALUATE EVENT-KEY
      WHEN 116
        IF ROLE-CODE > 0
          IF STUDENT-ID = 0 MOVE "CREATE" TO T-ACTION
          ELSE MOVE "UPDATE" TO T-ACTION END-IF END-IF
      WHEN 117 MOVE "RESET" TO T-ACTION
      WHEN 120 MOVE "RELOAD" TO T-ACTION
      WHEN 114 MOVE "BACK" TO T-ACTION
      WHEN 122
        IF ROLE-CODE = 2 AND STUDENT-ID > 0 MOVE "DELETE" TO T-ACTION END-IF
      WHEN 13
        CALL "STNORM" END-CALL CALL "STVALID" END-CALL
    END-EVALUATE.
CONFIRM-EVENT.
    EVALUATE EVENT-KEY
      WHEN 123 MOVE "CANCEL" TO T-ACTION
      WHEN 116
        IF T-SPECIAL-NULL(2) = 0 AND T-SPECIAL-LENGTH(2) = 1
          AND T-SPECIAL-DATA(2)(1:1) = "Y"
          MOVE "CONFIRM" TO T-ACTION
        END-IF
      WHEN 119 PERFORM FULL-VALUE
      WHEN 33 IF T-MODAL-WINDOW > 1 SUBTRACT 1 FROM T-MODAL-WINDOW END-IF
      WHEN 34
        IF EDITOR-PENDING = "DUPLICATE" AND
          T-MODAL-WINDOW * 6 < FUNCTION MIN(DUP-COUNT,20)
          ADD 1 TO T-MODAL-WINDOW END-IF
    END-EVALUATE.
START-PICK.
    MOVE SPACES TO UI-CATEGORY
    EVALUATE EVENT-FOCUS
      WHEN 7 MOVE "ERA" TO UI-CATEGORY
      WHEN 11 MOVE "GENDER" TO UI-CATEGORY
      WHEN 13 MOVE "PREFECTURE" TO UI-CATEGORY
      WHEN 19 MOVE "ENROLLMENT_STATUS" TO UI-CATEGORY
      WHEN 21 MOVE "CLASS" TO UI-CATEGORY
      WHEN 23 MOVE "RELATIONSHIP" TO UI-CATEGORY
      WHEN 26 MOVE "YEAR" TO UI-CATEGORY
      WHEN 27 MOVE "GRADE" TO UI-CATEGORY
    END-EVALUATE
    IF UI-CATEGORY = SPACES EXIT PARAGRAPH END-IF
    IF ROLE-CODE = 0 AND VIEW-MODE = "Edit" EXIT PARAGRAPH END-IF
    MOVE EVENT-FOCUS TO UI-FIELD T-PICK-FIELD T-RETURN-FOCUS
    MOVE SPACES TO UI-CURRENT
    IF VIEW-MODE = "Edit"
      MOVE EDITOR-NORMAL TO ST-OLD
      EVALUATE UI-FIELD
        WHEN 11 MOVE O-DATA(5) TO UI-CURRENT
        WHEN 13 MOVE O-DATA(7) TO UI-CURRENT
        WHEN 19 MOVE O-DATA(13) TO UI-CURRENT
        WHEN 21 MOVE O-DATA(15) TO UI-CURRENT
        WHEN 23 MOVE O-DATA(17) TO UI-CURRENT
      END-EVALUATE
      CALL "STHINT" END-CALL
      IF APP-STATUS NOT = 200
        MOVE 0 TO T-PICK-COUNT T-PICK-TOTAL INITIALIZE T-PICKS
        EXIT PARAGRAPH END-IF
    END-IF
    MOVE 1 TO T-PICK-START
    CALL "STMLOOK" END-CALL
    IF APP-STATUS NOT = 200 EXIT PARAGRAPH END-IF
    MOVE "PICK" TO T-PANEL MOVE 9001 TO T-FOCUS
    INITIALIZE T-SPECIAL(1)
    MOVE "1" TO T-SPECIAL-DATA(1) MOVE 1 TO T-SPECIAL-LENGTH(1).
PICK-EVENT.
    EVALUATE EVENT-KEY
      WHEN 123 MOVE "NORMAL" TO T-PANEL MOVE T-RETURN-FOCUS TO T-FOCUS
      WHEN 33
        IF T-PICK-START > 1 SUBTRACT 6 FROM T-PICK-START
          CALL "STMLOOK" END-CALL END-IF
      WHEN 34
        IF T-PICK-START + 5 < T-PICK-TOTAL ADD 6 TO T-PICK-START
          CALL "STMLOOK" END-CALL END-IF
      WHEN 119 PERFORM FULL-VALUE
      WHEN 13
        CALL "STINTEGER" USING T-SPECIAL(1) V RETURNING RC END-CALL
        IF RC = 0 AND V = 0
          INITIALIZE R-VALUE(T-PICK-FIELD) MOVE -1 TO R-NULL(T-PICK-FIELD)
          PERFORM PICK-APPLIED
        ELSE
          IF RC = 0 AND V >= 1 AND <= T-PICK-COUNT AND T-PICK-SELECTABLE(V) = 1
            MOVE T-PICK-VALUE(V) TO R-VALUE(T-PICK-FIELD)
            PERFORM PICK-APPLIED
          ELSE PERFORM INVALID-SELECTION END-IF
        END-IF
    END-EVALUATE.
PICK-APPLIED.
    MOVE "NORMAL" TO T-PANEL MOVE T-RETURN-FOCUS TO T-FOCUS
    IF VIEW-MODE = "Edit" MOVE "OPTIONS" TO T-ACTION END-IF.
ERROR-EVENT.
    EVALUATE EVENT-KEY
      WHEN 123 MOVE "NORMAL" TO T-PANEL MOVE T-RETURN-FOCUS TO T-FOCUS
      WHEN 119 PERFORM FULL-VALUE
      WHEN 33 IF T-MODAL-WINDOW > 1 SUBTRACT 1 FROM T-MODAL-WINDOW END-IF
      WHEN 34 IF T-MODAL-WINDOW * 6 < T-ERROR-COUNT ADD 1 TO T-MODAL-WINDOW END-IF
      WHEN 13
        CALL "STINTEGER" USING T-SPECIAL(1) V RETURNING RC END-CALL
        COMPUTE J = (T-MODAL-WINDOW - 1) * 6 + V
        IF RC = 0 AND V >= 1 AND <= 6 AND J <= T-ERROR-COUNT
          MOVE T-ERROR-FIELD(J) TO T-FOCUS MOVE "NORMAL" TO T-PANEL
        ELSE PERFORM INVALID-SELECTION END-IF
    END-EVALUATE.
FULL-VALUE.
    MOVE 8 TO T-FLAGS MOVE 1024 TO T-MAX
    INITIALIZE TMP-VALUE TMP2-VALUE
    IF EVENT-FOCUS >= 1 AND <= 64
      MOVE R-VALUE(EVENT-FOCUS) TO TMP-VALUE
      MOVE T-FIELD-LABEL(EVENT-FOCUS) TO TMP2-DATA
      MOVE T-MAXIMUM(EVENT-FOCUS) TO T-MAX
      IF ROLE-CODE > 0 AND NOT (EVENT-FOCUS = 4 AND STUDENT-ID > 0)
        AND NOT (EVENT-FOCUS = 20 AND (R-DATA(19)(1:2) = "01" OR "02"))
        MOVE 1 TO T-FLAGS END-IF
    ELSE
      MOVE EVENT-FOCUS TO T-ID
      CALL "STTERMGET" USING T-ID TMP-VALUE T-CHANGED RETURNING T-RC END-CALL
      IF T-RC < 0 EXIT PARAGRAPH END-IF
      MOVE "全文参照 / 原入力は変更しません" TO TMP2-DATA
    END-IF
    COMPUTE TMP2-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(TMP2-DATA))
    CALL "STTERMFULL" USING TMP-VALUE TMP2-VALUE T-FLAGS T-MAX
      RETURNING T-RC END-CALL
    IF T-RC = 1 AND T-FLAGS = 1 AND EVENT-FOCUS >= 1 AND <= 64
      MOVE TMP-VALUE TO R-VALUE(EVENT-FOCUS)
      IF EVENT-FOCUS = 26 OR 27 OR 19 OR 18 OR 20 MOVE "OPTIONS" TO T-ACTION END-IF
    END-IF.
INVALID-SELECTION.
    MOVE "E-COM-003: 選択番号または選択可否を確認してください。" TO APP-MESSAGE
    COMPUTE APP-MESSAGE-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(APP-MESSAGE)).
MAKE-REQUEST.
    IF T-SEQUENCE = 9223372036854775807
      MOVE -1 TO T-RC GOBACK END-IF
    COMPUTE T-REQUEST = T-SEQUENCE + 1 MOVE 0 TO T-NAME-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 64
      IF T-REGISTERED(I) = 1
        IF T-PANEL = "CONFIRM"
          IF I = 28 OR 36 PERFORM ADD-NAME END-IF
        ELSE PERFORM ADD-NAME END-IF
      END-IF
    END-PERFORM
    IF VIEW-MODE = "Search"
      MOVE 39 TO I PERFORM ADD-NAME
      MOVE 40 TO I PERFORM ADD-NAME
      PERFORM VARYING I FROM 42 BY 1 UNTIL I > 45
        IF R-NULL(I) = 0 PERFORM ADD-NAME END-IF
      END-PERFORM
    END-IF.
ADD-NAME.
    ADD 1 TO T-NAME-COUNT MOVE I TO T-SLOT(T-NAME-COUNT)
    EVALUATE I
      WHEN 4 MOVE "studentNo" TO T-NAME(T-NAME-COUNT)
      WHEN 5 MOVE "studentName" TO T-NAME(T-NAME-COUNT)
      WHEN 6 MOVE "studentNameKana" TO T-NAME(T-NAME-COUNT)
      WHEN 7 MOVE "birthEra" TO T-NAME(T-NAME-COUNT)
      WHEN 8 MOVE "birthYear" TO T-NAME(T-NAME-COUNT)
      WHEN 9 MOVE "birthMonth" TO T-NAME(T-NAME-COUNT)
      WHEN 10 MOVE "birthDay" TO T-NAME(T-NAME-COUNT)
      WHEN 11 MOVE "genderCode" TO T-NAME(T-NAME-COUNT)
      WHEN 12 MOVE "postalCode" TO T-NAME(T-NAME-COUNT)
      WHEN 13 MOVE "prefectureCode" TO T-NAME(T-NAME-COUNT)
      WHEN 14 MOVE "addressLine1" TO T-NAME(T-NAME-COUNT)
      WHEN 15 MOVE "addressLine2" TO T-NAME(T-NAME-COUNT)
      WHEN 16 MOVE "phoneNumber" TO T-NAME(T-NAME-COUNT)
      WHEN 17 MOVE "emailAddress" TO T-NAME(T-NAME-COUNT)
      WHEN 18 MOVE "admissionDate" TO T-NAME(T-NAME-COUNT)
      WHEN 19 MOVE "enrollmentStatusCode" TO T-NAME(T-NAME-COUNT)
      WHEN 20 MOVE "enrollmentEndDate" TO T-NAME(T-NAME-COUNT)
      WHEN 21 MOVE "classId" TO T-NAME(T-NAME-COUNT)
      WHEN 22 MOVE "emergencyContactName" TO T-NAME(T-NAME-COUNT)
      WHEN 23 MOVE "relationshipCode" TO T-NAME(T-NAME-COUNT)
      WHEN 24 MOVE "emergencyPhoneNumber" TO T-NAME(T-NAME-COUNT)
      WHEN 25 MOVE "remarks" TO T-NAME(T-NAME-COUNT)
      WHEN 26 MOVE "schoolYear" TO T-NAME(T-NAME-COUNT)
      WHEN 27 MOVE "gradeCode" TO T-NAME(T-NAME-COUNT)
      WHEN 28 MOVE "reason" TO T-NAME(T-NAME-COUNT)
      WHEN 36 MOVE "deleteReason" TO T-NAME(T-NAME-COUNT)
      WHEN 38 MOVE "pageSize" TO T-NAME(T-NAME-COUNT)
      WHEN 39 MOVE "sortKey" TO T-NAME(T-NAME-COUNT)
      WHEN 40 MOVE "sortDirection" TO T-NAME(T-NAME-COUNT)
      WHEN 42 WHEN 43 WHEN 44 WHEN 45
        MOVE "statusCode" TO T-NAME(T-NAME-COUNT)
    END-EVALUATE
    IF VIEW-MODE = "Search" AND I = 5 MOVE "name" TO T-NAME(T-NAME-COUNT) END-IF.

copy "ST-HELPERS.cpy".
end program STEVENT.
