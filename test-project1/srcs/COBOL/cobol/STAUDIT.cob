       >>SOURCE FORMAT FREE
identification division.
program-id. STAUDIT.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".

procedure division.
    MOVE "LOG-INSERT" TO COMMAND-NAME PERFORM DB-RESET
    MOVE SAVED-ID TO V PERFORM ID-AS-TEMP
    MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE
    IF R-DATA(F-ACTION) = "DELETE" MOVE "DELETE" TO TMP-DATA
    ELSE
      IF STUDENT-ID = 0 MOVE "CREATE" TO TMP-DATA
      ELSE MOVE "UPDATE" TO TMP-DATA END-IF
    END-IF
    COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(TMP-DATA))
    PERFORM ADD-TEMP
    MOVE EXPECTED-VERSION TO V PERFORM ID-AS-TEMP
    IF STUDENT-ID = 0 MOVE -1 TO TMP-NULL END-IF
    MOVE 3 TO PARAM-TYPE PERFORM ADD-TEMP
    COMPUTE V = EXPECTED-VERSION + 1 PERFORM ID-AS-TEMP PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE MOVE CHANGE-LIST TO TMP-DATA
    COMPUTE TMP-LENGTH = CHANGE-LENGTH - 1
    MOVE 1 TO PARAM-TYPE PERFORM ADD-TEMP
    MOVE OWNER-VALUE TO TMP-VALUE PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE MOVE BUSINESS-TIME TO TMP-DATA
    COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(BUSINESS-TIME))
    MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE MOVE CORRELATION-ID TO TMP-DATA
    MOVE 36 TO TMP-LENGTH PERFORM ADD-TEMP
    MOVE N-VALUE(22) TO TMP-VALUE MOVE 1 TO PARAM-TYPE PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE MOVE 1 TO TMP-LENGTH
    IF CONFIRMED-DUP = 1 MOVE "1" TO TMP-DATA ELSE MOVE "0" TO TMP-DATA END-IF
    MOVE 7 TO PARAM-TYPE PERFORM ADD-TEMP
    PERFORM DB-EXECUTE
    GOBACK.

copy "ST-HELPERS.cpy".
end program STAUDIT.
