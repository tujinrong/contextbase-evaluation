       >>SOURCE FORMAT FREE
identification division.
program-id. STMAINT.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
01 ARGUMENT-COUNT PIC S9(9) COMP-5.
01 MAINT-KIND PIC X(16).
01 INPUT-PATH PIC X(4096).
01 MAX-DAY PIC X(10).
01 OCCUPIED-N PIC S9(18) COMP-5.
01 WIDTH-N PIC S9(18) COMP-5.
01 ALLOW-ADD PIC X.
01 SAME-NAME PIC S9(9) COMP-5.
01 TARGET-TABLE PIC X(21).
01 TARGET-KEY.
  05 KEY-LENGTH PIC S9(9) COMP-5.
  05 KEY-NULL PIC S9(4) COMP-5.
  05 FILLER PIC X(2).
  05 KEY-DATA PIC X(1024).
01 KEY-POS PIC S9(9) COMP-5.
01 OPERATION-NAME PIC X(11).
01 OLD-ACTIVE PIC X.
01 NEW-ACTIVE PIC X.

procedure division.
    INITIALIZE APP MOVE 200 TO APP-STATUS MOVE 1 TO APP-ERRORS-LENGTH
    ACCEPT ARGUMENT-COUNT FROM ARGUMENT-NUMBER
    IF ARGUMENT-COUNT NOT = 2
      DISPLAY "Usage: student-maint class|code approved-input.form" STOP RUN RETURNING 2 END-IF
    ACCEPT MAINT-KIND FROM ARGUMENT-VALUE
    ACCEPT INPUT-PATH FROM ARGUMENT-VALUE
    CALL "STCLIREAD" USING INPUT-PATH BY VALUE FUNCTION LENGTH(FUNCTION TRIM(INPUT-PATH))
      BY REFERENCE ST-RAW RETURNING RC END-CALL
    IF RC NOT = 0 DISPLAY "Invalid approved input file" STOP RUN RETURNING 2 END-IF
    IF MAINT-KIND NOT = "class" AND "code"
      DISPLAY "Invalid maintenance kind" STOP RUN RETURNING 2 END-IF
    CALL "STCONNECT" RETURNING DB-HANDLE END-CALL
    IF DB-HANDLE = NULL DISPLAY "Database connection failed" STOP RUN RETURNING 1 END-IF
    CALL "STCLOCK" END-CALL
    IF APP-STATUS NOT = 200 PERFORM FINISH-FAILURE END-IF
    MOVE 0 TO STUDENT-ID EXPECTED-VERSION WRITE-STARTED COMMIT-ATTEMPTED
    IF R-NULL(F-EXPECTEDVERSION) = 0
      CALL "STINTEGER" USING R-VALUE(F-EXPECTEDVERSION) EXPECTED-VERSION
        RETURNING RC END-CALL
      IF RC NOT = 0 OR EXPECTED-VERSION < 1 OR = 9223372036854775807
        PERFORM BAD-INPUT END-IF
    END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(26)
      N-VALUE(1) BY VALUE 4 4 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 5 BY REFERENCE R-VALUE(27)
      N-VALUE(2) BY VALUE 2 2 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 4 BY REFERENCE R-VALUE(55)
      N-VALUE(3) BY VALUE 9 9 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(56)
      N-VALUE(4) BY VALUE 18 18 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(51)
      N-VALUE(5) BY VALUE 10 10 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(52)
      N-VALUE(6) BY VALUE 10 10 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(57)
      N-VALUE(7) BY VALUE 4 4 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(54)
      N-VALUE(8) BY VALUE 10 10 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(53)
      N-VALUE(9) BY VALUE 1 1 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 8 BY REFERENCE R-VALUE(25)
      N-VALUE(10) BY VALUE 120 120 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(48)
      N-VALUE(11) BY VALUE 24 24 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 5 BY REFERENCE R-VALUE(49)
      N-VALUE(12) BY VALUE 10 10 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE R-VALUE(50)
      N-VALUE(13) BY VALUE 12 12 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STUNICODE" USING BY VALUE 8 BY REFERENCE R-VALUE(28)
      N-VALUE(22) BY VALUE 60 60 RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    IF APP-STATUS NOT = 200 PERFORM FINISH-FAILURE END-IF
    CALL "STBEGIN" USING BY VALUE DB-HANDLE 0 BY REFERENCE ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM FINISH-FAILURE END-IF
    MOVE "AUTH-ADMIN" TO COMMAND-NAME PERFORM DB-RESET PERFORM DB-EXECUTE
    IF RC NOT = 0 PERFORM CANCEL-FAILURE END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 1 PERFORM CANCEL-FAILURE END-IF
    MOVE 1 TO K PERFORM FETCH-TEMP
    IF TMP-DATA(1:1) NOT = "1"
      MOVE 403 TO APP-STATUS
      MOVE "E-COM-002: DB管理者権限が必要です。" TO ERROR-TEXT
      PERFORM ADD-ERROR PERFORM CANCEL-FAILURE END-IF
    MOVE 2 TO K PERFORM FETCH-TEMP
    CALL "STUNICODE" USING BY VALUE 1 BY REFERENCE TMP-VALUE OWNER-VALUE
      BY VALUE 64 64 RETURNING RC END-CALL
    IF RC NOT = 0 OR OWNER-NULL = -1 PERFORM CANCEL-FAILURE END-IF
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    IF MAINT-KIND = "class" PERFORM CLASS-MAINT ELSE PERFORM CODE-MAINT END-IF
    IF APP-STATUS NOT = 200 PERFORM CANCEL-FAILURE END-IF
    IF APP-OUTCOME = "NoChange"
      PERFORM ROLLBACK-UNIT DISPLAY "NoChange"
      CALL "STCLOSE" USING BY VALUE DB-HANDLE END-CALL STOP RUN RETURNING 0 END-IF
    PERFORM MAINTENANCE-AUDIT
    IF APP-STATUS NOT = 200 PERFORM CANCEL-FAILURE END-IF
    PERFORM COMMIT-UNIT
    IF RC NOT = 0 PERFORM FINISH-FAILURE END-IF
    DISPLAY "Saved"
    IF SAME-NAME = 1 DISPLAY "W-MST-001: 同じ年度・学年の同名クラスがあります。" END-IF
    CALL "STCLOSE" USING BY VALUE DB-HANDLE END-CALL STOP RUN RETURNING 0.
CLASS-MAINT.
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 6
      IF N-NULL(I) = -1 PERFORM BAD-INPUT END-IF END-PERFORM
    CALL "STINTEGER" USING N-VALUE(1) V RETURNING RC END-CALL
    IF RC NOT = 0 OR V < 1900 OR > 9998 OR N-LENGTH(1) NOT = 4 PERFORM BAD-INPUT END-IF
    MOVE V TO YEAR-N
    PERFORM CODE-DIGITS-GRADE
    PERFORM VARYING J FROM 1 BY 1 UNTIL J > N-LENGTH(3)
      IF (N-DATA(3)(J:1) < "A" OR > "Z") AND (N-DATA(3)(J:1) < "0" OR > "9")
        AND (J = 1 OR N-DATA(3)(J:1) NOT = "-") PERFORM BAD-INPUT END-IF
    END-PERFORM
    MOVE "9999-12-31" TO MAX-DAY
    CALL "STISODATE" USING N-VALUE(5) MAX-DAY RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    CALL "STISODATE" USING N-VALUE(6) MAX-DAY RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    MOVE YEAR-N TO YEAR-OUT
    STRING YEAR-OUT "-04-01" INTO ERA-START END-STRING
    ADD 1 TO YEAR-N MOVE YEAR-N TO YEAR-OUT
    STRING YEAR-OUT "-03-31" INTO ERA-END END-STRING
    IF N-DATA(5)(1:10) < ERA-START OR N-DATA(6)(1:10) > ERA-END
      OR N-DATA(5)(1:10) > N-DATA(6)(1:10) PERFORM BAD-INPUT END-IF
    IF N-NULL(7) = 0
      CALL "STINTEGER" USING N-VALUE(7) V RETURNING RC END-CALL
      IF RC NOT = 0 OR V < 1 OR > 9999 PERFORM BAD-INPUT END-IF END-IF
    CALL "STINTEGER" USING N-VALUE(8) V RETURNING RC END-CALL
    IF RC NOT = 0 OR V > 2147483647 PERFORM BAD-INPUT END-IF
    IF (N-DATA(9)(1:1) NOT = "0" AND "1") OR N-LENGTH(9) NOT = 1 PERFORM BAD-INPUT END-IF
    IF R-NULL(F-CLASSID) = 0
      CALL "STINTEGER" USING R-VALUE(F-CLASSID) STUDENT-ID RETURNING RC END-CALL
      IF RC NOT = 0 OR STUDENT-ID < 1 OR EXPECTED-VERSION < 1 PERFORM BAD-INPUT END-IF
    ELSE
      IF EXPECTED-VERSION NOT = 0 PERFORM BAD-INPUT END-IF END-IF
    IF APP-STATUS NOT = 200 EXIT PARAGRAPH END-IF
    INITIALIZE ST-OLD
    IF STUDENT-ID > 0
      MOVE "MC-LOAD" TO COMMAND-NAME PERFORM DB-RESET
      MOVE 3 TO PARAM-TYPE MOVE F-CLASSID TO PARAM-FIELD PERFORM ADD-RAW
      PERFORM DB-EXECUTE IF RC NOT = 0 EXIT PARAGRAPH END-IF
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      IF RC NOT = 1 PERFORM NOT-FOUND EXIT PARAGRAPH END-IF
      PERFORM VARYING K FROM 1 BY 1 UNTIL K > 11
        CALL "STCOLUMN" USING BY REFERENCE ST-DB-RESULT BY VALUE K
          BY REFERENCE O-VALUE(K) RETURNING RC END-CALL
        IF RC NOT = 0 PERFORM BAD-INPUT END-IF END-PERFORM
      CALL "STINTEGER" USING O-VALUE(11) V RETURNING RC END-CALL
      IF RC NOT = 0 OR V NOT = EXPECTED-VERSION PERFORM CONFLICT EXIT PARAGRAPH END-IF
      IF O-VALUE(1) NOT = N-VALUE(1) OR O-VALUE(3) NOT = N-VALUE(3)
        PERFORM PROTECTED-VALUE EXIT PARAGRAPH END-IF
      MOVE "MC-REF" TO COMMAND-NAME PERFORM DB-RESET
      MOVE 3 TO PARAM-TYPE MOVE F-CLASSID TO PARAM-FIELD PERFORM ADD-RAW
      PERFORM DB-EXECUTE IF RC NOT = 0 EXIT PARAGRAPH END-IF
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      MOVE 1 TO K PERFORM FETCH-TEMP
      CALL "STINTEGER" USING TMP-VALUE V RETURNING RC END-CALL
      IF V > 0 AND O-VALUE(2) NOT = N-VALUE(2) PERFORM PROTECTED-VALUE END-IF
      MOVE 2 TO K PERFORM FETCH-TEMP
      CALL "STINTEGER" USING TMP-VALUE OCCUPIED-N RETURNING RC END-CALL
      IF OCCUPIED-N > 0 AND (N-DATA(9)(1:1) = "0" OR
        N-DATA(5)(1:10) > BUSINESS-DAY OR N-DATA(6)(1:10) < BUSINESS-DAY)
        PERFORM BAD-INPUT END-IF
      IF N-NULL(7) = 0
        CALL "STINTEGER" USING N-VALUE(7) V RETURNING RC END-CALL
        IF V < OCCUPIED-N PERFORM BAD-INPUT END-IF END-IF
    END-IF
    MOVE "ST-CODE" TO COMMAND-NAME PERFORM DB-RESET
    INITIALIZE TMP-VALUE MOVE "GRADE" TO TMP-DATA MOVE 5 TO TMP-LENGTH
    MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP
    MOVE 2 TO PARAM-FIELD PERFORM ADD-NORMAL PERFORM DB-EXECUTE
    IF RC NOT = 0 EXIT PARAGRAPH END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 1 PERFORM BAD-INPUT EXIT PARAGRAPH END-IF
    IF STUDENT-ID = 0 OR O-VALUE(2) NOT = N-VALUE(2)
      MOVE 1 TO K PERFORM FETCH-TEMP IF TMP-DATA(1:1) NOT = "1" PERFORM BAD-INPUT END-IF
      MOVE 2 TO K PERFORM FETCH-TEMP IF TMP-DATA(1:1) NOT = "1" PERFORM BAD-INPUT END-IF
      MOVE 3 TO K PERFORM FETCH-TEMP IF TMP-DATA(1:10) > BUSINESS-DAY PERFORM BAD-INPUT END-IF
      MOVE 4 TO K PERFORM FETCH-TEMP
      IF TMP-NULL = 0 AND TMP-DATA(1:10) < BUSINESS-DAY PERFORM BAD-INPUT END-IF
    END-IF
    IF APP-STATUS NOT = 200 EXIT PARAGRAPH END-IF
    PERFORM CLASS-CHANGES
    IF CHANGE-LENGTH = 3 MOVE "NoChange" TO APP-OUTCOME EXIT PARAGRAPH END-IF
    MOVE "MC-UQ" TO COMMAND-NAME PERFORM DB-RESET
    MOVE 5 TO PARAM-TYPE MOVE 1 TO PARAM-FIELD PERFORM ADD-NORMAL
    MOVE 2 TO PARAM-TYPE MOVE 3 TO PARAM-FIELD PERFORM ADD-NORMAL
    PERFORM OPTIONAL-ID-TWICE PERFORM DB-EXECUTE
    IF RC NOT = 0 EXIT PARAGRAPH END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    MOVE 1 TO K PERFORM FETCH-TEMP
    IF TMP-DATA(1:1) NOT = "0"
      MOVE "E-MST-002: 同年度のクラスコードは使用済みです。" TO ERROR-TEXT
      PERFORM ADD-ERROR EXIT PARAGRAPH END-IF
    MOVE "MC-NAME" TO COMMAND-NAME PERFORM DB-RESET
    MOVE 5 TO PARAM-TYPE MOVE 1 TO PARAM-FIELD PERFORM ADD-NORMAL
    MOVE 2 TO PARAM-TYPE MOVE 2 TO PARAM-FIELD PERFORM ADD-NORMAL
    MOVE 1 TO PARAM-TYPE MOVE 4 TO PARAM-FIELD PERFORM ADD-NORMAL
    PERFORM OPTIONAL-ID-TWICE PERFORM DB-EXECUTE
    IF RC NOT = 0 EXIT PARAGRAPH END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    MOVE 1 TO K PERFORM FETCH-TEMP
    IF TMP-DATA(1:1) NOT = "0" MOVE 1 TO SAME-NAME END-IF
    IF STUDENT-ID = 0 MOVE "MC-INSERT" TO COMMAND-NAME
    ELSE MOVE "MC-UPDATE" TO COMMAND-NAME END-IF
    PERFORM DB-RESET
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 10
      MOVE I TO PARAM-FIELD MOVE 1 TO PARAM-TYPE
      IF I = 1 OR 7 OR 8 MOVE 5 TO PARAM-TYPE END-IF
      IF I = 2 OR 3 MOVE 2 TO PARAM-TYPE END-IF
      IF I = 5 OR 6 MOVE 4 TO PARAM-TYPE END-IF
      IF I = 9 MOVE 7 TO PARAM-TYPE END-IF
      PERFORM ADD-NORMAL END-PERFORM
    PERFORM ADD-ACTOR-TIME
    IF STUDENT-ID > 0
      MOVE 3 TO PARAM-TYPE MOVE F-CLASSID TO PARAM-FIELD PERFORM ADD-RAW
      MOVE F-EXPECTEDVERSION TO PARAM-FIELD PERFORM ADD-RAW END-IF
    MOVE 1 TO WRITE-STARTED PERFORM DB-EXECUTE
    IF RC NOT = 0 EXIT PARAGRAPH END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 1 PERFORM CONFLICT EXIT PARAGRAPH END-IF
    MOVE 1 TO K PERFORM FETCH-TEMP
    CALL "STINTEGER" USING TMP-VALUE SAVED-ID RETURNING RC END-CALL
    MOVE "m_class" TO TARGET-TABLE
    MOVE SAVED-ID TO V PERFORM ID-AS-TEMP MOVE TMP-VALUE TO TARGET-KEY
    MOVE N-DATA(9)(1:1) TO NEW-ACTIVE MOVE O-DATA(9)(1:1) TO OLD-ACTIVE.
CODE-MAINT.
    IF N-DATA(11) NOT = "GENDER" AND "ENROLLMENT_STATUS" AND "PREFECTURE"
      AND "RELATIONSHIP" AND "GRADE" PERFORM BAD-INPUT EXIT PARAGRAPH END-IF
    MOVE "MK-CATEGORY" TO COMMAND-NAME PERFORM DB-RESET
    MOVE 2 TO PARAM-TYPE MOVE 11 TO PARAM-FIELD PERFORM ADD-NORMAL
    PERFORM DB-EXECUTE IF RC NOT = 0 EXIT PARAGRAPH END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 1 PERFORM BAD-INPUT EXIT PARAGRAPH END-IF
    MOVE 1 TO K PERFORM FETCH-TEMP
    CALL "STINTEGER" USING TMP-VALUE WIDTH-N RETURNING RC END-CALL
    IF RC NOT = 0 OR N-LENGTH(12) NOT = WIDTH-N PERFORM BAD-INPUT END-IF
    PERFORM VARYING J FROM 1 BY 1 UNTIL J > N-LENGTH(12)
      IF N-DATA(12)(J:1) < "0" OR > "9" PERFORM BAD-INPUT END-IF END-PERFORM
    MOVE 2 TO K PERFORM FETCH-TEMP MOVE TMP-DATA(1:1) TO ALLOW-ADD
    MOVE "MK-LOAD" TO COMMAND-NAME PERFORM DB-RESET
    MOVE 2 TO PARAM-TYPE MOVE 11 TO PARAM-FIELD PERFORM ADD-NORMAL
    MOVE 12 TO PARAM-FIELD PERFORM ADD-NORMAL PERFORM DB-EXECUTE
    IF RC NOT = 0 EXIT PARAGRAPH END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    INITIALIZE ST-OLD
    IF RC = 1
      MOVE 1 TO STUDENT-ID
      PERFORM VARYING K FROM 1 BY 1 UNTIL K > 8
        CALL "STCOLUMN" USING BY REFERENCE ST-DB-RESULT BY VALUE K
          BY REFERENCE O-VALUE(K) RETURNING RC END-CALL
        IF RC NOT = 0 PERFORM BAD-INPUT END-IF END-PERFORM
      CALL "STINTEGER" USING O-VALUE(8) V RETURNING RC END-CALL
      IF RC NOT = 0 OR V NOT = EXPECTED-VERSION PERFORM CONFLICT EXIT PARAGRAPH END-IF
    ELSE
      IF EXPECTED-VERSION > 0 PERFORM NOT-FOUND EXIT PARAGRAPH END-IF
      IF ALLOW-ADD NOT = "1" PERFORM PROTECTED-VALUE EXIT PARAGRAPH END-IF
    END-IF
    MOVE N-VALUE(13) TO N-VALUE(1) MOVE N-VALUE(8) TO N-VALUE(2)
    MOVE N-VALUE(9) TO N-VALUE(3) MOVE N-VALUE(5) TO N-VALUE(4)
    MOVE N-VALUE(6) TO N-VALUE(5) MOVE N-VALUE(10) TO N-VALUE(6)
    IF N-NULL(1) = -1 PERFORM BAD-INPUT END-IF
    CALL "STINTEGER" USING N-VALUE(2) V RETURNING RC END-CALL
    IF RC NOT = 0 OR V > 2147483647 PERFORM BAD-INPUT END-IF
    IF (N-DATA(3)(1:1) NOT = "0" AND "1") OR N-LENGTH(3) NOT = 1 PERFORM BAD-INPUT END-IF
    MOVE "9999-12-31" TO MAX-DAY
    CALL "STISODATE" USING N-VALUE(4) MAX-DAY RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-INPUT END-IF
    IF N-NULL(5) = 0
      CALL "STISODATE" USING N-VALUE(5) MAX-DAY RETURNING RC END-CALL
      IF RC NOT = 0 OR N-DATA(5)(1:10) < N-DATA(4)(1:10) PERFORM BAD-INPUT END-IF END-IF
    IF STUDENT-ID > 0 AND O-DATA(7)(1:1) = "1"
      IF N-DATA(3)(1:1) = "0" OR N-DATA(4)(1:10) > O-DATA(4)(1:10)
        OR (N-NULL(5) = 0 AND (O-NULL(5) = -1 OR N-DATA(5)(1:10) < O-DATA(5)(1:10)))
        PERFORM PROTECTED-VALUE END-IF END-IF
    IF APP-STATUS NOT = 200 EXIT PARAGRAPH END-IF
    PERFORM CODE-CHANGES
    IF CHANGE-LENGTH = 3 MOVE "NoChange" TO APP-OUTCOME EXIT PARAGRAPH END-IF
    IF STUDENT-ID = 0 MOVE "MK-INSERT" TO COMMAND-NAME
    ELSE MOVE "MK-UPDATE" TO COMMAND-NAME END-IF
    PERFORM DB-RESET
    MOVE 2 TO PARAM-TYPE MOVE 11 TO PARAM-FIELD PERFORM ADD-NORMAL
    MOVE 12 TO PARAM-FIELD PERFORM ADD-NORMAL
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 6
      MOVE I TO PARAM-FIELD MOVE 1 TO PARAM-TYPE
      IF I = 2 MOVE 5 TO PARAM-TYPE END-IF
      IF I = 3 MOVE 7 TO PARAM-TYPE END-IF
      IF I = 4 OR 5 MOVE 4 TO PARAM-TYPE END-IF
      PERFORM ADD-NORMAL END-PERFORM
    PERFORM ADD-ACTOR-TIME
    IF STUDENT-ID > 0 MOVE 3 TO PARAM-TYPE
      MOVE F-EXPECTEDVERSION TO PARAM-FIELD PERFORM ADD-RAW END-IF
    MOVE 1 TO WRITE-STARTED PERFORM DB-EXECUTE
    IF RC NOT = 0 EXIT PARAGRAPH END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 1 PERFORM CONFLICT EXIT PARAGRAPH END-IF
    MOVE "m_code" TO TARGET-TABLE
    INITIALIZE TARGET-KEY MOVE 1 TO KEY-POS
    STRING FUNCTION TRIM(N-DATA(11)) ":" FUNCTION TRIM(N-DATA(12))
      INTO KEY-DATA WITH POINTER KEY-POS END-STRING
    COMPUTE KEY-LENGTH = KEY-POS - 1
    MOVE N-DATA(3)(1:1) TO NEW-ACTIVE MOVE O-DATA(3)(1:1) TO OLD-ACTIVE.
MAINTENANCE-AUDIT.
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    MOVE "CREATE" TO OPERATION-NAME
    IF STUDENT-ID > 0
      MOVE "UPDATE" TO OPERATION-NAME
      IF OLD-ACTIVE = "1" AND NEW-ACTIVE = "0" MOVE "DISABLE" TO OPERATION-NAME END-IF
      IF OLD-ACTIVE = "0" AND NEW-ACTIVE = "1" MOVE "ENABLE" TO OPERATION-NAME END-IF END-IF
    MOVE "MAINT-LOG" TO COMMAND-NAME PERFORM DB-RESET
    INITIALIZE TMP-VALUE MOVE TARGET-TABLE TO TMP-DATA
    COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(TARGET-TABLE))
    MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP
    MOVE TARGET-KEY TO TMP-VALUE PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE MOVE OPERATION-NAME TO TMP-DATA
    COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(OPERATION-NAME))
    PERFORM ADD-TEMP
    MOVE EXPECTED-VERSION TO V PERFORM ID-AS-TEMP
    IF STUDENT-ID = 0 MOVE -1 TO TMP-NULL END-IF
    MOVE 3 TO PARAM-TYPE PERFORM ADD-TEMP
    COMPUTE V = EXPECTED-VERSION + 1 PERFORM ID-AS-TEMP PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE MOVE CHANGE-LIST TO TMP-DATA
    COMPUTE TMP-LENGTH = CHANGE-LENGTH - 1
    MOVE 1 TO PARAM-TYPE PERFORM ADD-TEMP
    PERFORM ADD-ACTOR-TIME
    INITIALIZE TMP-VALUE MOVE CORRELATION-ID TO TMP-DATA MOVE 36 TO TMP-LENGTH
    MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP
    MOVE 1 TO PARAM-TYPE MOVE 22 TO PARAM-FIELD PERFORM ADD-NORMAL
    PERFORM DB-EXECUTE.
ADD-ACTOR-TIME.
    MOVE OWNER-VALUE TO TMP-VALUE MOVE 1 TO PARAM-TYPE PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE MOVE BUSINESS-TIME TO TMP-DATA
    COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(BUSINESS-TIME))
    MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP.
OPTIONAL-ID-TWICE.
    MOVE STUDENT-ID TO V PERFORM ID-AS-TEMP
    IF STUDENT-ID = 0 MOVE -1 TO TMP-NULL END-IF
    MOVE 3 TO PARAM-TYPE PERFORM ADD-TEMP PERFORM ADD-TEMP.
CODE-DIGITS-GRADE.
    IF N-LENGTH(2) NOT = 2 OR N-DATA(2)(1:2) IS NOT NUMERIC PERFORM BAD-INPUT END-IF.
BAD-INPUT.
    MOVE "E-MST-004: マスタ項目・期間・定員を確認してください。" TO ERROR-TEXT PERFORM ADD-ERROR.
PROTECTED-VALUE.
    MOVE "E-MST-003: 保護または参照中のため変更できません。" TO ERROR-TEXT PERFORM ADD-ERROR.
NOT-FOUND.
    MOVE 404 TO APP-STATUS MOVE "NotFound" TO APP-OUTCOME.
CONFLICT.
    MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME.
CANCEL-FAILURE.
    PERFORM ROLLBACK-UNIT
    IF WRITE-STARTED = 1 AND RC NOT = 0 MOVE "Unknown" TO APP-OUTCOME END-IF
    PERFORM FINISH-FAILURE.
FINISH-FAILURE.
    DISPLAY FUNCTION TRIM(APP-OUTCOME)
    IF APP-ERRORS-LENGTH > 1 DISPLAY FUNCTION TRIM(APP-ERRORS) END-IF
    IF APP-OUTCOME = "Unknown" DISPLAY "再送せずDBの保存結果を確認してください。" END-IF
    CALL "STCLOSE" USING BY VALUE DB-HANDLE END-CALL STOP RUN RETURNING 1.
CLASS-CHANGES.
    MOVE SPACES TO CHANGE-LIST MOVE 1 TO CHANGE-LENGTH
    STRING "[" INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    IF STUDENT-ID = 0 OR N-VALUE(1) NOT = O-VALUE(1)
      IF CHANGE-LENGTH > 2 STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING END-IF
      STRING '"school_year"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(2) NOT = O-VALUE(2)
      IF CHANGE-LENGTH > 2 STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING END-IF
      STRING '"grade_code"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(3) NOT = O-VALUE(3)
      IF CHANGE-LENGTH > 2 STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING END-IF
      STRING '"class_code"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(4) NOT = O-VALUE(4)
