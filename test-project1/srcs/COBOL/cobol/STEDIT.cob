       >>SOURCE FORMAT FREE
identification division.
program-id. STEDIT.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
01 DATE-E.
  05 FILLER PIC X(1032).
01 DATE-Y.
  05 FILLER PIC X(1032).
01 DATE-M.
  05 FILLER PIC X(1032).
01 DATE-D.
  05 FILLER PIC X(1032).

procedure division.
    MOVE "Edit" TO VIEW-MODE
    CALL "STSTATE" END-CALL
    IF APP-STATUS NOT = 200 GOBACK END-IF
    IF R-DATA(F-ACTION) = "NEW" OR "EDIT"
      CALL "STPOST" RETURNING RC END-CALL
      IF RC = 1
        MOVE ST-RAW TO SEARCH-PENDING
        MOVE "Search" TO STATE-KIND
        CALL "STSTATEIO" USING BY VALUE DB-HANDLE 3
          BY REFERENCE CONTEXT-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
            SEARCH-STATE BY VALUE LENGTH OF SEARCH-STATE
          BY REFERENCE CONTEXT-REVISION BY VALUE 30 RETURNING RC END-CALL
        IF RC NOT = 0 MOVE 409 TO APP-STATUS GOBACK END-IF
      END-IF
    END-IF
    MOVE 0 TO STUDENT-ID EXPECTED-VERSION
    IF R-NULL(F-STUDENTID) = 0
      CALL "STINTEGER" USING R-VALUE(F-STUDENTID) STUDENT-ID
        RETURNING RC END-CALL
      IF RC NOT = 0 OR STUDENT-ID < 1
        MOVE "E-COM-003: 学生IDが無効です。" TO ERROR-TEXT PERFORM ADD-ERROR
        GOBACK
      END-IF
    END-IF
    IF R-DATA(F-ACTION) = "EDITOPTIONS"
      MOVE R-DATA(F-EDITORID) TO EDITOR-ID
      PERFORM RESTORE-EDITOR
      IF APP-STATUS = 200 CALL "STCAND" END-CALL END-IF GOBACK
    END-IF
    IF R-DATA(F-ACTION) = "CANCEL"
      MOVE R-DATA(F-EDITORID) TO EDITOR-ID PERFORM RESTORE-EDITOR
      IF APP-STATUS = 200 AND R-NULL(F-CONFIRMATIONTOKEN) = 0
        MOVE R-DATA(F-CONFIRMATIONTOKEN) TO CONFIRM-ID
        MOVE "Confirmation" TO STATE-KIND
        CALL "STSTATEIO" USING BY VALUE DB-HANDLE 2
          BY REFERENCE CONFIRM-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
            CONFIRM-PAYLOAD BY VALUE LENGTH OF CONFIRM-PAYLOAD
          BY REFERENCE CONFIRM-REVISION BY VALUE 10 RETURNING RC END-CALL
        IF RC = 0
          CALL "STSTATEIO" USING BY VALUE DB-HANDLE 4
            BY REFERENCE CONFIRM-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
              CONFIRM-PAYLOAD BY VALUE LENGTH OF CONFIRM-PAYLOAD
            BY REFERENCE CONFIRM-REVISION BY VALUE 10 RETURNING RC END-CALL
        END-IF
      END-IF
      INITIALIZE R-VALUE(F-CONFIRMATIONTOKEN)
      MOVE -1 TO R-NULL(F-CONFIRMATIONTOKEN) GOBACK
    END-IF
    IF R-DATA(F-ACTION) = "RESET"
      IF R-DATA(F-CONFIRMED) NOT = "1"
        MOVE "W-STU-104: 取消確認が必要です。" TO ERROR-TEXT
        PERFORM ADD-ERROR GOBACK
      END-IF
      MOVE R-DATA(F-EDITORID) TO EDITOR-ID
      MOVE "Editor" TO STATE-KIND
      CALL "STSTATEIO" USING BY VALUE DB-HANDLE 2
        BY REFERENCE EDITOR-ID STATE-KIND OWNER-VALUE SESSION-VALUE
          TAB-ID EDITOR-STATE BY VALUE LENGTH OF EDITOR-STATE
        BY REFERENCE EDITOR-REVISION BY VALUE 30 RETURNING RC END-CALL
      IF RC NOT = 0 OR EDITOR-TARGET NOT = STUDENT-ID
        MOVE "E-COM-003: 元の画面情報が無効です。" TO ERROR-TEXT
        PERFORM ADD-ERROR GOBACK
      END-IF
      MOVE EDITOR-RAW TO ST-RAW MOVE EDITOR-NORMAL TO ST-NORMAL
      MOVE EDITOR-VERSION TO EXPECTED-VERSION
      GOBACK
    END-IF
    IF R-DATA(F-ACTION) = "RELOAD" AND R-DATA(F-CONFIRMED) NOT = "1"
      MOVE "W-STU-109: 再読込確認が必要です。" TO ERROR-TEXT
      PERFORM ADD-ERROR GOBACK
    END-IF
    INITIALIZE ST-NORMAL
    IF STUDENT-ID > 0
      MOVE "ST-LOAD" TO COMMAND-NAME PERFORM DB-RESET
      MOVE 3 TO PARAM-TYPE MOVE F-STUDENTID TO PARAM-FIELD PERFORM ADD-RAW
      PERFORM DB-EXECUTE
      IF RC NOT = 0 GOBACK END-IF
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      IF RC NOT = 1
        MOVE 404 TO APP-STATUS MOVE "NotFound" TO APP-OUTCOME
        MOVE "E-STU-103: 対象が見つかりません。" TO ERROR-TEXT
        PERFORM ADD-ERROR GOBACK
      END-IF
      PERFORM VARYING I FROM 1 BY 1 UNTIL I > 25
        CALL "STCOLUMN" USING BY REFERENCE ST-DB-RESULT BY VALUE I
          BY REFERENCE N-VALUE(I) RETURNING RC END-CALL
        IF RC NOT = 0
          MOVE 503 TO APP-STATUS MOVE "SystemError" TO APP-OUTCOME
          GOBACK
        END-IF
      END-PERFORM
      CALL "STINTEGER" USING N-VALUE(22) EXPECTED-VERSION
        RETURNING RC END-CALL
      IF RC NOT = 0 MOVE 503 TO APP-STATUS GOBACK END-IF
      CALL "STCURSOR" USING ST-DB-RESULT END-CALL
      PERFORM MAP-LOADED-RAW
    ELSE
      PERFORM VARYING I FROM 4 BY 1 UNTIL I > 28
        INITIALIZE R-VALUE(I) MOVE -1 TO R-NULL(I)
      END-PERFORM
      MOVE "0" TO R-DATA(F-GENDERCODE) MOVE 1 TO R-LENGTH(F-GENDERCODE)
      MOVE 0 TO R-NULL(F-GENDERCODE)
      MOVE "01" TO R-DATA(F-ENROLLMENTSTATUSCODE)
      MOVE 2 TO R-LENGTH(F-ENROLLMENTSTATUSCODE)
      MOVE 0 TO R-NULL(F-ENROLLMENTSTATUSCODE)
      MOVE BUSINESS-DAY(1:4) TO R-DATA(F-SCHOOLYEAR)
      COMPUTE YEAR-N = FUNCTION NUMVAL(BUSINESS-DAY(1:4))
      IF BUSINESS-DAY(6:2) < "04" SUBTRACT 1 FROM YEAR-N END-IF
      MOVE YEAR-N TO YEAR-OUT MOVE YEAR-OUT TO R-DATA(F-SCHOOLYEAR)
      MOVE 4 TO R-LENGTH(F-SCHOOLYEAR) MOVE 0 TO R-NULL(F-SCHOOLYEAR)
    END-IF
    IF STUDENT-ID > 0
      INITIALIZE R-VALUE(F-SCHOOLYEAR) R-VALUE(F-GRADECODE)
      MOVE -1 TO R-NULL(F-SCHOOLYEAR) R-NULL(F-GRADECODE)
      IF N-NULL(15) = 0
        MOVE "ST-CLASS" TO COMMAND-NAME PERFORM DB-RESET
        MOVE 3 TO PARAM-TYPE MOVE 15 TO PARAM-FIELD PERFORM ADD-NORMAL
        PERFORM DB-EXECUTE IF RC NOT = 0 GOBACK END-IF
        CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
        IF RC = 1
          MOVE 1 TO K PERFORM FETCH-TEMP MOVE TMP-VALUE TO R-VALUE(F-SCHOOLYEAR)
          MOVE 2 TO K PERFORM FETCH-TEMP MOVE TMP-VALUE TO R-VALUE(F-GRADECODE)
        END-IF
        CALL "STCURSOR" USING ST-DB-RESULT END-CALL
      END-IF
    END-IF
    MOVE STUDENT-ID TO EDITOR-TARGET
    MOVE EXPECTED-VERSION TO EDITOR-VERSION
    MOVE TAB-ID TO EDITOR-TAB
    MOVE ST-RAW TO EDITOR-RAW MOVE ST-NORMAL TO EDITOR-NORMAL
    MOVE "Editor" TO STATE-KIND
    CALL "STSTATEIO" USING BY VALUE DB-HANDLE 1
      BY REFERENCE EDITOR-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
        EDITOR-STATE BY VALUE LENGTH OF EDITOR-STATE
      BY REFERENCE EDITOR-REVISION BY VALUE 30 RETURNING RC END-CALL
    IF RC NOT = 0
      MOVE 503 TO APP-STATUS
      MOVE "E-COM-004: 編集情報を保持できません。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    END-IF
    GOBACK.
RESTORE-EDITOR.
    MOVE "Editor" TO STATE-KIND
    CALL "STSTATEIO" USING BY VALUE DB-HANDLE 2
      BY REFERENCE EDITOR-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
        EDITOR-STATE BY VALUE LENGTH OF EDITOR-STATE
      BY REFERENCE EDITOR-REVISION BY VALUE 30 RETURNING RC END-CALL
    IF RC NOT = 0 OR EDITOR-TARGET NOT = STUDENT-ID
      MOVE "E-COM-003: 元の画面情報が無効です。" TO ERROR-TEXT
      PERFORM ADD-ERROR
    ELSE
      MOVE EDITOR-VERSION TO EXPECTED-VERSION
    END-IF.
MAP-LOADED-RAW.
    MOVE N-VALUE(1) TO R-VALUE(4)
    MOVE N-VALUE(2) TO R-VALUE(5)
    MOVE N-VALUE(3) TO R-VALUE(6)
    MOVE N-VALUE(5) TO R-VALUE(11)
    MOVE N-VALUE(6) TO R-VALUE(12)
    MOVE N-VALUE(7) TO R-VALUE(13)
    MOVE N-VALUE(8) TO R-VALUE(14)
    MOVE N-VALUE(9) TO R-VALUE(15)
    MOVE N-VALUE(10) TO R-VALUE(16)
    MOVE N-VALUE(11) TO R-VALUE(17)
    MOVE N-VALUE(12) TO R-VALUE(18)
    MOVE N-VALUE(13) TO R-VALUE(19)
    MOVE N-VALUE(14) TO R-VALUE(20)
    MOVE N-VALUE(15) TO R-VALUE(21)
    MOVE N-VALUE(16) TO R-VALUE(22)
    MOVE N-VALUE(17) TO R-VALUE(23)
    MOVE N-VALUE(18) TO R-VALUE(24)
    MOVE N-VALUE(19) TO R-VALUE(25)
    CALL "STDATEOUT" USING N-DATA(4) DATE-E DATE-Y DATE-M DATE-D
      WAREKI-OUT WAREKI-LENGTH RETURNING RC END-CALL
    MOVE DATE-E TO R-VALUE(F-BIRTHERA) MOVE DATE-Y TO R-VALUE(F-BIRTHYEAR)
    MOVE DATE-M TO R-VALUE(F-BIRTHMONTH) MOVE DATE-D TO R-VALUE(F-BIRTHDAY)
    MOVE EXPECTED-VERSION TO V PERFORM ID-AS-TEMP
    MOVE TMP-VALUE TO R-VALUE(F-EXPECTEDVERSION).

copy "ST-HELPERS.cpy".
end program STEDIT.
