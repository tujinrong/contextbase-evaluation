       >>SOURCE FORMAT FREE
identification division.
program-id. STSAVE.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".

procedure division.
    IF ROLE-CODE = 0
      MOVE 403 TO APP-STATUS MOVE "Forbidden" TO APP-OUTCOME
      MOVE "E-COM-002: 保存権限がありません。" TO ERROR-TEXT
      PERFORM ADD-ERROR GOBACK
    END-IF
    CALL "STSTATE" END-CALL
    IF APP-STATUS NOT = 200 GOBACK END-IF
    MOVE 0 TO STUDENT-ID EXPECTED-VERSION
    IF R-NULL(F-STUDENTID) = 0
      CALL "STINTEGER" USING R-VALUE(F-STUDENTID) STUDENT-ID RETURNING RC
        END-CALL
      IF RC NOT = 0 OR STUDENT-ID < 1 PERFORM INVALID-ID GOBACK END-IF
      CALL "STINTEGER" USING R-VALUE(F-EXPECTEDVERSION) EXPECTED-VERSION
        RETURNING RC END-CALL
      IF RC NOT = 0 OR EXPECTED-VERSION < 1
        PERFORM INVALID-ID GOBACK END-IF
    ELSE
      IF R-NULL(F-EXPECTEDVERSION) = 0 PERFORM INVALID-ID GOBACK END-IF
    END-IF
    MOVE R-DATA(F-EDITORID) TO EDITOR-ID MOVE "Editor" TO STATE-KIND
    CALL "STSTATEIO" USING BY VALUE DB-HANDLE 2
      BY REFERENCE EDITOR-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
        EDITOR-STATE BY VALUE LENGTH OF EDITOR-STATE
      BY REFERENCE EDITOR-REVISION BY VALUE 30 RETURNING RC END-CALL
    IF RC NOT = 0 OR EDITOR-TARGET NOT = STUDENT-ID OR
      EDITOR-VERSION NOT = EXPECTED-VERSION
      PERFORM INVALID-ID GOBACK END-IF
    CALL "STNORM" END-CALL CALL "STVALID" END-CALL
    IF N-NULL(27) = 0
      CALL "STINTEGER" USING N-VALUE(27) V RETURNING RC END-CALL
      IF RC NOT = 0 OR V < 1900 OR > 9998 OR N-LENGTH(27) NOT = 4
        MOVE "E-DATE-003: 年度が不正です。" TO ERROR-TEXT PERFORM ADD-ERROR
      END-IF
    END-IF
    IF APP-STATUS NOT = 200 GOBACK END-IF
    MOVE 0 TO WRITE-STARTED COMMIT-ATTEMPTED
    CALL "STBEGIN" USING BY VALUE DB-HANDLE 0 BY REFERENCE ST-DB-RESULT
      RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
    INITIALIZE ST-OLD
    IF STUDENT-ID > 0
      MOVE "ST-LOAD" TO COMMAND-NAME PERFORM DB-RESET
      MOVE 3 TO PARAM-TYPE MOVE F-STUDENTID TO PARAM-FIELD PERFORM ADD-RAW
      PERFORM DB-EXECUTE IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      IF RC NOT = 1
        MOVE 404 TO APP-STATUS MOVE "NotFound" TO APP-OUTCOME
        MOVE "E-STU-103: 対象が見つかりません。" TO ERROR-TEXT
        PERFORM ADD-ERROR PERFORM ROLLBACK-UNIT GOBACK
      END-IF
      PERFORM VARYING I FROM 1 BY 1 UNTIL I > 25
        CALL "STCOLUMN" USING BY REFERENCE ST-DB-RESULT BY VALUE I
          BY REFERENCE O-VALUE(I) RETURNING RC END-CALL
        IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
      END-PERFORM
      CALL "STINTEGER" USING O-VALUE(22) OLD-VERSION RETURNING RC END-CALL
      IF RC NOT = 0 OR OLD-VERSION NOT = EXPECTED-VERSION
        MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME
        MOVE "E-STU-105: 最新情報へ再読込してください。" TO ERROR-TEXT
        PERFORM ADD-ERROR PERFORM ROLLBACK-UNIT GOBACK
      END-IF
    END-IF
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    CALL "STRULES" END-CALL
    IF APP-STATUS NOT = 200 PERFORM ROLLBACK-UNIT GOBACK END-IF
    MOVE SPACES TO CHANGE-LIST MOVE 1 TO CHANGE-LENGTH
    STRING "[" INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    IF STUDENT-ID = 0 OR N-VALUE(1) NOT = O-VALUE(1)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"student_no"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(2) NOT = O-VALUE(2)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"student_name"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(3) NOT = O-VALUE(3)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"student_name_kana"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(4) NOT = O-VALUE(4)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"birth_date"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(5) NOT = O-VALUE(5)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"gender_code"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(6) NOT = O-VALUE(6)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"postal_code"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(7) NOT = O-VALUE(7)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"prefecture_code"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(8) NOT = O-VALUE(8)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"address_line1"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(9) NOT = O-VALUE(9)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"address_line2"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(10) NOT = O-VALUE(10)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"phone_number"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(11) NOT = O-VALUE(11)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"email_address"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(12) NOT = O-VALUE(12)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"admission_date"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(13) NOT = O-VALUE(13)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"enrollment_status_code"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(14) NOT = O-VALUE(14)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"enrollment_end_date"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(15) NOT = O-VALUE(15)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"class_id"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(16) NOT = O-VALUE(16)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"emergency_contact_name"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(17) NOT = O-VALUE(17)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"relationship_code"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(18) NOT = O-VALUE(18)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"emergency_phone_number"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(19) NOT = O-VALUE(19)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"remarks"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(20) NOT = O-VALUE(20)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"name_key"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(21) NOT = O-VALUE(21)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"kana_key"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    IF STUDENT-ID = 0 OR N-VALUE(25) NOT = O-VALUE(25)
      IF CHANGE-LENGTH > 2
        STRING "," INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
      END-IF
      STRING '"relationship_category"' INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    END-IF
    STRING "]" INTO CHANGE-LIST WITH POINTER CHANGE-LENGTH END-STRING
    IF CHANGE-LENGTH = 3
      PERFORM ROLLBACK-UNIT
      MOVE "NoChange" TO APP-OUTCOME
      MOVE "I-STU-004: 変更内容がありません。" TO APP-MESSAGE
      COMPUTE APP-MESSAGE-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(APP-MESSAGE))
      GOBACK
    END-IF
    IF EXPECTED-VERSION = 9223372036854775807
      MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME
      PERFORM ROLLBACK-UNIT GOBACK END-IF
    MOVE "ST-UQ" TO COMMAND-NAME PERFORM DB-RESET
    MOVE 2 TO PARAM-TYPE MOVE 1 TO PARAM-FIELD PERFORM ADD-NORMAL
    MOVE STUDENT-ID TO V PERFORM ID-AS-TEMP
    IF STUDENT-ID = 0 MOVE -1 TO TMP-NULL END-IF
    MOVE 3 TO PARAM-TYPE PERFORM ADD-TEMP PERFORM ADD-TEMP
    PERFORM DB-EXECUTE IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    MOVE 1 TO K PERFORM FETCH-TEMP
    CALL "STINTEGER" USING TMP-VALUE V RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
    IF V > 0
      MOVE "E-STU-101: 学籍番号は使用済みです。" TO ERROR-TEXT
      PERFORM ADD-ERROR PERFORM ROLLBACK-UNIT GOBACK
    END-IF
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    CALL "STDUP" END-CALL
    IF APP-STATUS NOT = 200
      IF APP-OUTCOME NOT = "ConfirmationRequired" PERFORM ROLLBACK-UNIT END-IF
      GOBACK
    END-IF
    IF STUDENT-ID = 0 MOVE "ST-INSERT" TO COMMAND-NAME
    ELSE MOVE "ST-UPDATE" TO COMMAND-NAME END-IF
    PERFORM DB-RESET
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 21
      MOVE I TO PARAM-FIELD MOVE 1 TO PARAM-TYPE
      IF I = 1 OR 5 OR 6 OR 7 OR 10 OR 11 OR 13 OR 17 OR 18
        MOVE 2 TO PARAM-TYPE END-IF
      IF I = 4 OR 12 OR 14 MOVE 4 TO PARAM-TYPE END-IF
      IF I = 15 MOVE 3 TO PARAM-TYPE END-IF
      PERFORM ADD-NORMAL
    END-PERFORM
    MOVE 25 TO PARAM-FIELD MOVE 2 TO PARAM-TYPE PERFORM ADD-NORMAL
    PERFORM ADD-ACTOR-TIME
    IF STUDENT-ID > 0
      MOVE 3 TO PARAM-TYPE MOVE F-STUDENTID TO PARAM-FIELD PERFORM ADD-RAW
      MOVE F-EXPECTEDVERSION TO PARAM-FIELD PERFORM ADD-RAW
    END-IF
    MOVE 1 TO WRITE-STARTED
    PERFORM DB-EXECUTE IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 1
      MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME
      PERFORM ROLLBACK-UNIT GOBACK
    END-IF
    MOVE 1 TO K PERFORM FETCH-TEMP
    CALL "STINTEGER" USING TMP-VALUE SAVED-ID RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    CALL "STAUDIT" END-CALL
    IF APP-STATUS NOT = 200 PERFORM DB-FAILURE GOBACK END-IF
    IF CONFIRMED-DUP = 1
      MOVE "Confirmation" TO STATE-KIND
      CALL "STSTATEIO" USING BY VALUE DB-HANDLE 4
        BY REFERENCE CONFIRM-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
          CONFIRM-PAYLOAD BY VALUE LENGTH OF CONFIRM-PAYLOAD
        BY REFERENCE CONFIRM-REVISION BY VALUE 10 RETURNING RC END-CALL
      IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
    END-IF
    IF CONFIRMED-DUP = 1
      MOVE SPACES TO EDITOR-PENDING
      CALL "STPEND" END-CALL
      IF APP-STATUS NOT = 200 PERFORM DB-FAILURE GOBACK END-IF
    END-IF
    PERFORM COMMIT-UNIT
    IF RC = 0 MOVE "Saved" TO APP-OUTCOME END-IF
    GOBACK.
ADD-ACTOR-TIME.
    MOVE OWNER-VALUE TO TMP-VALUE MOVE 1 TO PARAM-TYPE PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE MOVE BUSINESS-TIME TO TMP-DATA
    COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(BUSINESS-TIME))
    MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP.
INVALID-ID.
    MOVE "E-COM-003: ID・版・編集情報が無効です。" TO ERROR-TEXT
    PERFORM ADD-ERROR.
DB-FAILURE.
    PERFORM ROLLBACK-UNIT
    MOVE 503 TO APP-STATUS
    IF WRITE-STARTED = 1 AND (COMMIT-ATTEMPTED = 1 OR RC NOT = 0)
      MOVE "Unknown" TO APP-OUTCOME
      MOVE "E-COM-004: 結果不明です。再送せず検索で確認してください。"
        TO ERROR-TEXT
    ELSE
      MOVE "SystemError" TO APP-OUTCOME
      MOVE "E-COM-004: 処理を完了できませんでした。" TO ERROR-TEXT
    END-IF
    PERFORM ADD-ERROR.

copy "ST-HELPERS.cpy".
end program STSAVE.
