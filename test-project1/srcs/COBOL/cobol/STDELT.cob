       >>SOURCE FORMAT FREE
identification division.
program-id. STDELT.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
01 DELETE-RAW-BACKUP PIC X(66048).
01 DELETE-FIELD PIC X(1032).

procedure division.
    IF ROLE-CODE NOT = 2 OR R-DATA(F-CONFIRMED) NOT = "1"
      MOVE 403 TO APP-STATUS MOVE "Forbidden" TO APP-OUTCOME
      MOVE "E-COM-002: 管理者権限と明示確認が必要です。" TO ERROR-TEXT
      PERFORM ADD-ERROR GOBACK
    END-IF
    CALL "STSTATE" END-CALL IF APP-STATUS NOT = 200 GOBACK END-IF
    CALL "STINTEGER" USING R-VALUE(F-STUDENTID) STUDENT-ID RETURNING RC
      END-CALL
    IF RC NOT = 0 OR STUDENT-ID < 1 PERFORM INVALID-ID GOBACK END-IF
    CALL "STINTEGER" USING R-VALUE(F-EXPECTEDVERSION) EXPECTED-VERSION
      RETURNING RC END-CALL
    IF RC NOT = 0 OR EXPECTED-VERSION < 1 OR = 9223372036854775807
      PERFORM INVALID-ID GOBACK END-IF
    MOVE R-DATA(F-EDITORID) TO EDITOR-ID
    MOVE "Editor" TO STATE-KIND
    CALL "STSTATEIO" USING BY VALUE DB-HANDLE 2
      BY REFERENCE EDITOR-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
        EDITOR-STATE BY VALUE LENGTH OF EDITOR-STATE
      BY REFERENCE EDITOR-REVISION BY VALUE 30 RETURNING RC END-CALL
    IF RC NOT = 0 OR EDITOR-TARGET NOT = STUDENT-ID
      PERFORM INVALID-ID GOBACK END-IF
    PERFORM VARYING I FROM 4 BY 1 UNTIL I > 27
      MOVE ST-RAW TO DELETE-RAW-BACKUP
      MOVE EDITOR-RAW TO ST-RAW
      MOVE R-VALUE(I) TO DELETE-FIELD
      MOVE DELETE-RAW-BACKUP TO ST-RAW
      MOVE DELETE-FIELD TO R-VALUE(I)
    END-PERFORM
    CALL "STUNICODE" USING BY VALUE 8 BY REFERENCE R-VALUE(F-DELETEREASON)
      N-VALUE(22) BY VALUE 60 60 RETURNING RC END-CALL
    IF RC NOT = 0 OR N-NULL(22) = -1
      MOVE "E-STU-020: 削除理由を60文字以内で入力してください。" TO ERROR-TEXT
      PERFORM ADD-ERROR GOBACK END-IF
    MOVE 0 TO WRITE-STARTED COMMIT-ATTEMPTED CONFIRMED-DUP
    CALL "STBEGIN" USING BY VALUE DB-HANDLE 0 BY REFERENCE ST-DB-RESULT
      RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
    MOVE "ST-LOAD" TO COMMAND-NAME PERFORM DB-RESET
    MOVE 3 TO PARAM-TYPE MOVE F-STUDENTID TO PARAM-FIELD PERFORM ADD-RAW
    PERFORM DB-EXECUTE IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 1
      MOVE 404 TO APP-STATUS MOVE "NotFound" TO APP-OUTCOME
      MOVE "E-STU-103: 対象が見つかりません。" TO ERROR-TEXT
      PERFORM ADD-ERROR PERFORM ROLLBACK-UNIT GOBACK
    END-IF
    MOVE 22 TO K PERFORM FETCH-TEMP
    CALL "STINTEGER" USING TMP-VALUE OLD-VERSION RETURNING RC END-CALL
    IF RC NOT = 0 OR OLD-VERSION NOT = EXPECTED-VERSION
      MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME
      MOVE "E-STU-105: 最新情報へ再読込してください。" TO ERROR-TEXT
      PERFORM ADD-ERROR PERFORM ROLLBACK-UNIT GOBACK
    END-IF
    MOVE "ST-DELETE" TO COMMAND-NAME PERFORM DB-RESET
    MOVE OWNER-VALUE TO TMP-VALUE MOVE 1 TO PARAM-TYPE PERFORM ADD-TEMP
    INITIALIZE TMP-VALUE MOVE BUSINESS-TIME TO TMP-DATA
    COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(BUSINESS-TIME))
    MOVE 2 TO PARAM-TYPE PERFORM ADD-TEMP
    MOVE 1 TO PARAM-TYPE MOVE 22 TO PARAM-FIELD PERFORM ADD-NORMAL
    MOVE 3 TO PARAM-TYPE MOVE F-STUDENTID TO PARAM-FIELD PERFORM ADD-RAW
    MOVE F-EXPECTEDVERSION TO PARAM-FIELD PERFORM ADD-RAW
    MOVE 1 TO WRITE-STARTED
    PERFORM DB-EXECUTE IF RC NOT = 0 PERFORM DB-FAILURE GOBACK END-IF
    CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
    IF RC NOT = 1
      MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME
      PERFORM ROLLBACK-UNIT GOBACK END-IF
    MOVE STUDENT-ID TO SAVED-ID
    MOVE '["is_deleted","deleted_at","deleted_by","delete_reason"]'
      TO CHANGE-LIST
    COMPUTE CHANGE-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(CHANGE-LIST)) + 1
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    CALL "STAUDIT" END-CALL
    IF APP-STATUS NOT = 200 PERFORM DB-FAILURE GOBACK END-IF
    MOVE SPACES TO EDITOR-PENDING
    CALL "STPEND" END-CALL
    IF APP-STATUS NOT = 200 PERFORM DB-FAILURE GOBACK END-IF
    PERFORM COMMIT-UNIT
    IF RC = 0 MOVE "Saved" TO APP-OUTCOME END-IF
    GOBACK.
INVALID-ID.
    MOVE "E-COM-003: ID・版が無効です。" TO ERROR-TEXT PERFORM ADD-ERROR.
DB-FAILURE.
    PERFORM ROLLBACK-UNIT MOVE 503 TO APP-STATUS
    IF WRITE-STARTED = 1 AND (COMMIT-ATTEMPTED = 1 OR RC NOT = 0)
      MOVE "Unknown" TO APP-OUTCOME
      MOVE "E-COM-004: 結果不明です。再送せず検索で確認してください。"
        TO ERROR-TEXT
    ELSE MOVE "SystemError" TO APP-OUTCOME
      MOVE "E-COM-004: 処理を完了できませんでした。" TO ERROR-TEXT END-IF
    PERFORM ADD-ERROR.

copy "ST-HELPERS.cpy".
end program STDELT.
