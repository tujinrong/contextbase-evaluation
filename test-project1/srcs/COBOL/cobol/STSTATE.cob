       >>SOURCE FORMAT FREE
identification division.
program-id. STSTATE.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
01 STATE-REQUEST-RAW PIC X(66048).

procedure division.
    MOVE "Search" TO STATE-KIND
    MOVE 30 TO STATE-MINUTES
    IF R-NULL(F-CONTEXTID) = -1
      IF R-DATA(F-ACTION) = "SEARCH" OR "PAGE" OR "CLEAR" OR "RESUME"
        MOVE -1 TO RC
        PERFORM INVALID-CONTEXT GOBACK
      END-IF
      INITIALIZE SEARCH-STATE
      MOVE TAB-ID TO SEARCH-TAB
      MOVE ST-RAW TO STATE-REQUEST-RAW
      CALL "STDEFAULTS" END-CALL
      MOVE ST-RAW TO SEARCH-RAW SEARCH-PENDING
      MOVE 20 TO SEARCH-SIZE MOVE 1 TO SEARCH-PAGE
      MOVE STATE-REQUEST-RAW TO ST-RAW
      CALL "STSTATEIO" USING BY VALUE DB-HANDLE 1
        BY REFERENCE CONTEXT-ID STATE-KIND OWNER-VALUE SESSION-VALUE
          TAB-ID SEARCH-STATE BY VALUE LENGTH OF SEARCH-STATE
        BY REFERENCE CONTEXT-REVISION BY VALUE STATE-MINUTES
        RETURNING RC END-CALL
    ELSE
      MOVE R-DATA(F-CONTEXTID) TO CONTEXT-ID
      CALL "STSTATEIO" USING BY VALUE DB-HANDLE 2
        BY REFERENCE CONTEXT-ID STATE-KIND OWNER-VALUE SESSION-VALUE
          TAB-ID SEARCH-STATE BY VALUE LENGTH OF SEARCH-STATE
        BY REFERENCE CONTEXT-REVISION BY VALUE STATE-MINUTES
        RETURNING RC END-CALL
      IF RC = 0
        IF SEARCH-TAB NOT = TAB-ID MOVE -1 TO RC END-IF
        CALL "STPOST" RETURNING I END-CALL
        IF R-DATA(F-ACTION) = "SEARCH" OR "PAGE" OR "CLEAR" OR "RESUME"
          OR "OPTIONS" OR "EDITOPTIONS" OR "CANCEL" OR "SAVE" OR "CONFIRM"
          OR "DELETE" OR "RESET" OR "RELOAD" OR
          (I = 1 AND (R-DATA(F-ACTION) = "NEW" OR "EDIT"))
          CALL "STINTEGER" USING R-VALUE(F-CONTEXTREVISION) V
            RETURNING I END-CALL
          IF I NOT = 0 OR V NOT = CONTEXT-REVISION MOVE -1 TO RC END-IF
        END-IF
      END-IF
    END-IF
    IF RC NOT = 0 PERFORM INVALID-CONTEXT END-IF
    GOBACK.
INVALID-CONTEXT.
      MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME
      MOVE "W-SRC-002: 画面の保持期限または版が無効です。開き直してください。"
        TO ERROR-TEXT PERFORM ADD-ERROR.


copy "ST-HELPERS.cpy".
end program STSTATE.
