       >>SOURCE FORMAT FREE
identification division.
program-id. STMAIN.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".

procedure division.
    INITIALIZE APP
    MOVE 200 TO APP-STATUS MOVE 1 TO APP-ERRORS-LENGTH
    MOVE "Search" TO VIEW-MODE
    CALL "STHTTP" USING ST-RAW RETURNING RC END-CALL
    IF RC NOT = 0
        MOVE 400 TO APP-STATUS
        IF RC = -2
          MOVE "E-SRC-002: 未知または廃止された検索項目です。" TO ERROR-TEXT
        ELSE
          MOVE "E-COM-003: 要求形式またはサイズが無効です。" TO ERROR-TEXT
        END-IF
        PERFORM ADD-ERROR
    ELSE
        IF R-DATA(F-ACTION) = "OPTIONS" AND R-NULL(F-EDITORID) = 0
          MOVE "EDITOPTIONS" TO R-DATA(F-ACTION)
          MOVE 11 TO R-LENGTH(F-ACTION)
        END-IF
        IF R-DATA(F-ACTION) = "CREATE" OR "UPDATE"
          MOVE "SAVE" TO R-DATA(F-ACTION) MOVE 4 TO R-LENGTH(F-ACTION)
        END-IF
        IF R-NULL(F-PAGETARGET) = 0
          MOVE "PAGE" TO R-DATA(F-ACTION) MOVE 4 TO R-LENGTH(F-ACTION)
          MOVE 0 TO R-NULL(F-ACTION)
          MOVE R-VALUE(F-PAGETARGET) TO R-VALUE(F-PAGE)
        END-IF
        CALL "STAUTH" END-CALL
    END-IF
    IF APP-STATUS = 200
      CALL "STCONNECT" RETURNING DB-HANDLE END-CALL
      IF DB-HANDLE = NULL
        MOVE 503 TO APP-STATUS
        MOVE "E-COM-004: DBへ接続できませんでした。" TO ERROR-TEXT
        PERFORM ADD-ERROR
      ELSE
        CALL "STCLOCK" END-CALL
        IF APP-STATUS = 200 CALL "STMCHECK" END-CALL END-IF
      END-IF
    END-IF
    IF APP-STATUS = 200 AND R-NULL(F-NAVIGATION) = 0
      CALL "STNAV" END-CALL END-IF
    IF APP-STATUS = 200 AND APP-OUTCOME NOT = "NavigationReady"
      CALL "STPROMPT" END-CALL END-IF
    IF APP-STATUS = 200 AND APP-OUTCOME NOT = "ActionConfirmation"
      AND "PromptCancelled" AND "NavigationReady"
      EVALUATE FUNCTION TRIM(R-DATA(F-ACTION))
      WHEN "NEW" WHEN "EDIT" WHEN "RESET" WHEN "RELOAD" WHEN "EDITOPTIONS" WHEN "CANCEL"
        CALL "STEDIT" END-CALL
      WHEN "SAVE" WHEN "CONFIRM"
        MOVE "Edit" TO VIEW-MODE CALL "STSAVE" END-CALL
      WHEN "DELETE"
        MOVE "Edit" TO VIEW-MODE CALL "STDELT" END-CALL
      WHEN SPACES WHEN "INITIAL" WHEN "SEARCH" WHEN "PAGE"
      WHEN "CLEAR" WHEN "RESUME" WHEN "OPTIONS"
        CALL "STSRCH" END-CALL
      WHEN OTHER
        MOVE 400 TO APP-STATUS
        MOVE "E-COM-003: 操作が無効です。" TO ERROR-TEXT PERFORM ADD-ERROR
      END-EVALUATE
    END-IF
    IF APP-OUTCOME = "Saved"
        CALL "STFLASH" END-CALL
        CALL "STREDIRECT" USING CONTEXT-ID TAB-ID FLASH-ID
          BY VALUE CONTEXT-REVISION END-CALL
    ELSE
      IF APP-OUTCOME = "NavigationReady"
        CALL "STEDITORREDIRECT" USING CONTEXT-ID TAB-ID R-DATA(F-NAVIGATION)
          BY VALUE CONTEXT-REVISION STUDENT-ID END-CALL
      ELSE
        CALL "STFLASH" END-CALL
        CALL "STRENDER" END-CALL
      END-IF
    END-IF
    CALL "STCLOSE" USING BY VALUE DB-HANDLE END-CALL
    STOP RUN.

copy "ST-HELPERS.cpy".
end program STMAIN.
