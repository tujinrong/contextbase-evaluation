       >>SOURCE FORMAT FREE
identification division.
program-id. STPEND.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".

procedure division.
    MOVE SPACES TO SEARCH-PROMPT-EDITOR SEARCH-PROMPT-KIND
    IF EDITOR-PENDING NOT = SPACES AND LOW-VALUES
      MOVE EDITOR-ID TO SEARCH-PROMPT-EDITOR
      MOVE EDITOR-PENDING TO SEARCH-PROMPT-KIND
    END-IF
    MOVE "Search" TO STATE-KIND
    CALL "STSTATEIO" USING BY VALUE DB-HANDLE 3
      BY REFERENCE CONTEXT-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
        SEARCH-STATE BY VALUE LENGTH OF SEARCH-STATE
      BY REFERENCE CONTEXT-REVISION BY VALUE 30 RETURNING RC END-CALL
    IF RC NOT = 0 MOVE 409 TO APP-STATUS GOBACK END-IF
    MOVE CONTEXT-REVISION TO V PERFORM ID-AS-TEMP
    MOVE TMP-VALUE TO R-VALUE(F-CONTEXTREVISION)
    MOVE 30 TO STATE-MINUTES
    IF EDITOR-PENDING NOT = SPACES AND LOW-VALUES
      MOVE 10 TO STATE-MINUTES END-IF
    MOVE "Editor" TO STATE-KIND
    CALL "STSTATEIO" USING BY VALUE DB-HANDLE 3
      BY REFERENCE EDITOR-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
        EDITOR-STATE BY VALUE LENGTH OF EDITOR-STATE
      BY REFERENCE EDITOR-REVISION BY VALUE STATE-MINUTES RETURNING RC END-CALL
    IF RC NOT = 0 MOVE 409 TO APP-STATUS END-IF
    GOBACK.

copy "ST-HELPERS.cpy".
end program STPEND.
