01 APP EXTERNAL.
  05 DB-HANDLE USAGE POINTER.
  05 APP-STATUS PIC S9(9) COMP-5.
  05 APP-OUTCOME PIC X(24).
  05 APP-MESSAGE PIC X(1024).
  05 APP-MESSAGE-LENGTH PIC S9(9) COMP-5.
  05 APP-ERRORS PIC X(8192).
  05 APP-ERRORS-LENGTH PIC S9(9) COMP-5.
  05 ROLE-CODE PIC S9(9) COMP-5.
  05 OWNER-VALUE.
    10 OWNER-LENGTH PIC S9(9) COMP-5.
    10 OWNER-NULL PIC S9(4) COMP-5.
    10 FILLER PIC X(2).
    10 OWNER-DATA PIC X(1024).
  05 SESSION-VALUE.
    10 SESSION-LENGTH PIC S9(9) COMP-5.
    10 SESSION-NULL PIC S9(4) COMP-5.
    10 FILLER PIC X(2).
    10 SESSION-DATA PIC X(1024).
  05 CSRF-TOKEN PIC X(64).
  05 BUSINESS-DAY PIC X(10).
  05 BUSINESS-TIME PIC X(32).
  05 CORRELATION-ID PIC X(36).
  05 CONTEXT-ID PIC X(64).
  05 CONTEXT-REVISION PIC S9(18) COMP-5.
  05 EDITOR-ID PIC X(64).
  05 EDITOR-REVISION PIC S9(18) COMP-5.
  05 CONFIRM-ID PIC X(64).
  05 CONFIRM-REVISION PIC S9(18) COMP-5.
  05 TAB-ID PIC X(64).
  05 STUDENT-ID PIC S9(18) COMP-5.
  05 EXPECTED-VERSION PIC S9(18) COMP-5.
  05 SAVED-ID PIC S9(18) COMP-5.
  05 OLD-VERSION PIC S9(18) COMP-5.
  05 TOTAL-COUNT PIC S9(9) COMP-5.
  05 ROW-COUNT PIC S9(9) COMP-5.
  05 CURRENT-PAGE PIC S9(9) COMP-5.
  05 PAGE-SIZE PIC S9(9) COMP-5.
  05 LAST-PAGE PIC S9(9) COMP-5.
  05 VIEW-MODE PIC X(8).
  05 CHANGE-LIST PIC X(1024).
  05 CHANGE-LENGTH PIC S9(9) COMP-5.
  05 CONFIRMED-DUP PIC S9(9) COMP-5.
  05 WRITE-STARTED PIC S9(9) COMP-5.
  05 COMMIT-ATTEMPTED PIC S9(9) COMP-5.
  05 DUP-COUNT PIC S9(9) COMP-5.
  05 HASH-HANDLE USAGE POINTER.
  05 CONFIRM-PAYLOAD.
    10 CONFIRM-INPUT-HASH PIC X(32).
    10 CONFIRM-CANDIDATE-HASH PIC X(32).
    10 CONFIRM-TARGET PIC S9(18) COMP-5.
    10 CONFIRM-VERSION PIC S9(18) COMP-5.
  05 CONFIRM-CURRENT PIC X(80).
  05 SEARCH-STATE.
    10 SEARCH-EXECUTED PIC S9(9) COMP-5.
    10 SEARCH-TAB PIC X(64).
    10 SEARCH-RAW PIC X(66048).
    10 SEARCH-COUNT PIC S9(9) COMP-5.
    10 SEARCH-PAGE PIC S9(9) COMP-5.
    10 SEARCH-SIZE PIC S9(9) COMP-5.
    10 SEARCH-ROW-COUNT PIC S9(9) COMP-5.
    10 SEARCH-ROWS PIC X(1341600).
  05 EDITOR-STATE.
    10 EDITOR-TARGET PIC S9(18) COMP-5.
    10 EDITOR-VERSION PIC S9(18) COMP-5.
    10 EDITOR-TAB PIC X(64).
    10 EDITOR-RAW PIC X(66048).
    10 EDITOR-NORMAL PIC X(24768).
  05 ST-RAW.
    10 R-VALUE OCCURS 64 TIMES.
      15 R-LENGTH PIC S9(9) COMP-5.
      15 R-NULL PIC S9(4) COMP-5.
      15 FILLER PIC X(2).
      15 R-DATA PIC X(1024).
  05 ST-NORMAL.
    10 N-VALUE OCCURS 24 TIMES.
      15 N-LENGTH PIC S9(9) COMP-5.
      15 N-NULL PIC S9(4) COMP-5.
      15 FILLER PIC X(2).
      15 N-DATA PIC X(1024).
  05 ST-OLD.
    10 O-VALUE OCCURS 24 TIMES.
      15 O-LENGTH PIC S9(9) COMP-5.
      15 O-NULL PIC S9(4) COMP-5.
      15 FILLER PIC X(2).
      15 O-DATA PIC X(1024).
  05 ST-ROWS.
    10 ST-ROW OCCURS 100 TIMES.
      15 ROW-VALUE OCCURS 13 TIMES.
        20 ROW-LENGTH PIC S9(9) COMP-5.
        20 ROW-NULL PIC S9(4) COMP-5.
        20 FILLER PIC X(2).
        20 ROW-DATA PIC X(1024).
  05 DB-PARAMETER-VALUES.
    10 PARAM-VALUE OCCURS 40 TIMES.
      15 PARAM-LENGTH PIC S9(9) COMP-5.
      15 PARAM-NULL PIC S9(4) COMP-5.
      15 FILLER PIC X(2).
      15 PARAM-DATA PIC X(1024).
05 ST-DB-REQUEST.
  10 DB-COMMAND PIC X(12).
  10 DB-PARAMETER-COUNT PIC S9(9) COMP-5.
  10 DB-PARAMETER OCCURS 40 TIMES.
    15 DB-TYPE PIC S9(9) COMP-5.
    15 DB-NULL PIC S9(4) COMP-5.
    15 FILLER PIC X(2).
    15 DB-LENGTH PIC S9(9) COMP-5.
    15 FILLER PIC X(4).
    15 DB-DATA USAGE POINTER.
05 ST-DB-RESULT.
  10 DB-SQLSTATE PIC X(5).
  10 FILLER PIC X(3).
  10 DB-NATIVE PIC S9(9) COMP-5.
  10 FILLER PIC X(4).
  10 DB-AFFECTED PIC S9(18) COMP-5.
  10 DB-CURSOR USAGE POINTER.
  10 DB-ERROR PIC S9(9) COMP-5.
  10 FILLER PIC X(4).
