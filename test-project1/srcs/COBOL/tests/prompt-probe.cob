       >>SOURCE FORMAT FREE
identification division.
program-id. prompt-probe.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
01 MODE-NAME PIC X(32).
01 MODE-NUM PIC S9(9) COMP-5.
01 I PIC S9(9) COMP-5.
01 RC PIC S9(9) COMP-5.
01 HANDLE-MARKER PIC X.
01 STATUS-TEXT PIC 9(3).
01 REVISION-TEXT PIC 9(19).
01 NORMALIZED-REASON PIC X(1032).
01 REJECTED-REASON PIC S9(9) COMP-5.
procedure division.
    INITIALIZE APP MOVE 200 TO APP-STATUS MOVE 1 TO APP-ERRORS-LENGTH
    MOVE 2 TO ROLE-CODE SET DB-HANDLE TO ADDRESS OF HANDLE-MARKER
    MOVE ALL "a" TO TAB-ID
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 64
      MOVE -1 TO R-NULL(I)
    END-PERFORM
    MOVE ALL "a" TO R-DATA(F-EDITORID)(1:64) R-DATA(F-CONTEXTID)(1:64)
    MOVE 64 TO R-LENGTH(F-EDITORID) R-LENGTH(F-CONTEXTID)
    MOVE 0 TO R-NULL(F-EDITORID) R-NULL(F-CONTEXTID)
    MOVE "5" TO R-DATA(F-CONTEXTREVISION)
    MOVE 1 TO R-LENGTH(F-CONTEXTREVISION)
    MOVE 0 TO R-NULL(F-CONTEXTREVISION)
    MOVE "CONFIRM" TO R-DATA(F-ACTION)
    MOVE 7 TO R-LENGTH(F-ACTION) MOVE 0 TO R-NULL(F-ACTION)
    ACCEPT MODE-NAME FROM COMMAND-LINE
    MOVE 1 TO MODE-NUM
    EVALUATE MODE-NAME
      WHEN "stale"
        MOVE "4" TO R-DATA(F-CONTEXTREVISION) MOVE 2 TO MODE-NUM
      WHEN "expired" MOVE 3 TO MODE-NUM
      WHEN "prompt"
        MOVE 4 TO MODE-NUM MOVE "RESET" TO R-DATA(F-ACTION)
        MOVE 5 TO R-LENGTH(F-ACTION)
        MOVE "pending-raw" TO R-DATA(F-STUDENTNAME)
        MOVE 11 TO R-LENGTH(F-STUDENTNAME)
        MOVE 0 TO R-NULL(F-STUDENTNAME)
      WHEN "cancel"
        MOVE 5 TO MODE-NUM MOVE "CANCEL" TO R-DATA(F-ACTION)
        MOVE 6 TO R-LENGTH(F-ACTION)
      WHEN "unchanged"
        MOVE 6 TO MODE-NUM MOVE "RESET" TO R-DATA(F-ACTION)
        MOVE 5 TO R-LENGTH(F-ACTION)
        MOVE "draft-value" TO R-DATA(F-STUDENTNAME)
        MOVE 11 TO R-LENGTH(F-STUDENTNAME)
        MOVE 0 TO R-NULL(F-STUDENTNAME)
      WHEN "background-save" MOVE 7 TO MODE-NUM
        MOVE "SAVE" TO R-DATA(F-ACTION)
      WHEN "background-options" MOVE 8 TO MODE-NUM
        MOVE "EDITOPTIONS" TO R-DATA(F-ACTION)
      WHEN "background-reset" MOVE 9 TO MODE-NUM
        MOVE "RESET" TO R-DATA(F-ACTION)
      WHEN "escape-get" MOVE 11 TO MODE-NUM
        MOVE "NEW" TO R-DATA(F-ACTION)
        MOVE -1 TO R-NULL(F-EDITORID)
      WHEN "dup-confirm" MOVE 12 TO MODE-NUM
      WHEN "dup-cancel" MOVE 13 TO MODE-NUM
        MOVE "CANCEL" TO R-DATA(F-ACTION)
      WHEN "dup-wrong-token" MOVE 14 TO MODE-NUM
      WHEN "dup-background" MOVE 15 TO MODE-NUM
        MOVE "SAVE" TO R-DATA(F-ACTION)
      WHEN "background-orphan" MOVE 17 TO MODE-NUM
        MOVE "SAVE" TO R-DATA(F-ACTION)
      WHEN "recover-cancel" MOVE 18 TO MODE-NUM
      WHEN "recover-correct" MOVE 19 TO MODE-NUM
    END-EVALUATE
    IF (MODE-NUM >= 12 AND <= 14) OR MODE-NUM >= 18
      MOVE ALL "b" TO R-DATA(F-CONFIRMATIONTOKEN)(1:64)
      MOVE 64 TO R-LENGTH(F-CONFIRMATIONTOKEN)
      MOVE 0 TO R-NULL(F-CONFIRMATIONTOKEN)
      MOVE "approved" TO R-DATA(F-REASON)
      MOVE 8 TO R-LENGTH(F-REASON) MOVE 0 TO R-NULL(F-REASON)
      IF MODE-NUM = 14 MOVE ALL "c" TO R-DATA(F-CONFIRMATIONTOKEN)(1:64) END-IF
    END-IF
    IF MODE-NUM >= 18
      MOVE ALL "x" TO R-DATA(F-REASON)(1:61)
      MOVE 61 TO R-LENGTH(F-REASON)
    END-IF
    CALL "STFIXMODE" USING BY VALUE MODE-NUM RETURNING RC END-CALL
    IF MODE-NUM = 11 CALL "STSTATE" END-CALL
    ELSE CALL "STPROMPT" END-CALL END-IF
    IF MODE-NUM = 1 AND APP-STATUS = 200
      CALL "STSTATE" END-CALL
    END-IF
    IF MODE-NUM >= 18 AND APP-STATUS = 200
      CALL "STUNICODE" USING BY VALUE 1
        BY REFERENCE R-VALUE(F-REASON) NORMALIZED-REASON
        BY VALUE 60 60 RETURNING REJECTED-REASON END-CALL
      MOVE 422 TO APP-STATUS
      CALL "STRENDER" END-CALL
      MOVE 200 TO APP-STATUS MOVE SPACES TO APP-OUTCOME
      MOVE 1 TO APP-ERRORS-LENGTH
      MOVE CONTEXT-REVISION TO REVISION-TEXT
      MOVE REVISION-TEXT TO R-DATA(F-CONTEXTREVISION)
      MOVE 19 TO R-LENGTH(F-CONTEXTREVISION)
      MOVE 0 TO R-NULL(F-CONTEXTREVISION)
      IF MODE-NUM = 18
        MOVE "CANCEL" TO R-DATA(F-ACTION) MOVE 6 TO R-LENGTH(F-ACTION)
      ELSE
        MOVE "CONFIRM" TO R-DATA(F-ACTION) MOVE 7 TO R-LENGTH(F-ACTION)
        MOVE "corrected" TO R-DATA(F-REASON)
        MOVE 9 TO R-LENGTH(F-REASON) MOVE 0 TO R-NULL(F-REASON)
      END-IF
      CALL "STPROMPT" END-CALL
      DISPLAY "RECOVERY|" REJECTED-REASON "|"
        FUNCTION TRIM(R-DATA(F-ACTION)) "|" FUNCTION TRIM(R-DATA(F-REASON))
    END-IF
    CALL "STFIXREPORT" RETURNING RC END-CALL
    MOVE APP-STATUS TO STATUS-TEXT
    DISPLAY STATUS-TEXT "|" FUNCTION TRIM(APP-OUTCOME) "|"
      FUNCTION TRIM(R-DATA(F-ACTION)) "|"
      FUNCTION TRIM(R-DATA(F-CONTEXTREVISION)) "|"
      FUNCTION TRIM(R-DATA(F-STUDENTNAME))
    STOP RUN.
end program prompt-probe.
