<Project>
  <PropertyGroup>
    <MethodRoot>$(MSBuildThisFileDirectory)</MethodRoot>
    <ProjectWithinMethod>$([MSBuild]::MakeRelative('$(MethodRoot)', '$(MSBuildProjectDirectory)'))</ProjectWithinMethod>
    <BaseIntermediateOutputPath>$(MethodRoot).tmp/dotnet/obj/$(ProjectWithinMethod)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(MethodRoot).tmp/dotnet/bin/$(ProjectWithinMethod)/</BaseOutputPath>
    <RestorePackagesPath>$(MethodRoot).tmp/nuget/packages/</RestorePackagesPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/.tmp/**;**/build/**;**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
