@model EditorViewModel
@{
    ViewData["Title"] = Model.ReadOnly ? "学生参照" : Model.Input.Id.HasValue ? "学生編集" : "学生新規登録";
}
<h1>@ViewData["Title"] <span class="muted">* は必須項目</span></h1>
<form method="post" asp-action="Save" data-track-changes="true" data-draft-baseline="@Model.BaselineJson">
    <input asp-for="Input.Id" type="hidden" /><input asp-for="Input.ExpectedVersion" type="hidden" />
    <input asp-for="Input.SearchContextId" type="hidden" />
    <input asp-for="Input.SnapshotToken" type="hidden" />
    <div asp-validation-summary="All"></div>
    <fieldset class="panel" disabled="@Model.ReadOnly">
        <legend>基本情報</legend>
        <div class="form-grid">
            <div class="field"><label>管理番号（自動）</label><input value="@(Model.Input.Id?.ToString() ?? "保存時に採番")" readonly /></div>
            <div class="field"><label asp-for="Input.StudentNo">学籍番号 *</label><input asp-for="Input.StudentNo" readonly="@Model.Input.Id.HasValue" autocomplete="off" /><small class="muted">英大文字・数字・ハイフン、15文字以内</small></div>
            <div class="field"><label asp-for="Input.StudentName">氏名 *</label><input asp-for="Input.StudentName" /><small class="muted">8文字以内</small></div>
            <div class="field"><label asp-for="Input.StudentNameKana">氏名カナ *</label><input asp-for="Input.StudentNameKana" /><small class="muted">全角カナ18文字以内</small></div>
            <div class="field wide"><label for="Input_BirthEra">生年月日（和暦）*</label><div class="inline">
                <select asp-for="Input.BirthEra" aria-label="元号"><option value="">元号</option><option value="MEIJI">明治</option><option value="TAISHO">大正</option><option value="SHOWA">昭和</option><option value="HEISEI">平成</option><option value="REIWA">令和</option></select>
                <input asp-for="Input.BirthYear" aria-label="和暦年" inputmode="numeric" style="width:4rem" />年
                <input asp-for="Input.BirthMonth" aria-label="月" inputmode="numeric" style="width:3.5rem" />月
                <input asp-for="Input.BirthDay" aria-label="日" inputmode="numeric" style="width:3.5rem" />日
            </div></div>
            <div class="field"><label asp-for="Input.GenderCode">性別 *</label><select asp-for="Input.GenderCode" asp-items="Model.GenderCodes"><option value="">選択</option></select></div>
        </div>
    </fieldset>
    <fieldset class="panel" disabled="@Model.ReadOnly">
        <legend>住所・本人連絡先</legend>
        <div class="form-grid">
            <div class="field"><label asp-for="Input.PostalCode">郵便番号 *</label><input asp-for="Input.PostalCode" inputmode="text" placeholder="001-0001" /><small class="muted">ハイフン付き入力可・保存値は数字7桁</small></div>
            <div class="field"><label asp-for="Input.PrefectureCode">都道府県 *</label><select asp-for="Input.PrefectureCode" asp-items="Model.PrefectureCodes"><option value="">選択</option></select></div>
            <div class="field wide"><label asp-for="Input.AddressLine1">住所1 *</label><input asp-for="Input.AddressLine1" /></div>
            <div class="field wide"><label asp-for="Input.AddressLine2">住所2</label><input asp-for="Input.AddressLine2" /></div>
            <div class="field"><label asp-for="Input.PhoneNumber">本人電話</label><input asp-for="Input.PhoneNumber" type="tel" /></div>
            <div class="field"><label asp-for="Input.EmailAddress">本人メール</label><input asp-for="Input.EmailAddress" type="text" inputmode="email" /></div>
        </div>
    </fieldset>
    <fieldset class="panel" disabled="@Model.ReadOnly">
        <legend>在籍・所属</legend>
        <div class="form-grid">
            <div class="field"><label asp-for="Input.AdmissionDate">入学日 *</label><input asp-for="Input.AdmissionDate" placeholder="yyyy-MM-dd" /></div>
            <div class="field"><label asp-for="Input.EnrollmentStatusCode">在籍区分 *</label><select asp-for="Input.EnrollmentStatusCode" asp-items="Model.StatusCodes" data-refresh-candidates><option value="">選択</option></select></div>
            <div class="field"><label asp-for="Input.EnrollmentEndDate">卒業・退学日</label><input asp-for="Input.EnrollmentEndDate" placeholder="yyyy-MM-dd" readonly="@(Model.Input.EnrollmentStatusCode is "01" or "02")" /></div>
            <div class="field"><label asp-for="Input.SchoolYear">年度</label><select asp-for="Input.SchoolYear" asp-items="Model.SchoolYears" data-refresh-candidates><option value="">選択</option></select></div>
            <div class="field"><label asp-for="Input.GradeCode">学年</label><select asp-for="Input.GradeCode" asp-items="Model.GradeCodes" data-refresh-candidates><option value="">選択</option></select></div>
            <div class="field wide"><label asp-for="Input.ClassId">クラス</label><select asp-for="Input.ClassId" asp-items="Model.Classes" data-refresh-candidates><option value="">未選択</option></select></div>
            <div class="field"><label>所属人数・定員</label><output>@Model.Capacity</output></div>
        </div>
        @if (!Model.ReadOnly) { <button type="submit" asp-action="Candidates" formnovalidate data-candidate-submit>候補・人数を更新</button> }
    </fieldset>
    <fieldset class="panel" disabled="@Model.ReadOnly">
        <legend>緊急連絡先</legend>
        <div class="form-grid">
            <div class="field"><label asp-for="Input.EmergencyContactName">緊急氏名</label><input asp-for="Input.EmergencyContactName" /></div>
            <div class="field"><label asp-for="Input.RelationshipCode">緊急続柄</label><select asp-for="Input.RelationshipCode" asp-items="Model.RelationshipCodes"><option value="">未選択</option></select></div>
            <div class="field"><label asp-for="Input.EmergencyPhoneNumber">緊急電話</label><input asp-for="Input.EmergencyPhoneNumber" type="tel" /></div>
        </div>
    </fieldset>
    <fieldset class="panel" disabled="@Model.ReadOnly">
        <legend>備考・確認変更理由</legend>
        <div class="form-grid">
            <div class="field wide"><label asp-for="Input.Remarks">備考（120文字以内）</label><textarea asp-for="Input.Remarks" rows="3"></textarea></div>
            <div class="field wide"><label asp-for="Input.OperationReason">確認・変更理由</label><textarea asp-for="Input.OperationReason" rows="3"></textarea></div>
        </div>
    </fieldset>
    <p class="muted">@Model.Updated</p>
    <div class="actions">
        @if (!Model.ReadOnly)
        {
            <button class="primary" type="submit">保存</button>
            <button type="submit" asp-action="Reset" formnovalidate data-discard-confirm="reset">編集取消</button>
            <button type="submit" asp-action="Reload" formnovalidate data-discard-confirm="reload">最新再読込</button>
        }
        <a class="button" asp-action="Index" asp-route-contextId="@Model.Input.SearchContextId" data-discard-confirm>検索へ戻る</a>
        @if (Model.CanDelete) { <a class="button danger" asp-action="Delete" asp-route-id="@Model.Input.Id" asp-route-contextId="@Model.Input.SearchContextId" asp-route-snapshotToken="@Model.Input.SnapshotToken" data-discard-confirm>論理削除</a> }
    </div>
</form>
