@model CodeEditorViewModel
@{ ViewData["Title"] = Model.ExpectedVersion.HasValue ? "コード編集" : "コード追加"; }
<h1>@ViewData["Title"]</h1>
@if (Model.IsProtected) { <p class="muted">このコードは保護対象です。停止や有効期間の縮小には制約があります。</p> }
<form method="post" asp-action="Code" data-track-changes="true">
    <input asp-for="ExpectedVersion" type="hidden" />
    <div asp-validation-summary="All"></div>
    <div class="panel form-grid">
        <div class="field"><label asp-for="CategoryId">分類 *</label>
        @if (Model.ExpectedVersion.HasValue) { <input asp-for="CategoryId" readonly /> }
        else { <select asp-for="CategoryId" asp-items="Model.Categories"><option value="">選択</option></select> }
        </div>
        <div class="field"><label asp-for="CodeValue">コード *</label><input asp-for="CodeValue" readonly="@Model.ExpectedVersion.HasValue" /></div>
        <div class="field"><label asp-for="Input.CodeName">名称 *</label><input asp-for="Input.CodeName" /></div>
        <div class="field"><label asp-for="Input.DisplayOrder">表示順</label><input asp-for="Input.DisplayOrder" inputmode="numeric" /></div>
        <div class="field"><label asp-for="Input.ValidFrom">利用開始日 *</label><input asp-for="Input.ValidFrom" placeholder="yyyy-MM-dd" /></div>
        <div class="field"><label asp-for="Input.ValidTo">利用終了日</label><input asp-for="Input.ValidTo" placeholder="yyyy-MM-dd" /></div>
        <div class="field"><label class="inline"><input asp-for="Input.IsActive" />有効</label></div>
        <div class="field full"><label asp-for="Input.Remarks">備考</label><textarea asp-for="Input.Remarks" rows="3"></textarea></div>
    </div>
    <div class="actions"><button type="submit" class="primary">保存</button><a class="button" asp-action="Index" data-discard-confirm>戻る</a></div>
</form>
