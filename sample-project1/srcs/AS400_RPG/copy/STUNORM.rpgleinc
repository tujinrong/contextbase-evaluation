// raw checks precede transformations; failed conversions never become NULL.
 temp=StNormalizeText( raw.values( 1 ) :15 :15 :5 :*on :'studentNo' :result ) ;
 work.studentNo=%char( temp ) ;
 temp=StNormalizeText( raw.values( 2 ) :8 :8 :0 :*on :'studentName' :result ) ;
 work.studentName=temp ;
 temp=StNormalizeText( raw.values( 3 ) :36 :18 :3 :*on :'studentNameKana' :result ) ;
 work.studentNameKana=temp ;
 temp=StNormalizeText( raw.values( 5 ) :1 :1 :6 :*on :'genderCode' :result ) ;
 work.genderCode=%char( temp ) ;
 temp=StNormalizeText( raw.values( 6 ) :10 :7 :7 :*on :'postalCode' :result ) ;
 work.postalCode=%char( temp ) ;
 temp=StNormalizeText( raw.values( 7 ) :2 :2 :6 :*on :'prefectureCode' :result ) ;
 work.prefectureCode=%char( temp ) ;
 temp=StNormalizeText( raw.values( 8 ) :45 :45 :0 :*on :'addressLine1' :result ) ;
 work.addressLine1=temp ;
 temp=StNormalizeText( raw.values( 9 ) :45 :45 :0 :*off :'addressLine2' :result ) ;
 work.addressLine2=temp ;
 if %len( temp ) =0 ;
 work.addressLine2Ind=-1 ;
 else ;
 work.addressLine2Ind=0 ;
 endif ;
 temp=StNormalizeText( raw.values( 10 ) :20 :16 :8 :*off :'phoneNumber' :result ) ;
 work.phoneNumber=%char( temp ) ;
 if %len( temp ) =0 ;
 work.phoneNumberInd=-1 ;
 else ;
 work.phoneNumberInd=0 ;
 endif ;
 temp=StNormalizeText( raw.values( 11 ) :60 :60 :9 :*off :'emailAddress' :result ) ;
 work.emailAddress=%char( temp ) ;
 if %len( temp ) =0 ;
 work.emailAddressInd=-1 ;
 else ;
 work.emailAddressInd=0 ;
 endif ;
 temp=StNormalizeText( raw.values( 12 ) :10 :10 :10 :*on :'admissionDate' :result ) ;
 if %len( temp ) >0 ;
 StIsoDate( temp :businessDay :work.admissionDate :'admissionDate' :result ) ;
 endif ;
 temp=StNormalizeText( raw.values( 13 ) :2 :2 :6 :*on :'enrollmentStatusCode' :result ) ;
 work.enrollmentStatusCode=%char( temp ) ;
 temp=StNormalizeText( raw.values( 14 ) :10 :10 :10 :*off :'enrollmentEndDate' :result ) ;
 if %len( temp ) >0 ;
 StIsoDate( temp :businessDay :work.enrollmentEndDate :'enrollmentEndDate' :result ) ;
 endif ;
 if %len( temp ) =0 ;
 work.enrollmentEndDateInd=-1 ;
 else ;
 work.enrollmentEndDateInd=0 ;
 endif ;
 temp=StNormalizeText( raw.values( 15 ) :19 :19 :12 :*off :'classId' :result ) ;
 work.classId=StLong( temp :*off :'classId' :result ) ;
 if %len( temp ) =0 ;
 work.classIdInd=-1 ;
 else ;
 work.classIdInd=0 ;
 endif ;
 temp=StNormalizeText( raw.values( 16 ) :8 :8 :0 :*off :'emergencyContactName' :result ) ;
 work.emergencyContactName=temp ;
 if %len( temp ) =0 ;
 work.emergencyContactNameInd=-1 ;
 else ;
 work.emergencyContactNameInd=0 ;
 endif ;
 temp=StNormalizeText( raw.values( 17 ) :2 :2 :6 :*off :'relationshipCode' :result ) ;
 work.relationshipCode=%char( temp ) ;
 if %len( temp ) =0 ;
 work.relationshipCodeInd=-1 ;
 else ;
 work.relationshipCodeInd=0 ;
 endif ;
 temp=StNormalizeText( raw.values( 18 ) :20 :16 :8 :*off :'emergencyPhoneNumber' :result ) ;
 work.emergencyPhoneNumber=%char( temp ) ;
 if %len( temp ) =0 ;
 work.emergencyPhoneNumberInd=-1 ;
 else ;
 work.emergencyPhoneNumberInd=0 ;
 endif ;
 temp=StNormalizeText( raw.values( 19 ) :120 :120 :1 :*off :'remarks' :result ) ;
 work.remarks=temp ;
 if %len( temp ) =0 ;
 work.remarksInd=-1 ;
 else ;
 work.remarksInd=0 ;
 endif ;
 StParseBirthDate( raw.birthEra :raw.birthYear :raw.birthMonth :raw.birthDay :businessDay :
  work.birthDate :result ) ;
 if work.relationshipCodeInd<0 ;
 work.relationshipCategory= '' ;
 work.relationshipCategoryInd=-1 ;
 else ;
 work.relationshipCategory= 'RELATIONSHIP' ;
 work.relationshipCategoryInd=0 ;
 endif ;
 work.nameKey=StNormalizeText( raw.values( 2 ) :8 :160 :2 :*on :'studentName' :result ) ;
 work.kanaKey=StNormalizeText( raw.values( 3 ) :36 :18 :4 :*on :'studentNameKana' :result ) ;
