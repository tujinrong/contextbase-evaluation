PGM PARM(&LEAF)
DCL VAR(&LEAF) TYPE(*CHAR) LEN(64)
DCL VAR(&PATH) TYPE(*CHAR) LEN(256)
DCL VAR(&STATUS) TYPE(*INT) LEN(4)
CHGVAR VAR(&PATH) VALUE('/stuapp/approved/' *TCAT &LEAF)
CHGJOB CCSID(1399) DFTWAIT(15)
STRCMTCTL LCKLVL(*CS) CMTSCOPE(*JOB)
MONMSG MSGID(CPF0000) EXEC(DO)
 SNDPGMMSG MSG('Start maintenance in a clean dedicated job.') +
 MSGTYPE(*ESCAPE)
ENDDO
CALL PGM(STUDPGM/STUMNT) PARM(&PATH &STATUS)
MONMSG MSGID(CPF0000) EXEC(DO)
 ROLLBACK
 ENDCMTCTL
 SNDPGMMSG MSG('Maintenance failed; inspect joblog.') MSGTYPE(*ESCAPE)
ENDDO
ROLLBACK
ENDCMTCTL
RCLACTGRP ACTGRP(STUDAG)
IF COND(&STATUS *NE 0) THEN(DO)
 SNDPGMMSG MSG('Maintenance stopped; inspect request results in joblog.') +
 MSGTYPE(*ESCAPE)
ENDDO
ENDPGM
