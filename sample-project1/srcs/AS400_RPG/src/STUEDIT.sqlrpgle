 if field>0 and CSRPOS>0 ;
 CSRCOL+=CSRPOS-1 ;
 endif ;
 if uiError and not( *in08 or *in03 or *in12 or *in05 or *in14 ) ;
 result.kind=RK_VALIDATION ;
 result.messageId= 'E-COM-003' ;
 iter ;
 endif ;
 if *in03 or *in12 ;
 if( not Dirty( ) and not uiError ) or Question( 'W-STU-103' :reason :*off :result ) ;
 closed=*on ;
 endif ;
 iter ;
 endif ;
 if *in09 ;
 ShowErrors( ) ;
 iter ;
 endif ;
 if *in20 ;
 ErrorList( result ) ;
 iter ;
 endif ;
 if *in05 ;
 if( not Dirty( ) and not uiError ) or Question( 'W-STU-104' :reason :*off :result ) ;
 StCancelConfirmation( hints.instanceId :lookupResult ) ;
 raw=original ;
 hints.schoolYear=oldHints.schoolYear ;
 hints.gradeCode=oldHints.gradeCode ;
 hints.rawSchoolYear=oldHints.rawSchoolYear ;
 hints.rawGradeCode=oldHints.rawGradeCode ;
 hints.reason=%ucs2( '' ) ;
 clear result ;
 uiError=*off ;
 endif ;
 iter ;
 endif ;
 if *in14 ;
 if( not Dirty( ) and not uiError ) or Question( 'W-STU-109' :reason :*off :result ) ;
 LoadForm( ) ;
 endif ;
 iter ;
 endif ;
 if *in08 ;
 EditFull( field ) ;
 uiError=*off ;
 iter ;
 endif ;
 if *in04 and not protected ;
 PickField( field ) ;
 iter ;
 endif ;
 if *in10 and not protected ;
 SaveForm( ) ;
 iter ;
 endif ;
 if *in23 and not protected and studentId>0 ;
 clear result ;
 result.messageId= 'W-STU-105' ;
 StAuthorize( 'DELETE' :principal :role :result ) ;
 if result.kind<>0 ;
 iter ;
 endif ;
 if Question( 'W-STU-105' :deleteReason :*on :result ) ;
 StDeleteStudent( studentId :rec.rowVersion :deleteReason :result ) ;
 if result.kind=RK_SAVED ;
 notice=Render( UiMessage( result ) :128 ) ;
 closed=*on ;
 elseif result.kind=RK_VALIDATION ;
 errorIndex=0 ;
 ShowErrors( ) ;
 endif ;
 endif ;
 endif ;
 enddo ;
 StCancelConfirmation( hints.instanceId :lookupResult ) ;
 *inlr=*on ;
 return ;
 dcl-proc LoadForm ;
 uiError=*off ;
 StCancelConfirmation( hints.instanceId :lookupResult ) ;
 clear result ;
 if studentId>0 ;
 StLoadStudent( studentId :rec :result ) ;
 if result.kind<>0 ;
 return ;
 endif ;
/copy '../copy/STUTORAW.rpgleinc'
 hints.schoolYear= '' ;
 hints.gradeCode= '' ;
 if rec.work.classIdInd=0 ;
 hints.schoolYear=%char( rec.schoolYear ) ;
 hints.gradeCode=rec.gradeCode ;
 endif ;
 else ;
 clear raw ;
 clear rec ;
 StClock( utc :day ) ;
 hints.schoolYear=%char( %subdt( day :*years ) ) ;
 if %subdt( day :*months ) <4 ;
 hints.schoolYear=%char( %subdt( day :*years ) -1 ) ;
 endif ;
 hints.gradeCode= '' ;
 raw.values( 5 ) =%ucs2( '0' ) ;
// Admission date remains empty until entered (REG-013 / EV-REG-001).
 raw.values( 13 ) =%ucs2( '01' ) ;
 endif ;
 hints.rawSchoolYear=%ucs2( hints.schoolYear ) ;
 hints.rawGradeCode=%ucs2( hints.gradeCode ) ;
 hints.reason=%ucs2( '' ) ;
 original=raw ;
 oldHints=hints ;
 StLookupChoice( 'CLASS' :1 :0 :'' :lookupValues :lookupLabels :lookupCount :
 lookupResult ) ;
 if lookupResult.kind<>0 ;
 result=lookupResult ;
 elseif lookupCount=0 ;
 result.messageId= 'W-STU-108' ;
 endif ;
 end-proc ;
 dcl-proc DrawForm ;
 dcl-ds classResult likeds( Result_t ) ;
 dcl-s classId int( 20 ) ;
 dcl-s classYear varchar( 4 ) ;
 dcl-s classGrade varchar( 2 ) ;
 dcl-ds one likeds( Result_t ) ;
/copy '../copy/STUEDITOUT.rpgleinc'
 EBERA=Window( raw.birthEra :0 :22 :dateUsed( 1 ) :windowAdvance ) ;
 priorEra=EBERA ;
 EBYEAR=Window( raw.birthYear :0 :4 :dateUsed( 2 ) :windowAdvance ) ;
 priorYear=EBYEAR ;
 EBMONTH=Window( raw.birthMonth :0 :2 :dateUsed( 3 ) :windowAdvance ) ;
 priorMonth=EBMONTH ;
 EBDAY=Window( raw.birthDay :0 :2 :dateUsed( 4 ) :windowAdvance ) ;
 priorDay=EBDAY ;
 EYEAR=Window( hints.rawSchoolYear :0 :4 :hintUsed( 1 ) :windowAdvance ) ;
 priorHintYear=EYEAR ;
 EGRADE=Window( hints.rawGradeCode :0 :2 :hintUsed( 2 ) :windowAdvance ) ;
 priorHintGrade=EGRADE ;
 DrawParts( raw.values( 19 ) :3 :remBuffers :remStarts :remCounts ) ;
 remPrior=remBuffers ;
 EREM1=%subst( remBuffers( 1 ) :1 :112 ) ;
 EREM2=%subst( remBuffers( 2 ) :1 :112 ) ;
 EREM3=%subst( remBuffers( 3 ) :1 :112 ) ;
 DrawParts( hints.reason :2 :reasonBuffers :reasonStarts :reasonCounts ) ;
 reasonPrior=reasonBuffers ;
 EREAS1=%subst( reasonBuffers( 1 ) :1 :112 ) ;
 EREAS2=%subst( reasonBuffers( 2 ) :1 :112 ) ;
 STUID=%char( studentId ) ;
 fullUpdate=%ucs2( %char( rec.updatedAt+%hours( 9 ) :*iso ) + ' / ' ) +rec.updatedBy ;
 UPDINFO=Render( fullUpdate :124 ) ;
 if studentId=0 ;
 UPDINFO= '' ;
 fullUpdate=%ucs2( '' ) ;
 endif ;
 one=result ;
 if errorIndex>=1 and errorIndex<=result.errorCount ;
 one.errorCount=1 ;
 one.fieldErrors( 1 ) =result.fieldErrors( errorIndex ) ;
 endif ;
 fullError=UiMessage( one ) ;
 EMSG1=Render( fullError :128 ) ;
 EMSG2= 'F9=next field error' ;
 EMODE= 'Edit' ;
 if protected ;
 EMODE= 'View' ;
 endif ;
 fullGender=UiLabel( 'GENDER' :raw.values( 5 ) :0 :'' ) ;
 EGENDNAM=Render( fullGender :8 ) ;
 fullPref=UiLabel( 'PREFECTURE' :raw.values( 7 ) :0 :'' ) ;
 EPREFNAM=Render( fullPref :20 ) ;
 fullStatus=UiLabel( 'ENROLLMENT_STATUS' :raw.values( 13 ) :0 :'' ) ;
 ESTATNAM=Render( fullStatus :30 ) ;
 fullRel=UiLabel( 'RELATIONSHIP' :raw.values( 17 ) :0 :'' ) ;
 ERELNAM=Render( fullRel :8 ) ;
 fullGrade=UiLabel( 'GRADE' :hints.rawGradeCode :0 :'' ) ;
 EGRADNAM=Render( fullGrade :26 ) ;
 CLCOUNT= '' ;
 ECLASSNAME= '' ;
 fullClass=%ucs2( '' ) ;
 if %len( raw.values( 15 ) ) >0 ;
 monitor ;
 classId=%int( %char( raw.values( 15 ) ) ) ;
 on-error ;
 return ;
 endmon ;
 StClassInfo( classId :classYear :classGrade :occupancy :capacity :capacityInd :classResult :
 *on ) ;
 if classResult.kind=0 ;
 CLCOUNT= 'Current occupancy ' +%char( occupancy ) ;
 if capacityInd=0 ;
 CLCOUNT+= ' / ' +%char( capacity ) ;
 else ;
 CLCOUNT+= ' / unlimited' ;
 endif ;
 fullClass=UiLabel( 'CLASS' :raw.values( 15 ) :0 :'' ) ;
 ECLASSNAME=Render( fullClass :36 ) ;
 endif ;
 endif ;
 end-proc ;
 dcl-proc ReadEdited ;
 dcl-pi *n ;
 index int( 10 ) const ;
 value varchar( 128 ) const ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 if index=1 and studentId>0 ;
 return ;
 endif ;
 if value<>prior( index ) ;
 text=raw.values( index ) ;
 MergeWindow( text :value :0 :windowUsed( index ) ) ;
 if not uiError ;
 raw.values( index ) =text ;
 endif ;
 endif ;
 end-proc ;
 dcl-proc ReadForm ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 uiError=*off ;
 if protected ;
 return ;
 endif ;
/copy '../copy/STUEDITIO.rpgleinc'
 if EBERA<>priorEra ;
 text=raw.birthEra ;
 MergeWindow( text :EBERA :0 :dateUsed( 1 ) ) ;
 if not uiError and %len( text ) <=20 ;
 raw.birthEra=text ;
 else ;
 uiError=*on ;
 endif ;
 endif ;
 if EBYEAR<>priorYear ;
 text=raw.birthYear ;
 MergeWindow( text :EBYEAR :0 :dateUsed( 2 ) ) ;
 if not uiError and %len( text ) <=8 ;
 raw.birthYear=text ;
 else ;
 uiError=*on ;
 endif ;
 endif ;
 if EBMONTH<>priorMonth ;
 text=raw.birthMonth ;
 MergeWindow( text :EBMONTH :0 :dateUsed( 3 ) ) ;
 if not uiError and %len( text ) <=4 ;
 raw.birthMonth=text ;
 else ;
 uiError=*on ;
 endif ;
 endif ;
 if EBDAY<>priorDay ;
 text=raw.birthDay ;
 MergeWindow( text :EBDAY :0 :dateUsed( 4 ) ) ;
 if not uiError and %len( text ) <=4 ;
 raw.birthDay=text ;
 else ;
 uiError=*on ;
 endif ;
 endif ;
 if EYEAR<>priorHintYear ;
 text=hints.rawSchoolYear ;
 MergeWindow( text :EYEAR :0 :hintUsed( 1 ) ) ;
 if not uiError and %len( text ) <=8 ;
 hints.rawSchoolYear=text ;
 raw.values( 15 ) =%ucs2( '' ) ;
 else ;
 uiError=*on ;
 endif ;
 endif ;
 if EGRADE<>priorHintGrade ;
 text=hints.rawGradeCode ;
 MergeWindow( text :EGRADE :0 :hintUsed( 2 ) ) ;
 if not uiError and %len( text ) <=4 ;
 hints.rawGradeCode=text ;
 raw.values( 15 ) =%ucs2( '' ) ;
 else ;
 uiError=*on ;
 endif ;
 endif ;
 remBuffers( 1 ) =EREM1 ;
 remBuffers( 2 ) =EREM2 ;
 remBuffers( 3 ) =EREM3 ;
 MergeParts( raw.values( 19 ) :3 :remBuffers :remPrior :remStarts :remCounts ) ;
 reasonBuffers( 1 ) =EREAS1 ;
 reasonBuffers( 2 ) =EREAS2 ;
 text=hints.reason ;
 MergeParts( text :2 :reasonBuffers :reasonPrior :reasonStarts :reasonCounts ) ;
 if not uiError and %len( text ) <=120 ;
 hints.reason=text ;
 else ;
 uiError=*on ;
 endif ;
 end-proc ;
 dcl-proc Dirty ;
 dcl-pi *n ind ;
 end-pi ;
 dcl-s i int( 10 ) ;
 for i=1 to 19 ;
 if raw.values( i ) <>original.values( i ) ;
 return *on ;
 endif ;
 endfor ;
 return raw.birthEra<>original.birthEra or raw.birthYear<>original.birthYear or
 raw.birthMonth<>original.birthMonth or raw.birthDay<>original.birthDay or
 hints.rawSchoolYear<>oldHints.rawSchoolYear or hints.rawGradeCode<>oldHints.rawGradeCode or
 hints.reason<>oldHints.reason ;
 end-proc ;
 dcl-proc EditFull ;
 dcl-pi *n ;
 field int( 10 ) const ;
 end-pi ;
 dcl-s text varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s limit int( 10 ) ;
/copy '../copy/STUEDITLIMIT.rpgleinc'
 if field>=1 and field<=19 and field<>4 ;
 LongEdit( raw.values( field ) :protected or( field=1 and studentId>0 ) :320 :limit ) ;
 elseif field=20 ;
 text=raw.birthEra ;
 if LongEdit( text :protected :20 :10 ) ;
 raw.birthEra=text ;
 endif ;
 elseif field=21 ;
 text=raw.birthYear ;
 if LongEdit( text :protected :8 :4 ) ;
 raw.birthYear=text ;
 endif ;
 elseif field=22 ;
 text=raw.birthMonth ;
 if LongEdit( text :protected :4 :2 ) ;
 raw.birthMonth=text ;
 endif ;
 elseif field=23 ;
 text=raw.birthDay ;
 if LongEdit( text :protected :4 :2 ) ;
 raw.birthDay=text ;
 endif ;
 elseif field=24 ;
 text=hints.reason ;
 if LongEdit( text :protected :120 :60 ) ;
 hints.reason=text ;
 endif ;
 elseif field=25 ;
 text=hints.rawSchoolYear ;
 if LongEdit( text :protected :8 :4 ) ;
 if text<>hints.rawSchoolYear ;
 hints.rawSchoolYear=text ;
 raw.values( 15 ) =%ucs2( '' ) ;
 endif ;
 endif ;
 elseif field=26 ;
 text=hints.rawGradeCode ;
 if LongEdit( text :protected :4 :2 ) ;
 if text<>hints.rawGradeCode ;
 hints.rawGradeCode=text ;
 raw.values( 15 ) =%ucs2( '' ) ;
 endif ;
 endif ;
 elseif field=27 ;
 LongEdit( fullGender :*on ) ;
 elseif field=28 ;
 LongEdit( fullPref :*on ) ;
 elseif field=29 ;
 LongEdit( fullStatus :*on ) ;
 elseif field=30 ;
 LongEdit( fullGrade :*on ) ;
 elseif field=31 ;
 LongEdit( fullRel :*on ) ;
 elseif field=32 ;
 LongEdit( fullClass :*on ) ;
 elseif field=33 ;
 LongEdit( fullUpdate :*on ) ;
 elseif field=34 ;
 LongEdit( fullError :*on ) ;
 endif ;
 end-proc ;
 dcl-proc ShowErrors ;
 dcl-s property varchar( 32 ) ;
 if result.errorCount=0 ;
 return ;
 endif ;
 errorIndex=%rem( errorIndex :result.errorCount ) +1 ;
 property=result.fieldErrors( errorIndex ).field ;
 select ;
 when property= 'studentNo' ;
 CSRROW=3 ;
 CSRCOL=12 ;
 when property= 'studentName' ;
 CSRROW=4 ;
 CSRCOL=12 ;
 when property= 'studentNameKana' ;
 CSRROW=5 ;
 CSRCOL=12 ;
 when property= 'birthDate' ;
 CSRROW=6 ;
 CSRCOL=12 ;
 when property= 'genderCode' ;
 CSRROW=6 ;
 CSRCOL=82 ;
 when property= 'postalCode' ;
 CSRROW=7 ;
 CSRCOL=12 ;
 when property= 'prefectureCode' ;
 CSRROW=7 ;
 CSRCOL=42 ;
 when property= 'addressLine1' ;
 CSRROW=8 ;
 CSRCOL=12 ;
 when property= 'addressLine2' ;
 CSRROW=9 ;
 CSRCOL=12 ;
 when property= 'phoneNumber' ;
 CSRROW=10 ;
 CSRCOL=12 ;
 when property= 'emailAddress' ;
 CSRROW=11 ;
 CSRCOL=12 ;
 when property= 'admissionDate' ;
 CSRROW=3 ;
 CSRCOL=72 ;
 when property= 'enrollmentStatusCode' ;
 CSRROW=3 ;
 CSRCOL=94 ;
 when property= 'enrollmentEndDate' ;
 CSRROW=4 ;
 CSRCOL=72 ;
 when property= 'classId' ;
 CSRROW=10 ;
 CSRCOL=72 ;
 when property= 'emergencyContactName' ;
 CSRROW=12 ;
 CSRCOL=12 ;
 when property= 'relationshipCode' ;
 CSRROW=12 ;
 CSRCOL=44 ;
 when property= 'emergencyPhoneNumber' ;
 CSRROW=12 ;
 CSRCOL=72 ;
 when property= 'remarks' ;
 CSRROW=13 ;
 CSRCOL=12 ;
 when property= 'reason' ;
 CSRROW=16 ;
 CSRCOL=12 ;
 when property= 'schoolYear' ;
 CSRROW=7 ;
 CSRCOL=80 ;
 when property= 'gradeCode' ;
 CSRROW=7 ;
 CSRCOL=96 ;
 endsl ;
 end-proc ;
 dcl-proc SaveForm ;
 dcl-s token char( 36 ) ;
 dcl-s temp varucs2( 320 ) ccsid( 1200 ) ;
 StClock( utc :day ) ;
 StNormalize( raw :work :day :result ) ;
 temp=StNormalizeText( hints.rawSchoolYear :4 :4 :11 :*off :'schoolYear' :result ) ;
 if result.kind=0 ;
 hints.schoolYear=%char( temp ) ;
 endif ;
 temp=StNormalizeText( hints.rawGradeCode :2 :2 :6 :*off :'gradeCode' :result ) ;
 if result.kind=0 ;
 hints.gradeCode=%char( temp ) ;
 endif ;
 if result.kind=0 ;
 StValidate( work :result ) ;
 endif ;
 if result.kind<>0 ;
 errorIndex=0 ;
 ShowErrors( ) ;
 return ;
 endif ;
 dou *off ;
 StSaveStudent( work :hints :studentId :rec.rowVersion :token :result ) ;
 if result.kind=RK_CONFIRM ;
 if not Question( result.messageId :hints.reason :*on :result ) ;
 StCancelConfirmation( hints.instanceId :lookupResult ) ;
 return ;
 endif ;
 token=result.token ;
 iter ;
 endif ;
 if result.kind=RK_SAVED ;
 notice=Render( UiMessage( result :work.studentNo ) :128 ) ;
 closed=*on ;
 elseif result.kind=RK_NOCHANGE ;
 notice=Render( UiMessage( result :work.studentNo ) :128 ) ;
 closed=*on ;
 elseif result.kind=RK_VALIDATION ;
 errorIndex=0 ;
 ShowErrors( ) ;
 elseif result.kind=RK_CONFLICT ;
 if Question( 'E-STU-105' :reason :*off :result ) ;
 LoadForm( ) ;
 endif ;
 endif ;
 leave ;
 enddo ;
 end-proc ;
 dcl-proc PickField ;
 dcl-pi *n ;
 field int( 10 ) const ;
 end-pi ;
 dcl-s kind varchar( 24 ) ;
 dcl-s selected varchar( 24 ) ;
 dcl-s year int( 10 ) ;
 dcl-s id int( 20 ) ;
 dcl-s temp varucs2( 320 ) ccsid( 1200 ) ;
 dcl-s grade varchar( 2 ) ;
 clear lookupResult ;
 temp=StNormalizeText( hints.rawSchoolYear :4 :4 :11 :*off :'schoolYear' :lookupResult ) ;
 if lookupResult.kind<>0 ;
 result=lookupResult ;
 return ;
 endif ;
 year=0 ;
 if %len( temp ) >0 ;
 year=%int( %char( temp ) ) ;
 endif ;
 temp=StNormalizeText( hints.rawGradeCode :2 :2 :6 :*off :'gradeCode' :lookupResult ) ;
 if lookupResult.kind<>0 ;
 result=lookupResult ;
 return ;
 endif ;
 grade=%char( temp ) ;
 select ;
 when field=20 ;
 kind= 'ERA' ;
 when field=5 ;
 kind= 'GENDER' ;
 when field=7 ;
 kind= 'PREFECTURE' ;
 when field=13 ;
 kind= 'ENROLLMENT_STATUS' ;
 when field=15 ;
 kind= 'CLASS' ;
 when field=17 ;
 kind= 'RELATIONSHIP' ;
 when field=25 ;
 kind= 'YEAR' ;
 when field=26 ;
 kind= 'GRADE' ;
 other ;
 return ;
 endsl ;
 if field=20 ;
 selected=Choice( kind :%char( raw.birthEra ) :0 :'' :*on ) ;
 raw.birthEra=%ucs2( selected ) ;
 elseif field=25 ;
 selected=Choice( kind :hints.schoolYear :0 :'' :*on ) ;
 if selected<>hints.schoolYear ;
 hints.schoolYear=selected ;
 hints.rawSchoolYear=%ucs2( selected ) ;
 raw.values( 15 ) =%ucs2( '' ) ;
 endif ;
 elseif field=26 ;
 selected=Choice( kind :hints.gradeCode :year :'' :*on ) ;
 if selected<>hints.gradeCode ;
 hints.gradeCode=selected ;
 hints.rawGradeCode=%ucs2( selected ) ;
 raw.values( 15 ) =%ucs2( '' ) ;
 endif ;
 else ;
 selected=Choice( kind :%char( raw.values( field ) ) :year :grade :*on ) ;
 raw.values( field ) =%ucs2( selected ) ;
 if field=15 and selected<> '' ;
 id=%int( selected ) ;
 StClassInfo( id :hints.schoolYear :hints.gradeCode :occupancy :capacity :capacityInd :
 result :*on ) ;
 hints.rawSchoolYear=%ucs2( hints.schoolYear ) ;
 hints.rawGradeCode=%ucs2( hints.gradeCode ) ;
 endif ;
 endif ;
 end-proc ;
/copy '../copy/STUDSP.rpgleinc'
/copy '../copy/STUFIELDUI.rpgleinc'
