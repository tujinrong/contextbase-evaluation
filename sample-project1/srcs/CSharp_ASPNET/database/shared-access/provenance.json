  "producerSource": {
    "path": "test-project1/srcs/Access-CSharp_ASPNET/tools/New-TrainingDatabase.ps1",
    "sha256": "d89d636ae8cf1fbaaefb4a4c3c2a9e6edd1d5c83c5583788e076c5f3409fc019",
    "startLine": 1,
    "endLine": 18,
    "lines": [
      {
        "line": 1,
        "text": "[CmdletBinding()]"
      },
      {
        "line": 2,
        "text": "param([string]$Server='.\\SQLEXPRESS', [string]$Database='AccessRebuilderTraining_01a17be7')"
      },
      {
        "line": 3,
        "text": "$ErrorActionPreference='Stop'"
      },
      {
        "line": 4,
        "text": "if ($Server -ne '.\\SQLEXPRESS' -or $Database -notmatch '^AccessRebuilderTraining_[A-Za-z0-9_]+$') { throw 'This helper only creates a named local training database.' }"
      },
      {
        "line": 5,
        "text": "$methodRoot=Split-Path -Parent $PSScriptRoot"
      },
      {
        "line": 6,
        "text": "$schema=Join-Path $methodRoot 'database/sql/001-schema.sql'"
      },
      {
        "line": 7,
        "text": "$seed=Join-Path $methodRoot 'database/sql/002-seed.sql'"
      },
      {
        "line": 8,
        "text": "if (-not (Test-Path -LiteralPath $schema) -or -not (Test-Path -LiteralPath $seed)) { throw 'Generate schema and seed first.' }"
      },
      {
        "line": 9,
        "text": "# A pre-existing database is never dropped, reset or adopted by this creation helper."
      },
      {
        "line": 10,
        "text": "$create=\"IF DB_ID(N'$Database') IS NOT NULL THROW 51000,'Training database already exists; no changes.',1; EXEC(N'CREATE DATABASE [$Database]');\""
      },
      {
        "line": 11,
        "text": "& sqlcmd -S $Server -E -C -b -Q $create"
      },
      {
        "line": 12,
        "text": "if ($LASTEXITCODE -ne 0) { throw 'Database creation failed.' }"
      },
      {
        "line": 13,
        "text": "& sqlcmd -S $Server -d $Database -E -C -b -Q \"EXEC sys.sp_addextendedproperty @name=N'AccessRebuilderOwner',@value=N'test-project1/Access-CSharp_ASPNET';\""
      },
      {
        "line": 14,
        "text": "if ($LASTEXITCODE -ne 0) { throw 'Database ownership marker failed.' }"
      },
      {
        "line": 15,
        "text": "& sqlcmd -S $Server -d $Database -E -C -b -f 65001 -i $schema"
      },
      {
        "line": 16,
        "text": "if ($LASTEXITCODE -ne 0) { throw 'Schema creation failed; dedicated DB retained for inspection.' }"
      },
      {
        "line": 17,
        "text": "& sqlcmd -S $Server -d $Database -E -C -b -f 65001 -i $seed"
      },
      {
        "line": 18,
        "text": "if ($LASTEXITCODE -ne 0) { throw 'Seed failed; dedicated DB retained for inspection.' }"
      }
    ],
    "defaultDatabaseName": "AccessRebuilderTraining_01a17be7"
  },
