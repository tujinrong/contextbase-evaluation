@model LoginPageModel
<section class="login-card" aria-labelledby="login-title">
    <p class="login-eyebrow">学生管理システム</p>
    <h1 id="login-title">ログイン</h1>
    <p class="login-description">利用者名とパスワードを入力してください。</p>
    @if (Model.Error is not null) { <p class="message error" role="alert">@Model.Error</p> }
    <form action="/login" method="post" class="login-form">
        @Html.AntiForgeryToken()
        <label for="login-username">利用者名<input id="login-username" name="Username" value="@Model.Username" autocomplete="username" maxlength="64" required autofocus></label>
        <label for="login-password">パスワード<input id="login-password" name="Password" type="password" autocomplete="current-password" maxlength="1024" required></label>
        <button class="primary" type="submit">ログイン</button>
    </form>
</section>
