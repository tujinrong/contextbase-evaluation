<Application x:Class="StudentManagement.Wpf.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Style TargetType="TextBox">
   <Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="BorderBrush" Value="#A5B6C7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#22374C"/><Setter Property="Background" Value="White"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Style.Triggers><Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="#F0F3F7"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="34"/><Setter Property="BorderBrush" Value="#A5B6C7"/><Setter Property="Foreground" Value="#22374C"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,2,7,2"/><Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#98ABBE"/><Setter Property="Foreground" Value="#253C54"/></Style>
  <Style TargetType="Label"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2,5,2"/></Style>
 </Application.Resources>
</Application>
