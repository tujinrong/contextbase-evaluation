<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><RootNamespace>StudentManagement.WinForms</RootNamespace><StartupObject>StudentManagement.WinForms.GuiEvidence.Program</StartupObject><MyType>Empty</MyType><EnableDefaultCompileItems>false</EnableDefaultCompileItems><OptionStrict>On</OptionStrict><OptionExplicit>On</OptionExplicit><OptionInfer>On</OptionInfer><AssemblyName>Vb.GuiEvidence</AssemblyName></PropertyGroup>
 <ItemGroup><PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3"/><Compile Include="Program.vb;InitialFocusRegression.vb;FixtureService.vb;FixtureApplicationService.vb"/><Compile Include="../../Forms/*.vb" Link="Production/Forms/%(Filename)%(Extension)"/><Compile Include="../../Presenters/*.vb" Link="Production/Presenters/%(Filename)%(Extension)"/><Compile Include="../../Controls/*.vb" Link="Production/Controls/%(Filename)%(Extension)"/><Compile Include="../../Domain/*.vb" Link="Production/Domain/%(Filename)%(Extension)"/><Compile Include="../../Infrastructure/*.vb" Link="Production/Infrastructure/%(Filename)%(Extension)"/><None Include="fixture.json" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
