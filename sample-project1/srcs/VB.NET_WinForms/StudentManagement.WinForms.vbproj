<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
  <RootNamespace>StudentManagement.WinForms</RootNamespace><StartupObject>StudentManagement.WinForms.Program</StartupObject><MyType>Empty</MyType>
  <OptionStrict>On</OptionStrict><OptionExplicit>On</OptionExplicit><OptionInfer>On</OptionInfer>
  <DefaultItemExcludes>$(DefaultItemExcludes);build/**</DefaultItemExcludes>
 </PropertyGroup>
 <ItemGroup><PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" /></ItemGroup>
 <ItemGroup><Compile Remove="Tests\**;Maintenance\**;database\tests\**;build\**" /></ItemGroup>
</Project>
