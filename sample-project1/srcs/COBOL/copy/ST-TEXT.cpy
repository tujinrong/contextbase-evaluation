01 TEXT-UI EXTERNAL.
  05 T-PANEL PIC X(16).
  05 T-PREVIOUS-PANEL PIC X(16).
  05 T-SCREEN PIC X(8).
  05 T-ACTION PIC X(16).
  05 T-REQUEST PIC S9(18) COMP-5.
  05 T-SEQUENCE PIC S9(18) COMP-5.
  05 T-EDITOR-EXPECTED PIC S9(18) COMP-5.
  05 T-EXPECTED PIC S9(18) COMP-5.
  05 T-WINDOW-ID PIC X(64).
  05 T-SESSION PIC X(64).
  05 T-KEY PIC S9(9) COMP-5.
  05 T-FOCUS PIC S9(9) COMP-5.
  05 T-RETURN-FOCUS PIC S9(9) COMP-5.
  05 T-ID PIC S9(9) COMP-5.
  05 T-ROW PIC S9(9) COMP-5.
  05 T-COL PIC S9(9) COMP-5.
  05 T-WIDTH PIC S9(9) COMP-5.
  05 T-HEIGHT PIC S9(9) COMP-5.
  05 T-FLAGS PIC S9(9) COMP-5.
  05 T-MAX PIC S9(9) COMP-5.
  05 T-CHANGED PIC S9(9) COMP-5.
  05 T-RC PIC S9(9) COMP-5.
  05 T-STOP PIC S9(9) COMP-5.
  05 T-DISPLAY-WINDOW PIC S9(9) COMP-5.
  05 T-MODAL-WINDOW PIC S9(9) COMP-5.
  05 T-PICK-FIELD PIC S9(9) COMP-5.
  05 T-PICK-START PIC S9(9) COMP-5.
  05 T-PICK-TOTAL PIC S9(9) COMP-5.
  05 T-PICK-COUNT PIC S9(9) COMP-5.
  05 T-ERROR-COUNT PIC S9(9) COMP-5.
  05 T-ERROR-SEEN PIC S9(9) COMP-5.
  05 T-NAME-COUNT PIC S9(9) COMP-5.
  05 T-NAMED OCCURS 64 TIMES.
    10 T-NAME PIC X(32).
    10 T-SLOT PIC S9(9) COMP-5.
  05 T-REGISTERED OCCURS 64 TIMES PIC S9(9) COMP-5.
  05 T-MAXIMUM OCCURS 64 TIMES PIC S9(9) COMP-5.
  05 T-FIELD-LABEL OCCURS 64 TIMES PIC X(64).
  05 T-SPECIALS.
    10 T-SPECIAL OCCURS 8 TIMES.
      15 T-SPECIAL-LENGTH PIC S9(9) COMP-5.
      15 T-SPECIAL-NULL PIC S9(4) COMP-5.
      15 FILLER PIC X(2).
      15 T-SPECIAL-DATA PIC X(1024).
  05 T-PICKS.
    10 T-PICK OCCURS 6 TIMES.
      15 T-PICK-SELECTABLE PIC S9(9) COMP-5.
      15 T-PICK-VALUE.
        20 T-PICK-LENGTH PIC S9(9) COMP-5.
        20 T-PICK-NULL PIC S9(4) COMP-5.
        20 FILLER PIC X(2).
        20 T-PICK-DATA PIC X(1024).
      15 T-PICK-LABEL.
        20 T-PICK-LABEL-LENGTH PIC S9(9) COMP-5.
        20 T-PICK-LABEL-NULL PIC S9(4) COMP-5.
        20 FILLER PIC X(2).
        20 T-PICK-LABEL-DATA PIC X(1024).
  05 T-ERRORS.
    10 T-ERROR OCCURS 64 TIMES.
      15 T-ERROR-FIELD PIC S9(9) COMP-5.
      15 T-ERROR-VALUE.
        20 T-ERROR-LENGTH PIC S9(9) COMP-5.
        20 T-ERROR-NULL PIC S9(4) COMP-5.
        20 FILLER PIC X(2).
        20 T-ERROR-DATA PIC X(1024).
  05 T-VALUE.
    10 T-LENGTH PIC S9(9) COMP-5.
    10 T-NULL PIC S9(4) COMP-5.
    10 FILLER PIC X(2).
    10 T-DATA PIC X(1024).
  05 T-CLASS-COUNTS PIC X(1032).
  05 T-CLASS-LABEL PIC X(1032).
  05 T-TITLE PIC X(1032).
  05 T-PANEL-VALUE PIC X(1032).
