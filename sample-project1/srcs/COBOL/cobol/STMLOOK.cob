       >>SOURCE FORMAT FREE
identification division.
program-id. STMLOOK.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
copy "ST-TEXT.cpy".
01 SELECTABLE BINARY-LONG SIGNED.
01 SHOW-OPTION BINARY-LONG SIGNED.
01 COLUMN-COUNT BINARY-LONG SIGNED.
01 LABEL-POS BINARY-LONG SIGNED.
01 PREVIOUS-YEAR PIC X(1024).

procedure division.
    MOVE 0 TO T-PICK-TOTAL T-PICK-COUNT INITIALIZE T-PICKS
    IF UI-CATEGORY = "ERA" PERFORM ERA-LIST GOBACK END-IF
    IF UI-CATEGORY = "CLASS" OR "YEAR"
      IF VIEW-MODE = "Edit" MOVE "CLASS-EDIT" TO COMMAND-NAME
      ELSE MOVE "CLASS-LIST" TO COMMAND-NAME END-IF
    ELSE MOVE "CODE-LIST" TO COMMAND-NAME END-IF
    PERFORM DB-RESET PERFORM DB-EXECUTE IF RC NOT = 0 GOBACK END-IF
    MOVE SPACES TO PREVIOUS-YEAR
    PERFORM UNTIL EXIT
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      IF RC NOT = 1 EXIT PERFORM END-IF
      IF UI-CATEGORY = "CLASS" OR "YEAR"
        MOVE 10 TO COLUMN-COUNT
        IF VIEW-MODE = "Edit" MOVE 11 TO COLUMN-COUNT END-IF
      ELSE MOVE 7 TO COLUMN-COUNT END-IF
      PERFORM VARYING K FROM 1 BY 1 UNTIL K > COLUMN-COUNT
        CALL "STCOLUMN" USING BY REFERENCE ST-DB-RESULT BY VALUE K
          BY REFERENCE LOOKUP-VALUE(K) RETURNING RC END-CALL
        IF RC NOT = 0 EXIT PERFORM END-IF
      END-PERFORM
      IF RC NOT = 0 EXIT PERFORM END-IF
      MOVE 1 TO SELECTABLE SHOW-OPTION
      IF UI-CATEGORY = "YEAR"
        IF LOOKUP-DATA(2) = PREVIOUS-YEAR MOVE 0 TO SHOW-OPTION
        ELSE MOVE LOOKUP-DATA(2) TO PREVIOUS-YEAR END-IF
        MOVE LOOKUP-VALUE(2) TO TMP-VALUE
      ELSE
        IF UI-CATEGORY = "CLASS"
          MOVE LOOKUP-VALUE(1) TO TMP-VALUE
          IF VIEW-MODE = "Edit" AND N-NULL(27) = 0 AND LOOKUP-DATA(2) NOT = N-DATA(27)
            MOVE 0 TO SHOW-OPTION END-IF
          IF VIEW-MODE = "Edit" AND N-NULL(26) = 0 AND LOOKUP-DATA(3) NOT = N-DATA(26)
            MOVE 0 TO SHOW-OPTION END-IF
          IF VIEW-MODE = "Edit"
            IF N-DATA(28)(1:2) = "03" OR "04"
              IF R-NULL(F-ADMISSIONDATE) = -1 OR R-NULL(F-ENROLLMENTENDDATE) = -1
                OR LOOKUP-DATA(6)(1:10) > R-DATA(F-ENROLLMENTENDDATE)(1:10)
                OR LOOKUP-DATA(7)(1:10) < R-DATA(F-ADMISSIONDATE)(1:10)
                MOVE 0 TO SELECTABLE END-IF
            ELSE
              IF LOOKUP-DATA(8)(1:1) NOT = "1" OR
                LOOKUP-DATA(6)(1:10) > BUSINESS-DAY OR
                LOOKUP-DATA(7)(1:10) < BUSINESS-DAY MOVE 0 TO SELECTABLE END-IF
            END-IF
            IF LOOKUP-DATA(1) = UI-CURRENT MOVE 1 TO SELECTABLE END-IF
          END-IF
        ELSE
          IF LOOKUP-DATA(1) NOT = UI-CATEGORY MOVE 0 TO SHOW-OPTION END-IF
          MOVE LOOKUP-VALUE(2) TO TMP-VALUE
          IF VIEW-MODE = "Edit"
            IF LOOKUP-DATA(4)(1:1) NOT = "1" OR LOOKUP-DATA(5)(1:1) NOT = "1"
              OR LOOKUP-DATA(6)(1:10) > BUSINESS-DAY OR
              (LOOKUP-NULL(7) = 0 AND LOOKUP-DATA(7)(1:10) < BUSINESS-DAY)
              MOVE 0 TO SELECTABLE END-IF
            IF LOOKUP-DATA(2) = UI-CURRENT MOVE 1 TO SELECTABLE END-IF
          END-IF
        END-IF
      END-IF
      IF SHOW-OPTION = 1
        ADD 1 TO T-PICK-TOTAL
        IF T-PICK-TOTAL >= T-PICK-START AND T-PICK-COUNT < 6
          ADD 1 TO T-PICK-COUNT
          MOVE SELECTABLE TO T-PICK-SELECTABLE(T-PICK-COUNT)
          MOVE TMP-VALUE TO T-PICK-VALUE(T-PICK-COUNT)
          INITIALIZE T-PICK-LABEL(T-PICK-COUNT)
          MOVE 1 TO LABEL-POS
          EVALUATE UI-CATEGORY
            WHEN "YEAR"
              MOVE LOOKUP-VALUE(2) TO T-PICK-LABEL(T-PICK-COUNT)
            WHEN "CLASS"
              STRING FUNCTION TRIM(LOOKUP-DATA(1)) " / "
                FUNCTION TRIM(LOOKUP-DATA(2)) " / "
                FUNCTION TRIM(LOOKUP-DATA(10)) " / "
                FUNCTION TRIM(LOOKUP-DATA(4)) " / "
                FUNCTION TRIM(LOOKUP-DATA(5))
                INTO T-PICK-LABEL-DATA(T-PICK-COUNT) WITH POINTER LABEL-POS
              END-STRING
              IF LOOKUP-DATA(8)(1:1) NOT = "1"
                STRING " (停止)" INTO T-PICK-LABEL-DATA(T-PICK-COUNT)
                  WITH POINTER LABEL-POS END-STRING END-IF
              IF LOOKUP-DATA(6)(1:10) > BUSINESS-DAY OR LOOKUP-DATA(7)(1:10) < BUSINESS-DAY
                STRING " (期間外)" INTO T-PICK-LABEL-DATA(T-PICK-COUNT)
                  WITH POINTER LABEL-POS END-STRING END-IF
              IF VIEW-MODE = "Edit"
                STRING " 人数参考:" FUNCTION TRIM(LOOKUP-DATA(11)) " / 定員:"
                  INTO T-PICK-LABEL-DATA(T-PICK-COUNT) WITH POINTER LABEL-POS END-STRING
                IF LOOKUP-NULL(9) = -1
                  STRING "制限なし" INTO T-PICK-LABEL-DATA(T-PICK-COUNT)
                    WITH POINTER LABEL-POS END-STRING
                ELSE STRING FUNCTION TRIM(LOOKUP-DATA(9))
                  INTO T-PICK-LABEL-DATA(T-PICK-COUNT) WITH POINTER LABEL-POS END-STRING END-IF
              END-IF
            WHEN OTHER
              STRING FUNCTION TRIM(LOOKUP-DATA(2)) " / " FUNCTION TRIM(LOOKUP-DATA(3))
                INTO T-PICK-LABEL-DATA(T-PICK-COUNT) WITH POINTER LABEL-POS END-STRING
              IF SELECTABLE = 0
                STRING " (新規選択不可)" INTO T-PICK-LABEL-DATA(T-PICK-COUNT)
                  WITH POINTER LABEL-POS END-STRING END-IF
          END-EVALUATE
          COMPUTE T-PICK-LABEL-LENGTH(T-PICK-COUNT) =
            FUNCTION LENGTH(FUNCTION TRIM(T-PICK-LABEL-DATA(T-PICK-COUNT)))
        END-IF
      END-IF
    END-PERFORM
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL GOBACK.

ERA-LIST.
    MOVE 5 TO T-PICK-TOTAL T-PICK-COUNT
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 5
      MOVE 1 TO T-PICK-SELECTABLE(I)
      EVALUATE I
        WHEN 1 MOVE "REIWA" TO T-PICK-DATA(I) MOVE "R / 令和" TO T-PICK-LABEL-DATA(I)
        WHEN 2 MOVE "HEISEI" TO T-PICK-DATA(I) MOVE "H / 平成" TO T-PICK-LABEL-DATA(I)
        WHEN 3 MOVE "SHOWA" TO T-PICK-DATA(I) MOVE "S / 昭和" TO T-PICK-LABEL-DATA(I)
        WHEN 4 MOVE "TAISHO" TO T-PICK-DATA(I) MOVE "T / 大正" TO T-PICK-LABEL-DATA(I)
        WHEN 5 MOVE "MEIJI" TO T-PICK-DATA(I) MOVE "M / 明治" TO T-PICK-LABEL-DATA(I)
      END-EVALUATE
      COMPUTE T-PICK-LENGTH(I) = FUNCTION LENGTH(FUNCTION TRIM(T-PICK-DATA(I)))
      COMPUTE T-PICK-LABEL-LENGTH(I) = FUNCTION LENGTH(FUNCTION TRIM(T-PICK-LABEL-DATA(I)))
    END-PERFORM.

copy "ST-HELPERS.cpy".
end program STMLOOK.
