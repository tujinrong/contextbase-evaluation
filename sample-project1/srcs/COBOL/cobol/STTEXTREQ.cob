       >>SOURCE FORMAT FREE
identification division.
program-id. STTEXTREQ.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
copy "ST-TEXT.cpy".
01 ALLOWED-NAME PIC X(32).
01 SEEN-SLOTS.
  05 SEEN-SLOT OCCURS 64 TIMES BINARY-LONG SIGNED.

procedure division.
    MOVE 200 TO APP-STATUS
    IF T-REQUEST NOT = T-SEQUENCE + 1 OR T-REQUEST < 1 OR
      T-EXPECTED NOT = CONTEXT-REVISION OR T-WINDOW-ID NOT = TAB-ID OR
      T-SESSION NOT = SESSION-DATA OR
      (VIEW-MODE = "Edit" AND T-EDITOR-EXPECTED NOT = EDITOR-REVISION)
      PERFORM BAD-REQUEST GOBACK END-IF
    IF T-SCREEN NOT = "SRC" AND "REG"
      PERFORM BAD-REQUEST GOBACK END-IF
    IF (VIEW-MODE = "Search" AND T-SCREEN NOT = "SRC") OR
      (VIEW-MODE = "Edit" AND T-SCREEN NOT = "REG")
      PERFORM BAD-REQUEST GOBACK END-IF
    IF T-ACTION NOT = "INIT" AND "OPEN" AND "NEW" AND "MENU" AND "SEARCH"
      AND "PAGE" AND "CLEAR" AND "OPTIONS" AND "CREATE" AND "UPDATE"
      AND "DELETE" AND "CONFIRM" AND "RESET" AND "RELOAD" AND "BACK" AND "CANCEL"
      PERFORM BAD-REQUEST GOBACK END-IF
    IF VIEW-MODE = "Search" AND T-ACTION NOT = "INIT" AND "OPEN" AND "NEW"
      AND "MENU" AND "SEARCH" AND "PAGE" AND "CLEAR" AND "OPTIONS"
      PERFORM BAD-REQUEST GOBACK END-IF
    IF VIEW-MODE = "Edit" AND T-ACTION NOT = "OPTIONS" AND "CREATE" AND "UPDATE"
      AND "DELETE" AND "CONFIRM" AND "RESET" AND "RELOAD" AND "BACK" AND "CANCEL"
      PERFORM BAD-REQUEST GOBACK END-IF
    IF VIEW-MODE = "Edit" AND EDITOR-PENDING NOT = SPACES AND LOW-VALUES
      AND T-ACTION NOT = "CONFIRM" AND "CANCEL"
      PERFORM BAD-REQUEST GOBACK END-IF
    IF (T-ACTION = "CREATE" AND STUDENT-ID NOT = 0) OR
      (T-ACTION = "UPDATE" AND STUDENT-ID <= 0)
      PERFORM BAD-REQUEST GOBACK END-IF
    IF T-NAME-COUNT < 0 OR > 64 PERFORM BAD-NAME GOBACK END-IF
    INITIALIZE SEEN-SLOTS
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > T-NAME-COUNT
      MOVE T-SLOT(I) TO J
      IF J < 1 OR > 64 PERFORM BAD-NAME GOBACK END-IF
      IF SEEN-SLOT(J) NOT = 0 PERFORM BAD-NAME GOBACK END-IF
      MOVE 1 TO SEEN-SLOT(J) MOVE SPACES TO ALLOWED-NAME
      IF VIEW-MODE = "Search"
        EVALUATE J
          WHEN 4 MOVE "studentNo" TO ALLOWED-NAME
          WHEN 5 MOVE "name" TO ALLOWED-NAME
          WHEN 21 MOVE "classId" TO ALLOWED-NAME
          WHEN 38 MOVE "pageSize" TO ALLOWED-NAME
          WHEN 39 MOVE "sortKey" TO ALLOWED-NAME
          WHEN 40 MOVE "sortDirection" TO ALLOWED-NAME
          WHEN 42 WHEN 43 WHEN 44 WHEN 45 MOVE "statusCode" TO ALLOWED-NAME
        END-EVALUATE
      ELSE
        EVALUATE J
          WHEN 4 MOVE "studentNo" TO ALLOWED-NAME
          WHEN 5 MOVE "studentName" TO ALLOWED-NAME
          WHEN 6 MOVE "studentNameKana" TO ALLOWED-NAME
          WHEN 7 MOVE "birthEra" TO ALLOWED-NAME
          WHEN 8 MOVE "birthYear" TO ALLOWED-NAME
          WHEN 9 MOVE "birthMonth" TO ALLOWED-NAME
          WHEN 10 MOVE "birthDay" TO ALLOWED-NAME
          WHEN 11 MOVE "genderCode" TO ALLOWED-NAME
          WHEN 12 MOVE "postalCode" TO ALLOWED-NAME
          WHEN 13 MOVE "prefectureCode" TO ALLOWED-NAME
          WHEN 14 MOVE "addressLine1" TO ALLOWED-NAME
          WHEN 15 MOVE "addressLine2" TO ALLOWED-NAME
          WHEN 16 MOVE "phoneNumber" TO ALLOWED-NAME
          WHEN 17 MOVE "emailAddress" TO ALLOWED-NAME
          WHEN 18 MOVE "admissionDate" TO ALLOWED-NAME
          WHEN 19 MOVE "enrollmentStatusCode" TO ALLOWED-NAME
          WHEN 20 MOVE "enrollmentEndDate" TO ALLOWED-NAME
          WHEN 21 MOVE "classId" TO ALLOWED-NAME
          WHEN 22 MOVE "emergencyContactName" TO ALLOWED-NAME
          WHEN 23 MOVE "relationshipCode" TO ALLOWED-NAME
          WHEN 24 MOVE "emergencyPhoneNumber" TO ALLOWED-NAME
          WHEN 25 MOVE "remarks" TO ALLOWED-NAME
          WHEN 26 MOVE "schoolYear" TO ALLOWED-NAME
          WHEN 27 MOVE "gradeCode" TO ALLOWED-NAME
          WHEN 28 MOVE "reason" TO ALLOWED-NAME
          WHEN 36 MOVE "deleteReason" TO ALLOWED-NAME
        END-EVALUATE
        IF EDITOR-PENDING NOT = SPACES AND LOW-VALUES
          IF (EDITOR-PENDING = "DELETE" AND J NOT = 36) OR
            (EDITOR-PENDING = "DUPLICATE" AND J NOT = 28) OR
            (EDITOR-PENDING NOT = "DELETE" AND "DUPLICATE")
            MOVE SPACES TO ALLOWED-NAME END-IF
        END-IF
      END-IF
      IF ALLOWED-NAME = SPACES OR T-NAME(I) NOT = ALLOWED-NAME
        PERFORM BAD-NAME GOBACK END-IF
      PERFORM VARYING K FROM 1 BY 1 UNTIL K >= I
        IF T-NAME(K) = T-NAME(I) AND T-NAME(I) NOT = "statusCode"
          PERFORM BAD-NAME GOBACK END-IF
      END-PERFORM
    END-PERFORM
    CALL "STTEXTCHECK" USING ST-RAW RETURNING RC END-CALL
    IF RC NOT = 0 PERFORM BAD-REQUEST GOBACK END-IF
    MOVE T-REQUEST TO T-SEQUENCE GOBACK.
BAD-NAME.
    MOVE 400 TO APP-STATUS
    MOVE "E-SRC-002: 未知・廃止・重複または許可外の入力項目です。" TO ERROR-TEXT
    PERFORM ADD-ERROR.
BAD-REQUEST.
    MOVE 400 TO APP-STATUS
    MOVE "E-COM-003: 操作・画面・要求連番・保持版が無効です。" TO ERROR-TEXT
    PERFORM ADD-ERROR.

copy "ST-HELPERS.cpy".
end program STTEXTREQ.
