       >>SOURCE FORMAT FREE
identification division.
program-id. STPROMPT.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
01 REASON-BACKUP PIC X(1032).
01 TOKEN-BACKUP PIC X(1032).
01 TOKEN-ACTION PIC X(16).
01 DIRTY-FLAG PIC S9(9) COMP-5.
01 ORIGINAL-INPUT.
  05 ORIGINAL-VALUE OCCURS 64 TIMES.
    10 ORIGINAL-LENGTH PIC S9(9) COMP-5.
    10 ORIGINAL-NULL PIC S9(4) COMP-5.
    10 FILLER PIC X(2).
    10 ORIGINAL-DATA PIC X(1024).

procedure division.
    IF R-NULL(F-EDITORID) = -1 GOBACK END-IF
    MOVE "Edit" TO VIEW-MODE
    CALL "STSTATE" END-CALL IF APP-STATUS NOT = 200 GOBACK END-IF
    MOVE R-DATA(F-EDITORID) TO EDITOR-ID MOVE "Editor" TO STATE-KIND
    CALL "STSTATEIO" USING BY VALUE DB-HANDLE 2
      BY REFERENCE EDITOR-ID STATE-KIND OWNER-VALUE SESSION-VALUE TAB-ID
        EDITOR-STATE BY VALUE LENGTH OF EDITOR-STATE
      BY REFERENCE EDITOR-REVISION BY VALUE 30 RETURNING RC END-CALL
    IF RC NOT = 0 OR EDITOR-TAB NOT = TAB-ID
      MOVE 409 TO APP-STATUS GOBACK END-IF
    MOVE EDITOR-TARGET TO STUDENT-ID
    MOVE EDITOR-VERSION TO EXPECTED-VERSION
    IF SEARCH-PROMPT-KIND NOT = SPACES AND LOW-VALUES AND
      EDITOR-PENDING NOT = SEARCH-PROMPT-KIND
      MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME GOBACK
    END-IF
    IF EDITOR-PENDING NOT = SPACES AND LOW-VALUES AND
      R-DATA(F-ACTION) NOT = "CONFIRM" AND "CANCEL"
      MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME
      MOVE "E-COM-003: 確認中は続行または取消だけを選択してください。"
        TO ERROR-TEXT PERFORM ADD-ERROR GOBACK
    END-IF
    IF R-DATA(F-ACTION) NOT = "RESET" AND "RELOAD" AND "BACK"
      AND "DELETE" AND "CONFIRM" AND "CANCEL" GOBACK END-IF
    IF EDITOR-PENDING = "DUPLICATE"
      MOVE R-DATA(F-ACTION) TO TOKEN-ACTION
      MOVE R-VALUE(F-REASON) TO REASON-BACKUP
      MOVE R-VALUE(F-CONFIRMATIONTOKEN) TO TOKEN-BACKUP
      MOVE EDITOR-DRAFT TO ST-RAW
      IF TOKEN-BACKUP NOT = R-VALUE(F-CONFIRMATIONTOKEN)
        MOVE 409 TO APP-STATUS MOVE "Conflict" TO APP-OUTCOME GOBACK
      END-IF
      IF TOKEN-ACTION = "CANCEL"
        MOVE "CANCEL" TO R-DATA(F-ACTION) MOVE 6 TO R-LENGTH(F-ACTION)
        MOVE SPACES TO EDITOR-PENDING
      ELSE
        MOVE REASON-BACKUP TO R-VALUE(F-REASON)
        MOVE "CONFIRM" TO R-DATA(F-ACTION) MOVE 7 TO R-LENGTH(F-ACTION)
      END-IF
      CALL "STPEND" END-CALL GOBACK
    END-IF
    IF R-DATA(F-ACTION) = "RESET" OR "RELOAD" OR "BACK"
      MOVE EDITOR-RAW TO ORIGINAL-INPUT MOVE 0 TO DIRTY-FLAG
      PERFORM VARYING I FROM 4 BY 1 UNTIL I > 28
        IF R-LENGTH(I) NOT = ORIGINAL-LENGTH(I)
          MOVE 1 TO DIRTY-FLAG
        ELSE
          IF R-LENGTH(I) > 0 AND
            R-DATA(I)(1:R-LENGTH(I)) NOT = ORIGINAL-DATA(I)(1:R-LENGTH(I))
            MOVE 1 TO DIRTY-FLAG
          END-IF
        END-IF
      END-PERFORM
      IF DIRTY-FLAG = 0
        MOVE "1" TO R-DATA(F-CONFIRMED)
        MOVE 1 TO R-LENGTH(F-CONFIRMED) MOVE 0 TO R-NULL(F-CONFIRMED)
        IF R-DATA(F-ACTION) = "BACK"
          MOVE "RESUME" TO R-DATA(F-ACTION) MOVE 6 TO R-LENGTH(F-ACTION)
        END-IF
        GOBACK
      END-IF
    END-IF
    IF R-DATA(F-ACTION) = "RESET" OR "RELOAD" OR "BACK" OR "DELETE"
      IF R-DATA(F-ACTION) = "DELETE" AND ROLE-CODE NOT = 2
        MOVE 403 TO APP-STATUS GOBACK END-IF
      MOVE ST-RAW TO EDITOR-DRAFT
      MOVE R-DATA(F-ACTION) TO EDITOR-PENDING
      MOVE "ActionConfirmation" TO APP-OUTCOME
    ELSE
      IF EDITOR-PENDING = SPACES OR LOW-VALUES GOBACK END-IF
      IF R-DATA(F-ACTION) = "CANCEL"
        MOVE EDITOR-DRAFT TO ST-RAW
        MOVE "PromptCancelled" TO APP-OUTCOME
      ELSE
        MOVE R-VALUE(F-DELETEREASON) TO REASON-BACKUP
        MOVE EDITOR-DRAFT TO ST-RAW
        MOVE EDITOR-PENDING TO R-DATA(F-ACTION)
        COMPUTE R-LENGTH(F-ACTION) = FUNCTION LENGTH(FUNCTION TRIM(EDITOR-PENDING))
        MOVE 0 TO R-NULL(F-ACTION)
        MOVE "1" TO R-DATA(F-CONFIRMED)
        MOVE 1 TO R-LENGTH(F-CONFIRMED) MOVE 0 TO R-NULL(F-CONFIRMED)
        IF EDITOR-PENDING = "DELETE"
          MOVE REASON-BACKUP TO R-VALUE(F-DELETEREASON)
        END-IF
        IF EDITOR-PENDING = "BACK"
          MOVE "RESUME" TO R-DATA(F-ACTION) MOVE 6 TO R-LENGTH(F-ACTION)
        END-IF
      END-IF
      IF APP-OUTCOME = "PromptCancelled" OR EDITOR-PENDING NOT = "DELETE"
        MOVE SPACES TO EDITOR-PENDING END-IF
    END-IF
    CALL "STPEND" END-CALL GOBACK.

copy "ST-HELPERS.cpy".
end program STPROMPT.
