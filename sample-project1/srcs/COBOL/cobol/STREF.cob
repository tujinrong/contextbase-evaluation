       >>SOURCE FORMAT FREE
identification division.
program-id. STREF.
environment division.
configuration section.
repository. function all intrinsic.
data division.
working-storage section.
copy "ST-FIELDS.cpy".
copy "ST-APP.cpy".
copy "ST-LOCAL.cpy".
copy "ST-TEXT.cpy".
01 FOUND-CLASS BINARY-LONG SIGNED.
01 LABEL-POS BINARY-LONG SIGNED.

procedure division.
    INITIALIZE T-CLASS-COUNTS T-CLASS-LABEL
    IF R-NULL(F-CLASSID) = -1 GOBACK END-IF
    MOVE "CLASS-EDIT" TO COMMAND-NAME PERFORM DB-RESET PERFORM DB-EXECUTE
    IF RC NOT = 0 GOBACK END-IF
    MOVE 0 TO FOUND-CLASS
    PERFORM UNTIL EXIT
      CALL "STFETCH" USING ST-DB-RESULT RETURNING RC END-CALL
      IF RC = 0 EXIT PERFORM END-IF
      IF RC NOT = 1 MOVE 503 TO APP-STATUS EXIT PERFORM END-IF
      PERFORM VARYING K FROM 1 BY 1 UNTIL K > 11
        CALL "STCOLUMN" USING BY REFERENCE ST-DB-RESULT BY VALUE K
          BY REFERENCE LOOKUP-VALUE(K) RETURNING RC END-CALL
        IF RC NOT = 0 MOVE 503 TO APP-STATUS EXIT PERFORM END-IF
      END-PERFORM
      IF APP-STATUS NOT = 200 EXIT PERFORM END-IF
      IF R-LENGTH(F-CLASSID) = LOOKUP-LENGTH(1) AND
        R-DATA(F-CLASSID) = LOOKUP-DATA(1)
        MOVE 1 TO FOUND-CLASS
        INITIALIZE TMP-VALUE TMP2-VALUE
        MOVE 1 TO LABEL-POS
        STRING FUNCTION TRIM(LOOKUP-DATA(11)) " / " INTO TMP-DATA
          WITH POINTER LABEL-POS END-STRING
        IF LOOKUP-NULL(9) = -1
          STRING "制限なし" INTO TMP-DATA WITH POINTER LABEL-POS END-STRING
        ELSE STRING FUNCTION TRIM(LOOKUP-DATA(9)) INTO TMP-DATA
          WITH POINTER LABEL-POS END-STRING END-IF
        COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(TMP-DATA))
        MOVE TMP-VALUE TO T-CLASS-COUNTS
        STRING FUNCTION TRIM(LOOKUP-DATA(2)) " / "
          FUNCTION TRIM(LOOKUP-DATA(10)) " / " FUNCTION TRIM(LOOKUP-DATA(4))
          " / " FUNCTION TRIM(LOOKUP-DATA(5)) INTO TMP2-DATA END-STRING
        COMPUTE TMP2-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(TMP2-DATA))
        MOVE TMP2-VALUE TO T-CLASS-LABEL EXIT PERFORM
      END-IF
    END-PERFORM
    CALL "STCURSOR" USING ST-DB-RESULT END-CALL
    IF FOUND-CLASS = 0
      INITIALIZE TMP-VALUE MOVE "不整合: クラスが見つかりません。" TO TMP-DATA
      COMPUTE TMP-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(TMP-DATA))
      MOVE TMP-VALUE TO T-CLASS-LABEL
    END-IF
    GOBACK.

copy "ST-HELPERS.cpy".
end program STREF.
