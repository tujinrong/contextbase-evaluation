@model MasterIndexViewModel
@{ ViewData["Title"] = "マスタ管理"; }
<div class="pagehead"><div><p class="eyebrow">MASTER DATA</p><h1>マスタ管理</h1><p class="page-description">クラスと業務コードの登録・更新を行います。</p></div><span class="badge neutral">管理者専用</span></div>
<div class="master-tabs" role="tablist" aria-label="マスタの種類"><button type="button" id="class-tab" role="tab" aria-selected="true" aria-controls="classes-panel" data-tab-button="classes-panel">クラス管理 <span class="count-badge">@Model.Classes.Count</span></button><button type="button" id="code-tab" role="tab" aria-selected="false" aria-controls="codes-panel" data-tab-button="codes-panel">コード管理 <span class="count-badge">@Model.Codes.Count</span></button></div>
<section id="classes-panel" data-tab-panel role="tabpanel" aria-labelledby="class-tab" class="surface result-surface">
    <div class="master-toolbar"><input type="search" data-table-filter="class-table" aria-label="クラス一覧を絞り込み" placeholder="クラス名・年度などで絞り込み" /><a class="button primary" asp-action="Class">クラス追加</a></div>
    <div class="table-wrap"><table id="class-table"><thead><tr><th>年度</th><th>学年</th><th>コード</th><th>名称</th><th>利用期間</th><th>定員</th><th>状態</th><th>操作</th></tr></thead><tbody>
    @foreach (var item in Model.Classes)
    { <tr><td>@item.SchoolYear</td><td>@item.GradeCode</td><td class="student-number">@item.ClassCode</td><td><strong>@item.ClassName</strong></td><td>@item.ValidFrom ～ @item.ValidTo</td><td>@(item.Capacity?.ToString() ?? "上限なし")</td><td><span class="badge @(item.IsActive ? "success" : "neutral")">@(item.IsActive ? "有効" : "停止")</span></td><td><a class="row-link" asp-action="Class" asp-route-id="@item.ClassId">編集</a></td></tr> }
    </tbody></table></div>
</section>
<section id="codes-panel" data-tab-panel role="tabpanel" aria-labelledby="code-tab" class="surface result-surface" hidden>
    <div class="master-toolbar"><input type="search" data-table-filter="code-table" aria-label="コード一覧を絞り込み" placeholder="分類・コード・名称で絞り込み" /><a class="button primary" asp-action="Code">コード追加</a></div>
    <div class="table-wrap"><table id="code-table"><thead><tr><th>分類</th><th>コード</th><th>名称</th><th>利用期間</th><th>順序</th><th>状態</th><th>保護</th><th>操作</th></tr></thead><tbody>
    @foreach (var item in Model.Codes)
    { <tr><td>@item.CategoryId</td><td class="student-number">@item.CodeValue</td><td><strong>@item.CodeName</strong></td><td>@item.ValidFrom ～ @(item.ValidTo ?? "制限なし")</td><td>@item.DisplayOrder</td><td><span class="badge @(item.IsActive ? "success" : "neutral")">@(item.IsActive ? "有効" : "停止")</span></td><td>@(item.IsProtected ? "保護" : "—")</td><td><a class="row-link" asp-action="Code" asp-route-categoryId="@item.CategoryId" asp-route-codeValue="@item.CodeValue">編集</a></td></tr> }
    </tbody></table></div>
</section>
